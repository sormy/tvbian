-	unsigned int width_picture = pix_format_picture->width;
+	unsigned int width_picture = cedrus_picture_recon_format(ctx).width;
 	u32 value = 0;
 
 	/*
@@ -202,13 +200,15 @@ static int cedrus_dec_format_picture_prepare(struct cedrus_context *ctx,
 	struct v4l2_pix_format *pix_format = &format->fmt.pix;
 	struct v4l2_pix_format *pix_format_coded =
 		&ctx->v4l2.format_coded.fmt.pix;
+	unsigned int shift =
+		cedrus_picture_scale_shift(ctx, pix_format->pixelformat);
 	unsigned int width, height;
 	unsigned int bytesperline;
 	unsigned int sizeimage;
 
 	/* Picture format dimensions are copied from coded format. */
-	width = pix_format_coded->width;
-	height = pix_format_coded->height;
+	width = pix_format_coded->width >> shift;
+	height = pix_format_coded->height >> shift;
 
 	switch (pix_format->pixelformat) {
 	case V4L2_PIX_FMT_NV12_32L32:
@@ -268,6 +268,12 @@ static int cedrus_dec_format_picture_prepare(struct cedrus_context *ctx,
 		return -EINVAL;
 	}
 
+	/* The full-size NV12 reconstruction follows the scaled picture. */
+	if (shift)
+		sizeimage = cedrus_picture_visible_size(bytesperline, height) +
+			    ALIGN(pix_format_coded->width, 16) *
+			    ALIGN(pix_format_coded->height, 16) * 3 / 2;
+
 	pix_format->width = width;
 	pix_format->height = height;
 	pix_format->bytesperline = bytesperline;
@@ -350,32 +356,45 @@ int cedrus_dec_format_picture_configure(struct cedrus_context *ctx)
 }
 
 /*
- * Program the secondary output to convert the 8-bit NV12 reconstruction into
- * the visible P010 picture at the start of the buffer. The engine still needs
- * its 10-bit configuration and its second output enabled.
+ * Program the secondary output to write the visible picture, P010 or scaled
+ * NV12, at the start of the buffer from the NV12 reconstruction after it.
+ * The codec writes the addresses and enables its second output.
  */
-void cedrus_dec_picture_p010_output_set(struct cedrus_context *ctx)
+void cedrus_dec_picture_secondary_output_set(struct cedrus_context *ctx,
+					     dma_addr_t *luma_addr,
+					     dma_addr_t *chroma_addr)
 {
 	struct cedrus_device *dev = ctx->proc->dev;
 	struct v4l2_pix_format *pix_format = &ctx->v4l2.format_picture.fmt.pix;
 	struct cedrus_buffer *buffer = cedrus_job_buffer_picture(ctx);
 	u32 stride = pix_format->bytesperline;
+	u32 chroma_stride = cedrus_picture_is_p010(ctx) ? stride : stride / 2;
 	u32 chroma_size = stride * pix_format->height / 2;
-	dma_addr_t luma_addr, chroma_addr;
 
-	luma_addr = vb2_dma_contig_plane_dma_addr(&buffer->m2m_buffer.vb.vb2_buf,
-						  0);
-	chroma_addr = luma_addr + stride * pix_format->height;
+	*luma_addr =
+		vb2_dma_contig_plane_dma_addr(&buffer->m2m_buffer.vb.vb2_buf, 0);
+	*chroma_addr = *luma_addr + stride * pix_format->height;
 
 	cedrus_write(dev, VE_SECONDARY_FB_LINE_STRIDE,
 		     VE_PRIMARY_FB_LINE_STRIDE_LUMA(stride) |
-		     VE_PRIMARY_FB_LINE_STRIDE_CHROMA(stride));
+		     VE_PRIMARY_FB_LINE_STRIDE_CHROMA(chroma_stride));
 	cedrus_write(dev, VE_CHROMA_BUF_LEN,
 		     VE_SECONDARY_OUT_FMT_EXT |
 		     VE_CHROMA_BUF_LEN_SDRT(chroma_size));
 	cedrus_write(dev, VE_PRIMARY_OUT_FMT,
 		     VE_PRIMARY_OUT_FMT_NV12 | VE_SECONDARY_OUT_FMT_EXT_NV12);
-	cedrus_write(dev, VE_DEC_SECOND_OUT_CTRL, 0);
+}
+
+/* The secondary output of the H.265 engine, which VP9 shares. */
+void cedrus_dec_picture_second_out_set(struct cedrus_context *ctx)
+{
+	struct cedrus_device *dev = ctx->proc->dev;
+	dma_addr_t luma_addr, chroma_addr;
+
+	cedrus_dec_picture_secondary_output_set(ctx, &luma_addr, &chroma_addr);
+	cedrus_write(dev, VE_DEC_SECOND_OUT_CTRL,
+		     VE_SDRT_SCALE(cedrus_picture_is_scaled(ctx) ?
+				   ctx->v4l2.scale_shift : 0));
 	cedrus_write(dev, VE_DEC_SECOND_OUT_LUMA_ADDR, luma_addr >> 8);
 	cedrus_write(dev, VE_DEC_SECOND_OUT_CHROMA_ADDR, chroma_addr >> 8);
 }
