 .../media/sunxi/cedrus/cedrus_context.h       |  2 +
 .../staging/media/sunxi/cedrus/cedrus_dec.c   | 49 ++++++++----
 .../staging/media/sunxi/cedrus/cedrus_dec.h   |  5 +-
 .../media/sunxi/cedrus/cedrus_dec_h264.c      | 23 ++++--
 .../media/sunxi/cedrus/cedrus_dec_h265.c      | 11 ++-
 .../media/sunxi/cedrus/cedrus_dec_vp9.c       |  2 +-
 .../staging/media/sunxi/cedrus/cedrus_proc.c  | 79 ++++++++++++++++++-
 .../staging/media/sunxi/cedrus/cedrus_regs.h  |  7 ++
 9 files changed, 193 insertions(+), 38 deletions(-)

diff --git a/drivers/staging/media/sunxi/cedrus/cedrus.h b/drivers/staging/media/sunxi/cedrus/cedrus.h
index 596e271..7e97bbb 100644
--- a/drivers/staging/media/sunxi/cedrus/cedrus.h
+++ b/drivers/staging/media/sunxi/cedrus/cedrus.h
@@ -169,24 +169,59 @@ static inline bool cedrus_picture_is_p010(struct cedrus_context *ctx)
 	return ctx->v4l2.format_picture.fmt.pix.pixelformat == V4L2_PIX_FMT_P010;
 }
 
-/* Size of the visible P010 picture at the start of the buffer. */
-static inline unsigned int cedrus_picture_p010_size(struct cedrus_context *ctx)
+/* The secondary output scales 8-bit NV12 H.264 and H.265 pictures only. */
+static inline unsigned int cedrus_picture_scale_shift(struct cedrus_context *ctx,
+						      u32 pixelformat)
 {
-	struct v4l2_pix_format *pix_format = &ctx->v4l2.format_picture.fmt.pix;
+	u32 coded = ctx->v4l2.format_coded.fmt.pix.pixelformat;
 
-	return pix_format->bytesperline * pix_format->height * 3 / 2;
+	if (pixelformat != V4L2_PIX_FMT_NV12 || ctx->bit_depth_coded > 8 ||
+	    (coded != V4L2_PIX_FMT_H264_SLICE &&
+	     coded != V4L2_PIX_FMT_HEVC_SLICE))
+		return 0;
+
+	return ctx->v4l2.scale_shift;
+}
+
+static inline bool cedrus_picture_is_scaled(struct cedrus_context *ctx)
+{
+	return cedrus_picture_scale_shift(ctx,
+		ctx->v4l2.format_picture.fmt.pix.pixelformat);
+}
+
+/*
+ * The secondary output writes the visible picture, P010 or scaled, at the
+ * start of the buffer; the engine reconstructs into a hidden one after it.
+ */
+static inline bool cedrus_picture_is_secondary(struct cedrus_context *ctx)
+{
+	return cedrus_picture_is_p010(ctx) || cedrus_picture_is_scaled(ctx);
+}
+
+/* Size of the visible picture before the hidden reconstruction. */
+static inline unsigned int cedrus_picture_visible_size(unsigned int bytesperline,
+						       unsigned int height)
+{
+	return ALIGN(bytesperline * height * 3 / 2, 256);
 }
 
 /*
  * The 8-bit NV12 picture the engine reconstructs into and references: the
- * picture itself, or for P010 a hidden one after the visible P010 picture.
+ * picture itself, or a hidden full-size one after the visible picture.
  */
 static inline struct v4l2_pix_format
 cedrus_picture_recon_format(struct cedrus_context *ctx)
 {
 	struct v4l2_pix_format pix_format = ctx->v4l2.format_picture.fmt.pix;
+	struct v4l2_pix_format *pix_format_coded =
+		&ctx->v4l2.format_coded.fmt.pix;
+
+	if (cedrus_picture_is_scaled(ctx)) {
+		pix_format.width = pix_format_coded->width;
+		pix_format.height = ALIGN(pix_format_coded->height, 16);
+	}
 
-	if (cedrus_picture_is_p010(ctx)) {
+	if (cedrus_picture_is_secondary(ctx)) {
 		pix_format.pixelformat = V4L2_PIX_FMT_NV12;
 		pix_format.bytesperline = ALIGN(pix_format.width, 16);
 	}
@@ -207,12 +242,14 @@ static inline void cedrus_buffer_picture_dma(struct cedrus_context *ctx,
 					     dma_addr_t *chroma_addr)
 {
 	struct v4l2_pix_format pix_format = cedrus_picture_recon_format(ctx);
+	struct v4l2_pix_format *visible = &ctx->v4l2.format_picture.fmt.pix;
 	struct vb2_buffer *vb2_buffer = &cedrus_buffer->m2m_buffer.vb.vb2_buf;
 	dma_addr_t addr;
 
 	addr = vb2_dma_contig_plane_dma_addr(vb2_buffer, 0);
-	if (cedrus_picture_is_p010(ctx))
-		addr += cedrus_picture_p010_size(ctx);
+	if (cedrus_picture_is_secondary(ctx))
+		addr += cedrus_picture_visible_size(visible->bytesperline,
+						    visible->height);
 	*luma_addr = addr;
 
 	addr += pix_format.bytesperline * pix_format.height;
