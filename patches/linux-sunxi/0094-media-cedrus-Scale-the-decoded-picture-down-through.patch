+/* The decoder's selection: the picture, scaled by COMPOSE. */
+static int cedrus_proc_compose_get(struct cedrus_context *ctx,
+				   struct v4l2_selection *selection)
+{
+	struct v4l2_pix_format *pix_format_coded =
+		&ctx->v4l2.format_coded.fmt.pix;
+	struct v4l2_pix_format *pix_format = &ctx->v4l2.format_picture.fmt.pix;
+
+	selection->r.top = 0;
+	selection->r.left = 0;
+
+	switch (selection->target) {
+	case V4L2_SEL_TGT_COMPOSE_DEFAULT:
+	case V4L2_SEL_TGT_COMPOSE_BOUNDS:
+		selection->r.width = pix_format_coded->width;
+		selection->r.height = pix_format_coded->height;
+		return 0;
+	case V4L2_SEL_TGT_COMPOSE:
+		selection->r.width = pix_format->width;
+		selection->r.height = pix_format->height;
+		return 0;
+	}
+
+	return -EINVAL;
+}
+
+/* ⅛ wrote a partial picture on the H713 */
+#define CEDRUS_SCALE_SHIFT_MAX	2
+
+/*
+ * COMPOSE scales the decoded picture down by 1, 2 or 4 each way, the smallest
+ * ratio that fits it in the rectangle, before picture buffers are allocated.
+ */
+static int cedrus_proc_compose_set(struct cedrus_context *ctx,
+				   struct v4l2_selection *selection)
+{
+	struct v4l2_pix_format *pix_format_coded =
+		&ctx->v4l2.format_coded.fmt.pix;
+	struct v4l2_format *format = &ctx->v4l2.format_picture;
+	unsigned int shift = 0;
+	int ret;
+
+	if (selection->target != V4L2_SEL_TGT_COMPOSE)
+		return -EINVAL;
+
+	if (cedrus_context_queue_busy_check(ctx, selection->type))
+		return -EBUSY;
+
+	while (shift < CEDRUS_SCALE_SHIFT_MAX &&
+	       ((pix_format_coded->width >> shift) > selection->r.width ||
+		(pix_format_coded->height >> shift) > selection->r.height))
+		shift++;
+
+	ctx->v4l2.scale_shift = shift;
+
+	ret = cedrus_proc_format_picture_prepare(ctx, format);
+	if (ret)
+		return ret;
+
+	cedrus_context_selection_picture_reset(ctx);
+
+	selection->r.top = 0;
+	selection->r.left = 0;
+	selection->r.width = format->fmt.pix.width;
+	selection->r.height = format->fmt.pix.height;
+
+	return 0;
+}
+
 static int cedrus_proc_g_selection(struct file *file, void *private,
 				   struct v4l2_selection *selection)
 {
@@ -525,6 +596,9 @@ static int cedrus_proc_g_selection(struct file *file, void *private,
 	if (format_type != CEDRUS_FORMAT_TYPE_PICTURE)
 		return -EINVAL;
 
+	if (ctx->proc->role == CEDRUS_ROLE_DECODER)
+		return cedrus_proc_compose_get(ctx, selection);
+
 	switch (selection->target) {
 	case V4L2_SEL_TGT_CROP_DEFAULT:
 	case V4L2_SEL_TGT_CROP_BOUNDS:
@@ -556,6 +630,9 @@ static int cedrus_proc_s_selection(struct file *file, void *private,
 	if (format_type != CEDRUS_FORMAT_TYPE_PICTURE)
 		return -EINVAL;
 
+	if (ctx->proc->role == CEDRUS_ROLE_DECODER)
+		return cedrus_proc_compose_set(ctx, selection);
+
 	switch (selection->target) {
 	case V4L2_SEL_TGT_CROP:
 		/* Even dimensions are expected by most codecs. */
@@ -826,8 +903,6 @@ static int cedrus_proc_v4l2_setup(struct cedrus_proc *proc)
 
 	if (proc->role == CEDRUS_ROLE_DECODER) {
 		v4l2_disable_ioctl(video_dev, VIDIOC_ENUM_FRAMEINTERVALS);
-		v4l2_disable_ioctl(video_dev, VIDIOC_G_SELECTION);
-		v4l2_disable_ioctl(video_dev, VIDIOC_S_SELECTION);
 		v4l2_disable_ioctl(video_dev, VIDIOC_G_PARM);
 		v4l2_disable_ioctl(video_dev, VIDIOC_S_PARM);
 		v4l2_disable_ioctl(video_dev, VIDIOC_ENCODER_CMD);
