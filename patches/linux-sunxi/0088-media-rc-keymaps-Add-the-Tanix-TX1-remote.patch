From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Artem Butusov <art.sormy@gmail.com>
Date: Sun, 25 Oct 2026 15:00:00 -0400
Subject: [PATCH] media: rc: keymaps: Add the Tanix TX1 remote

The Tanix TX1 ships the TX3 mini's remote, whose keymap sends KEY_HOME,
KEY_DELETE, KEY_NEXT and KEY_PREVIOUS: keys a media centre maps to the
first page, delete, or nothing. Map Home, the backspace key and the
track keys as their labels read, and the mouse button, which toggles a
pointer in the vendor's software, as KEY_TOUCHPAD_TOGGLE for a pointer
mode to follow.

---
--- a/drivers/media/rc/keymaps/Makefile	2026-10-25 18:42:38.893338041 +0000
+++ b/drivers/media/rc/keymaps/Makefile	2026-10-25 18:42:38.904134666 +0000
@@ -110,6 +110,7 @@
 			rc-snapstream-firefly.o \
 			rc-streamzap.o \
 			rc-su3000.o \
+			rc-tanix-tx1.o \
 			rc-tanix-tx3mini.o \
 			rc-tanix-tx5max.o \
 			rc-tbs-nec.o \
--- a/include/media/rc-map.h	2026-10-25 18:42:38.897289708 +0000
+++ b/include/media/rc-map.h	2026-10-25 18:42:38.904758791 +0000
@@ -315,6 +315,7 @@
 #define RC_MAP_SNAPSTREAM_FIREFLY        "rc-snapstream-firefly"
 #define RC_MAP_STREAMZAP                 "rc-streamzap"
 #define RC_MAP_SU3000                    "rc-su3000"
+#define RC_MAP_TANIX_TX1                 "rc-tanix-tx1"
 #define RC_MAP_TANIX_TX3MINI             "rc-tanix-tx3mini"
 #define RC_MAP_TANIX_TX5MAX              "rc-tanix-tx5max"
 #define RC_MAP_TBS_NEC                   "rc-tbs-nec"
--- a/Documentation/devicetree/bindings/media/rc.yaml	2026-10-25 18:42:38.902423041 +0000
+++ b/Documentation/devicetree/bindings/media/rc.yaml	2026-10-25 18:42:38.905469791 +0000
@@ -129,6 +129,7 @@
       - rc-snapstream-firefly
       - rc-streamzap
       - rc-su3000
+      - rc-tanix-tx1
       - rc-tanix-tx3mini
       - rc-tanix-tx5max
       - rc-tbs-nec
--- /dev/null
+++ b/drivers/media/rc/keymaps/rc-tanix-tx1.c	2026-10-25 18:42:38.906829875 +0000
@@ -0,0 +1,75 @@
+// SPDX-License-Identifier: GPL-2.0+
+
+#include <media/rc-map.h>
+#include <linux/module.h>
+
+/*
+ * Keymap for the Tanix TX1 STB remote control: the TX3 mini's buttons, with
+ * the keys a media centre reads on its labels. The mouse button toggles a
+ * pointer mode, as the vendor's software does with it.
+ */
+
+static struct rc_map_table tanix_tx1[] = {
+	{ 0x8051, KEY_POWER },
+	{ 0x804d, KEY_MUTE },
+
+	{ 0x8009, KEY_RED },
+	{ 0x8011, KEY_GREEN },
+	{ 0x8054, KEY_YELLOW },
+	{ 0x804f, KEY_BLUE },
+
+	{ 0x8056, KEY_VOLUMEDOWN },
+	{ 0x80bd, KEY_PREVIOUSSONG },
+	{ 0x80bb, KEY_NEXTSONG },
+	{ 0x804e, KEY_VOLUMEUP },
+
+	{ 0x8053, KEY_HOMEPAGE },
+	{ 0x801b, KEY_BACK },
+
+	{ 0x8026, KEY_UP },
+	{ 0x8028, KEY_DOWN },
+	{ 0x8025, KEY_LEFT },
+	{ 0x8027, KEY_RIGHT },
+	{ 0x800d, KEY_OK },
+
+	{ 0x8049, KEY_MENU },
+	{ 0x8052, KEY_TOUCHPAD_TOGGLE },
+
+	{ 0x8031, KEY_1 },
+	{ 0x8032, KEY_2 },
+	{ 0x8033, KEY_3 },
+	{ 0x8034, KEY_4 },
+	{ 0x8035, KEY_5 },
+	{ 0x8036, KEY_6 },
+	{ 0x8037, KEY_7 },
+	{ 0x8038, KEY_8 },
+	{ 0x8039, KEY_9 },
+	{ 0x8058, KEY_SUBTITLE },
+	{ 0x8030, KEY_0 },
+	{ 0x8044, KEY_BACKSPACE },
+};
+
+static struct rc_map_list tanix_tx1_map = {
+	.map = {
+		.scan     = tanix_tx1,
+		.size     = ARRAY_SIZE(tanix_tx1),
+		.rc_proto = RC_PROTO_NEC,
+		.name     = RC_MAP_TANIX_TX1,
+	}
+};
+
+static int __init init_rc_map_tanix_tx1(void)
+{
+	return rc_map_register(&tanix_tx1_map);
+}
+
+static void __exit exit_rc_map_tanix_tx1(void)
+{
+	rc_map_unregister(&tanix_tx1_map);
+}
+
+module_init(init_rc_map_tanix_tx1)
+module_exit(exit_rc_map_tanix_tx1)
+
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("Tanix TX1 STB remote controller keytable");
