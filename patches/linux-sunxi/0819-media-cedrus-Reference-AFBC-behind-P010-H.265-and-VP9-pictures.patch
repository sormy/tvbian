From b3bb1d2af94681cde89a7d0a0137a770b6b2761e Mon Sep 17 00:00:00 2001
From: Artem Butusov <art.sormy@gmail.com>
Date: Tue, 17 Nov 2026 05:37:42 +0000
Subject: [PATCH] media: cedrus: Reference AFBC behind P010 H.265 and VP9
 pictures

As for 8-bit pictures behind NV12: a 10-bit H.265 or VP9 stream's
engine now reconstructs into and references a hidden 10-bit AFBC picture
after the P010 one the secondary output writes, in place of the hidden
8-bit NV12 picture and its low 2 bits plane. H.265 still appends its low
2 bits plane after the compressed body, as its own 10-bit AFBC output
does; VP9 carries the full samples in the body.
---
 drivers/staging/media/sunxi/cedrus/cedrus.h   | 62 +++++++++++++------
 .../staging/media/sunxi/cedrus/cedrus_dec.c   | 13 ++--
 .../media/sunxi/cedrus/cedrus_dec_h265.c      |  2 +-
 .../media/sunxi/cedrus/cedrus_dec_vp9.c       | 10 ++-
 4 files changed, 56 insertions(+), 31 deletions(-)

diff --git a/drivers/staging/media/sunxi/cedrus/cedrus.h b/drivers/staging/media/sunxi/cedrus/cedrus.h
index cf5dd14c2..ea6c7ac57 100644
--- a/drivers/staging/media/sunxi/cedrus/cedrus.h
+++ b/drivers/staging/media/sunxi/cedrus/cedrus.h
@@ -204,19 +204,20 @@ static inline bool cedrus_picture_is_scaled(struct cedrus_context *ctx)
 extern bool cedrus_afbc_reference;
 
 /*
- * An 8-bit H.265 or VP9 NV12 picture on an engine that writes AFBC: the
- * engine reconstructs into and references a hidden AFBC picture, which
- * takes a fraction of NV12's memory traffic, and the secondary output writes
- * the NV12 one.
+ * An H.265 or VP9 picture, NV12 of an 8-bit stream or P010 of a 10-bit one,
+ * on an engine that writes AFBC: the engine reconstructs into and references
+ * a hidden AFBC picture, which takes a fraction of the linear one's memory
+ * traffic, and the secondary output writes the linear one.
  */
 static inline bool cedrus_picture_recon_afbc_for(struct cedrus_context *ctx,
 						 u32 pixelformat)
 {
 	struct cedrus_device *dev = ctx->proc->dev;
 	u32 coded = ctx->v4l2.format_coded.fmt.pix.pixelformat;
+	bool ten_bit = ctx->bit_depth_coded > 8;
 
-	if (!cedrus_afbc_reference || pixelformat != V4L2_PIX_FMT_NV12 ||
-	    ctx->bit_depth_coded > 8 ||
+	if (!cedrus_afbc_reference ||
+	    pixelformat != (ten_bit ? V4L2_PIX_FMT_P010 : V4L2_PIX_FMT_NV12) ||
 	    cedrus_picture_scale_shift(ctx, pixelformat))
 		return false;
 
@@ -238,12 +239,37 @@ static inline bool cedrus_recon_is_afbc(struct cedrus_context *ctx)
 	return cedrus_picture_is_afbc(ctx) || cedrus_picture_recon_is_afbc(ctx);
 }
 
-/* An 8-bit AFBC picture: a 16-byte header and a body per 16x16 block. */
-static inline unsigned int cedrus_afbc_8bit_size(unsigned int width,
-						 unsigned int height)
+/* An AFBC picture: a 16-byte header and a body per 16x16 block. */
+static inline unsigned int cedrus_afbc_size(unsigned int width,
+					    unsigned int height, bool ten_bit)
 {
 	return DIV_ROUND_UP(width, 16) * DIV_ROUND_UP(height + 4, 16) *
-	       (384 + 16) + 32 + SZ_1K;
+	       ((ten_bit ? 512 : 384) + 16) + 32 + SZ_1K;
+}
+
+/* Size of the low 2 bits plane the engine appends to a 10-bit picture. */
+static inline unsigned int cedrus_picture_2bit_size(unsigned int width,
+						    unsigned int height)
+{
+	return ALIGN(width / 4, 32) * height * 3 / 2;
+}
+
+/*
+ * The hidden AFBC reconstruction; 10-bit H.265 still appends its low 2 bits
+ * plane after the compressed body, VP9 does not.
+ */
+static inline unsigned int cedrus_picture_recon_afbc_size(struct cedrus_context *ctx,
+							  unsigned int width,
+							  unsigned int height)
+{
+	bool ten_bit = ctx->bit_depth_coded > 8;
+	unsigned int size = cedrus_afbc_size(width, height, ten_bit);
+
+	if (ten_bit && ctx->v4l2.format_coded.fmt.pix.pixelformat ==
+		       V4L2_PIX_FMT_HEVC_SLICE)
+		size += cedrus_picture_2bit_size(width, height);
+
+	return size;
 }
 
 /*
@@ -306,10 +332,13 @@ cedrus_picture_recon_format(struct cedrus_context *ctx)
 	}
 
 	if (cedrus_picture_recon_is_afbc(ctx)) {
-		pix_format.pixelformat = V4L2_PIX_FMT_YUV420_8_AFBC_16X16_SPLIT;
+		pix_format.pixelformat = ctx->bit_depth_coded > 8 ?
+			V4L2_PIX_FMT_YUV420_10_AFBC_16X16_SPLIT :
+			V4L2_PIX_FMT_YUV420_8_AFBC_16X16_SPLIT;
 		pix_format.bytesperline = 0;
-		pix_format.sizeimage = cedrus_afbc_8bit_size(pix_format.width,
-							     pix_format.height);
+		pix_format.sizeimage =
+			cedrus_picture_recon_afbc_size(ctx, pix_format.width,
+						       pix_format.height);
 	} else if (cedrus_picture_recon_is_tiled(ctx)) {
 		pix_format.pixelformat = V4L2_PIX_FMT_NV12_32L32;
 		pix_format.bytesperline = ALIGN(pix_format.width, 32);
@@ -322,13 +351,6 @@ cedrus_picture_recon_format(struct cedrus_context *ctx)
 	return pix_format;
 }
 
-/* Size of the low 2 bits plane the engine appends to a 10-bit picture. */
-static inline unsigned int cedrus_picture_2bit_size(unsigned int width,
-						    unsigned int height)
-{
-	return ALIGN(width / 4, 32) * height * 3 / 2;
-}
-
 static inline void cedrus_buffer_picture_dma(struct cedrus_context *ctx,
 					     struct cedrus_buffer *cedrus_buffer,
 					     dma_addr_t *luma_addr,
diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_dec.c b/drivers/staging/media/sunxi/cedrus/cedrus_dec.c
index 6fa657ec2..53f29eb76 100644
--- a/drivers/staging/media/sunxi/cedrus/cedrus_dec.c
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_dec.c
@@ -260,24 +260,22 @@ static int cedrus_dec_format_picture_prepare(struct cedrus_context *ctx,
 		bytesperline = 0;
 
 		/* AFBC header (one 16-byte entry per 16x16 block) plus body. */
-		sizeimage = DIV_ROUND_UP(width, 16) *
-			    DIV_ROUND_UP(height + 4, 16) * (512 + 16) +
-			    32 + SZ_1K;
+		sizeimage = cedrus_afbc_size(width, height, true);
 		break;
 	case V4L2_PIX_FMT_YUV420_8_AFBC_16X16_SPLIT:
 		/* Compressed picture, no meaningful line stride. */
 		bytesperline = 0;
 
-		sizeimage = cedrus_afbc_8bit_size(width, height);
+		sizeimage = cedrus_afbc_size(width, height, false);
 		break;
 	default:
 		return -EINVAL;
 	}
 
-	/* The AFBC reconstruction follows the NV12 picture. */
+	/* The AFBC reconstruction follows the linear picture. */
 	if (cedrus_picture_recon_afbc_for(ctx, pix_format->pixelformat))
 		sizeimage = cedrus_picture_visible_size(bytesperline, height) +
-			    cedrus_afbc_8bit_size(width, height);
+			    cedrus_picture_recon_afbc_size(ctx, width, height);
 
 	/* The full-size reconstruction, linear or tiled, follows the scaled picture. */
 	if (shift)
@@ -424,7 +422,8 @@ cedrus_dec_picture_10bit_extra_size(struct cedrus_context *ctx,
 	unsigned int extra;
 
 	if (ctx->bit_depth_coded <= 8 ||
-	    cedrus_format_is_afbc(pix_format->pixelformat))
+	    cedrus_format_is_afbc(pix_format->pixelformat) ||
+	    cedrus_picture_recon_afbc_for(ctx, pix_format->pixelformat))
 		return 0;
 
 	/* Scaled, the hidden reconstruction is already counted at full size. */
diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_dec_h265.c b/drivers/staging/media/sunxi/cedrus/cedrus_dec_h265.c
index 93ffb51af..3f8df6e24 100644
--- a/drivers/staging/media/sunxi/cedrus/cedrus_dec_h265.c
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_dec_h265.c
@@ -998,7 +998,7 @@ static int cedrus_dec_h265_job_configure(struct cedrus_context *cedrus_ctx)
 		 * Offset of the low 2 bits plane from the reconstruction luma
 		 * base. For AFBC it follows the compressed body.
 		 */
-		if (cedrus_picture_is_afbc(cedrus_ctx))
+		if (cedrus_recon_is_afbc(cedrus_ctx))
 			value = recon.sizeimage -
 				cedrus_picture_2bit_size(recon.width,
 							 recon.height);
diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_dec_vp9.c b/drivers/staging/media/sunxi/cedrus/cedrus_dec_vp9.c
index 281fc8c38..5103c19aa 100644
--- a/drivers/staging/media/sunxi/cedrus/cedrus_dec_vp9.c
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_dec_vp9.c
@@ -1052,6 +1052,10 @@ static int cedrus_vp9_job_configure(struct cedrus_context *ctx)
 		cedrus_write(dev, VE_DEC_VP9_FIRST_OUT_OFFSET,
 			     off & GENMASK(27, 0));
 		cedrus_write(dev, VE_DEC_VP9_10BIT_CFG, cfg);
+	} else if (dec->bit_depth > 8 && p010) {
+		/* The P010 picture behind an AFBC reconstruction: no 2-bit plane. */
+		cedrus_write(dev, VE_DEC_VP9_FIRST_OUT_OFFSET, 0);
+		cedrus_write(dev, VE_DEC_VP9_10BIT_CFG, VE_DEC_10BIT_CFG_P010);
 	}
 
 	/* Side buffers and segment feature register. */
@@ -1369,13 +1373,13 @@ static int cedrus_vp9_format_picture_prepare(struct cedrus_context *ctx,
 		break;
 	}
 
-	/* The AFBC reconstruction follows the NV12 picture. */
+	/* The AFBC reconstruction follows the linear picture. */
 	if (cedrus_picture_recon_afbc_for(ctx, pix_format->pixelformat))
 		pix_format->sizeimage =
 			cedrus_picture_visible_size(pix_format->bytesperline,
 						    pix_format->height) +
-			cedrus_afbc_8bit_size(pix_format->width,
-					      pix_format->height);
+			cedrus_picture_recon_afbc_size(ctx, pix_format->width,
+						       pix_format->height);
 
 	pix_format->sizeimage +=
 		cedrus_dec_picture_10bit_extra_size(ctx, pix_format);
-- 
2.47.3

