From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Artem Butusov <art.sormy@gmail.com>
Date: Thu, 12 Nov 2026 00:00:00 +0000
Subject: [PATCH] dt-bindings: display: allwinner: Add the DE3 and DE33 writeback

The H6's DE3 and the H616's DE33 have a writeback unit, which writes a
mixer's output back to memory; the DE33's adds a register command queue
and a phandle to the display engine's top registers, which route a
mixer to it. Describe both. The DE33's split mixers and its writeback
take two register regions on the display engine's bus, and its planes
block maps buffers through the IOMMU.

Signed-off-by: Artem Butusov <art.sormy@gmail.com>
---
diff --git a/Documentation/devicetree/bindings/display/allwinner,sun50i-h6-de3-wb.yaml b/Documentation/devicetree/bindings/display/allwinner,sun50i-h6-de3-wb.yaml
new file mode 100644
--- /dev/null
+++ b/Documentation/devicetree/bindings/display/allwinner,sun50i-h6-de3-wb.yaml
@@ -0,0 +1,129 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/allwinner,sun50i-h6-de3-wb.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Allwinner Display Engine 3 writeback
+
+maintainers:
+  - Jernej Skrabec <jernej.skrabec@gmail.com>
+
+description:
+  The display engine's writeback unit, which writes a mixer's output back to
+  memory.
+
+properties:
+  compatible:
+    enum:
+      - allwinner,sun50i-h6-de3-wb
+      - allwinner,sun50i-h616-de33-wb
+
+  reg:
+    minItems: 1
+    items:
+      - description: Writeback registers
+      - description: Its register command queue (RCQ)
+
+  reg-names:
+    items:
+      - const: writeback
+      - const: rcq
+
+  interrupts:
+    maxItems: 1
+
+  clocks:
+    items:
+      - description: The writeback's bus clock
+      - description: The writeback's module clock
+
+  clock-names:
+    items:
+      - const: bus
+      - const: mod
+
+  resets:
+    maxItems: 1
+
+  iommus:
+    maxItems: 1
+
+  allwinner,top:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description:
+      Phandle of the display engine's top registers, which route a mixer's
+      output to the writeback.
+
+  ports:
+    $ref: /schemas/graph.yaml#/properties/ports
+
+    properties:
+      port@0:
+        $ref: /schemas/graph.yaml#/properties/port
+        description: Input endpoints, from the mixers.
+
+    required:
+      - port@0
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - clocks
+  - clock-names
+  - resets
+  - ports
+
+allOf:
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: allwinner,sun50i-h616-de33-wb
+    then:
+      properties:
+        reg:
+          minItems: 2
+      required:
+        - reg-names
+        - allwinner,top
+    else:
+      properties:
+        reg:
+          maxItems: 1
+        reg-names: false
+        allwinner,top: false
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/sun8i-de2.h>
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+    #include <dt-bindings/reset/sun8i-de2.h>
+
+    writeback@10000 {
+        compatible = "allwinner,sun50i-h6-de3-wb";
+        reg = <0x10000 0x1000>;
+        clocks = <&display_clocks CLK_BUS_WB>, <&display_clocks CLK_WB>;
+        clock-names = "bus", "mod";
+        resets = <&display_clocks RST_WB>;
+        iommus = <&iommu 0>;
+        interrupts = <GIC_SPI 78 IRQ_TYPE_LEVEL_HIGH>;
+
+        ports {
+            #address-cells = <1>;
+            #size-cells = <0>;
+
+            port@0 {
+                reg = <0>;
+
+                endpoint {
+                    remote-endpoint = <&mixer0_out_writeback>;
+                };
+            };
+        };
+    };
+
+...
diff --git a/Documentation/devicetree/bindings/bus/allwinner,sun50i-a64-de2.yaml b/Documentation/devicetree/bindings/bus/allwinner,sun50i-a64-de2.yaml
--- a/Documentation/devicetree/bindings/bus/allwinner,sun50i-a64-de2.yaml
+++ b/Documentation/devicetree/bindings/bus/allwinner,sun50i-a64-de2.yaml
@@ -52,7 +52,8 @@
     additionalProperties: true
     properties:
       reg:
-        maxItems: 1
+        minItems: 1
+        maxItems: 2
 
     required:
       - reg
diff --git a/Documentation/devicetree/bindings/display/allwinner,sun50i-h616-de33-planes.yaml b/Documentation/devicetree/bindings/display/allwinner,sun50i-h616-de33-planes.yaml
--- a/Documentation/devicetree/bindings/display/allwinner,sun50i-h616-de33-planes.yaml
+++ b/Documentation/devicetree/bindings/display/allwinner,sun50i-h616-de33-planes.yaml
@@ -22,6 +22,9 @@
   reg:
     maxItems: 1
 
+  iommus:
+    maxItems: 1
+
   allwinner,plane-mapping:
     $ref: /schemas/types.yaml#/definitions/phandle
     description:
