From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Artem Butusov <art.sormy@gmail.com>
Date: Mon, 2 Nov 2026 22:00:00 -0500
Subject: [PATCH] drm/sun4i: Send HDR as 10-bit YCbCr 4:2:2

dw-hdmi lists RGB888 ahead of every deeper format, and the DE33 mixer
offers RGB888 and 4:2:0 alone, so HDR10 left in 8 bits. 4:4:4 at 10
bits needs a TMDS clock 5/4 of the pixel clock, which the H616's integer
video PLL cannot divide from the TCON's.

Offer YCbCr 4:2:2 first where the connector asks for HDR, an
HDR_OUTPUT_METADATA EOTF other than SDR with max bpc 10 or more, and the
sink takes 4:2:2: its 12-bit container runs at the pixel clock, so every
mode the sink takes in 8 bits. The mixer accepts UYVY12_1X24 and its
formatter outputs 4:2:2 at 10 bits, clamped to the limited range. SDR
stays RGB.
---
diff -urN a/drivers/gpu/drm/bridge/synopsys/dw-hdmi.c b/drivers/gpu/drm/bridge/synopsys/dw-hdmi.c
--- a/drivers/gpu/drm/bridge/synopsys/dw-hdmi.c
+++ b/drivers/gpu/drm/bridge/synopsys/dw-hdmi.c
@@ -2706,8 +2706,21 @@
  * - MEDIA_BUS_FMT_YUV8_1X24,
  */
 
-/* Can return a maximum of 11 possible output formats for a mode/connector */
-#define MAX_OUTPUT_SEL_FORMATS	11
+/* Can return a maximum of 12 possible output formats for a mode/connector */
+#define MAX_OUTPUT_SEL_FORMATS	12
+
+static bool dw_hdmi_hdr_output(const struct drm_connector_state *conn_state)
+{
+	const struct hdr_output_metadata *metadata;
+
+	if (!conn_state->hdr_output_metadata)
+		return false;
+
+	metadata = conn_state->hdr_output_metadata->data;
+
+	return metadata->hdmi_metadata_type1.eotf !=
+	       HDMI_EOTF_TRADITIONAL_GAMMA_SDR;
+}
 
 static u32 *dw_hdmi_bridge_atomic_get_output_bus_fmts(struct drm_bridge *bridge,
 					struct drm_bridge_state *bridge_state,
@@ -2741,6 +2754,16 @@
 	}
 
 	/*
+	 * HDR goes out in 10 bits where max bpc allows: as 4:2:2, whose 12-bit
+	 * container runs at the 8-bit TMDS rate, so in every mode the sink
+	 * takes in 8 bits. SDR stays RGB.
+	 */
+	if (max_bpc >= 10 && dw_hdmi_hdr_output(conn_state) &&
+	    !drm_mode_is_420_only(info, mode) &&
+	    (info->color_formats & BIT(DRM_OUTPUT_COLOR_FORMAT_YCBCR422)))
+		output_fmts[i++] = MEDIA_BUS_FMT_UYVY12_1X24;
+
+	/*
 	 * If the current mode enforces 4:2:0, force the output bus format
 	 * to 4:2:0 and do not add the YUV422/444/RGB formats
 	 */
diff -urN a/drivers/gpu/drm/sun4i/sun50i_fmt.c b/drivers/gpu/drm/sun4i/sun50i_fmt.c
--- a/drivers/gpu/drm/sun4i/sun50i_fmt.c
+++ b/drivers/gpu/drm/sun4i/sun50i_fmt.c
@@ -20,6 +20,8 @@
 	case MEDIA_BUS_FMT_UYYVYY8_0_5X24:
 	case MEDIA_BUS_FMT_UYYVYY10_0_5X30:
 		return SUN50I_FMT_CS_YUV420;
+	case MEDIA_BUS_FMT_UYVY12_1X24:
+		return SUN50I_FMT_CS_YUV422;
 	default:
 		return SUN50I_FMT_CS_YUV444RGB;
 	}
@@ -27,14 +29,15 @@
 
 static bool sun50i_fmt_is_10bit(u32 format)
 {
-	return format == MEDIA_BUS_FMT_UYYVYY10_0_5X30;
+	return format == MEDIA_BUS_FMT_UYYVYY10_0_5X30 ||
+	       format == MEDIA_BUS_FMT_UYVY12_1X24;
 }
 
 void sun50i_fmt_setup(struct sun8i_mixer *mixer, u16 width,
 		      u16 height, u32 format)
 {
 	u32 colorspace = sun50i_fmt_get_colorspace(format);
-	bool bypass = colorspace == SUN50I_FMT_CS_YUV444RGB;
+	bool bypass = format == MEDIA_BUS_FMT_RGB888_1X24;
 	bool de3 = mixer->cfg->de_type == SUN8I_MIXER_DE3;
 
 	sun8i_rdma_write(mixer->fmt_rdma, SUN50I_FMT_SIZE,
diff -urN a/drivers/gpu/drm/sun4i/sun8i_mixer.c b/drivers/gpu/drm/sun4i/sun8i_mixer.c
--- a/drivers/gpu/drm/sun4i/sun8i_mixer.c
+++ b/drivers/gpu/drm/sun4i/sun8i_mixer.c
@@ -504,7 +504,8 @@
 
 	if (mixer->cfg->has_formatter &&
 	    (format == MEDIA_BUS_FMT_UYYVYY8_0_5X24 ||
-	     format == MEDIA_BUS_FMT_UYYVYY10_0_5X30))
+	     format == MEDIA_BUS_FMT_UYYVYY10_0_5X30 ||
+	     format == MEDIA_BUS_FMT_UYVY12_1X24))
 		return true;
 
 	return format == MEDIA_BUS_FMT_RGB888_1X24;
