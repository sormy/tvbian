+	if (ctrl->id != V4L2_CID_STATELESS_VC1_SLICE_PARAMS)
+		return 0;
+
+	slice = ctrl->p_new.p;
+
+	/* Complex profile is not supported by the hardware. */
+	if (slice->sequence.profile == V4L2_VC1_PROFILE_COMPLEX)
+		return -EINVAL;
