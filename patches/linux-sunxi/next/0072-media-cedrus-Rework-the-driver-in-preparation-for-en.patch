+/*
+ * The coded bit depth selects the picture formats. It can't grow once
+ * picture buffers are allocated; otherwise the picture format is reset.
+ */
+int cedrus_dec_bit_depth_update(struct cedrus_context *ctx,
+				unsigned int bit_depth)
+{
+	unsigned int buffer_type =
+		cedrus_proc_buffer_type(ctx->proc, CEDRUS_FORMAT_TYPE_PICTURE);
+
+	if (cedrus_context_queue_busy_check(ctx, buffer_type))
+		return ctx->bit_depth_coded < bit_depth ? -EINVAL : 0;
+
+	ctx->bit_depth_coded = bit_depth;
+
+	return cedrus_proc_format_propagate(ctx, CEDRUS_FORMAT_TYPE_CODED);
+}
