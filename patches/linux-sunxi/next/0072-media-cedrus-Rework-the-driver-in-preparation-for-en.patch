+static int cedrus_dec_format_propagate(struct cedrus_context *ctx,
+				       unsigned int format_type)
+{
+	struct v4l2_format *format = &ctx->v4l2.format_picture;
+
+	/* Format is propagated from coded to picture. */
+	if (format_type != CEDRUS_FORMAT_TYPE_CODED)
+		return 0;
+
+	/* The picture format is reset to the default for the coded one. */
+	format->fmt.pix.pixelformat = 0;
+
+	return cedrus_proc_format_picture_prepare(ctx, format);
