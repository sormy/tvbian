From 89663428370eb84b62f1958511735432169394bc Mon Sep 17 00:00:00 2001
From: Artem Butusov <art.sormy@gmail.com>
Date: Tue, 17 Nov 2026 02:46:39 +0000
Subject: [PATCH] media: cedrus: Reference AFBC behind NV12 H.265 and VP9
 pictures

At 3840x2160 the engine spends 20 to 25 ms on an 8-bit H.265 or VP9
picture written and referenced as NV12, and 9 to 12 ms on the same
picture as AFBC: decoding is bound by the memory the references take.
A GPU that cannot sample Cedrus's AFBC, Panfrost on the H616's Mali-G31
among them, then gets no 4K at 60 fps.

The engine now reconstructs into and references a hidden AFBC picture
after the visible one, and the secondary output writes that NV12
picture, as it already does for P010 and scaled pictures. 8-bit H.265
on an engine with 10-bit H.265, and VP9, NV12 at full size only.
afbc_reference=0 keeps the NV12 reconstruction. The visible picture
before a hidden one is now padded to a page, where an AFBC buffer
starts.
---
 drivers/staging/media/sunxi/cedrus/cedrus.c   |  5 ++
 drivers/staging/media/sunxi/cedrus/cedrus.h   | 67 +++++++++++++++++--
 .../staging/media/sunxi/cedrus/cedrus_dec.c   | 11 +--
 .../media/sunxi/cedrus/cedrus_dec_h265.c      |  8 +--
 .../media/sunxi/cedrus/cedrus_dec_vp9.c       | 14 +++-
 5 files changed, 88 insertions(+), 17 deletions(-)

diff --git a/drivers/staging/media/sunxi/cedrus/cedrus.c b/drivers/staging/media/sunxi/cedrus/cedrus.c
index 5dadffa06..a79b80cc7 100644
--- a/drivers/staging/media/sunxi/cedrus/cedrus.c
+++ b/drivers/staging/media/sunxi/cedrus/cedrus.c
@@ -23,6 +23,11 @@
 #include <media/v4l2-mem2mem.h>
 
 #include "cedrus.h"
+
+bool cedrus_afbc_reference = true;
+module_param_named(afbc_reference, cedrus_afbc_reference, bool, 0644);
+MODULE_PARM_DESC(afbc_reference,
+		 "Reconstruct 8-bit H.265 and VP9 references in AFBC behind NV12 pictures");
 #include "cedrus_context.h"
 #include "cedrus_dec.h"
 #include "cedrus_enc.h"
diff --git a/drivers/staging/media/sunxi/cedrus/cedrus.h b/drivers/staging/media/sunxi/cedrus/cedrus.h
index 1caf04512..cf5dd14c2 100644
--- a/drivers/staging/media/sunxi/cedrus/cedrus.h
+++ b/drivers/staging/media/sunxi/cedrus/cedrus.h
@@ -201,13 +201,60 @@ static inline bool cedrus_picture_is_scaled(struct cedrus_context *ctx)
 		ctx->v4l2.format_picture.fmt.pix.pixelformat);
 }
 
+extern bool cedrus_afbc_reference;
+
 /*
- * The secondary output writes the visible picture, P010 or scaled, at the
- * start of the buffer; the engine reconstructs into a hidden one after it.
+ * An 8-bit H.265 or VP9 NV12 picture on an engine that writes AFBC: the
+ * engine reconstructs into and references a hidden AFBC picture, which
+ * takes a fraction of NV12's memory traffic, and the secondary output writes
+ * the NV12 one.
+ */
+static inline bool cedrus_picture_recon_afbc_for(struct cedrus_context *ctx,
+						 u32 pixelformat)
+{
+	struct cedrus_device *dev = ctx->proc->dev;
+	u32 coded = ctx->v4l2.format_coded.fmt.pix.pixelformat;
+
+	if (!cedrus_afbc_reference || pixelformat != V4L2_PIX_FMT_NV12 ||
+	    ctx->bit_depth_coded > 8 ||
+	    cedrus_picture_scale_shift(ctx, pixelformat))
+		return false;
+
+	return (coded == V4L2_PIX_FMT_HEVC_SLICE &&
+		cedrus_capabilities_check(dev, CEDRUS_CAPABILITY_H265_10_DEC)) ||
+	       (coded == V4L2_PIX_FMT_VP9_FRAME &&
+		cedrus_capabilities_check(dev, CEDRUS_CAPABILITY_VP9_DEC));
+}
+
+static inline bool cedrus_picture_recon_is_afbc(struct cedrus_context *ctx)
+{
+	return cedrus_picture_recon_afbc_for(ctx,
+		ctx->v4l2.format_picture.fmt.pix.pixelformat);
+}
+
+/* The engine writes and reads AFBC: the picture itself or its reconstruction. */
+static inline bool cedrus_recon_is_afbc(struct cedrus_context *ctx)
+{
+	return cedrus_picture_is_afbc(ctx) || cedrus_picture_recon_is_afbc(ctx);
+}
+
+/* An 8-bit AFBC picture: a 16-byte header and a body per 16x16 block. */
+static inline unsigned int cedrus_afbc_8bit_size(unsigned int width,
+						 unsigned int height)
+{
+	return DIV_ROUND_UP(width, 16) * DIV_ROUND_UP(height + 4, 16) *
+	       (384 + 16) + 32 + SZ_1K;
+}
+
+/*
+ * The secondary output writes the visible picture, P010, scaled or behind an
+ * AFBC reconstruction, at the start of the buffer; the engine reconstructs
+ * into a hidden one after it.
  */
 static inline bool cedrus_picture_is_secondary(struct cedrus_context *ctx)
 {
-	return cedrus_picture_is_p010(ctx) || cedrus_picture_is_scaled(ctx);
+	return cedrus_picture_is_p010(ctx) || cedrus_picture_is_scaled(ctx) ||
+	       cedrus_picture_recon_is_afbc(ctx);
 }
 
 /* H.264 motion compensation reads 32x32 tiles faster than linear rows. */
@@ -218,11 +265,14 @@ static inline bool cedrus_picture_recon_is_tiled(struct cedrus_context *ctx)
 	       V4L2_PIX_FMT_H264_SLICE;
 }
 
-/* Size of the visible picture before the hidden reconstruction. */
+/*
+ * Size of the visible picture before the hidden reconstruction, which starts
+ * on a page as an AFBC buffer does.
+ */
 static inline unsigned int cedrus_picture_visible_size(unsigned int bytesperline,
 						       unsigned int height)
 {
-	return ALIGN(bytesperline * height * 3 / 2, 256);
+	return ALIGN(bytesperline * height * 3 / 2, SZ_4K);
 }
 
 /* H.264, HEVC and VC-1 fetch references at a 32-byte pitch. */
@@ -255,7 +305,12 @@ cedrus_picture_recon_format(struct cedrus_context *ctx)
 		pix_format.height = ALIGN(pix_format_coded->height, 16);
 	}
 
-	if (cedrus_picture_recon_is_tiled(ctx)) {
+	if (cedrus_picture_recon_is_afbc(ctx)) {
+		pix_format.pixelformat = V4L2_PIX_FMT_YUV420_8_AFBC_16X16_SPLIT;
+		pix_format.bytesperline = 0;
+		pix_format.sizeimage = cedrus_afbc_8bit_size(pix_format.width,
+							     pix_format.height);
+	} else if (cedrus_picture_recon_is_tiled(ctx)) {
 		pix_format.pixelformat = V4L2_PIX_FMT_NV12_32L32;
 		pix_format.bytesperline = ALIGN(pix_format.width, 32);
 		pix_format.height = ALIGN(pix_format_coded->height, 32);
diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_dec.c b/drivers/staging/media/sunxi/cedrus/cedrus_dec.c
index d92eccb92..6fa657ec2 100644
--- a/drivers/staging/media/sunxi/cedrus/cedrus_dec.c
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_dec.c
@@ -190,7 +190,7 @@ int cedrus_dec_format_coded_configure(struct cedrus_context *ctx)
 	 * in order to render it properly with the display engine, the default
 	 * color has to be set to white there.
 	 */
-	if (cedrus_picture_is_afbc(ctx))
+	if (cedrus_recon_is_afbc(ctx))
 		value |= VE_MODE_COMPRESS_EN |
 			 VE_MODE_MIN_VAL_WRAP_EN |
 			 VE_MODE_RGB_DEF_COLOR_EN |
@@ -268,14 +268,17 @@ static int cedrus_dec_format_picture_prepare(struct cedrus_context *ctx,
 		/* Compressed picture, no meaningful line stride. */
 		bytesperline = 0;
 
-		sizeimage = DIV_ROUND_UP(width, 16) *
-			    DIV_ROUND_UP(height + 4, 16) * (384 + 16) +
-			    32 + SZ_1K;
+		sizeimage = cedrus_afbc_8bit_size(width, height);
 		break;
 	default:
 		return -EINVAL;
 	}
 
+	/* The AFBC reconstruction follows the NV12 picture. */
+	if (cedrus_picture_recon_afbc_for(ctx, pix_format->pixelformat))
+		sizeimage = cedrus_picture_visible_size(bytesperline, height) +
+			    cedrus_afbc_8bit_size(width, height);
+
 	/* The full-size reconstruction, linear or tiled, follows the scaled picture. */
 	if (shift)
 		sizeimage = cedrus_picture_visible_size(bytesperline, height) +
diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_dec_h265.c b/drivers/staging/media/sunxi/cedrus/cedrus_dec_h265.c
index 6465f1a5d..93ffb51af 100644
--- a/drivers/staging/media/sunxi/cedrus/cedrus_dec_h265.c
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_dec_h265.c
@@ -277,8 +277,8 @@ cedrus_dec_h265_frame_info_write_single(struct cedrus_context *ctx,
 
 	cedrus_buffer_picture_dma(ctx, buffer, &luma_addr, &chroma_addr);
 
-	/* AFBC output has no separate chroma plane. */
-	if (cedrus_picture_is_afbc(ctx))
+	/* An AFBC reconstruction has no separate chroma plane. */
+	if (cedrus_recon_is_afbc(ctx))
 		chroma_addr = 0;
 
 	luma_addr = VE_DEC_H265_SRAM_DATA_ADDR_BASE(luma_addr);
@@ -1013,8 +1013,8 @@ static int cedrus_dec_h265_job_configure(struct cedrus_context *cedrus_ctx)
 	}
 
 	/*
-	 * P010 or scaled picture: the primary output holds the hidden 8-bit
-	 * NV12 reconstruction, the secondary output writes the visible one.
+	 * P010, scaled or AFBC-backed picture: the primary output holds the
+	 * hidden reconstruction, the secondary output writes the visible one.
 	 */
 	if (cedrus_picture_is_secondary(cedrus_ctx))
 		cedrus_dec_picture_second_out_set(cedrus_ctx);
diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_dec_vp9.c b/drivers/staging/media/sunxi/cedrus/cedrus_dec_vp9.c
index 5d8b9d038..281fc8c38 100644
--- a/drivers/staging/media/sunxi/cedrus/cedrus_dec_vp9.c
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_dec_vp9.c
@@ -795,7 +795,7 @@ static int cedrus_vp9_job_configure(struct cedrus_context *ctx)
 	cur_w = dec->frame_width_minus_1 + 1;
 	cur_h = dec->frame_height_minus_1 + 1;
 	p010 = cedrus_picture_is_p010(ctx);
-	afbc = cedrus_picture_is_afbc(ctx);
+	afbc = cedrus_recon_is_afbc(ctx);
 
 	intra_only = !!(dec->flags & (V4L2_VP9_FRAME_FLAG_KEY_FRAME |
 				      V4L2_VP9_FRAME_FLAG_INTRA_ONLY));
@@ -1027,7 +1027,7 @@ static int cedrus_vp9_job_configure(struct cedrus_context *ctx)
 	cedrus_write(dev, VE_DEC_VP9_CUR_CHROMA_ADDR, VE_DEC_VP9_BUF_ADDR(chroma));
 
 	cedrus_write(dev, VE_DEC_VP9_SDRT_CTRL, 0);
-	if (p010) {
+	if (cedrus_picture_is_secondary(ctx)) {
 		cedrus_dec_picture_second_out_set(ctx);
 	} else {
 		cedrus_write(dev, VE_DEC_VP9_SDRT_LUMA_ADDR, 0);
@@ -1102,7 +1102,7 @@ static int cedrus_vp9_job_configure(struct cedrus_context *ctx)
 		if ((wa - 0x81u) < 0x40 && ha > 64)
 			fc |= VE_DEC_VP9_FUNC_CTRL_DDR_CONS;
 	}
-	if (p010)
+	if (cedrus_picture_is_secondary(ctx))
 		fc |= VE_DEC_VP9_FUNC_CTRL_SECOND_OUT;
 	cedrus_write(dev, VE_DEC_VP9_FUNC_CTRL, fc);
 
@@ -1369,6 +1369,14 @@ static int cedrus_vp9_format_picture_prepare(struct cedrus_context *ctx,
 		break;
 	}
 
+	/* The AFBC reconstruction follows the NV12 picture. */
+	if (cedrus_picture_recon_afbc_for(ctx, pix_format->pixelformat))
+		pix_format->sizeimage =
+			cedrus_picture_visible_size(pix_format->bytesperline,
+						    pix_format->height) +
+			cedrus_afbc_8bit_size(pix_format->width,
+					      pix_format->height);
+
 	pix_format->sizeimage +=
 		cedrus_dec_picture_10bit_extra_size(ctx, pix_format);
 
-- 
2.47.3

