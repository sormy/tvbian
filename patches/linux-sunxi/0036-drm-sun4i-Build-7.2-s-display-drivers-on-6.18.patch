@@ -88,7 +88,7 @@ struct sunxi_engine_ops {
 	 */
 	void (*commit)(struct sunxi_engine *engine,
 		       struct drm_crtc *crtc,
-		       struct drm_atomic_commit *state);
+		       struct drm_atomic_state *state);
 
