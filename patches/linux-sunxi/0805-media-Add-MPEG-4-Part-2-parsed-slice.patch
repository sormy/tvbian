From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Artem Butusov <art.sormy@gmail.com>
Date: Sat, 31 Oct 2026 03:08:35 -0400
Subject: [PATCH] media: Add MPEG-4 Part 2 parsed slice

Private stateless controls for MPEG-4 Part 2 Simple and Advanced Simple
profile and H.263 baseline: the VOL, the VOP, the quantisation matrices
and a slice, one video packet, H.263 GOB run or whole VOP a request.
They stay out of the public headers until they settle, as VC-1's do.

Signed-off-by: Artem Butusov <art.sormy@gmail.com>
---
 drivers/media/v4l2-core/v4l2-ctrls-core.c |  28 ++++++
 drivers/media/v4l2-core/v4l2-ctrls-defs.c |  16 ++++
 drivers/media/v4l2-core/v4l2-ioctl.c      |   1 +
 include/media/mpeg4-ctrls.h               | 108 ++++++++++++++++++++++
 include/media/v4l2-ctrls.h                |   1 +
 5 files changed, 154 insertions(+)
 create mode 100644 include/media/mpeg4-ctrls.h

diff --git a/drivers/media/v4l2-core/v4l2-ctrls-core.c b/drivers/media/v4l2-core/v4l2-ctrls-core.c
index c9a8baa6d..92375c0f2 100644
--- a/drivers/media/v4l2-core/v4l2-ctrls-core.c
+++ b/drivers/media/v4l2-core/v4l2-ctrls-core.c
@@ -442,6 +442,18 @@ void v4l2_ctrl_type_op_log(const struct v4l2_ctrl *ctrl)
 	case V4L2_CTRL_TYPE_VC1_BITPLANES:
 		pr_cont("VC1_BITPLANES");
 		break;
+	case V4L2_CTRL_TYPE_MPEG4_VOL:
+		pr_cont("MPEG4_VOL");
+		break;
+	case V4L2_CTRL_TYPE_MPEG4_VOP:
+		pr_cont("MPEG4_VOP");
+		break;
+	case V4L2_CTRL_TYPE_MPEG4_QUANTISATION:
+		pr_cont("MPEG4_QUANTISATION");
+		break;
+	case V4L2_CTRL_TYPE_MPEG4_SLICE:
+		pr_cont("MPEG4_SLICE");
+		break;
 	case V4L2_CTRL_TYPE_RECT:
 		pr_cont("(%d,%d)/%ux%u",
 			ptr.p_rect->left, ptr.p_rect->top,
@@ -1313,6 +1325,10 @@ static int std_validate_compound(const struct v4l2_ctrl *ctrl, u32 idx,
 
 	case V4L2_CTRL_TYPE_VC1_SLICE_PARAMS:
 	case V4L2_CTRL_TYPE_VC1_BITPLANES:
+	case V4L2_CTRL_TYPE_MPEG4_VOL:
+	case V4L2_CTRL_TYPE_MPEG4_VOP:
+	case V4L2_CTRL_TYPE_MPEG4_QUANTISATION:
+	case V4L2_CTRL_TYPE_MPEG4_SLICE:
 		break;
 
 	case V4L2_CTRL_TYPE_RECT:
@@ -2036,6 +2052,18 @@ static struct v4l2_ctrl *v4l2_ctrl_new(struct v4l2_ctrl_handler *hdl,
 	case V4L2_CTRL_TYPE_VC1_BITPLANES:
 		elem_size = sizeof(struct v4l2_ctrl_vc1_bitplanes);
 		break;
+	case V4L2_CTRL_TYPE_MPEG4_VOL:
+		elem_size = sizeof(struct v4l2_ctrl_mpeg4_vol);
+		break;
+	case V4L2_CTRL_TYPE_MPEG4_VOP:
+		elem_size = sizeof(struct v4l2_ctrl_mpeg4_vop);
+		break;
+	case V4L2_CTRL_TYPE_MPEG4_QUANTISATION:
+		elem_size = sizeof(struct v4l2_ctrl_mpeg4_quantisation);
+		break;
+	case V4L2_CTRL_TYPE_MPEG4_SLICE:
+		elem_size = sizeof(struct v4l2_ctrl_mpeg4_slice);
+		break;
 	case V4L2_CTRL_TYPE_RECT:
 		elem_size = sizeof(struct v4l2_rect);
 		break;
diff --git a/drivers/media/v4l2-core/v4l2-ctrls-defs.c b/drivers/media/v4l2-core/v4l2-ctrls-defs.c
index 46e4b6a88..7175043f4 100644
--- a/drivers/media/v4l2-core/v4l2-ctrls-defs.c
+++ b/drivers/media/v4l2-core/v4l2-ctrls-defs.c
@@ -1239,6 +1239,10 @@ const char *v4l2_ctrl_get_name(u32 id)
 	case V4L2_CID_STATELESS_AV1_FILM_GRAIN:			return "AV1 Film Grain";
 	case V4L2_CID_STATELESS_VC1_SLICE_PARAMS:		return "VC1 Slice Parameters";
 	case V4L2_CID_STATELESS_VC1_BITPLANES:			return "VC1 Bitplanes";
+	case V4L2_CID_STATELESS_MPEG4_VOL:			return "MPEG-4 VOL";
+	case V4L2_CID_STATELESS_MPEG4_VOP:			return "MPEG-4 VOP";
+	case V4L2_CID_STATELESS_MPEG4_QUANTISATION:		return "MPEG-4 Quantisation Matrices";
+	case V4L2_CID_STATELESS_MPEG4_SLICE:			return "MPEG-4 Slice";
 
 	/* Colorimetry controls */
 	/* Keep the order of the 'case's the same as in v4l2-controls.h! */
@@ -1615,6 +1619,18 @@ void v4l2_ctrl_fill(u32 id, const char **name, enum v4l2_ctrl_type *type,
 	case V4L2_CID_STATELESS_VC1_BITPLANES:
 		*type = V4L2_CTRL_TYPE_VC1_BITPLANES;
 		break;
+	case V4L2_CID_STATELESS_MPEG4_VOL:
+		*type = V4L2_CTRL_TYPE_MPEG4_VOL;
+		break;
+	case V4L2_CID_STATELESS_MPEG4_VOP:
+		*type = V4L2_CTRL_TYPE_MPEG4_VOP;
+		break;
+	case V4L2_CID_STATELESS_MPEG4_QUANTISATION:
+		*type = V4L2_CTRL_TYPE_MPEG4_QUANTISATION;
+		break;
+	case V4L2_CID_STATELESS_MPEG4_SLICE:
+		*type = V4L2_CTRL_TYPE_MPEG4_SLICE;
+		break;
 	default:
 		*type = V4L2_CTRL_TYPE_INTEGER;
 		break;
diff --git a/drivers/media/v4l2-core/v4l2-ioctl.c b/drivers/media/v4l2-core/v4l2-ioctl.c
index 539262203..3664d074b 100644
--- a/drivers/media/v4l2-core/v4l2-ioctl.c
+++ b/drivers/media/v4l2-core/v4l2-ioctl.c
@@ -1509,6 +1509,7 @@ static void v4l_fill_fmtdesc(struct v4l2_fmtdesc *fmt)
 		case V4L2_PIX_FMT_VC1_ANNEX_G:	descr = "VC-1 (SMPTE 412M Annex G)"; break;
 		case V4L2_PIX_FMT_VC1_ANNEX_L:	descr = "VC-1 (SMPTE 412M Annex L)"; break;
 		case V4L2_PIX_FMT_VC1_SLICE:	descr = "VC-1 Parsed Data"; break;
+		case V4L2_PIX_FMT_MPEG4_SLICE:	descr = "MPEG-4 Part 2 Parsed Slice Data"; break;
 		case V4L2_PIX_FMT_VP8:		descr = "VP8"; break;
 		case V4L2_PIX_FMT_VP8_FRAME:    descr = "VP8 Frame"; break;
 		case V4L2_PIX_FMT_VP9:		descr = "VP9"; break;
diff --git a/include/media/mpeg4-ctrls.h b/include/media/mpeg4-ctrls.h
new file mode 100644
index 000000000..a6ed5962a
--- /dev/null
+++ b/include/media/mpeg4-ctrls.h
@@ -0,0 +1,108 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * The MPEG-4 Part 2 (Simple and Advanced Simple profiles) and H.263
+ * baseline controls for stateless decoders.
+ *
+ * These structs are not stable yet: keep them private until they are.
+ */
+
+#ifndef _MPEG4_CTRLS_H_
+#define _MPEG4_CTRLS_H_
+
+/* One video packet, H.263 GOB run or whole VOP a request */
+#define V4L2_PIX_FMT_MPEG4_SLICE v4l2_fourcc('M', 'G', '4', 'S')
+
+#define V4L2_CID_STATELESS_MPEG4_VOL		(V4L2_CID_CODEC_STATELESS_BASE + 520)
+#define V4L2_CID_STATELESS_MPEG4_VOP		(V4L2_CID_CODEC_STATELESS_BASE + 521)
+#define V4L2_CID_STATELESS_MPEG4_QUANTISATION	(V4L2_CID_CODEC_STATELESS_BASE + 522)
+#define V4L2_CID_STATELESS_MPEG4_SLICE		(V4L2_CID_CODEC_STATELESS_BASE + 523)
+
+/* enum v4l2_ctrl_type type values */
+#define V4L2_CTRL_TYPE_MPEG4_VOL		0x010b
+#define V4L2_CTRL_TYPE_MPEG4_VOP		0x010c
+#define V4L2_CTRL_TYPE_MPEG4_QUANTISATION	0x010d
+#define V4L2_CTRL_TYPE_MPEG4_SLICE		0x010e
+
+/* H.263 baseline: no annex, no PLUSPTYPE */
+#define V4L2_MPEG4_VOL_FLAG_SHORT_VIDEO_HEADER		0x01
+#define V4L2_MPEG4_VOL_FLAG_INTERLACED			0x02
+#define V4L2_MPEG4_VOL_FLAG_QUANT_TYPE			0x04
+#define V4L2_MPEG4_VOL_FLAG_QUARTER_SAMPLE		0x08
+#define V4L2_MPEG4_VOL_FLAG_RESYNC_MARKER_DISABLE	0x10
+#define V4L2_MPEG4_VOL_FLAG_DATA_PARTITIONED		0x20
+#define V4L2_MPEG4_VOL_FLAG_REVERSIBLE_VLC		0x40
+#define V4L2_MPEG4_VOL_FLAG_SPRITE_BRIGHTNESS_CHANGE	0x80
+
+#define V4L2_MPEG4_SPRITE_NONE				0
+#define V4L2_MPEG4_SPRITE_STATIC			1
+#define V4L2_MPEG4_SPRITE_GMC				2
+
+/* Encoder bugs that change the reconstruction */
+#define V4L2_MPEG4_BUG_EDGE				0x01
+#define V4L2_MPEG4_BUG_QPEL_CHROMA			0x02
+#define V4L2_MPEG4_BUG_QPEL_CHROMA2			0x04
+#define V4L2_MPEG4_BUG_HPEL_CHROMA			0x08
+/* DivX 5.00 build 413: sprite points coded unscaled */
+#define V4L2_MPEG4_BUG_SPRITE_UNSCALED			0x10
+
+struct v4l2_ctrl_mpeg4_vol {
+	__u16	width;
+	__u16	height;
+	__u8	sprite_enable;
+	__u8	sprite_warping_accuracy;
+	__u8	no_of_sprite_warping_points;
+	__u8	bugs;
+	__u32	flags;
+};
+
+#define V4L2_MPEG4_VOP_TYPE_I				0
+#define V4L2_MPEG4_VOP_TYPE_P				1
+#define V4L2_MPEG4_VOP_TYPE_B				2
+#define V4L2_MPEG4_VOP_TYPE_S				3
+
+#define V4L2_MPEG4_VOP_FLAG_ROUNDING_TYPE		0x01
+#define V4L2_MPEG4_VOP_FLAG_TOP_FIELD_FIRST		0x02
+#define V4L2_MPEG4_VOP_FLAG_ALTERNATE_VERTICAL_SCAN	0x04
+
+/*
+ * trb and trd are TRB and TRD of a B-VOP in frame periods; trb_field and
+ * trd_field their field-period counterparts for an interlaced B-VOP.
+ * intra_dc_vlc_thr is the 3-bit code from the VOP header.
+ */
+struct v4l2_ctrl_mpeg4_vop {
+	__u64	forward_ref_ts;
+	__u64	backward_ref_ts;
+	__u32	flags;
+	__u16	trb;
+	__u16	trd;
+	__u16	trb_field;
+	__u16	trd_field;
+	__s16	sprite_trajectory_du[3];
+	__s16	sprite_trajectory_dv[3];
+	__u8	vop_coding_type;
+	__u8	intra_dc_vlc_thr;
+	__u8	vop_fcode_forward;
+	__u8	vop_fcode_backward;
+	__u8	reserved[4];
+};
+
+/* Zigzag order; read only with V4L2_MPEG4_VOL_FLAG_QUANT_TYPE */
+struct v4l2_ctrl_mpeg4_quantisation {
+	__u8	intra_quantiser_matrix[64];
+	__u8	non_intra_quantiser_matrix[64];
+};
+
+/*
+ * A run of macroblocks starting at a VOP, video packet or GOB header:
+ * data_bit_offset is its first macroblock's bit in the buffer.
+ */
+struct v4l2_ctrl_mpeg4_slice {
+	__u32	bit_size;
+	__u32	data_bit_offset;
+	__u16	macroblock_number;
+	__u16	num_macroblocks;
+	__u8	quant_scale;
+	__u8	reserved[3];
+};
+
+#endif
diff --git a/include/media/v4l2-ctrls.h b/include/media/v4l2-ctrls.h
index 926600557..77c739561 100644
--- a/include/media/v4l2-ctrls.h
+++ b/include/media/v4l2-ctrls.h
@@ -18,6 +18,7 @@
  * This will move to the public headers once this API is fully stable.
  */
 #include <media/vc1-ctrls.h>
+#include <media/mpeg4-ctrls.h>
 
 /* forward references */
 struct file;
