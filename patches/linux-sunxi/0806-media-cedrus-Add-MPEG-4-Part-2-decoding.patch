+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Cedrus Video Engine Driver
+ */
+
+#ifndef _CEDRUS_DEC_MPEG4_H_
+#define _CEDRUS_DEC_MPEG4_H_
+
+#include <media/v4l2-ctrls.h>
+
+struct cedrus_dec_mpeg4_job {
+	const struct v4l2_ctrl_mpeg4_vol		*vol;
+	const struct v4l2_ctrl_mpeg4_vop		*vop;
+	const struct v4l2_ctrl_mpeg4_quantisation	*quantisation;
+	const struct v4l2_ctrl_mpeg4_slice		*slice;
+};
+
+extern const struct cedrus_engine cedrus_dec_mpeg4;
+
+#endif
diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_regs.h b/drivers/staging/media/sunxi/cedrus/cedrus_regs.h
index 5526b31c4..809b48d01 100644
--- a/drivers/staging/media/sunxi/cedrus/cedrus_regs.h
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_regs.h
@@ -163,8 +163,34 @@
