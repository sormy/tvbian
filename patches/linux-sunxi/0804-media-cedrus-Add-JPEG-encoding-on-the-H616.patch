diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_enc_jpeg.c b/drivers/staging/media/sunxi/cedrus/cedrus_enc_jpeg.c
new file mode 100644
index 000000000..a9f1ccf08
--- /dev/null
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_enc_jpeg.c
@@ -0,0 +1,354 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Cedrus Video Engine Driver
+ *
+ * Baseline JPEG, 4:2:0, from the encoder's JPEG mode: the engine codes the
+ * scan with the Annex K Huffman tables; the headers and the end marker are
+ * written here.
+ */
+
+#include <linux/types.h>
+#include <linux/videodev2.h>
+#include <media/v4l2-jpeg.h>
+#include <media/videobuf2-dma-contig.h>
+
+#include "cedrus.h"
+#include "cedrus_context.h"
+#include "cedrus_enc.h"
+#include "cedrus_enc_jpeg.h"
+#include "cedrus_engine.h"
+#include "cedrus_proc.h"
+#include "cedrus_regs.h"
+
+#define CEDRUS_ENC_JPEG_QUALITY_DEFAULT	85
+#define CEDRUS_ENC_JPEG_BIT_MAX		0x0fff0000
+#define CEDRUS_ENC_JPEG_DC_SCALE	1024
+
+#define JPEG_MARKER_SOI		0xd8
+#define JPEG_MARKER_EOI		0xd9
+#define JPEG_MARKER_DQT		0xdb
+#define JPEG_MARKER_SOF0	0xc0
+#define JPEG_MARKER_DHT		0xc4
+#define JPEG_MARKER_SOS		0xda
+
+enum cedrus_enc_jpeg_table {
+	CEDRUS_ENC_JPEG_LUMA,
+	CEDRUS_ENC_JPEG_CHROMA,
+	CEDRUS_ENC_JPEG_TABLES,
+};
+
+struct cedrus_enc_jpeg_job {
+	u8	quantisation[CEDRUS_ENC_JPEG_TABLES][V4L2_JPEG_PIXELS_IN_BLOCK];
+};
+
+/* libjpeg's scaling of the Annex K tables, natural order. */
+static void cedrus_enc_jpeg_quantisation(struct cedrus_enc_jpeg_job *job,
+					 unsigned int quality)
+{
+	const u8 *reference[CEDRUS_ENC_JPEG_TABLES] = {
+		v4l2_jpeg_ref_table_luma_qt,
+		v4l2_jpeg_ref_table_chroma_qt,
+	};
+	unsigned int scale = quality < 50 ? 5000 / quality : 200 - 2 * quality;
+	unsigned int t, i;
+
+	for (t = 0; t < CEDRUS_ENC_JPEG_TABLES; t++)
+		for (i = 0; i < V4L2_JPEG_PIXELS_IN_BLOCK; i++)
+			job->quantisation[t][i] =
+				clamp((reference[t][i] * scale + 50) / 100,
+				      1U, 255U);
+}
+
+static void cedrus_enc_jpeg_put(struct cedrus_device *dev, u8 byte)
+{
+	cedrus_poll(dev, VE_ENC_AVC_STATUS_REG,
+		    VE_ENC_AVC_STATUS_PUT_BITS_READY);
+
+	cedrus_write(dev, VE_ENC_AVC_PUTBITSDATA_REG, byte);
+
+	cedrus_write(dev, VE_ENC_AVC_STARTTRIG_REG,
+		     VE_ENC_AVC_STARTTRIG_ENCODE_MODE_JPEG |
+		     VE_ENC_AVC_STARTTRIG_NUM_BITS(8) |
+		     VE_ENC_AVC_STARTTRIG_TYPE_PUT_BITS);
+}
+
+static void cedrus_enc_jpeg_put_u16(struct cedrus_device *dev, u16 value)
+{
+	cedrus_enc_jpeg_put(dev, value >> 8);
+	cedrus_enc_jpeg_put(dev, value);
+}
+
+static void cedrus_enc_jpeg_put_marker(struct cedrus_device *dev, u8 marker)
+{
+	cedrus_enc_jpeg_put(dev, 0xff);
+	cedrus_enc_jpeg_put(dev, marker);
+}
+
+static void cedrus_enc_jpeg_put_dqt(struct cedrus_device *dev,
+				    const struct cedrus_enc_jpeg_job *job)
+{
+	unsigned int t, i;
+
+	for (t = 0; t < CEDRUS_ENC_JPEG_TABLES; t++) {
+		cedrus_enc_jpeg_put_marker(dev, JPEG_MARKER_DQT);
+		cedrus_enc_jpeg_put_u16(dev, 3 + V4L2_JPEG_PIXELS_IN_BLOCK);
+		cedrus_enc_jpeg_put(dev, t);
+
+		for (i = 0; i < V4L2_JPEG_PIXELS_IN_BLOCK; i++)
+			cedrus_enc_jpeg_put(dev, job->quantisation[t]
+					    [v4l2_jpeg_zigzag_scan_index[i]]);
+	}
+}
+
+/* Luma 2x2, chroma 1x1, each chroma component on the chroma tables. */
+static void cedrus_enc_jpeg_put_sof(struct cedrus_device *dev,
+				    const struct v4l2_pix_format *pix_format)
+{
+	unsigned int c;
+
+	cedrus_enc_jpeg_put_marker(dev, JPEG_MARKER_SOF0);
+	cedrus_enc_jpeg_put_u16(dev, 8 + 3 * 3);
+	cedrus_enc_jpeg_put(dev, 8);
+	cedrus_enc_jpeg_put_u16(dev, pix_format->height);
+	cedrus_enc_jpeg_put_u16(dev, pix_format->width);
+	cedrus_enc_jpeg_put(dev, 3);
+
+	for (c = 1; c <= 3; c++) {
+		cedrus_enc_jpeg_put(dev, c);
+		cedrus_enc_jpeg_put(dev, c == 1 ? 0x22 : 0x11);
+		cedrus_enc_jpeg_put(dev, c == 1 ? CEDRUS_ENC_JPEG_LUMA :
+					 CEDRUS_ENC_JPEG_CHROMA);
+	}
+}
+
+static void cedrus_enc_jpeg_put_dht(struct cedrus_device *dev)
+{
+	static const struct {
+		u8		class_id;
+		const u8	*table;
+		unsigned int	length;
+	} tables[] = {
+		{ 0x00, v4l2_jpeg_ref_table_luma_dc_ht, V4L2_JPEG_REF_HT_DC_LEN },
+		{ 0x10, v4l2_jpeg_ref_table_luma_ac_ht, V4L2_JPEG_REF_HT_AC_LEN },
+		{ 0x01, v4l2_jpeg_ref_table_chroma_dc_ht, V4L2_JPEG_REF_HT_DC_LEN },
+		{ 0x11, v4l2_jpeg_ref_table_chroma_ac_ht, V4L2_JPEG_REF_HT_AC_LEN },
+	};
+	unsigned int t, i;
+
+	for (t = 0; t < ARRAY_SIZE(tables); t++) {
+		cedrus_enc_jpeg_put_marker(dev, JPEG_MARKER_DHT);
+		cedrus_enc_jpeg_put_u16(dev, 3 + tables[t].length);
+		cedrus_enc_jpeg_put(dev, tables[t].class_id);
+
+		for (i = 0; i < tables[t].length; i++)
+			cedrus_enc_jpeg_put(dev, tables[t].table[i]);
+	}
+}
+
+static void cedrus_enc_jpeg_put_sos(struct cedrus_device *dev)
+{
+	unsigned int c;
+
+	cedrus_enc_jpeg_put_marker(dev, JPEG_MARKER_SOS);
+	cedrus_enc_jpeg_put_u16(dev, 6 + 2 * 3);
+	cedrus_enc_jpeg_put(dev, 3);
+
+	for (c = 1; c <= 3; c++) {
+		cedrus_enc_jpeg_put(dev, c);
+		cedrus_enc_jpeg_put(dev, c == 1 ? 0x00 : 0x11);
+	}
+
+	/* Spectral selection 0-63, no successive approximation. */
+	cedrus_enc_jpeg_put(dev, 0);
+	cedrus_enc_jpeg_put(dev, 63);
+	cedrus_enc_jpeg_put(dev, 0);
+}
+
+/* Job */
+
+static int cedrus_enc_jpeg_job_prepare(struct cedrus_context *ctx)
+{
+	int quality = cedrus_context_ctrl_value(ctx,
+					V4L2_CID_JPEG_COMPRESSION_QUALITY);
+
+	cedrus_enc_jpeg_quantisation(ctx->engine_job, quality);
+
+	return 0;
+}
+
+static int cedrus_enc_jpeg_job_configure(struct cedrus_context *ctx)
+{
+	struct cedrus_device *dev = ctx->proc->dev;
+	struct cedrus_enc_jpeg_job *job = ctx->engine_job;
+	struct v4l2_pix_format *pix_format = &ctx->v4l2.format_picture.fmt.pix;
+	unsigned int width_8 = DIV_ROUND_UP(pix_format->width, 8);
+	unsigned int height_8 = DIV_ROUND_UP(pix_format->height, 8);
+	const u8 *luma = job->quantisation[CEDRUS_ENC_JPEG_LUMA];
+	const u8 *chroma = job->quantisation[CEDRUS_ENC_JPEG_CHROMA];
+	unsigned int size, t, i;
+	dma_addr_t addr;
+
+	cedrus_write(dev, VE_ENC_AVC_STARTTRIG_REG,
+		     VE_ENC_AVC_STARTTRIG_ENCODE_MODE_JPEG);
+
+	/* JPEG counts the picture in 8-pixel units. */
+	cedrus_write(dev, VE_ISP_PIC_INFO_REG,
+		     VE_ISP_PIC_INFO_WIDTH_MBS(width_8) |
+		     VE_ISP_PIC_INFO_HEIGHT_MBS(height_8));
+	cedrus_write(dev, VE_ISP_SCALER_SIZE_REG,
+		     VE_ISP_SCALER_SIZE_HEIGHT_MBS(height_8) |
+		     VE_ISP_SCALER_SIZE_WIDTH_MBS(width_8));
+
+	cedrus_write(dev, VE_ENC_AVC_STATUS_REG, VE_ENC_AVC_STATUS_MASK);
+
+	/* Coded buffer. */
+
+	cedrus_job_buffer_coded_dma(ctx, &addr, &size);
+
+	cedrus_write(dev, VE_ENC_AVC_STM_BIT_OFFSET_REG, 0);
+	cedrus_enc_write_addr(dev, VE_ENC_AVC_STM_START_ADDR_REG, addr);
+	cedrus_enc_write_addr(dev, VE_ENC_AVC_STM_END_ADDR_REG, addr + size - 1);
+	cedrus_write(dev, VE_ENC_AVC_STM_BIT_MAX_REG,
+		     min_t(u32, size * 8, CEDRUS_ENC_JPEG_BIT_MAX));
+	cedrus_write(dev, VE_ENC_AVC_STM_BIT_LEN_REG, 0);
+
+	/* Headers, their 0xff bytes not stuffed. */
+
+	cedrus_write(dev, VE_ENC_AVC_PARA0_REG, VE_ENC_AVC_PARA0_EPTB_DIS);
+
+	cedrus_enc_jpeg_put_marker(dev, JPEG_MARKER_SOI);
+	cedrus_enc_jpeg_put_dqt(dev, job);
+	cedrus_enc_jpeg_put_sof(dev, pix_format);
+	cedrus_enc_jpeg_put_dht(dev);
+	cedrus_enc_jpeg_put_sos(dev);
+
+	/* The scan, stuffed. */
+
+	cedrus_poll(dev, VE_ENC_AVC_STATUS_REG,
+		    VE_ENC_AVC_STATUS_PUT_BITS_READY);
+
+	cedrus_write(dev, VE_ENC_AVC_PARA0_REG,
+		     VE_ENC_AVC_PARA0_EPTB_DIS |
+		     VE_ENC_AVC_PARA0_STUFF_ZERO_AFTER_FF_EN |
+		     VE_ENC_JPEG_PARA0_DC_CHROMA(CEDRUS_ENC_JPEG_DC_SCALE /
+						 chroma[0]) |
+		     VE_ENC_JPEG_PARA0_DC_LUMA(CEDRUS_ENC_JPEG_DC_SCALE /
+					       luma[0]));
+
+	/* Plain quantisation: no coefficient or run-length shortcuts. */
+	cedrus_write(dev, VE_ENC_AVC_PARA1_REG,
+		     VE_ENC_JPEG_PARA1_RUN_LEN_OPT_DIS |
+		     VE_ENC_JPEG_PARA1_COEF_DOWN_DIS);
+
+	cedrus_write(dev, VE_ENC_JPEG_QM_INDEX_REG, 0);
+	for (t = 0; t < CEDRUS_ENC_JPEG_TABLES; t++)
+		for (i = 0; i < V4L2_JPEG_PIXELS_IN_BLOCK; i++)
+			cedrus_write(dev, VE_ENC_JPEG_QM_DATA_REG,
+				     VE_ENC_JPEG_QM_DATA_ROUND(job->quantisation[t][i]) |
+				     VE_ENC_JPEG_QM_DATA_RECIPROCAL(job->quantisation[t][i]));
+
+	return 0;
+}
+
+static void cedrus_enc_jpeg_job_trigger(struct cedrus_context *ctx)
+{
+	struct cedrus_device *dev = ctx->proc->dev;
+
+	cedrus_write(dev, VE_ENC_AVC_INT_EN_REG,
+		     VE_ENC_AVC_INT_EN_STALL |
+		     VE_ENC_AVC_INT_EN_FINISH);
+
+	cedrus_write(dev, VE_ENC_AVC_STARTTRIG_REG,
+		     VE_ENC_AVC_STARTTRIG_ENCODE_MODE_JPEG |
+		     VE_ENC_AVC_STARTTRIG_TYPE_ENC_START);
+}
+
+/* The engine leaves the end marker to software. */
+static void cedrus_enc_jpeg_job_finish(struct cedrus_context *ctx, int state)
+{
+	struct cedrus_device *dev = ctx->proc->dev;
+	struct vb2_v4l2_buffer *v4l2_buffer = ctx->job.buffer_coded;
+	struct vb2_buffer *vb2_buffer = &v4l2_buffer->vb2_buf;
+	u8 *data = vb2_plane_vaddr(vb2_buffer, 0);
+	u32 length;
+
+	length = cedrus_read(dev, VE_ENC_AVC_STM_BIT_LEN_REG) / 8;
+
+	if (state != VB2_BUF_STATE_DONE || !data ||
+	    length + 2 > vb2_plane_size(vb2_buffer, 0)) {
+		vb2_set_plane_payload(vb2_buffer, 0, 0);
+		return;
+	}
+
+	data[length++] = 0xff;
+	data[length++] = JPEG_MARKER_EOI;
+
+	vb2_set_plane_payload(vb2_buffer, 0, length);
+	v4l2_buffer->flags |= V4L2_BUF_FLAG_KEYFRAME;
+}
+
+/* Engine */
+
