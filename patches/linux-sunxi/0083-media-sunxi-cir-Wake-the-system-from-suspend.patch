From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Artem Butusov <art.sormy@gmail.com>
Date: Sun, 25 Oct 2026 11:30:00 -0400
Subject: [PATCH] media: sunxi-cir: Wake the system from suspend

The receiver's node may carry wakeup-source, but the driver never
declared the capability and stopped the hardware on suspend, so a remote
could not wake a box. Honour the property: keep the receiver running
and its interrupt armed as a wake source.

---
--- a/drivers/media/rc/sunxi-cir.c
+++ b/drivers/media/rc/sunxi-cir.c
@@ -238,6 +238,11 @@
 
 static int __maybe_unused sunxi_ir_suspend(struct device *dev)
 {
+	struct sunxi_ir *ir = dev_get_drvdata(dev);
+
+	if (device_may_wakeup(dev))
+		return enable_irq_wake(ir->irq);
+
 	sunxi_ir_hw_exit(dev);
 
 	return 0;
@@ -245,6 +250,11 @@
 
 static int __maybe_unused sunxi_ir_resume(struct device *dev)
 {
+	struct sunxi_ir *ir = dev_get_drvdata(dev);
+
+	if (device_may_wakeup(dev))
+		return disable_irq_wake(ir->irq);
+
 	return sunxi_ir_hw_init(dev);
 }
 
@@ -357,6 +367,9 @@
 	if (ret)
 		goto exit_unregister_dev;
 
+	device_init_wakeup(dev,
+			   of_property_read_bool(dev->of_node, "wakeup-source"));
+
 	dev_info(dev, "initialized sunXi IR driver\n");
 	return 0;
 
