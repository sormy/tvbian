From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Artem Butusov <art.sormy@gmail.com>
Date: Tue, 3 Nov 2026 09:45:00 -0500
Subject: [PATCH] clk: sunxi-ng: mp: Support the closest-rate feature

The NM, divider and mux clocks pick the rate closest to the request
where CCU_FEATURE_CLOSEST_RATE is set, through ccu_is_better_rate(). The
MP clock's divider search still keeps the best rate below, with or
without parent adjustment. Use ccu_is_better_rate() there too: nothing
changes for clocks without the feature. Add
SUNXI_CCU_MP_WITH_MUX_GATE_CLOSEST to declare one.

Signed-off-by: Artem Butusov <art.sormy@gmail.com>
---
diff -urN a/drivers/clk/sunxi-ng/ccu_mp.c b/drivers/clk/sunxi-ng/ccu_mp.c
--- a/drivers/clk/sunxi-ng/ccu_mp.c
+++ b/drivers/clk/sunxi-ng/ccu_mp.c
@@ -17,7 +17,8 @@
 	return div + 1;
 }
 
-static unsigned long ccu_mp_find_best(unsigned long parent, unsigned long rate,
+static unsigned long ccu_mp_find_best(struct ccu_common *common,
+				      unsigned long parent, unsigned long rate,
 				      unsigned int max_m, unsigned int max_p,
 				      bool shift,
 				      unsigned int *m, unsigned int *p)
@@ -30,10 +31,7 @@
 		for (_m = 1; _m <= max_m; _m++) {
 			unsigned long tmp_rate = parent / _p / _m;
 
-			if (tmp_rate > rate)
-				continue;
-
-			if ((rate - tmp_rate) < (rate - best_rate)) {
+			if (ccu_is_better_rate(common, rate, tmp_rate, best_rate)) {
 				best_rate = tmp_rate;
 				best_m = _m;
 				best_p = _p;
@@ -47,7 +45,8 @@
 	return best_rate;
 }
 
-static unsigned long ccu_mp_find_best_with_parent_adj(struct clk_hw *hw,
+static unsigned long ccu_mp_find_best_with_parent_adj(struct ccu_common *common,
+						      struct clk_hw *hw,
 						      unsigned long *parent,
 						      unsigned long rate,
 						      unsigned int max_m,
@@ -90,7 +89,7 @@
 			parent_rate = clk_hw_round_rate(hw, rate * div);
 			now = parent_rate / div;
 
-			if (now <= rate && now > best_rate) {
+			if (ccu_is_better_rate(common, rate, now, best_rate)) {
 				best_rate = now;
 				*parent = parent_rate;
 
@@ -127,10 +126,11 @@
 		max_p = cmp->p.max ?: 1 << cmp->p.width;
 
 	if (!clk_hw_can_set_rate_parent(&cmp->common.hw)) {
-		rate = ccu_mp_find_best(*parent_rate, rate, max_m, max_p, shift,
-					&m, &p);
+		rate = ccu_mp_find_best(&cmp->common, *parent_rate, rate, max_m,
+					max_p, shift, &m, &p);
 	} else {
-		rate = ccu_mp_find_best_with_parent_adj(hw, parent_rate, rate,
+		rate = ccu_mp_find_best_with_parent_adj(&cmp->common, hw,
+							parent_rate, rate,
 							max_m, max_p, shift);
 	}
 
@@ -231,7 +231,8 @@
 	if (cmp->common.features & CCU_FEATURE_FIXED_POSTDIV)
 		rate = rate * cmp->fixed_post_div;
 
-	ccu_mp_find_best(parent_rate, rate, max_m, max_p, shift, &m, &p);
+	ccu_mp_find_best(&cmp->common, parent_rate, rate, max_m, max_p, shift,
+			 &m, &p);
 
 	spin_lock_irqsave(cmp->common.lock, flags);
 
diff -urN a/drivers/clk/sunxi-ng/ccu_mp.h b/drivers/clk/sunxi-ng/ccu_mp.h
--- a/drivers/clk/sunxi-ng/ccu_mp.h
+++ b/drivers/clk/sunxi-ng/ccu_mp.h
@@ -93,6 +93,26 @@
 		}							\
 	}
 
+#define SUNXI_CCU_MP_WITH_MUX_GATE_CLOSEST(_struct, _name, _parents, _reg, \
+					   _mshift, _mwidth,		\
+					   _pshift, _pwidth,		\
+					   _muxshift, _muxwidth,	\
+					   _gate, _flags)		\
+	struct ccu_mp _struct = {					\
+		.enable	= _gate,					\
+		.m	= _SUNXI_CCU_DIV(_mshift, _mwidth),		\
+		.p	= _SUNXI_CCU_DIV(_pshift, _pwidth),		\
+		.mux	= _SUNXI_CCU_MUX(_muxshift, _muxwidth),		\
+		.common	= {						\
+			.reg		= _reg,				\
+			.features	= CCU_FEATURE_CLOSEST_RATE,	\
+			.hw.init	= CLK_HW_INIT_PARENTS(_name,	\
+							      _parents, \
+							      &ccu_mp_ops, \
+							      _flags),	\
+		}							\
+	}
+
 #define SUNXI_CCU_MP_WITH_MUX(_struct, _name, _parents, _reg,		\
 			      _mshift, _mwidth,				\
 			      _pshift, _pwidth,				\
