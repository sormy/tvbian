diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_dec_jpeg.c b/drivers/staging/media/sunxi/cedrus/cedrus_dec_jpeg.c
new file mode 100644
index 000000000..ed943462c
--- /dev/null
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_dec_jpeg.c
@@ -0,0 +1,390 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Cedrus Video Engine Driver
+ *
+ * Copyright (C) 2022 Emmanuel Gil Peyrot <linkmauve@linkmauve.fr>
+ */
+
+#include <linux/types.h>
+#include <linux/unaligned.h>
+#include <linux/videodev2.h>
+#include <media/v4l2-jpeg.h>
+#include <media/videobuf2-dma-contig.h>
+
+#include "cedrus.h"
+#include "cedrus_context.h"
+#include "cedrus_dec.h"
+#include "cedrus_dec_jpeg.h"
+#include "cedrus_engine.h"
+#include "cedrus_proc.h"
+#include "cedrus_regs.h"
+
+#define CEDRUS_JPEG_HUFFMAN_CODES	16
+#define CEDRUS_JPEG_HUFFMAN_SYMBOLS_WORDS	64
+#define CEDRUS_JPEG_HUFFMAN_GAP_WORDS	192
+
+/* The Annex K tables, for a stream that leaves them out, as MJPEG does. */
+static const struct {
+	const u8	*table;
+	size_t		length;
+} cedrus_dec_jpeg_default_huffman[4] = {
+	{ v4l2_jpeg_ref_table_luma_dc_ht, V4L2_JPEG_REF_HT_DC_LEN },
+	{ v4l2_jpeg_ref_table_chroma_dc_ht, V4L2_JPEG_REF_HT_DC_LEN },
+	{ v4l2_jpeg_ref_table_luma_ac_ht, V4L2_JPEG_REF_HT_AC_LEN },
+	{ v4l2_jpeg_ref_table_chroma_ac_ht, V4L2_JPEG_REF_HT_AC_LEN },
+};
+
+static void cedrus_dec_jpeg_huffman_default(struct v4l2_jpeg_header *header)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(cedrus_dec_jpeg_default_huffman); i++) {
+		struct v4l2_jpeg_reference *table = &header->huffman_tables[i];
+
+		if (table->start)
+			continue;
+
+		table->start = (u8 *)cedrus_dec_jpeg_default_huffman[i].table;
+		table->length = cedrus_dec_jpeg_default_huffman[i].length;
+	}
+}
+
+static void cedrus_dec_jpeg_huffman_codes_write(struct cedrus_device *dev,
+					      const u8 *counts)
+{
+	u16 start_codes[CEDRUS_JPEG_HUFFMAN_CODES];
+	u8 offsets[CEDRUS_JPEG_HUFFMAN_CODES];
+	unsigned int count = 0, code = 0;
+	int i;
+
+	for (i = 0; i < CEDRUS_JPEG_HUFFMAN_CODES; i++) {
+		offsets[i] = count;
+		start_codes[i] = code;
+		count += counts[i];
+		code = (code + counts[i]) * 2;
+	}
+
+	for (i = CEDRUS_JPEG_HUFFMAN_CODES - 1; i >= 0 && !counts[i]; i--)
+		start_codes[i] = 0xffff;
+
+	for (i = 0; i < CEDRUS_JPEG_HUFFMAN_CODES; i += 2)
+		cedrus_write(dev, VE_DEC_MPEG_SRAM_RW_DATA,
+			     start_codes[i] | start_codes[i + 1] << 16);
+
+	for (i = 0; i < CEDRUS_JPEG_HUFFMAN_CODES; i += 4)
+		cedrus_write(dev, VE_DEC_MPEG_SRAM_RW_DATA,
+			     get_unaligned_le32(&offsets[i]));
+
+	for (i = 0; i < 4; i++)
+		cedrus_write(dev, VE_DEC_MPEG_SRAM_RW_DATA, 0);
+}
+
+static void cedrus_dec_jpeg_huffman_symbols_write(struct cedrus_device *dev,
+						const u8 *symbols,
+						size_t length)
+{
+	unsigned int i, words = DIV_ROUND_UP(length, 4);
+	u32 value = 0;
+
+	/* Little-endian words, the last one zero-padded. */
+	for (i = 0; i < length; i++) {
+		value |= symbols[i] << (8 * (i % 4));
+		if (i % 4 == 3 || i == length - 1) {
+			cedrus_write(dev, VE_DEC_MPEG_SRAM_RW_DATA, value);
+			value = 0;
+		}
+	}
+
+	for (i = words; i < CEDRUS_JPEG_HUFFMAN_SYMBOLS_WORDS; i++)
+		cedrus_write(dev, VE_DEC_MPEG_SRAM_RW_DATA, 0);
+}
+
+/* Luma DC and AC, then chroma DC and AC; the third component shares chroma's. */
+static void cedrus_dec_jpeg_huffman_write(struct cedrus_device *dev,
+					  struct v4l2_jpeg_header *header)
+{
+	struct v4l2_jpeg_reference *tables[4];
+	unsigned int i;
+
+	for (i = 0; i < 2; i++) {
+		struct v4l2_jpeg_scan_component_spec *component =
+			&header->scan->component[i];
+
+		tables[i * 2] = &header->huffman_tables[
+			component->dc_entropy_coding_table_selector];
+		tables[i * 2 + 1] = &header->huffman_tables[
+			component->ac_entropy_coding_table_selector + 2];
+	}
+
+	cedrus_write(dev, VE_DEC_MPEG_SRAM_RW_OFFSET, 0);
+
+	for (i = 0; i < ARRAY_SIZE(tables); i++)
+		cedrus_dec_jpeg_huffman_codes_write(dev, tables[i]->start);
+
+	for (i = 0; i < CEDRUS_JPEG_HUFFMAN_GAP_WORDS; i++)
+		cedrus_write(dev, VE_DEC_MPEG_SRAM_RW_DATA, 0);
+
+	for (i = 0; i < ARRAY_SIZE(tables); i++)
+		cedrus_dec_jpeg_huffman_symbols_write(dev,
+			tables[i]->start + CEDRUS_JPEG_HUFFMAN_CODES,
+			tables[i]->length - CEDRUS_JPEG_HUFFMAN_CODES);
+}
+
+static int cedrus_dec_jpeg_quantisation_write(struct cedrus_device *dev,
+					      const struct v4l2_jpeg_reference *table,
+					      u32 flag)
+{
+	const u8 *matrix = table->start;
+	bool wide = table->length > V4L2_JPEG_PIXELS_IN_BLOCK;
+	unsigned int i;
+	u32 value;
+
+	if (!matrix)
+		return -EINVAL;
+
+	for (i = 0; i < V4L2_JPEG_PIXELS_IN_BLOCK; i++) {
+		value = wide ? get_unaligned_be16(&matrix[i * 2]) : matrix[i];
+		cedrus_write(dev, VE_DEC_MPEG_IQMINPUT,
+			     VE_DEC_MPEG_IQMINPUT_WEIGHT(i, value) | flag);
+	}
+
+	return 0;
+}
+
+static int cedrus_dec_jpeg_subsampling(const struct v4l2_jpeg_frame_header *frame,
+				       u32 *subsampling)
+{
+	const struct v4l2_jpeg_frame_component_spec *c = frame->component;
+	u32 factors = c[0].horizontal_sampling_factor << 20 |
+		      c[0].vertical_sampling_factor << 16 |
+		      c[1].horizontal_sampling_factor << 12 |
+		      c[1].vertical_sampling_factor << 8 |
+		      c[2].horizontal_sampling_factor << 4 |
+		      c[2].vertical_sampling_factor;
+
+	switch (factors) {
+	case 0x221111:
+		*subsampling = VE_DEC_MPEG_TRIGGER_CHROMA_FMT_420;
+		return 0;
+	case 0x211111:
+		*subsampling = VE_DEC_MPEG_TRIGGER_CHROMA_FMT_422;
+		return 0;
+	case 0x111111:
+		*subsampling = VE_DEC_MPEG_TRIGGER_CHROMA_FMT_444;
+		return 0;
+	case 0x121111:
+		*subsampling = VE_DEC_MPEG_TRIGGER_CHROMA_FMT_422T;
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+/* Job */
+
+static int cedrus_dec_jpeg_job_configure(struct cedrus_context *ctx)
+{
+	struct cedrus_device *dev = ctx->proc->dev;
+	struct cedrus_dec_jpeg_job *job = ctx->engine_job;
+	struct v4l2_pix_format *pix_format = &ctx->v4l2.format_coded.fmt.pix;
+	struct vb2_buffer *coded =
+		&cedrus_job_buffer_coded(ctx)->m2m_buffer.vb.vb2_buf;
+	struct v4l2_jpeg_reference quantisation_tables[4] = { };
+	struct v4l2_jpeg_reference huffman_tables[4] = { };
+	struct v4l2_jpeg_scan_header scan = { };
+	struct v4l2_jpeg_header header = {
+		.scan			= &scan,
+		.quantization_tables	= quantisation_tables,
+		.huffman_tables		= huffman_tables,
+	};
+	const struct v4l2_jpeg_frame_component_spec *components;
+	unsigned int size = vb2_get_plane_payload(coded, 0);
+	dma_addr_t coded_addr, luma_addr, chroma_addr;
+	unsigned int hmax = 0, vmax = 0, i;
+	void *coded_data = vb2_plane_vaddr(coded, 0);
+	u32 value;
+	int ret;
+
+	if (!coded_data)
+		return -EFAULT;
+
+	ret = v4l2_jpeg_parse_header(coded_data, size, &header);
+	if (ret < 0)
+		return ret;
+
+	/* Baseline 8-bit YCbCr, within the buffers the coded format sized. */
+	if (header.frame.precision != 8 || header.frame.num_components != 3 ||
+	    header.frame.width > pix_format->width ||
+	    header.frame.height > pix_format->height)
+		return -EINVAL;
+
+	ret = cedrus_dec_jpeg_subsampling(&header.frame, &job->subsampling);
+	if (ret)
+		return ret;
+
+	cedrus_dec_jpeg_huffman_default(&header);
+
+	components = header.frame.component;
+	for (i = 0; i < 3; i++) {
+		hmax = max_t(unsigned int, hmax,
+			     components[i].horizontal_sampling_factor);
+		vmax = max_t(unsigned int, vmax,
+			     components[i].vertical_sampling_factor);
+	}
+
+	cedrus_write(dev, VE_DEC_MPEG_TRIGGER,
+		     VE_DEC_MPEG_TRIGGER_JPEG | job->subsampling);
+
+	cedrus_write(dev, VE_DEC_MPEG_JPEG_RES_INT, header.restart_interval);
+
+	/* Size in MCUs. */
+	value = VE_DEC_MPEG_JPEG_SIZE_WIDTH(DIV_ROUND_UP(header.frame.width,
+							 8 * hmax)) |
+		VE_DEC_MPEG_JPEG_SIZE_HEIGHT(DIV_ROUND_UP(header.frame.height,
+							  8 * vmax));
+	cedrus_write(dev, VE_DEC_MPEG_JPEG_SIZE, value);
+
+	/* Luma's table as the intra matrix, chroma's as the non-intra one. */
+	ret = cedrus_dec_jpeg_quantisation_write(dev,
+			&quantisation_tables[components[0].quantization_table_selector],
+			VE_DEC_MPEG_IQMINPUT_FLAG_INTRA);
+	if (ret)
+		return ret;
+
+	ret = cedrus_dec_jpeg_quantisation_write(dev,
+			&quantisation_tables[components[1].quantization_table_selector],
+			VE_DEC_MPEG_IQMINPUT_FLAG_NON_INTRA);
+	if (ret)
+		return ret;
+
+	cedrus_dec_jpeg_huffman_write(dev, &header);
+
+	/* The engine writes JPEG to its rotate and scale output only. */
+	cedrus_dec_picture_secondary_output_set(ctx, &luma_addr, &chroma_addr);
+	cedrus_write(dev, VE_DEC_MPEG_ROT_LUMA, luma_addr);
+	cedrus_write(dev, VE_DEC_MPEG_ROT_CHROMA, chroma_addr);
+	cedrus_write(dev, VE_DEC_MPEG_SD_ROT_DBLK_CTL, 0);
+
+	/* The entropy-coded segment, in bits from the start of the buffer. */
+	coded_addr = vb2_dma_contig_plane_dma_addr(coded, 0);
+
+	cedrus_write(dev, VE_DEC_MPEG_VLD_OFFSET, header.ecs_offset * 8);
+	cedrus_write(dev, VE_DEC_MPEG_VLD_LEN, size * 8);
+	cedrus_write(dev, VE_DEC_MPEG_VLD_ADDR,
+		     VE_DEC_MPEG_VLD_ADDR_BASE(coded_addr) |
+		     VE_DEC_MPEG_VLD_ADDR_VALID_PIC_DATA |
+		     VE_DEC_MPEG_VLD_ADDR_LAST_PIC_DATA |
+		     VE_DEC_MPEG_VLD_ADDR_FIRST_PIC_DATA);
+	cedrus_write(dev, VE_DEC_MPEG_VLD_END_ADDR, coded_addr + size);
+
+	value = VE_DEC_MPEG_CTRL_IRQ_MASK;
+	if (job->subsampling != VE_DEC_MPEG_TRIGGER_CHROMA_FMT_420)
+		value |= VE_DEC_MPEG_CTRL_JPEG_FORCE_420;
+	cedrus_write(dev, VE_DEC_MPEG_CTRL, value);
+
+	return 0;
+}
+
+static void cedrus_dec_jpeg_job_trigger(struct cedrus_context *ctx)
+{
+	struct cedrus_device *dev = ctx->proc->dev;
+	struct cedrus_dec_jpeg_job *job = ctx->engine_job;
+
+	cedrus_write(dev, VE_DEC_MPEG_TRIGGER,
+		     VE_DEC_MPEG_TRIGGER_HW_JPEG_VLD |
+		     VE_DEC_MPEG_TRIGGER_JPEG | job->subsampling);
+}
+
+/* IRQ */
+
+static int cedrus_dec_jpeg_irq_status(struct cedrus_context *ctx)
+{
+	struct cedrus_device *dev = ctx->proc->dev;
+	u32 status;
+
+	status = cedrus_read(dev, VE_DEC_MPEG_STATUS);
+	status &= VE_DEC_MPEG_STATUS_CHECK_MASK;
+
+	if (!status)
+		return CEDRUS_IRQ_NONE;
+
+	if (status & VE_DEC_MPEG_STATUS_CHECK_ERROR)
+		return CEDRUS_IRQ_ERROR;
+
+	return CEDRUS_IRQ_SUCCESS;
+}
+
+static void cedrus_dec_jpeg_irq_clear(struct cedrus_context *ctx)
+{
+	struct cedrus_device *dev = ctx->proc->dev;
+
+	cedrus_write(dev, VE_DEC_MPEG_STATUS, VE_DEC_MPEG_STATUS_CHECK_MASK);
+}
+
+static void cedrus_dec_jpeg_irq_disable(struct cedrus_context *ctx)
+{
+	struct cedrus_device *dev = ctx->proc->dev;
+	u32 value;
+
+	value = cedrus_read(dev, VE_DEC_MPEG_CTRL);
+	value &= ~VE_DEC_MPEG_CTRL_IRQ_MASK;
+
+	cedrus_write(dev, VE_DEC_MPEG_CTRL, value);
+}
+
+/* Engine */
+
+static const struct cedrus_engine_ops cedrus_dec_jpeg_ops = {
+	.format_prepare		= cedrus_dec_format_coded_prepare,
+	.format_configure	= cedrus_dec_format_coded_configure,
+
+	.job_configure		= cedrus_dec_jpeg_job_configure,
+	.job_trigger		= cedrus_dec_jpeg_job_trigger,
+
+	.irq_status		= cedrus_dec_jpeg_irq_status,
+	.irq_clear		= cedrus_dec_jpeg_irq_clear,
+	.irq_disable		= cedrus_dec_jpeg_irq_disable,
+};
+
+static const struct v4l2_frmsize_stepwise cedrus_dec_jpeg_frmsize = {
+	.min_width	= 16,
+	.max_width	= 6144,
+	.step_width	= 16,
+
+	.min_height	= 16,
+	.max_height	= 6144,
+	.step_height	= 16,
+};
+
+const struct cedrus_engine cedrus_dec_jpeg = {
+	.codec			= CEDRUS_CODEC_JPEG,
+	.role			= CEDRUS_ROLE_DECODER,
+	.capabilities		= CEDRUS_CAPABILITY_JPEG_DEC |
+				  CEDRUS_CAPABILITY_UNTILED,
+
+	.ops			= &cedrus_dec_jpeg_ops,
+
+	.pixelformat		= V4L2_PIX_FMT_JPEG,
+	.parses_header		= true,
+	.pixelformat_picture	= V4L2_PIX_FMT_NV12,
+	.frmsize		= &cedrus_dec_jpeg_frmsize,
+
