+/* An engine reading its own headers drains as a stateful decoder. */
+static int cedrus_proc_decoder_cmd(struct file *file, void *private,
+				   struct v4l2_decoder_cmd *cmd)
+{
+	struct cedrus_context *ctx =
+		container_of(file->private_data, struct cedrus_context,
+			     v4l2.fh);
+
+	if (ctx->engine->parses_header) {
+		if (cmd->cmd == V4L2_DEC_CMD_STOP)
+			cedrus_proc_stop_empty_prepare(ctx);
+
+		return v4l2_m2m_ioctl_decoder_cmd(file, private, cmd);
+	}
+
+	return v4l2_m2m_ioctl_stateless_decoder_cmd(file, private, cmd);
+}
+
+static int cedrus_proc_try_decoder_cmd(struct file *file, void *private,
+				       struct v4l2_decoder_cmd *cmd)
+{
+	struct cedrus_context *ctx =
+		container_of(file->private_data, struct cedrus_context,
+			     v4l2.fh);
+
+	if (ctx->engine->parses_header)
+		return v4l2_m2m_ioctl_try_decoder_cmd(file, private, cmd);
+
+	return v4l2_m2m_ioctl_stateless_try_decoder_cmd(file, private, cmd);
+}
