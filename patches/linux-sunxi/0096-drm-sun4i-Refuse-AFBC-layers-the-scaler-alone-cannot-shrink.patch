From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Artem Butusov <art.sormy@gmail.com>
Date: Tue, 28 Oct 2026 09:00:00 -0400
Subject: [PATCH] drm/sun4i: Refuse AFBC layers the scaler alone cannot shrink

When the VI scaler cannot keep up with a downscale in the current mode,
atomic_update falls back on the fetcher's coarse scaling. AFBC bypasses
the coarse stage, so an AFBC layer the scaler cannot keep up with, or
wider than the channel's line buffer, is programmed anyway: the scaler
falls behind, the picture is clean at the top and garbage below.

Check it in atomic_check instead, so a commit the hardware cannot scan
out fails and userspace can fall back to a linear buffer. The scaler
takes a source pixel a clock: an output line's source pixels, the wider
width times the shrink, must fit in 90% of the mixer clocks of its line
time. On DE33 at 696 MHz, 3840x2160 onto 1269 lines of 2256x1504@60
needs 87% and scans out with no TCON underflow; at 600 MHz it needs
101% and breaks up. A 1:1 AFBC layer still passes.
---
diff -urN a/drivers/gpu/drm/sun4i/sun8i_vi_layer.c b/drivers/gpu/drm/sun4i/sun8i_vi_layer.c
--- a/drivers/gpu/drm/sun4i/sun8i_vi_layer.c
+++ b/drivers/gpu/drm/sun4i/sun8i_vi_layer.c
@@ -66,6 +66,63 @@
 	}
 }
 
+/* The share of a line time an AFBC layer's scaler may use, in percent */
+#define SUN8I_VI_AFBC_SCALER_LOAD	90
+
+/*
+ * The scaler takes a source pixel a clock, so an output line's source pixels
+ * must fit in the clocks of its line time, with a margin.
+ */
+static bool sun8i_vi_layer_afbc_shrink_fits(struct sun8i_mixer *mixer,
+					    const struct drm_display_mode *mode,
+					    u32 width, u32 src_h, u32 dst_h)
+{
+	u64 needed = (u64)width * src_h * 100;
+	u64 available = (u64)clk_get_rate(mixer->mod_clk) * mode->htotal *
+			SUN8I_VI_AFBC_SCALER_LOAD * dst_h;
+
+	return needed <= div_u64(available, mode->clock * 1000ULL);
+}
+
+/*
+ * AFBC bypasses the coarse scaling atomic_update falls back on: refuse what
+ * the scaler alone cannot keep up with, so userspace picks a linear buffer.
+ */
+static int sun8i_vi_layer_check_afbc_scale(struct sun8i_layer *layer,
+					   struct drm_plane_state *state,
+					   struct drm_crtc_state *crtc_state)
+{
+	struct sun4i_crtc *scrtc = drm_crtc_to_sun4i_crtc(state->crtc);
+	struct sun8i_mixer *mixer = engine_to_sun8i_mixer(scrtc->engine);
+	const struct drm_format_info *format = state->fb->format;
+	u32 src_w = drm_rect_width(&state->src) >> 16;
+	u32 src_h = drm_rect_height(&state->src) >> 16;
+	u32 dst_w = drm_rect_width(&state->dst);
+	u32 dst_h = drm_rect_height(&state->dst);
+	unsigned int scanline;
+
+	if (format->hsub > 1 || format->vsub > 1)
+		scanline = layer->cfg->scanline_yuv[layer->channel];
+	else
+		scanline = layer->cfg->scanline_rgb[layer->channel];
+
+	if (src_w > scanline) {
+		DRM_DEBUG_DRIVER("AFBC: %u wide past the %u-pixel line buffer\n",
+				 src_w, scanline);
+		return -EINVAL;
+	}
+
+	if (src_h > dst_h &&
+	    !sun8i_vi_layer_afbc_shrink_fits(mixer, &crtc_state->mode,
+					     max(src_w, dst_w), src_h, dst_h)) {
+		DRM_DEBUG_DRIVER("AFBC: %u to %u lines past the scaler alone\n",
+				 src_h, dst_h);
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
 static void sun8i_vi_layer_update_coord(struct sun8i_layer *layer,
 					struct drm_plane *plane, bool afbc)
 {
@@ -284,10 +341,15 @@
 		max_scale = SUN8I_VI_SCALER_SCALE_MAX;
 	}
 
-	return drm_atomic_helper_check_plane_state(new_plane_state,
-						   crtc_state,
-						   min_scale, max_scale,
-						   true, true);
+	ret = drm_atomic_helper_check_plane_state(new_plane_state, crtc_state,
+						  min_scale, max_scale,
+						  true, true);
+	if (ret || !new_plane_state->visible ||
+	    !drm_is_afbc(new_plane_state->fb->modifier))
+		return ret;
+
+	return sun8i_vi_layer_check_afbc_scale(layer, new_plane_state,
+					       crtc_state);
 }
 
 static void sun8i_vi_layer_atomic_disable(struct drm_plane *plane,
