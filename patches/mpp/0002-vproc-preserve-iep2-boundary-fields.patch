From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Artem Butusov <art.sormy@gmail.com>
Date: Sun, 22 Nov 2026 00:00:00 +0000
Subject: [PATCH] vproc: preserve IEP2 boundary fields

Use spatial deinterlacing where the temporal window is incomplete.
Drain the last source picture before emitting EOS or a format change.

Signed-off-by: Artem Butusov <art.sormy@gmail.com>
---
diff --git a/mpp/vproc/mpp_dec_vproc.c b/mpp/vproc/mpp_dec_vproc.c
index daf0741..211e7b2 100644
--- a/mpp/vproc/mpp_dec_vproc.c
+++ b/mpp/vproc/mpp_dec_vproc.c
@@ -569,6 +569,10 @@ MPP_RET dec_vproc_output_dei_v2(MppDecVprocCtxImpl *ctx, MppFrame frm, RK_U32 is
                 ctx->out_buf0 = NULL;
             }
         } else {
+            if (ctx->vproc_mode == MPP_VPROC_MODE_DEINTELACE) {
+                first_pts = curr_pts;
+                curr_pts += (mpp_frame_get_pts(frm) - curr_pts) / 2;
+            }
             RK_U32 fo_from_syntax = ((mode & MPP_FRAME_FLAG_TOP_FIRST) != 0) ? 1 : 0;
             RK_U32 fo_from_iep = (ctx->dei_info.dil_order == IEP2_FIELD_ORDER_UND) ?
                                  fo_from_syntax : (ctx->dei_info.dil_order == IEP2_FIELD_ORDER_TFF);
@@ -625,6 +629,9 @@ MPP_RET dec_vproc_output_dei_v2(MppDecVprocCtxImpl *ctx, MppFrame frm, RK_U32 is
     return ret;
 }
 
+static void dec_vproc_output_spatial_pair(MppDecVprocCtxImpl *ctx, MppFrame frm,
+                                       RK_S64 pts, RK_S64 half_step);
+
 static MPP_RET dec_vproc_dei_v2_deinterlace(MppDecVprocCtxImpl *ctx, MppFrame frm)
 {
     MPP_RET ret = MPP_OK;
@@ -659,31 +666,10 @@ static MPP_RET dec_vproc_dei_v2_deinterlace(MppDecVprocCtxImpl *ctx, MppFrame fr
         else
             ctx->pd_mode = 1;
 
-    } else if (ctx->prev_frm0 && ! ctx->prev_frm1) {
-        vproc_dbg_status("Wait for next frame to turn into I5O2");
-
-        if (ctx->out_buf0) {
-            mpp_buffer_put(ctx->out_buf0);
-            ctx->out_buf0 = NULL;
-        }
-
-        if (ctx->out_buf1) {
-            mpp_buffer_put(ctx->out_buf1);
-            ctx->out_buf1 = NULL;
-        }
-    } else {
-        // 2 in 1 out case
-        vproc_dbg_status("2 field in and 1 frame out\n");
-        dil_mode = IEP2_DIL_MODE_I1O1T;
-
-        dec_vproc_config_dei_v2(ctx, frm, dil_mode);
-
-        mode = mode | MPP_FRAME_FLAG_IEP_DEI_I2O1;
-        mpp_frame_set_mode(frm, mode);
-        // start hardware
-        ctx->start_dei((MppDecVprocCtx *)ctx, mode);
-
-        dec_vproc_output_dei_v2(ctx, frm, 0);
+    } else if (ctx->prev_frm0) {
+        RK_S64 prev_pts = mpp_frame_get_pts(ctx->prev_frm0);
+        RK_S64 half_step = (mpp_frame_get_pts(frm) - prev_pts) / 2;
+        dec_vproc_output_spatial_pair(ctx, ctx->prev_frm0, prev_pts, half_step);
     }
 
     return ret;
@@ -815,22 +801,62 @@ MPP_RET dec_vproc_update_ref_v2(MppDecVprocCtx *vproc_ctx, MppFrame frm, RK_U32
     return ret;
 }
 
-static MPP_RET dec_vproc_update_ref(MppDecVprocCtxImpl *ctx, MppFrame frm, RK_U32 index, RK_U32 eos)
+static void dec_vproc_output_spatial_pair(MppDecVprocCtxImpl *ctx, MppFrame frm,
+                                       RK_S64 pts, RK_S64 half_step)
 {
-    MPP_RET ret = MPP_OK;
-    Mpp *mpp = ctx->mpp;
+    RK_U32 mode = mpp_frame_get_mode(frm);
+    RK_U32 error = mpp_frame_get_errinfo(frm) || mpp_frame_get_discard(frm);
+    RK_U32 first = (mode & MPP_FRAME_FLAG_TOP_FIRST) ? 0 : 1;
+    MppBuffer buffers[2] = { ctx->out_buf0, ctx->out_buf1 };
+    MPP_RET ret = dec_vproc_config_dei_v2(ctx, frm, IEP2_DIL_MODE_I2O2);
 
-    ret = ctx->update_ref((MppDecVprocCtx *)ctx, frm, index);
+    if (!ret)
+        ret = ctx->start_dei((MppDecVprocCtx *)ctx, mode);
+    if (ret)
+        return;
+
+    dec_vproc_put_frame(ctx->mpp, frm, buffers[first], pts, error);
+    dec_vproc_put_frame(ctx->mpp, frm, buffers[1 - first], pts + half_step, error);
+    ctx->out_buf0 = NULL;
+    ctx->out_buf1 = NULL;
+}
+
+static RK_U32 dec_vproc_has_tail(MppDecVprocCtxImpl *ctx)
+{
+    if (ctx->reset || ctx->set_dei != dec_vproc_set_dei_v2 ||
+        ctx->vproc_mode != MPP_VPROC_MODE_DEINTELACE || ctx->pd_mode ||
+        !ctx->prev_frm0)
+        return 0;
+
+    RK_U32 mode = mpp_frame_get_mode(ctx->prev_frm0);
+    return ((mode & MPP_FRAME_FLAG_PAIRED_FIELD) != MPP_FRAME_FLAG_FRAME) ||
+           (mode & MPP_FRAME_FLAG_FIELD_ORDER_MASK);
+}
 
-    if (eos) {
-        mpp_frame_init(&frm);
-        mpp_frame_set_eos(frm, eos);
-        vproc_dbg_out("output at update ref, frame poc %d\n", mpp_frame_get_poc(frm));
-        dec_vproc_put_frame(mpp, frm, NULL, -1, 0);
-        dec_vproc_clr_prev(ctx);
-        mpp_frame_deinit(&frm);
+static void dec_vproc_drain_tail(MppDecVprocCtxImpl *ctx)
+{
+    RK_S64 pts = mpp_frame_get_pts(ctx->prev_frm0);
+    RK_S64 half_step = 0;
+
+    if (ctx->prev_frm1) {
+        RK_S64 prev_pts = mpp_frame_get_pts(ctx->prev_frm1);
+        if (pts > prev_pts)
+            half_step = (pts - prev_pts) / 2;
     }
-    return ret;
+
+    dec_vproc_output_spatial_pair(ctx, ctx->prev_frm0, pts, half_step);
+}
+
+static RK_U32 dec_vproc_prepare_output(MppDecVprocCtxImpl *ctx, MppFrame frm)
+{
+    size_t size = mpp_buffer_get_size(mpp_frame_get_buffer(frm));
+
+    if (!ctx->out_buf0)
+        mpp_buffer_get(ctx->mpp->mFrameGroup, &ctx->out_buf0, size);
+    if (ctx->out_buf0 && !ctx->out_buf1)
+        mpp_buffer_get(ctx->mpp->mFrameGroup, &ctx->out_buf1, size);
+
+    return ctx->out_buf0 && ctx->out_buf1;
 }
 
 static void *dec_vproc_thread(void *data)
@@ -843,6 +869,7 @@ static void *dec_vproc_thread(void *data)
     MppBufSlots slots = dec->frame_slots;
 
     HalTaskHnd task = NULL;
+    RK_U32 drain_pending = 0;
     HalTaskInfo task_info;
     HalDecVprocTask *task_vproc = &task_info.dec_vproc;
 
@@ -898,7 +925,16 @@ static void *dec_vproc_thread(void *data)
             RK_U32 change = task_vproc->flags.info_change;
             MppFrame frm = NULL;
 
-            if (eos && index < 0) {
+            RK_U32 drain_eos = eos && (index < 0 || drain_pending);
+            if ((drain_eos || change) && dec_vproc_has_tail(ctx)) {
+                if (!dec_vproc_prepare_output(ctx, ctx->prev_frm0)) {
+                    ctx->task_wait.task_buf_in = 1;
+                    continue;
+                }
+                dec_vproc_drain_tail(ctx);
+            }
+
+            if (drain_eos) {
                 vproc_dbg_status("eos signal\n");
 
                 mpp_frame_init(&frm);
@@ -909,13 +945,24 @@ static void *dec_vproc_thread(void *data)
                 mpp_frame_deinit(&frm);
 
                 hal_task_hnd_set_status(task, TASK_IDLE);
-                ctx->task_status.task_rdy = 0;
+                ctx->task_status.val = 0;
+                ctx->task_wait.val = 0;
+                drain_pending = 0;
                 continue;
             }
 
             mpp_buf_slot_get_prop(slots, index, SLOT_FRAME_PTR, &frm);
 
             if (change) {
+                if (ctx->out_buf0) {
+                    mpp_buffer_put(ctx->out_buf0);
+                    ctx->out_buf0 = NULL;
+                }
+                if (ctx->out_buf1) {
+                    mpp_buffer_put(ctx->out_buf1);
+                    ctx->out_buf1 = NULL;
+                }
+
                 vproc_dbg_status("info change\n");
                 vproc_dbg_out("output at info change, frame poc %d\n", mpp_frame_get_poc(frm));
                 dec_vproc_put_frame(mpp, frm, NULL, -1, 0);
@@ -925,29 +972,15 @@ static void *dec_vproc_thread(void *data)
                     ctx->com_ctx->ops->reset(ctx->iep_ctx);
 
                 hal_task_hnd_set_status(task, TASK_IDLE);
-                ctx->task_status.task_rdy = 0;
+                ctx->task_status.val = 0;
+                ctx->task_wait.val = 0;
                 continue;
             }
             vproc_dbg_status("vproc get buf in");
             if (!ctx->task_status.buf_rdy && !ctx->reset) {
-                MppBuffer buf = mpp_frame_get_buffer(frm);
-                size_t buf_size = mpp_buffer_get_size(buf);
-
-                if (!ctx->out_buf0) {
-                    mpp_buffer_get(mpp->mFrameGroup, &ctx->out_buf0, buf_size);
-                    vproc_dbg_out("get out buf0 ptr %p\n", mpp_buffer_get_ptr(ctx->out_buf0));
-                    if (NULL == ctx->out_buf0) {
-                        ctx->task_wait.task_buf_in = 1;
-                        continue;
-                    }
-                }
-                if (!ctx->out_buf1) {
-                    mpp_buffer_get(mpp->mFrameGroup, &ctx->out_buf1, buf_size);
-                    vproc_dbg_out("get out buf1 ptr %p\n", mpp_buffer_get_ptr(ctx->out_buf1));
-                    if (NULL == ctx->out_buf1) {
-                        ctx->task_wait.task_buf_in = 1;
-                        continue;
-                    }
+                if (!dec_vproc_prepare_output(ctx, frm)) {
+                    ctx->task_wait.task_buf_in = 1;
+                    continue;
                 }
                 ctx->task_status.buf_rdy = 1;
             }
@@ -964,7 +997,12 @@ static void *dec_vproc_thread(void *data)
                 ctx->set_dei((MppDecVprocCtx *)ctx, frm);
             }
 
-            dec_vproc_update_ref(ctx, frm, index, eos);
+            ctx->update_ref((MppDecVprocCtx *)ctx, frm, index);
+            if (eos) {
+                drain_pending = 1;
+                ctx->task_wait.val = 0;
+                continue;
+            }
             hal_task_hnd_set_status(task, TASK_IDLE);
             ctx->task_status.val = 0;
             ctx->task_wait.val = 0;
