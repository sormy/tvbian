From 49aec6bb0537be1b63272bfb15317ece42a468d6 Mon Sep 17 00:00:00 2001
From: David Turner <david.turner@raspberrypi.com>
Date: Mon, 12 May 2025 15:30:46 +0100
Subject: [PATCH] alloc: Speed up is_layer_allocated()

When you have lots of planes, is_layer_allocated() starts to eat
significant amounts of time, gprof shows 50% of time going into
is_layer_allocated in one case.  After this patch, is_layer_allocated()
takes negligible time.

Adds an array of bools in alloc_step used to keep track of whether each
layer is allocated in the current step.  The array ordering/length
corresponds to the output->layers list.
---
 alloc.c | 44 +++++++++++++++++++++++++++++---------------
 1 file changed, 29 insertions(+), 15 deletions(-)

diff --git a/alloc.c b/alloc.c
index 6fd3205..1a59841 100644
--- a/alloc.c
+++ b/alloc.c
@@ -92,6 +92,10 @@ struct alloc_step {
 	size_t plane_idx;
 
 	struct liftoff_layer **alloc; /* only items up to plane_idx are valid */
+
+	/* Is layer allocated? Ordering/length match the output->layers list */
+	bool *layer_allocated;
+
 	int score; /* number of allocated layers */
 	int last_layer_zpos;
 	int primary_layer_zpos, primary_plane_zpos;
@@ -150,6 +154,7 @@ plane_step_init_next(struct alloc_step *step, struct alloc_step *prev,
 	step->plane_link = prev->plane_link->next;
 	step->plane_idx = prev->plane_idx + 1;
 	step->alloc = prev->alloc;
+	step->layer_allocated = prev->layer_allocated;
 	step->alloc[prev->plane_idx] = layer;
 
 	if (check_plane_output_compatible(plane, output)) {
@@ -204,18 +209,9 @@ plane_step_init_next(struct alloc_step *step, struct alloc_step *prev,
 }
 
 static bool
-is_layer_allocated(struct alloc_step *step, struct liftoff_layer *layer)
+is_layer_allocated(struct alloc_step *step, int layer_id)
 {
-	size_t i;
-
-	/* TODO: speed this up with an array of bools indicating whether a layer
-	 * has been allocated */
-	for (i = 0; i < step->plane_idx; i++) {
-		if (step->alloc[i] == layer) {
-			return true;
-		}
-	}
-	return false;
+	return step->layer_allocated[layer_id];
 }
 
 static bool
@@ -224,6 +220,7 @@ has_composited_layer_over(struct liftoff_output *output,
 {
 	struct liftoff_layer *other_layer;
 	struct liftoff_layer_property *zpos_prop, *other_zpos_prop;
+	int other_layer_id = -1;
 
 	zpos_prop = layer_get_core_property(layer, LIFTOFF_PROP_ZPOS);
 	if (zpos_prop == NULL) {
@@ -231,7 +228,9 @@ has_composited_layer_over(struct liftoff_output *output,
 	}
 
 	liftoff_list_for_each(other_layer, &output->layers, link) {
-		if (is_layer_allocated(step, other_layer)) {
+		other_layer_id++;
+
+		if (is_layer_allocated(step, other_layer_id)) {
 			continue;
 		}
 
@@ -331,6 +330,7 @@ has_allocated_plane_under(struct liftoff_output *output,
 static bool
 check_layer_plane_compatible(struct alloc_step *step,
 			     struct liftoff_layer *layer,
+			     int layer_id,
 			     struct liftoff_plane *plane)
 {
 	struct liftoff_output *output;
@@ -339,7 +339,7 @@ check_layer_plane_compatible(struct alloc_step *step,
 	output = layer->output;
 
 	/* Skip this layer if already allocated */
-	if (is_layer_allocated(step, layer)) {
+	if (is_layer_allocated(step, layer_id)) {
 		return false;
 	}
 
@@ -459,6 +459,7 @@ output_choose_layers(struct liftoff_output *output, struct alloc_result *result,
 	struct liftoff_device *device;
 	struct liftoff_plane *plane;
 	struct liftoff_layer *layer;
+	int layer_id = -1; /* Index into step->layer_allocated */
 	int cursor, ret;
 	int best_possible_score;
 	struct alloc_step next_step = {0};
@@ -494,13 +495,15 @@ output_choose_layers(struct liftoff_output *output, struct alloc_result *result,
 		    step->log_prefix, plane->id, step->plane_idx + 1, result->planes_len);
 
 	liftoff_list_for_each(layer, &output->layers, link) {
+		layer_id++;
+
 		if (layer->plane != NULL) {
 			continue;
 		}
 		if (!layer_is_visible(layer)) {
 			continue;
 		}
-		if (!check_layer_plane_compatible(step, layer, plane)) {
+		if (!check_layer_plane_compatible(step, layer, layer_id, plane)) {
 			continue;
 		}
 
@@ -548,9 +551,18 @@ output_choose_layers(struct liftoff_output *output, struct alloc_result *result,
 			liftoff_log(LIFTOFF_DEBUG,
 				    "%s Layer %p -> plane %"PRIu32": success",
 				    step->log_prefix, (void *)layer, plane->id);
+
+			/* Mark the layer we just allocated */
+			step->layer_allocated[layer_id] = true;
+
 			/* Continue with the next plane */
 			plane_step_init_next(&next_step, step, layer, output);
 			ret = output_choose_layers(output, result, &next_step);
+
+			/* When we get here we're backtracking so need to clear
+			 * the layer we just marked as allocated. */
+			step->layer_allocated[layer_id] = false;
+
 			if (ret != 0) {
 				return ret;
 			}
@@ -1075,7 +1087,8 @@ liftoff_output_apply(struct liftoff_output *output, drmModeAtomicReq *req,
 
 	step.alloc = malloc(result.planes_len * sizeof(step.alloc[0]));
 	result.best = malloc(result.planes_len * sizeof(result.best[0]));
-	if (step.alloc == NULL || result.best == NULL) {
+	step.layer_allocated = calloc(liftoff_list_length(&output->layers), sizeof(bool));
+	if (step.alloc == NULL || result.best == NULL || step.layer_allocated == NULL) {
 		liftoff_log_errno(LIFTOFF_ERROR, "malloc");
 		ret = -ENOMEM;
 		goto error;
@@ -1151,6 +1164,7 @@ liftoff_output_apply(struct liftoff_output *output, drmModeAtomicReq *req,
 
 	free(step.alloc);
 	free(result.best);
+	free(step.layer_allocated);
 
 	mark_layers_clean(output);
 
-- 
