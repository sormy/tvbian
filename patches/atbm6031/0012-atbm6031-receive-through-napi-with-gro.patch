 	} while (0)	
 	CALL_RXSPECAL(ieee80211_deliver_special_pae);
 	CALL_RXSPECAL(ieee80211_deliver_special_dhcp);
+#ifdef CONFIG_ATBM_SUPPORT_GRO
+	CALL_RXSPECAL(ieee80211_deliver_special_napi);
+#endif
 	
 	return false;
 handle:	
@@ -4116,3 +4129,23 @@ void ieee80211_rx_irqsafe(struct ieee80211_hw *hw, struct sk_buff *skb)
 		tasklet_schedule(&local->tasklet);
 }
 //EXPORT_SYMBOL(ieee80211_rx_irqsafe);
+#ifdef CONFIG_ATBM_SUPPORT_GRO
+int ieee80211_rx_napi_poll(struct napi_struct *napi, int budget)
+{
+	struct ieee80211_sub_if_data *sdata = container_of(napi, struct ieee80211_sub_if_data, napi_rx);
+	struct sk_buff *skb;
+	int done = 0;
+
+	while (done < budget && (skb = atbm_skb_dequeue(&sdata->napi_rx_list))) {
+		atbm_napi_gro_receive(napi, skb);
+		done++;
+	}
+
+	/* a frame queued after the last dequeue would otherwise wait for the next RX pass */
+	if (done < budget && napi_complete_done(napi, done) &&
+	    !atbm_skb_queue_empty(&sdata->napi_rx_list))
+		napi_schedule(napi);
+
+	return done;
+}
+#endif
