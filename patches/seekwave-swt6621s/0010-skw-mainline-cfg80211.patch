@@ -849,7 +849,7 @@ int skw_mlme_ap_rx_mgmt(struct skw_iface *iface, u16 fc, int freq,
 
 		if (client->state >= SKW_STATE_ASSOCED) {
 			//notify hostapd to update state and delete sta
-			cfg80211_del_sta(iface->ndev, client->addr, GFP_KERNEL);
+			skw_compat_del_sta(&iface->wdev, client->addr, GFP_KERNEL);
 		} else if (client->state >= SKW_STATE_AUTHED) {
 			//just delete local sta info
 			skw_mlme_ap_del_sta(iface->wdev.wiphy,
diff --git a/drivers/swt6621s_wifi/skw_msg.c b/drivers/swt6621s_wifi/skw_msg.c
index b7aa9f3..f5f4023 100644
--- a/drivers/swt6621s_wifi/skw_msg.c
+++ b/drivers/swt6621s_wifi/skw_msg.c
@@ -660,7 +660,7 @@ void skw_del_sta_event(struct skw_iface *iface, const u8 *addr, u16 reason)
 				 -5400, (void *)&mgmt,
 				 SKW_DEAUTH_FRAME_LEN, 0, GFP_ATOMIC);
 	} else {
-		cfg80211_del_sta(iface->ndev, addr, GFP_KERNEL);
+		skw_compat_del_sta(&iface->wdev, addr, GFP_KERNEL);
 	}
 }
 
diff --git a/drivers/swt6621s_wifi/skw_recovery.c b/drivers/swt6621s_wifi/skw_recovery.c
index f68579c..5670f35 100644
--- a/drivers/swt6621s_wifi/skw_recovery.c
+++ b/drivers/swt6621s_wifi/skw_recovery.c
@@ -89,7 +89,7 @@ static int skw_recovery_sta(struct wiphy *wiphy, struct skw_recovery_data *rd,
 			continue;
 
