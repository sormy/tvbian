From: Artem Butusov <art.sormy@gmail.com>
Subject: [PATCH] skw: use mainline namespace and bounded-copy APIs

Mainline takes string namespace names and no longer exports strncpy.
Keep the fixed-width copy and padding with strscpy_pad, which every
kernel the driver builds for has.

Signed-off-by: Artem Butusov <art.sormy@gmail.com>

diff --git a/drivers/seekwaveplatform_lite/sdio/skw_sdio_rx.c b/drivers/seekwaveplatform_lite/sdio/skw_sdio_rx.c
index 62e0098..0f07eba 100644
--- a/drivers/seekwaveplatform_lite/sdio/skw_sdio_rx.c
+++ b/drivers/seekwaveplatform_lite/sdio/skw_sdio_rx.c
@@ -825,10 +825,10 @@ static int skw_sdio_handle_packet(struct skw_sdio_data_t *skw_sdio,
 		}else if (!strncmp("trunk_W", cmd, 7)) {
 			memset(firmware_version, 0 , sizeof(firmware_version));
 			if (strlen(cmd) > strlen(firmware_version)) {
-				strncpy(firmware_version, cmd, sizeof(firmware_version)-1);
+				memcpy_and_pad(firmware_version, sizeof(firmware_version)-1, cmd, strnlen(cmd, sizeof(firmware_version)-1), 0);
 				firmware_version[sizeof(firmware_version)-1] = '\0';
 			} else {
-				strncpy(firmware_version, cmd, strlen(cmd));
+				memcpy_and_pad(firmware_version, strlen(cmd), cmd, strnlen(cmd, strlen(cmd)), 0);
 				//strcpy(firmware_version, cmd);
 			}
 			cmd = strstr(firmware_version, "slp=");
@@ -1054,10 +1054,10 @@ static int skw_sdio2_handle_packet(struct skw_sdio_data_t *skw_sdio,
 		}else if (!strncmp("trunk_W", cmd, 7)) {
 			memset(firmware_version, 0 , sizeof(firmware_version));
 			if (strlen(cmd) > strlen(firmware_version)) {
-				strncpy(firmware_version, cmd, sizeof(firmware_version)-1);
+				memcpy_and_pad(firmware_version, sizeof(firmware_version)-1, cmd, strnlen(cmd, sizeof(firmware_version)-1), 0);
 				firmware_version[sizeof(firmware_version)-1] = '\0';
 			} else {
-				strncpy(firmware_version, cmd, strlen(cmd));
+				memcpy_and_pad(firmware_version, strlen(cmd), cmd, strnlen(cmd, strlen(cmd)), 0);
 				//strcpy(firmware_version, cmd);
 			}
 			cmd = strstr(firmware_version, "slp=");
