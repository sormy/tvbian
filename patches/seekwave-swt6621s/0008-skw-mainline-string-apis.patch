diff --git a/drivers/swt6621s_wifi/skw_config.c b/drivers/swt6621s_wifi/skw_config.c
index 64401ad..fd6dd2f 100644
--- a/drivers/swt6621s_wifi/skw_config.c
+++ b/drivers/swt6621s_wifi/skw_config.c
@@ -812,14 +812,12 @@ void skw_config_init(struct skw_config *conf)
 
 #ifdef CONFIG_SWT6621S_CHIP_ID
 	if (strlen(CONFIG_SWT6621S_CHIP_ID))
-		strncpy(conf->calib.chip_alias_name, CONFIG_SWT6621S_CHIP_ID,
-			sizeof(conf->calib.chip_alias_name) - 1);
+		memcpy_and_pad(conf->calib.chip_alias_name, sizeof(conf->calib.chip_alias_name) - 1, CONFIG_SWT6621S_CHIP_ID, strnlen(CONFIG_SWT6621S_CHIP_ID, sizeof(conf->calib.chip_alias_name) - 1), 0);
 #endif
 
 #ifdef CONFIG_SWT6621S_PROJECT_NAME
 	if (strlen(CONFIG_SWT6621S_PROJECT_NAME))
-		strncpy(conf->calib.project, CONFIG_SWT6621S_PROJECT_NAME,
-			sizeof(conf->calib.project) - 1);
+		memcpy_and_pad(conf->calib.project, sizeof(conf->calib.project) - 1, CONFIG_SWT6621S_PROJECT_NAME, strnlen(CONFIG_SWT6621S_PROJECT_NAME, sizeof(conf->calib.project) - 1), 0);
 #endif
 
 	set_bit(SKW_CFG_WOWLAN_SUPPORT, &conf->wowlan.flags);
diff --git a/drivers/swt6621s_wifi/skw_iw.c b/drivers/swt6621s_wifi/skw_iw.c
index dc79b22..730ac87 100644
--- a/drivers/swt6621s_wifi/skw_iw.c
+++ b/drivers/swt6621s_wifi/skw_iw.c
@@ -1012,7 +1012,7 @@ int skw_wow_filter_set(struct net_device *dev, u8 *param, int len, char *resp,
 
 		//Store the temp rule
 		memset(t_rule, 0, SKW_MAX_WOW_USER_RULE_LEN);
-		strncpy(t_rule, param, min_t(int, SKW_MAX_WOW_USER_RULE_LEN, len));
+		memcpy_and_pad(t_rule, min_t(int, SKW_MAX_WOW_USER_RULE_LEN, len), param, strnlen(param, min_t(int, SKW_MAX_WOW_USER_RULE_LEN, len)), 0);
 
 		//Translate the wow filter to skw rules
 		rule = &wow_rules_set.rules[rule_idx];
@@ -1205,7 +1205,7 @@ int skw_wow_filter_set(struct net_device *dev, u8 *param, int len, char *resp,
 		//Store the rule
 		wow_user_rules.en_bitmap |=  (1ULL << rule_idx);
 		memset(wow_user_rules.rules[rule_idx], 0, SKW_MAX_WOW_USER_RULE_LEN);
-		strncpy(wow_user_rules.rules[rule_idx], t_rule, SKW_MAX_WOW_USER_RULE_LEN);
+		memcpy_and_pad(wow_user_rules.rules[rule_idx], SKW_MAX_WOW_USER_RULE_LEN, t_rule, strnlen(t_rule, SKW_MAX_WOW_USER_RULE_LEN), 0);
 
 		ret = 0;
 
