diff --git a/include/linux/skw_firmware_helper.h b/include/linux/skw_firmware_helper.h
index dcd6b0f..da5ae11 100644
--- a/include/linux/skw_firmware_helper.h
+++ b/include/linux/skw_firmware_helper.h
@@ -29,7 +29,7 @@ static inline void skw_firmware_board_id_init(char *board_id, size_t size)
 
 	compat = of_get_property(root, "compatible", &len);
 	if (compat && len > 0) {
-		strncpy(board_id, compat, size - 1);
+		memcpy_and_pad(board_id, size - 1, compat, strnlen(compat, size - 1), 0);
 		board_id[size - 1] = '\0';
 		pr_info("skw firmware: board_id from DT compatible: %s\n", board_id);
 	}
