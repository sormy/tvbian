index 39e2e85..c72d8a4 100644
--- a/drivers/seekwaveplatform_lite/usb/skw_usb_io.c
+++ b/drivers/seekwaveplatform_lite/usb/skw_usb_io.c
@@ -1884,7 +1884,7 @@ static int usb_loopcheck_entry(void *para)
 			assert_info_print = 0;
 			modem_status = MODEM_ON;
 			memset(firmware_version, 0 , sizeof(firmware_version));
