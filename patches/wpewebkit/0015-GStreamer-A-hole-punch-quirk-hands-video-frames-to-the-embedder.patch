+#pragma once
+
+#if USE(GSTREAMER)
+
+#include "GStreamerCommon.h"
+#include "GStreamerQuirks.h"
+#include "MediaPlayer.h"
+#include <wtf/text/MakeString.h>
+
+namespace WebCore {
+
+// Video frames go to the embedder, which shows them on a display plane under the page's hole
+class GStreamerHolePunchQuirkTVBian final : public GStreamerHolePunchQuirk {
+public:
+    const ASCIILiteral identifier() const final { return "TVBianHolePunch"_s; }
+
+    GstElement* createHolePunchVideoSink(bool, const MediaPlayer* player) final
+    {
+        auto* sink = makeGStreamerElement("tvbvideoplanesink"_s);
+        if (!sink)
+            return nullptr;
+        if (auto pageIdentifier = player ? player->pageIdentifier() : std::nullopt)
+            g_object_set(sink, "page-id", static_cast<guint64>(pageIdentifier->toUInt64()), nullptr);
+        return sink;
+    }
+
+    bool setHolePunchVideoRectangle(GstElement* sink, const IntRect& rect) final
+    {
+        auto rectangle = makeString(rect.x(), ',', rect.y(), ',', rect.width(), ',', rect.height());
+        g_object_set(sink, "rectangle", rectangle.ascii().data(), nullptr);
+        return true;
+    }
+};
+
+} // namespace WebCore
+
+#endif // USE(GSTREAMER)
--- a/Source/WebKit/WebProcess/WebPage/CoordinatedGraphics/AcceleratedSurface.cpp
+++ b/Source/WebKit/WebProcess/WebPage/CoordinatedGraphics/AcceleratedSurface.cpp
@@ -1067,6 +1067,10 @@
 bool AcceleratedSurface::isOpaque() const
 {
     ASSERT(RunLoop::isMain());
+    // A video beneath the page shows through its hole
+    static const bool punchesHoles = !!g_getenv("WEBKIT_GST_HOLE_PUNCH_QUIRK");
+    if (punchesHoles)
+        return false;
     Locker locker { m_backgroundColorLock };
     return !m_backgroundColor || m_backgroundColor->isOpaque();
 }
