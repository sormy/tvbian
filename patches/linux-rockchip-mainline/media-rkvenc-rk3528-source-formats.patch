From: Artem Butusov <art.sormy@gmail.com>
Subject: [PATCH] media: rkvenc: The RK3528's source formats

The VEPU540C takes its source in YUV 4:2:0 and 4:2:2, semi-planar,
planar or packed, and in 32-, 24- and 16-bit RGB, which it converts to
BT.601 YCbCr itself, as the vendor's MPP sets it; the driver offered
NV12 alone. Offer them on the RK3528: describe each by the encoder's
format code and its swap of red and blue or U and V and of alpha, lay a
source out by v4l2_format_info(), and program the VEPU540C's video and
JPEG sources from that.

An RGB source is converted to limited range for H.264 and HEVC, whose
sequence headers now say so, and to full range for JPEG, as JFIF has it.

Signed-off-by: Artem Butusov <art.sormy@gmail.com>
---
diff --git a/drivers/media/platform/rockchip/rkvenc/rkvenc-h264.c b/drivers/media/platform/rockchip/rkvenc/rkvenc-h264.c
--- a/drivers/media/platform/rockchip/rkvenc/rkvenc-h264.c
+++ b/drivers/media/platform/rockchip/rkvenc/rkvenc-h264.c
@@ -57,6 +57,7 @@
 	seq->beta_offset = ctx->c.lf_beta;
 	seq->timing = true;
 	seq->fps = ctx->fps ?: 30;
+	seq->bt601_signal = rkvenc_rgb_source(ctx);
 
 	return rkvenc_h264_headers_write(seq, ctx->hdr, RKVENC_HDR_MAX);
 }
diff --git a/drivers/media/platform/rockchip/rkvenc/rkvenc-hevc.c b/drivers/media/platform/rockchip/rkvenc/rkvenc-hevc.c
--- a/drivers/media/platform/rockchip/rkvenc/rkvenc-hevc.c
+++ b/drivers/media/platform/rockchip/rkvenc/rkvenc-hevc.c
@@ -43,6 +43,7 @@
 	seq->beta_offset = ctx->c.hevc_beta_offset;
 	seq->tc_offset = ctx->c.hevc_tc_offset;
 	seq->strong_intra_smoothing = ctx->c.hevc_strong_intra;
+	seq->bt601_signal = rkvenc_rgb_source(ctx);
 	seq->cabac_init_present = ctx->c.hevc_cabac_init;
 
 	return rkvenc_hevc_headers_write(seq, ctx->hdr, RKVENC_HDR_MAX);
diff --git a/drivers/media/platform/rockchip/rkvenc/rkvenc-nal.c b/drivers/media/platform/rockchip/rkvenc/rkvenc-nal.c
--- a/drivers/media/platform/rockchip/rkvenc/rkvenc-nal.c
+++ b/drivers/media/platform/rockchip/rkvenc/rkvenc-nal.c
@@ -6,6 +6,10 @@
 
 #include "rkvenc-nal.h"
 
+#define VUI_VIDEO_FORMAT_UNSPECIFIED	5
+#define VUI_UNSPECIFIED			2
+#define VUI_MATRIX_BT601		6
+
 #define NAL_RBSP_MAX		256
 
 #define H264_NAL_SPS		7
@@ -89,9 +93,27 @@
 	return pos;
 }
 
+/*
+ * video_signal_type: limited range, BT.601 matrix, primaries and transfer
+ * unspecified; what the encoder makes of an RGB source.
+ */
+static void vui_bt601_write(struct nal_bw *bw)
+{
+	bw_put(bw, VUI_VIDEO_FORMAT_UNSPECIFIED, 3);
+	bw_put(bw, 0, 1);
+	bw_put(bw, 1, 1);
+	bw_put(bw, VUI_UNSPECIFIED, 8);
+	bw_put(bw, VUI_UNSPECIFIED, 8);
+	bw_put(bw, VUI_MATRIX_BT601, 8);
+}
+
 static void h264_vui_write(struct nal_bw *bw, const struct rkvenc_h264_seq *seq)
 {
-	bw_put(bw, 0, 4);
+	bw_put(bw, 0, 2);
+	bw_put(bw, seq->bt601_signal, 1);
+	if (seq->bt601_signal)
+		vui_bt601_write(bw);
+	bw_put(bw, 0, 1);
 	bw_put(bw, seq->timing, 1);
 	if (seq->timing) {
 		bw_put(bw, 1, 32);
@@ -278,7 +300,14 @@
 	bw_put(bw, 0, 1);
 	bw_put(bw, 0, 1);
 	bw_put(bw, seq->strong_intra_smoothing, 1);
-	bw_put(bw, 0, 1);
+	bw_put(bw, seq->bt601_signal, 1);	/* vui_parameters_present_flag */
+	if (seq->bt601_signal) {
+		bw_put(bw, 0, 2);
+		bw_put(bw, 1, 1);
+		vui_bt601_write(bw);
+		/* no chroma location, field or window, timing or restriction */
+		bw_put(bw, 0, 7);
+	}
 	bw_put(bw, 0, 1);
 	bw_trailing(bw);
 }
diff --git a/drivers/media/platform/rockchip/rkvenc/rkvenc-v4l2.c b/drivers/media/platform/rockchip/rkvenc/rkvenc-v4l2.c
--- a/drivers/media/platform/rockchip/rkvenc/rkvenc-v4l2.c
+++ b/drivers/media/platform/rockchip/rkvenc/rkvenc-v4l2.c
@@ -21,18 +21,45 @@
 
 struct rkvenc_fmt {
 	u32 fourcc;
-	u8 num_planes;
+	enum rkvenc_cfmt cfmt;
+	bool rbuv_swap;
+	bool alpha_swap;
 };
 
