+/* Each JPEG carries its own header, so that a quality change takes at once */
+static int rkvenc_prepare_jpeg(struct rkvenc_ctx *ctx,
+			       struct vb2_v4l2_buffer *dst)
+{
+	u8 *vaddr = vb2_plane_vaddr(&dst->vb2_buf, 0);
+
+	if (!vaddr) {
+		dev_warn_once(ctx->dev->dev,
+			      "JPEG needs an MMAP capture buffer\n");
+		return -EINVAL;
+	}
+	rkvenc_refresh_header(ctx);
+	memcpy(vaddr, ctx->hdr, ctx->hdr_len);
+	return ctx->hdr_len;
+}
