+static void vepu540c_jpeg_tab_build(const struct rkvenc_frame *f,
+				    struct rkvenc_vepu540c_img *img)
+{
+	u32 *word = &img->regs[VEPU540C_JPEG_TAB / 4];
+	unsigned int t, i, n = 0;
+
+	for (t = 0; t < VEPU540C_JPEG_TABS; t++) {
+		const u8 *qt = f->jpeg_qt[t ? 1 : 0];
+
+		for (i = 0; i < RKVENC_JPEG_QT_LEN; i++, n++) {
+			u32 col = i / RKVENC_JPEG_SIDE, row = i % RKVENC_JPEG_SIDE;
+			u32 recip = VEPU540C_JPEG_RECIPROCAL /
+				    qt[row * RKVENC_JPEG_SIDE + col];
+
+			word[n / 2] |= recip << (16 * (n % 2));
+		}
+	}
+}
+
+static void vepu540c_jpeg_build(const struct rkvenc_frame *f,
+				struct rkvenc_vepu540c_img *img)
+{
+	const struct rkvenc_src *src = &f->src;
+	const struct rkvenc_bs *bs = &f->bs;
+	u32 w = ALIGN(src->width, 8), h = ALIGN(src->height, 8);
+
+	vepu540c_set(img, VEPU540C_INT_EN, VEPU540C_INT_USED & ~VEPU540C_INT_WDG);
+	vepu540c_set(img, VEPU540C_DTRNS_MAP,
+		     FIELD_PREP(VEPU540C_DTRNS_MAP_JPEG_BUS_EDIN, 7));
+	vepu540c_set(img, VEPU540C_ENC_PIC,
+		     FIELD_PREP(VEPU540C_ENC_PIC_STND,
+				VEPU540C_ENC_PIC_STND_JPEG));
+
+	vepu540c_set(img, VEPU540C_JPEG_ADR_BSBT, bs->base + bs->size - 1);
+	vepu540c_set(img, VEPU540C_JPEG_ADR_BSBB, bs->base);
+	vepu540c_set(img, VEPU540C_JPEG_ADR_BSBS, bs->base + bs->offset);
+	vepu540c_set(img, VEPU540C_JPEG_ADR_BSBR, bs->base);
+	vepu540c_set(img, VEPU540C_JPEG_ADR_SRC0, src->plane[0]);
+	vepu540c_set(img, VEPU540C_JPEG_ADR_SRC1, src->plane[1]);
+	vepu540c_set(img, VEPU540C_JPEG_ADR_SRC2, src->plane[1]);
+
+	vepu540c_set(img, VEPU540C_JPEG_ENC_RSL,
+		     FIELD_PREP(VEPU540C_ENC_RSL_WD8_M1, w / 8 - 1) |
+		     FIELD_PREP(VEPU540C_ENC_RSL_HD8_M1, h / 8 - 1));
+	vepu540c_set(img, VEPU540C_JPEG_SRC_FILL,
+		     FIELD_PREP(VEPU540C_SRC_FILL_W, w - src->width) |
+		     FIELD_PREP(VEPU540C_SRC_FILL_H, h - src->height));
+	vepu540c_set(img, VEPU540C_JPEG_SRC_FMT,
+		     FIELD_PREP(VEPU540C_SRC_FMT_CFMT,
+				VEPU540C_SRC_FMT_CFMT_NV12) |
+		     VEPU540C_SRC_FMT_OUT_FMT);
+	vepu540c_set(img, VEPU540C_JPEG_SRC_STRD0,
+		     FIELD_PREP(VEPU540C_SRC_STRD0_STRD, src->stride[0]));
+	vepu540c_set(img, VEPU540C_JPEG_SRC_STRD1,
+		     FIELD_PREP(VEPU540C_SRC_STRD1_STRD, src->stride[1]));
+	vepu540c_set(img, VEPU540C_JPEG_BASE_CFG,
+		     VEPU540C_JPEG_BASE_CFG_PIC_LAST_ECS |
+		     VEPU540C_JPEG_BASE_CFG_STND);
+
+	vepu540c_jpeg_tab_build(f, img);
+}
