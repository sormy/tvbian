new file mode 100644
index 0000000..9b6f8f8
--- /dev/null
+++ b/drivers/media/platform/rockchip/rkvenc/rkvenc-jpeg.c
@@ -0,0 +1,152 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Rockchip RKVENC JPEG headers: the core codes the scan, the driver writes
+ * everything before it, with the Annex K Huffman tables the core codes with.
+ */
+
+#include <linux/minmax.h>
+#include <linux/unaligned.h>
+
+#include <media/v4l2-jpeg.h>
+
+#include "rkvenc.h"
+
+#define JPEG_SOI	0xffd8
+#define JPEG_SOF0	0xffc0
+#define JPEG_DHT	0xffc4
+#define JPEG_SOS	0xffda
+#define JPEG_DQT	0xffdb
+
+#define JPEG_PRECISION		8
+#define JPEG_COMPONENTS		3
+#define JPEG_LUMA_SAMPLING	0x22
+#define JPEG_CHROMA_SAMPLING	0x11
+#define JPEG_SPECTRAL_END	63
+#define JPEG_LUMA_TABLES	0x00
+#define JPEG_CHROMA_TABLES	0x11
+#define JPEG_QUALITY_HALF	50
+#define JPEG_QT_MAX		255
+
+struct rkvenc_jpeg_writer {
+	u8 *buf;
+	u32 len;
+};
+
+static void jpeg_put8(struct rkvenc_jpeg_writer *w, u8 val)
+{
+	w->buf[w->len++] = val;
+}
+
+static void jpeg_put16(struct rkvenc_jpeg_writer *w, u16 val)
+{
+	put_unaligned_be16(val, w->buf + w->len);
+	w->len += 2;
+}
+
+static void jpeg_put(struct rkvenc_jpeg_writer *w, const u8 *data, u32 len)
+{
+	memcpy(w->buf + w->len, data, len);
+	w->len += len;
+}
+
+/* The IJG scaling of the Annex K tables: 50 keeps them, 100 is all ones */
+static void jpeg_scale_qt(u8 *qt, const u8 *ref, u32 quality)
+{
+	u32 scale = quality < JPEG_QUALITY_HALF ? 5000 / quality :
+						   200 - 2 * quality;
+	unsigned int i;
+
+	for (i = 0; i < V4L2_JPEG_PIXELS_IN_BLOCK; i++)
+		qt[i] = clamp((ref[i] * scale + 50) / 100, 1U, JPEG_QT_MAX);
+}
+
+static void jpeg_put_dqt(struct rkvenc_jpeg_writer *w,
+			 u8 qt[][RKVENC_JPEG_QT_LEN])
+{
+	unsigned int t, i;
+
+	jpeg_put16(w, JPEG_DQT);
+	jpeg_put16(w, 2 + 2 * (1 + V4L2_JPEG_PIXELS_IN_BLOCK));
+	for (t = 0; t < 2; t++) {
+		jpeg_put8(w, t);
+		for (i = 0; i < V4L2_JPEG_PIXELS_IN_BLOCK; i++)
+			jpeg_put8(w, qt[t][v4l2_jpeg_zigzag_scan_index[i]]);
+	}
+}
+
+static void jpeg_put_sof(struct rkvenc_jpeg_writer *w, u32 width, u32 height)
+{
+	unsigned int c;
+
+	jpeg_put16(w, JPEG_SOF0);
+	jpeg_put16(w, 8 + 3 * JPEG_COMPONENTS);
+	jpeg_put8(w, JPEG_PRECISION);
+	jpeg_put16(w, height);
+	jpeg_put16(w, width);
+	jpeg_put8(w, JPEG_COMPONENTS);
+	for (c = 0; c < JPEG_COMPONENTS; c++) {
+		jpeg_put8(w, c + 1);
+		jpeg_put8(w, c ? JPEG_CHROMA_SAMPLING : JPEG_LUMA_SAMPLING);
+		jpeg_put8(w, c ? 1 : 0);
+	}
+}
+
+static void jpeg_put_dht(struct rkvenc_jpeg_writer *w)
+{
+	static const struct {
+		u8 id;
+		const u8 *table;
+		u32 len;
+	} tables[] = {
+		{ V4L2_JPEG_DC_HT | V4L2_JPEG_LUM_HT,
+		  v4l2_jpeg_ref_table_luma_dc_ht, V4L2_JPEG_REF_HT_DC_LEN },
+		{ V4L2_JPEG_AC_HT | V4L2_JPEG_LUM_HT,
+		  v4l2_jpeg_ref_table_luma_ac_ht, V4L2_JPEG_REF_HT_AC_LEN },
+		{ V4L2_JPEG_DC_HT | V4L2_JPEG_CHR_HT,
+		  v4l2_jpeg_ref_table_chroma_dc_ht, V4L2_JPEG_REF_HT_DC_LEN },
+		{ V4L2_JPEG_AC_HT | V4L2_JPEG_CHR_HT,
+		  v4l2_jpeg_ref_table_chroma_ac_ht, V4L2_JPEG_REF_HT_AC_LEN },
+	};
+	unsigned int t;
+
+	jpeg_put16(w, JPEG_DHT);
+	jpeg_put16(w, 2 + 4 + 2 * (V4L2_JPEG_REF_HT_DC_LEN +
+				   V4L2_JPEG_REF_HT_AC_LEN));
+	for (t = 0; t < ARRAY_SIZE(tables); t++) {
+		jpeg_put8(w, tables[t].id);
+		jpeg_put(w, tables[t].table, tables[t].len);
+	}
+}
+
+static void jpeg_put_sos(struct rkvenc_jpeg_writer *w)
+{
+	unsigned int c;
+
+	jpeg_put16(w, JPEG_SOS);
+	jpeg_put16(w, 6 + 2 * JPEG_COMPONENTS);
+	jpeg_put8(w, JPEG_COMPONENTS);
+	for (c = 0; c < JPEG_COMPONENTS; c++) {
+		jpeg_put8(w, c + 1);
+		jpeg_put8(w, c ? JPEG_CHROMA_TABLES : JPEG_LUMA_TABLES);
+	}
+	jpeg_put8(w, 0);
+	jpeg_put8(w, JPEG_SPECTRAL_END);
+	jpeg_put8(w, 0);
+}
+
+/* Fills ctx->jpeg_qt and ctx->hdr; returns the header's length */
+int rkvenc_jpeg_setup(struct rkvenc_ctx *ctx, u32 quality)
+{
+	struct rkvenc_jpeg_writer w = { .buf = ctx->hdr };
+
+	jpeg_scale_qt(ctx->jpeg_qt[0], v4l2_jpeg_ref_table_luma_qt, quality);
+	jpeg_scale_qt(ctx->jpeg_qt[1], v4l2_jpeg_ref_table_chroma_qt, quality);
+
+	jpeg_put16(&w, JPEG_SOI);
+	jpeg_put_dqt(&w, ctx->jpeg_qt);
+	jpeg_put_sof(&w, ctx->width, ctx->height);
+	jpeg_put_dht(&w);
+	jpeg_put_sos(&w);
+
+	return w.len;
+}
