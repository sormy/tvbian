+/* A JPEG of noise at the top quality outgrows the picture it codes */
+static u32 rkvenc_coded_size(enum rkvenc_codec codec, u32 width, u32 height)
+{
+	u32 mbw = ALIGN(width, 16) / 16, mbh = ALIGN(height, 16) / 16;
+
+	switch (codec) {
+	case RKVENC_CODEC_H264:
+		return min(mbw * mbh * 400, width * height / 2) + RKVENC_HDR_MAX;
+	case RKVENC_CODEC_JPEG:
+		return width * height * 2 + RKVENC_HDR_MAX;
+	default:
+		return width * height / 2 + RKVENC_HDR_MAX;
+	}
 }
 
