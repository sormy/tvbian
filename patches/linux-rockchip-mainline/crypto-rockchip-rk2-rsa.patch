  drivers/crypto/rockchip/rk2_crypto.h     |  18 ++
  drivers/crypto/rockchip/rk2_crypto_pka.c | 491 +++++++++++++++++++++++++++++++
  5 files changed, 550 insertions(+), 1 deletion(-)

