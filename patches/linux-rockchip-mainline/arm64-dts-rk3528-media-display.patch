From: W132D maintainers <tech@wenziwanka.com>
Subject: [PATCH] arm64: dts: rockchip: describe RK3528 media and display blocks

SoC descriptions from w132d-linux-mainline d9bfd153f813, appended to
rk3528.dtsi for the experimental mainline kernel. No board wiring.
diff --git a/arch/arm64/boot/dts/rockchip/rk3528.dtsi b/arch/arm64/boot/dts/rockchip/rk3528.dtsi
index 03cd00f..c0919aa 100644
--- a/arch/arm64/boot/dts/rockchip/rk3528.dtsi
+++ b/arch/arm64/boot/dts/rockchip/rk3528.dtsi
@@ -560,6 +560,11 @@
 			reg = <0x0 0xff280400 0x0 0x20>;
 		};
 
+		core_grf: syscon@ff300000 {
+			compatible = "rockchip,rk3528-core-grf", "syscon";
+			reg = <0x0 0xff300000 0x0 0x10000>;
+		};
+
 		vpu_grf: syscon@ff340000 {
 			compatible = "rockchip,rk3528-vpu-grf", "syscon";
 			reg = <0x0 0xff340000 0x0 0x8000>;
@@ -1365,3 +1370,455 @@
 };
 
 #include "rk3528-pinctrl.dtsi"
+
+#include <dt-bindings/phy/phy.h>
+#include <dt-bindings/soc/rockchip,vop2.h>
+
+/ {
+	display_subsystem: display-subsystem {
+		compatible = "rockchip,display-subsystem";
+		ports = <&vop_out>;
+	};
+
+	soc {
+	spdif: spdif@ffbc0000 {
+		compatible = "rockchip,rk3568-spdif";
+		reg = <0x0 0xffbc0000 0x0 0x1000>;
+		interrupts = <GIC_SPI 130 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&cru MCLK_SPDIF>, <&cru HCLK_SPDIF>;
+		clock-names = "mclk", "hclk";
+		dmas = <&dmac 7>;
+		dma-names = "tx";
+		pinctrl-names = "default";
+		pinctrl-0 = <&spdifm0_pins>;
+		#sound-dai-cells = <0>;
+		status = "disabled";
+	};
+
+	rng: rng@ffc50000 {
+		compatible = "rockchip,rk3576-rng";
+		reg = <0x0 0xffc50000 0x0 0x200>;
+		interrupts = <GIC_SPI 23 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&scmi_clk SCMI_HCLK_TRNG>;
+		resets = <&cru SRST_H_TRNG_NS>;
+	};
+
+	rga: rga@ff850000 {
+		compatible = "rockchip,rk3528-rga", "rockchip,rk3288-rga";
+		reg = <0x0 0xff850000 0x0 0x180>;
+		interrupts = <GIC_SPI 105 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&cru ACLK_RGA2E>, <&cru HCLK_RGA2E>, <&cru CLK_CORE_RGA2E>;
+		clock-names = "aclk", "hclk", "sclk";
+		resets = <&cru SRST_CORE_RGA2E>, <&cru SRST_A_RGA2E>, <&cru SRST_H_RGA2E>;
+		reset-names = "core", "axi", "ahb";
+		iommus = <&rga_mmu>;
+		power-domains = <&power RK3528_PD_VO>;
+		status = "disabled";
+	};
+
+	rga_mmu: iommu@ff850f00 {
+		compatible = "rockchip,rk3568-iommu";
+		reg = <0x0 0xff850f00 0x0 0x100>;
+		interrupts = <GIC_SPI 105 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&cru ACLK_RGA2E>, <&cru HCLK_RGA2E>;
+		clock-names = "aclk", "iface";
+		#iommu-cells = <0>;
+		power-domains = <&power RK3528_PD_VO>;
+		status = "disabled";
+	};
+
+	iep: iep@ff860000 {
+		compatible = "rockchip,rk3528-iep";
+		reg = <0x0 0xff860000 0x0 0x500>;
+		interrupts = <GIC_SPI 106 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&cru ACLK_VDPP>, <&cru HCLK_VDPP>, <&cru CLK_CORE_VDPP>;
+		clock-names = "aclk", "hclk", "sclk";
+		assigned-clocks = <&cru ACLK_VDPP>, <&cru CLK_CORE_VDPP>;
+		assigned-clock-rates = <340000000>, <340000000>;
+		resets = <&cru SRST_A_VDPP>, <&cru SRST_H_VDPP>, <&cru SRST_CORE_VDPP>;
+		reset-names = "axi", "ahb", "core";
+		iommus = <&iep_mmu>;
+		power-domains = <&power RK3528_PD_VO>;
+		status = "disabled";
+	};
+
+	iep_mmu: iommu@ff860800 {
+		compatible = "rockchip,rk3568-iommu";
+		reg = <0x0 0xff860800 0x0 0x100>;
+		interrupts = <GIC_SPI 106 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&cru ACLK_VDPP>, <&cru HCLK_VDPP>;
+		clock-names = "aclk", "iface";
+		#iommu-cells = <0>;
+		power-domains = <&power RK3528_PD_VO>;
+		status = "disabled";
+	};
+
+	vdpp: vdpp@ff861000 {
+		compatible = "rockchip,rk3528-vdpp";
+		reg = <0x0 0xff861000 0x0 0x100>, <0x0 0xff862000 0x0 0x900>;
+		reg-names = "vdpp", "zme";
+		interrupts = <GIC_SPI 106 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&cru ACLK_VDPP>, <&cru HCLK_VDPP>, <&cru CLK_CORE_VDPP>;
+		clock-names = "aclk", "hclk", "sclk";
+		assigned-clocks = <&cru ACLK_VDPP>, <&cru CLK_CORE_VDPP>;
+		assigned-clock-rates = <340000000>, <340000000>;
+		resets = <&cru SRST_A_VDPP>, <&cru SRST_H_VDPP>, <&cru SRST_CORE_VDPP>;
+		reset-names = "axi", "ahb", "core";
+		iommus = <&iep_mmu>;
+		power-domains = <&power RK3528_PD_VO>;
+		status = "disabled";
+	};
+
+	jpegd: video-codec@ff870000 {
+		compatible = "rockchip,rk3588-jpegd";
+		reg = <0x0 0xff870000 0x0 0x400>;
+		interrupts = <GIC_SPI 107 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&cru ACLK_JPEG_DECODER>, <&cru HCLK_JPEG_DECODER>;
+		clock-names = "axi", "ahb";
+		assigned-clocks = <&cru ACLK_JPEG_DECODER>;
+		assigned-clock-rates = <340000000>;
+		iommus = <&jpegd_mmu>;
+		power-domains = <&power RK3528_PD_VPU>;
+		resets = <&cru SRST_A_JPEG_DECODER>, <&cru SRST_H_JPEG_DECODER>;
+		reset-names = "axi", "ahb";
+		status = "disabled";
+	};
+
+	jpegd_mmu: iommu@ff870480 {
+		compatible = "rockchip,rk3568-iommu";
+		reg = <0x0 0xff870480 0x0 0x40>;
+		interrupts = <GIC_SPI 108 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&cru ACLK_JPEG_DECODER>, <&cru HCLK_JPEG_DECODER>;
+		clock-names = "aclk", "iface";
+		#iommu-cells = <0>;
+		power-domains = <&power RK3528_PD_VPU>;
+		status = "disabled";
+	};
+
+	/* VDPU2, as on RK3568: MPEG-2, VP8 and H.264 behind the decoder at +0x400. */
+	vpu: video-codec@ff7c0000 {
+		compatible = "rockchip,rk3528-vpu", "rockchip,rk3568-vpu";
+		reg = <0x0 0xff7c0000 0x0 0x800>;
+		interrupts = <GIC_SPI 98 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-names = "vdpu";
+		clocks = <&cru ACLK_VPU>, <&cru HCLK_VPU>;
+		clock-names = "aclk", "hclk";
+		iommus = <&vdpu_mmu>;
+		power-domains = <&power RK3528_PD_VPU>;
+		status = "disabled";
+	};
+
+	vdpu_mmu: iommu@ff7c0800 {
+		compatible = "rockchip,rk3568-iommu";
+		reg = <0x0 0xff7c0800 0x0 0x40>;
+		interrupts = <GIC_SPI 99 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&cru ACLK_VPU>, <&cru HCLK_VPU>;
+		clock-names = "aclk", "iface";
+		#iommu-cells = <0>;
+		power-domains = <&power RK3528_PD_VPU>;
+		status = "disabled";
+	};
+
+	/*
+	 * The vendor DTB uses the BSP-only "rockchip,iommu-v2"; mainline reaches
+	 * the same v2 ops through "rockchip,rk3568-iommu".
+	 */
+	vdec_mmu: iommu@ff740800 {
+		compatible = "rockchip,rk3568-iommu";
+		reg = <0x0 0xff740800 0x0 0x40>,
+		      <0x0 0xff740900 0x0 0x40>;
+		interrupts = <GIC_SPI 95 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&cru ACLK_RKVDEC>, <&cru HCLK_RKVDEC>;
+		clock-names = "aclk", "iface";
+		#iommu-cells = <0>;
+		rockchip,disable-mmu-reset;
+		status = "disabled";
+	};
+
+	/*
+	 * No power-domains on purpose.  rk3528.dtsi leaves
+	 * power-domain@RK3528_PD_RKVDEC disabled, so referencing it makes both
+	 * devices fail with deferred probe timeouts.  The vendor DTB does not
+	 * use a power domain here either: the RK3528 vdec domain is defined with
+	 * a zero power mask, i.e. bus idle handshake only, permanently powered.
+	 */
+	vdec: video-codec@ff740000 {
+		compatible = "rockchip,rk3528-vdec";
+		reg = <0x0 0xff740000 0x0 0x100>,
+		      <0x0 0xff740100 0x0 0x400>;
+		reg-names = "link", "function";
+		interrupts = <GIC_SPI 94 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&cru ACLK_RKVDEC>, <&cru HCLK_RKVDEC>,
+			 <&cru CLK_HEVC_CA_RKVDEC>;
+		clock-names = "axi", "ahb", "hevc_cabac";
+		assigned-clocks = <&cru ACLK_RKVDEC>, <&cru CLK_HEVC_CA_RKVDEC>;
+		assigned-clock-rates = <340000000>, <600000000>;
+		iommus = <&vdec_mmu>;
+		sram = <&vdec_sram>;
+		status = "disabled";
+	};
+
+	/*
+	 * On-chip SRAM used for the decoder row cache.  The child must carry
+	 * "pool" or drivers/misc/sram.c never creates a named gen_pool for it.
+	 */
+	sram: sram@fe480000 {
+		compatible = "mmio-sram";
+		reg = <0x0 0xfe480000 0x0 0xc000>;
+		ranges = <0x0 0x0 0xfe480000 0xc000>;
+		#address-cells = <1>;
+		#size-cells = <1>;
+
+		vdec_sram: rkvdec-sram@0 {
+			reg = <0x0 0xc000>;
+			pool;
+		};
+	};
+	/*
+	 * SAI2 is wired to the on-chip codec, so it has no pins.  Mainline only
+	 * matches rockchip,rk3576-sai, but the RK3528 register layout is
+	 * identical and the driver reads SAI_VERSION at runtime; the rk3576
+	 * fallback is kept so an unpatched driver still binds.
+	 */
+	sai2: sai@ffb90000 {
+		compatible = "rockchip,rk3528-sai", "rockchip,rk3576-sai";
+		reg = <0x0 0xffb90000 0x0 0x1000>;
+		interrupts = <GIC_SPI 127 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&cru MCLK_SAI_I2S2>, <&cru HCLK_SAI_I2S2>;
+		clock-names = "mclk", "hclk";
+		dmas = <&dmac 4>;
+		dma-names = "tx";
+		resets = <&cru SRST_M_SAI_I2S2>, <&cru SRST_H_SAI_I2S2>;
+		reset-names = "m", "h";
+		#sound-dai-cells = <0>;
+		status = "disabled";
+	};
+
+	acodec: acodec@ffe10000 {
+		compatible = "rockchip,rk3528-codec";
+		reg = <0x0 0xffe10000 0x0 0x1000>;
+		clocks = <&cru PCLK_ACODEC>, <&cru MCLK_ACODEC_TX>;
+		clock-names = "pclk", "mclk";
+		resets = <&cru SRST_P_ACODEC>;
+		reset-names = "acodec";
+		/* External amplifier enable. */
+		#sound-dai-cells = <0>;
+		status = "disabled";
+	};
+
+	pdm: pdm@ffbb0000 {
+		compatible = "rockchip,rk3528-pdm", "rockchip,rk3568-pdm";
+		reg = <0x0 0xffbb0000 0x0 0x1000>;
+		clocks = <&cru MCLK_PDM>, <&cru HCLK_PDM>;
+		clock-names = "pdm_clk", "pdm_hclk";
+		dmas = <&dmac 6>;
+		dma-names = "rx";
+		#sound-dai-cells = <0>;
+		status = "disabled";
+	};
+	vop: vop@ff840000 {
+		compatible = "rockchip,rk3528-vop";
+		reg = <0x0 0xff840000 0x0 0x3000>;
+		reg-names = "vop";
+		interrupts = <GIC_SPI 109 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&cru ACLK_VOP>, <&cru HCLK_VOP>, <&cru DCLK_VOP0>,
+			 <&cru DCLK_VOP1>;
+		clock-names = "aclk", "hclk", "dclk_vp0", "dclk_vp1";
+		assigned-clocks = <&cru DCLK_VOP0>;
+		assigned-clock-parents = <&hdmiphy>;
+		iommus = <&vop_mmu>;
+		power-domains = <&power RK3528_PD_VO>;
+		resets = <&cru SRST_A_VOP>, <&cru SRST_H_VOP>,
+			 <&cru SRST_D_VOP0>, <&cru SRST_D_VOP1>;
+		status = "disabled";
+
+		vop_out: ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			vp0: port@0 {
+				reg = <0>;
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				vp0_out_hdmi: endpoint@ROCKCHIP_VOP2_EP_HDMI0 {
+					reg = <ROCKCHIP_VOP2_EP_HDMI0>;
+					remote-endpoint = <&hdmi_in_vp0>;
+				};
+			};
+
+			vp1: port@1 {
+				reg = <1>;
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				vp1_out_tve: endpoint@ROCKCHIP_VOP2_EP_RGB0 {
+					reg = <ROCKCHIP_VOP2_EP_RGB0>;
+					remote-endpoint = <&tve_in_vp1>;
+				};
+			};
+		};
+	};
+
+	vop_mmu: iommu@ff847e00 {
+		compatible = "rockchip,rk3568-iommu";
+		reg = <0x0 0xff847e00 0x0 0x100>;
+		interrupts = <GIC_SPI 109 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&cru ACLK_VOP>, <&cru HCLK_VOP>;
+		clock-names = "aclk", "iface";
+		#iommu-cells = <0>;
+		rockchip,disable-device-link-resume;
+		power-domains = <&power RK3528_PD_VO>;
+		status = "disabled";
+	};
+
+	tve: tve@ff880000 {
+		compatible = "rockchip,rk3528-tve";
+		reg = <0x0 0xff880000 0x0 0x4000>, <0x0 0xffde0000 0x0 0x300>;
+		interrupts = <GIC_SPI 112 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&cru HCLK_CVBS>, <&cru PCLK_VCDCPHY>, <&cru DCLK_CVBS>,
+			 <&cru DCLK_4X_CVBS>;
+		clock-names = "hclk", "pclk_vdac", "dclk", "dclk_4x";
+		nvmem-cells = <&vdac_out_current>, <&test_version>;
+		nvmem-cell-names = "out-current", "version";
+		power-domains = <&power RK3528_PD_VO>;
+		rockchip,grf = <&vo_grf>;
+		status = "disabled";
+
+		port {
+			tve_in_vp1: endpoint {
+				remote-endpoint = <&vp1_out_tve>;
+			};
+		};
+	};
+
+	rkvenc: video-codec@ff780000 {
+		compatible = "rockchip,rk3528-rkvenc";
+		reg = <0x0 0xff780000 0x0 0x6000>;
+		interrupts = <GIC_SPI 97 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&cru ACLK_RKVENC>, <&cru HCLK_RKVENC>,
+			 <&cru CLK_CORE_RKVENC>;
+		clock-names = "axi", "ahb", "core";
+		assigned-clocks = <&cru ACLK_RKVENC_ROOT>, <&cru CLK_CORE_RKVENC>;
+		assigned-clock-rates = <300000000>, <300000000>;
+		resets = <&cru SRST_A_RKVENC>, <&cru SRST_H_RKVENC>,
+			 <&cru SRST_CORE_RKVENC>;
+		reset-names = "axi", "ahb", "core";
+		iommus = <&rkvenc_mmu>;
+		power-domains = <&power RK3528_PD_RKVENC>;
+		status = "disabled";
+	};
+
+	rkvenc_mmu: iommu@ff78f000 {
+		compatible = "rockchip,rk3568-iommu";
+		reg = <0x0 0xff78f000 0x0 0x40>;
+		interrupts = <GIC_SPI 96 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&cru ACLK_RKVENC>, <&cru HCLK_RKVENC>;
+		clock-names = "aclk", "iface";
+		#iommu-cells = <0>;
+		power-domains = <&power RK3528_PD_RKVENC>;
+		status = "disabled";
+	};
+
+	hdmi: hdmi@ff8d0000 {
+		compatible = "rockchip,rk3528-dw-hdmi";
+		reg = <0x0 0xff8d0000 0x0 0x20000>;
+		interrupts = <GIC_SPI 102 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&cru PCLK_HDMI>, <&cru CLK_SFR_HDMI>, <&cru CLK_CEC_HDMI>;
+		clock-names = "iahb", "isfr", "cec";
+		phys = <&hdmiphy>;
+		phy-names = "hdmi";
+		power-domains = <&power RK3528_PD_VO>;
+		reg-io-width = <4>;
+		rockchip,grf = <&vo_grf>;
+		#sound-dai-cells = <0>;
+		status = "disabled";
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			hdmi_in: port@0 {
+				reg = <0>;
+
+				hdmi_in_vp0: endpoint {
+					remote-endpoint = <&vp0_out_hdmi>;
+				};
+			};
+
+			hdmi_out: port@1 {
+				reg = <1>;
+			};
+		};
+	};
+
+	hdmiphy: phy@ffe00000 {
+		compatible = "rockchip,rk3528-hdmi-phy";
+		reg = <0x0 0xffe00000 0x0 0x10000>;
+		interrupts = <GIC_SPI 101 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&cru PCLK_HDMIPHY>, <&xin24m>;
+		clock-names = "sysclk", "refoclk";
+		/* Must match the DCLK_VOP0 parent name in the clock driver. */
+		clock-output-names = "clk_hdmiphy_pixel_io";
+		#clock-cells = <0>;
+		#phy-cells = <0>;
+		power-domains = <&power RK3528_PD_VO>;
+		status = "disabled";
+	};
+
+	sai3: sai@ffb70000 {
+		compatible = "rockchip,rk3528-sai", "rockchip,rk3576-sai";
+		reg = <0x0 0xffb70000 0x0 0x1000>;
+		interrupts = <GIC_SPI 128 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&cru MCLK_SAI_I2S3>, <&cru HCLK_SAI_I2S3>;
+		clock-names = "mclk", "hclk";
+		dmas = <&dmac 5>;
+		dma-names = "tx";
+		power-domains = <&power RK3528_PD_VO>;
+		resets = <&cru SRST_M_SAI_I2S3>, <&cru SRST_H_SAI_I2S3>;
+		reset-names = "m", "h";
+		rockchip,sai-tx-route = <0 1 2 3>;
+		#sound-dai-cells = <0>;
+		status = "disabled";
+	};
+	tsadc: tsadc@ffad0000 {
+		compatible = "rockchip,rk3528-tsadc";
+		reg = <0x0 0xffad0000 0x0 0x400>;
+		interrupts = <GIC_SPI 139 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&cru CLK_TSADC>, <&cru CLK_TSADC_TSEN>,
+			 <&cru PCLK_TSADC>;
+		clock-names = "tsadc", "tsadc_tsen", "apb_pclk";
+		assigned-clocks = <&cru CLK_TSADC>, <&cru CLK_TSADC_TSEN>;
+		assigned-clock-rates = <1200000>, <12000000>;
+		resets = <&cru SRST_TSADC>, <&cru SRST_P_TSADC>;
+		reset-names = "tsadc", "tsadc-apb";
+		rockchip,grf = <&vpu_grf>;
+		nvmem-cells = <&tsadc_trim>;
+		nvmem-cell-names = "trim";
+		rockchip,hw-tshut-temp = <120000>;
+		rockchip,hw-tshut-mode = <0>;
+		rockchip,hw-tshut-polarity = <0>;
+		#thermal-sensor-cells = <1>;
+		status = "disabled";
+	};
+};
+};
+
+&otp {
+	test_version: test-version@29 {
+		reg = <0x29 0x1>;
+	};
+
+	macphy_txlevel: macphy-txlevel@2e {
+		reg = <0x2e 0x2>;
+	};
+
+	vdac_out_current: vdac-out-current@30 {
+		reg = <0x30 0x1>;
+	};
+};
+
+&rmii0_phy {
+	nvmem-cells = <&macphy_txlevel>;
+	nvmem-cell-names = "txlevel";
+};
