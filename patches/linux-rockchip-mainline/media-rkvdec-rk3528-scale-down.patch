+/*
+ * The picture scaled down by 1 << shift each way, written beside the full one:
+ * its luma at addr, its chroma after it, by the stride of the scaled format.
+ */
+static inline void
+rkvdec_vdpu381_set_scale_down(struct rkvdec_vdpu381_regs_common *common,
+			      const struct v4l2_pix_format_mplane *scaled,
+			      unsigned int shift, dma_addr_t addr,
+			      u32 *luma_base, u32 *chroma_base)
+{
+	u32 stride = scaled->plane_fmt[0].bytesperline;
+	u32 ratio = 1 << shift;
+
+	common->reg012_secondary_en.scale_down_en = !!shift;
+	common->reg029_scale_down_ctrl.y_wratio = shift ? ratio : 0;
+	common->reg029_scale_down_ctrl.y_hratio = shift ? ratio : 0;
+	common->reg029_scale_down_ctrl.c_wratio = shift ? ratio : 0;
+	common->reg029_scale_down_ctrl.c_hratio = shift ? ratio : 0;
+	common->reg030_y_scale_down_hor_stride.y_scale_down_hor_stride = stride / 16;
+	common->reg031_uv_scale_down_hor_stride.uv_scale_down_hor_stride = stride / 16;
+	*luma_base = shift ? addr : 0;
+	*chroma_base = shift ? addr + stride * scaled->height : 0;
+}
+
 #endif /* __RKVDEC_REGS_H__ */
