+/*
+ * COMPOSE scales the picture down by the smallest power of two the variant
+ * can that fits it in the rectangle, before capture buffers exist.
+ */
+static int rkvdec_s_selection(struct file *file, void *priv,
+			      struct v4l2_selection *s)
+{
+	struct rkvdec_ctx *ctx = file_to_rkvdec_ctx(file);
+	const struct v4l2_pix_format_mplane *coded = &ctx->coded_fmt.fmt.pix_mp;
+	const struct v4l2_pix_format_mplane *full = &ctx->layout.picture;
+	unsigned int max = ctx->dev->variant->scale_shift_max;
+	struct v4l2_format f = ctx->decoded_fmt;
+	unsigned int shift = 0;
+	int ret;
+
+	if (s->type != V4L2_BUF_TYPE_VIDEO_CAPTURE || s->target != V4L2_SEL_TGT_COMPOSE)
+		return -EINVAL;
+	if (vb2_is_busy(v4l2_m2m_get_vq(ctx->fh.m2m_ctx, V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE)))
+		return -EBUSY;
+
+	/* the stream's size, not the decoder's padding of it */
+	while (shift < max && ((coded->width >> shift) > s->r.width ||
+			       (coded->height >> shift) > s->r.height))
+		shift++;
+	ctx->scale_shift = shift;
+
+	f.fmt.pix_mp.width = full->width;
+	f.fmt.pix_mp.height = full->height;
+	ret = rkvdec_try_decoded_fmt(ctx, &f, &ctx->layout);
+	if (ret)
+		return ret;
+	ctx->decoded_fmt = f;
+
+	s->r = (struct v4l2_rect){ 0, 0, f.fmt.pix_mp.width, f.fmt.pix_mp.height };
+	return 0;
+}
