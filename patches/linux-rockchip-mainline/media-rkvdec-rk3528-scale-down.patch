+/* The scaler writes 8-bit 4:2:0 linear pictures only */
+static unsigned int rkvdec_scale_shift(struct rkvdec_ctx *ctx, u32 pixelformat)
+{
+	return pixelformat == V4L2_PIX_FMT_NV12 ? ctx->scale_shift : 0;
+}
+
+/*
+ * The client's format for a full-size pix_mp, and the buffer's layout: the
+ * picture scaled down where COMPOSE asked, the full one after it.
+ */
 static void rkvdec_fill_decoded_pixfmt(struct rkvdec_ctx *ctx,
-				       struct v4l2_pix_format_mplane *pix_mp)
+				       struct v4l2_pix_format_mplane *pix_mp,
+				       struct rkvdec_layout *layout)
 {
 	const struct rkvdec_variant *variant = ctx->dev->variant;
+	struct v4l2_pix_format_mplane *full = &layout->picture;
+	unsigned int shift = rkvdec_scale_shift(ctx, pix_mp->pixelformat);
+	u32 stride, height;
 
