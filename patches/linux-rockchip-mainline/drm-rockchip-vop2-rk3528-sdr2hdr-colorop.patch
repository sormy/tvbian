From: Artem Butusov <art.sormy@gmail.com>
Subject: [PATCH] drm/rockchip: vop2: RK3528 SDR to PQ as a plane color pipeline

VP0 of the RK3528 converts its SDR layers for an HDR output: gamma 2.2
decoded, a matrix to BT.2020, scaled to the SDR white's luminance and
PQ encoded, after the layer mixer. Offer it as each plane's color
pipeline, a gamma 2.2 curve, a 3x4 matrix, a multiplier and the PQ
inverse EOTF, the stage's order. The stage is the port's: every plane on
it asks for the same pipeline or none does, whole or bypassed, and the
output stays RGB. The fixed terms are those Rockchip's userspace sets
for a PQ output.

Signed-off-by: Artem Butusov <art.sormy@gmail.com>
---
diff --git a/drivers/gpu/drm/rockchip/rockchip_drm_vop2.c b/drivers/gpu/drm/rockchip/rockchip_drm_vop2.c
--- a/drivers/gpu/drm/rockchip/rockchip_drm_vop2.c
+++ b/drivers/gpu/drm/rockchip/rockchip_drm_vop2.c
@@ -7,6 +7,7 @@
 #include <linux/clk.h>
 #include <linux/component.h>
 #include <linux/delay.h>
+#include <linux/int_log.h>
 #include <linux/iopoll.h>
 #include <linux/kernel.h>
 #include <linux/media-bus-format.h>
@@ -22,6 +23,7 @@
 
 #include <drm/drm.h>
 #include <drm/drm_atomic.h>
+#include <drm/drm_colorop.h>
 #include <drm/drm_atomic_helper.h>
 #include <drm/drm_atomic_uapi.h>
 #include <drm/drm_blend.h>
@@ -2311,6 +2313,37 @@
 	return 0;
 }
 
+/*
+ * The SDR to HDR stage is the port's, not a plane's: every plane on the port
+ * asks for it alike, or none does, and the output stays RGB.
+ */
+static int vop2_crtc_atomic_check_sdr2hdr(struct vop2_video_port *vp,
+					  struct drm_atomic_commit *state,
+					  struct drm_crtc_state *crtc_state)
+{
+	struct rockchip_crtc_state *vcstate = to_rockchip_crtc_state(crtc_state);
+	const struct drm_plane_state *pstate;
+	struct vop2_sdr2hdr first, s2h;
+	struct drm_plane *plane;
+	bool seen = false;
+	int ret;
+
+	drm_atomic_crtc_state_for_each_plane_state(plane, pstate, crtc_state) {
+		ret = vop2_sdr2hdr_of(state, pstate, &s2h);
+		if (ret)
+			return ret;
+		if (seen && memcmp(&first, &s2h, sizeof(s2h)))
+			return -EINVAL;
+		first = s2h;
+		seen = true;
+	}
+	if (!seen || !first.on)
+		return 0;
+	if (!vp->data->sdr2hdr_dly || is_yuv_output(vcstate->bus_format))
+		return -EINVAL;
+	return 0;
+}
+
 static int vop2_crtc_atomic_check(struct drm_crtc *crtc,
 				  struct drm_atomic_commit *state)
 {
@@ -2324,6 +2357,10 @@
 	if (ret)
 		return ret;
 
+	ret = vop2_crtc_atomic_check_sdr2hdr(vp, state, crtc_state);
+	if (ret)
+		return ret;
+
 	ret = vop2_wb_check_output(vp, state, crtc_state);
 	if (ret)
 		return ret;
@@ -3011,6 +3048,132 @@
 	return ret;
 }
 
+/* the SDR to HDR stage's terms: Q13 matrix coefficients under 4, white from 100 to 10000 nits */
+#define VOP2_S2H_CSC_SHIFT		19
+#define VOP2_S2H_CSC_MAX		(4ULL << 32)
+#define VOP2_S2H_MULT_MIN		(5ULL << 30)
+#define VOP2_S2H_MULT_MAX		(125ULL << 32)
+#define VOP2_S2H_PQ_125_WHITE		(125 << 16)
+#define VOP2_S2H_WHITE_SCALE		1020
+#define VOP2_S2H_OPS			4
+#define S31_32_SIGN			BIT_ULL(63)
+
+static const struct drm_colorop_funcs vop2_colorop_funcs = {
+	.destroy = drm_colorop_destroy,
+};
+
+static const struct drm_colorop_state *
+vop2_colorop_state(struct drm_atomic_commit *state, struct drm_colorop *colorop)
+{
+	const struct drm_colorop_state *s = state ?
+		drm_atomic_get_new_colorop_state(state, colorop) : NULL;
+
+	return s ?: colorop->state;
+}
+
+/*
+ * The SDR to HDR stage as the plane's pipeline asks: gamma 2.2 decoded, a 3x4
+ * matrix, a multiplier setting SDR white, PQ encoded, all in use or none.
+ */
+int vop2_sdr2hdr_of(struct drm_atomic_commit *state, const struct drm_plane_state *pstate,
+		    struct vop2_sdr2hdr *s2h)
+{
+	const struct drm_colorop_state *ops[VOP2_S2H_OPS];
+	struct drm_colorop *colorop = pstate->color_pipeline;
+	const struct drm_color_ctm_3x4 *ctm;
+	unsigned int i, bypassed = 0;
+	u64 v, mult;
+
+	memset(s2h, 0, sizeof(*s2h));
+	for (i = 0; i < VOP2_S2H_OPS; i++, colorop = colorop->next) {
+		if (!colorop)
+			return 0;
+		ops[i] = vop2_colorop_state(state, colorop);
+		bypassed += ops[i]->bypass;
+	}
+	if (bypassed == VOP2_S2H_OPS)
+		return 0;
+	if (bypassed || !ops[1]->data ||
+	    ops[0]->curve_1d_type != DRM_COLOROP_1D_CURVE_GAMMA22 ||
+	    ops[3]->curve_1d_type != DRM_COLOROP_1D_CURVE_PQ_125_INV_EOTF)
+		return -EINVAL;
+
+	ctm = ops[1]->data->data;
+	for (i = 0; i < ARRAY_SIZE(ctm->matrix); i++) {
+		v = ctm->matrix[i];
+		if (i % 4 == 3) {
+			if (v & ~S31_32_SIGN)
+				return -EINVAL;
+			continue;
+		}
+		if (v & S31_32_SIGN || v >= VOP2_S2H_CSC_MAX)
+			return -EINVAL;
+		s2h->csc[i - i / 4] = (v + BIT_ULL(VOP2_S2H_CSC_SHIFT - 1)) >> VOP2_S2H_CSC_SHIFT;
+	}
+
+	mult = ops[2]->multiplier;
+	if (mult < VOP2_S2H_MULT_MIN || mult > VOP2_S2H_MULT_MAX)
+		return -EINVAL;
+	s2h->white = DIV_ROUND_CLOSEST((u64)(intlog10(VOP2_S2H_PQ_125_WHITE) -
+					     intlog10(mult >> 16)) * VOP2_S2H_WHITE_SCALE,
+				       1 << 24);
+	s2h->on = true;
+	return 0;
+}
+
+static int vop2_colorop_init(struct vop2 *vop2, struct drm_colorop *colorop,
+			     struct drm_plane *plane, unsigned int i)
+{
+	const struct drm_colorop_funcs *funcs = &vop2_colorop_funcs;
+	const u32 flags = DRM_COLOROP_FLAG_ALLOW_BYPASS;
+
+	switch (i) {
+	case 0:
+		return drm_plane_colorop_curve_1d_init(vop2->drm, colorop, plane, funcs,
+						       BIT(DRM_COLOROP_1D_CURVE_GAMMA22), flags);
+	case 1:
+		return drm_plane_colorop_ctm_3x4_init(vop2->drm, colorop, plane, funcs, flags);
+	case 2:
+		return drm_plane_colorop_mult_init(vop2->drm, colorop, plane, funcs, flags);
+	default:
+		return drm_plane_colorop_curve_1d_init(vop2->drm, colorop, plane, funcs,
+						       BIT(DRM_COLOROP_1D_CURVE_PQ_125_INV_EOTF),
+						       flags);
+	}
+}
+
+static int vop2_plane_init_color_pipeline(struct vop2 *vop2, struct drm_plane *plane)
+{
+	struct drm_colorop *ops[VOP2_S2H_OPS] = {};
+	struct drm_prop_enum_list pipeline = {};
+	unsigned int i;
+	int ret = 0;
+
+	for (i = 0; i < VOP2_S2H_OPS && !ret; i++) {
+		ops[i] = kzalloc_obj(*ops[i]);
+		ret = ops[i] ? vop2_colorop_init(vop2, ops[i], plane, i) : -ENOMEM;
+		if (ret) {
+			kfree(ops[i]);
+			ops[i] = NULL;
+		} else if (i) {
+			drm_colorop_set_next_property(ops[i - 1], ops[i]);
+		}
+	}
+
+	if (!ret) {
+		pipeline.type = ops[0]->base.id;
+		pipeline.name = kasprintf(GFP_KERNEL, "SDR to PQ %d", ops[0]->base.id);
+		ret = -ENOMEM;
+		if (pipeline.name)
+			ret = drm_plane_create_color_pipeline_property(plane, &pipeline, 1);
+		kfree(pipeline.name);
+	}
+	if (ret)
+		for (i = 0; i < VOP2_S2H_OPS && ops[i]; i++)
+			drm_colorop_destroy(ops[i]);
+	return ret;
+}
+
 static int vop2_plane_init(struct vop2 *vop2, struct vop2_win *win,
 			   unsigned long possible_crtcs)
 {
@@ -3041,6 +3204,9 @@
 	drm_plane_create_zpos_property(&win->base, win->win_id, 0,
 				       vop2->registered_num_wins - 1);
 
+	if (vop2->data->vp[0].sdr2hdr_dly)
+		return vop2_plane_init_color_pipeline(vop2, &win->base);
+
 	return 0;
 }
 
diff --git a/drivers/gpu/drm/rockchip/rockchip_drm_vop2.h b/drivers/gpu/drm/rockchip/rockchip_drm_vop2.h
--- a/drivers/gpu/drm/rockchip/rockchip_drm_vop2.h
+++ b/drivers/gpu/drm/rockchip/rockchip_drm_vop2.h
@@ -242,11 +242,33 @@
 	 * bound to their port; 0 shares all windows equally between ports
 	 */
 	u8 nlayers;
+	/**
+	 * @sdr2hdr_dly: the background delay the SDR to HDR stage adds; 0 where
+	 * the port has none
+	 */
+	u8 sdr2hdr_dly;
 };
 
+/**
+ * struct vop2_sdr2hdr - the SDR to HDR stage, as a plane's colorop pipeline asks
+ * @on: the pipeline is in use
+ * @csc: the BT.709 to BT.2020 matrix, Q13, row by row
+ * @white: the SDR white's term, -log10 of its luminance over 10000 nits, scaled
+ */
+struct vop2_sdr2hdr {
+	bool on;
+	u16 csc[9];
+	s16 white;
+};
+
+int vop2_sdr2hdr_of(struct drm_atomic_commit *state, const struct drm_plane_state *pstate,
+		    struct vop2_sdr2hdr *s2h);
+
 struct vop2_video_port {
 	struct drm_crtc crtc;
 	struct vop2 *vop2;
+	/* the SDR to HDR stage runs, its planes' colorop pipelines in use */
+	bool sdr2hdr;
 	struct clk *dclk;
 	struct clk *dclk_src;
 	/* This port owns a dclk reference and a share of the VOP resources. */
@@ -487,6 +509,17 @@
 /* Extra OVL register definition */
 #define RK3576_SYS_EXTRA_ALPHA_CTRL		0x500
 #define RK3528_OVL_SYS_PORT_SEL_IMD		0x504
+#define RK3528_SDR2HDR_CTRL			0x2010
+#define RK3528_SDR2HDR_CTRL__EN				BIT(0)
+#define RK3528_SDR2HDR_CTRL__AUTO_GATING		BIT(1)
+#define RK3528_SDR_CFG_COE0			0x2014
+#define RK3528_SDR_CFG_COE1			0x2018
+#define RK3528_SDR_CSC_COE00_01			0x201c
+#define RK3528_HDRVIVID_CTRL			0x2040
+#define RK3528_SDRINVGAMMA_CURVE		0x2700
+#define RK3528_SDRINVGAMMA_STARTIDX		0x2820
+#define RK3528_SDRINVGAMMA_CHANGEIDX		0x2840
+#define RK3528_SDR_SMGAIN			0x2900
 #define RK3528_OVL_SYS_CLUSTER0_CTRL		0x510
 #define RK3528_OVL_SYS_ESMART0_CTRL		0x520
 #define RK3528_OVL_SYS_ESMART1_CTRL		0x524
@@ -854,6 +887,7 @@
 #define RK3528_OVL_SYS_ESMART0_CTRL__DLY_NUM		GENMASK(7, 0)
 
 #define RK3576_OVL_CTRL__YUV_MODE			BIT(0)
+#define RK3576_OVL_CTRL__SDR2HDR_PATH			BIT(5)
 #define RK3576_OVL_BG_MIX_CTRL__BG_DLY			GENMASK(31, 24)
 
 #define RK3576_DSP_IF_CFG_DONE_IMD			BIT(31)
diff --git a/drivers/gpu/drm/rockchip/rockchip_vop2_reg.c b/drivers/gpu/drm/rockchip/rockchip_vop2_reg.c
--- a/drivers/gpu/drm/rockchip/rockchip_vop2_reg.c
+++ b/drivers/gpu/drm/rockchip/rockchip_vop2_reg.c
@@ -2486,7 +2486,8 @@
 
 	bg_dly = vp->data->pre_scan_max_dly[VOP2_DLY_WIN] +
 		 vp->data->pre_scan_max_dly[VOP2_DLY_LAYER_MIX] +
-		 vp->data->pre_scan_max_dly[VOP2_DLY_HDR_MIX];
+		 vp->data->pre_scan_max_dly[VOP2_DLY_HDR_MIX] +
+		 (vp->sdr2hdr ? vp->data->sdr2hdr_dly : 0);
 
 	vop2_writel(vp->vop2, RK3576_OVL_BG_MIX_CTRL(vp->id),
 		    FIELD_PREP(RK3576_OVL_BG_MIX_CTRL__BG_DLY, bg_dly));
@@ -2606,6 +2607,89 @@
  * port assignment and the delay of the windows live in the OVL_SYS block
  * instead of the window registers.
  */
+/* the SDR to HDR stage's fixed terms, as Rockchip's userspace sets them for a PQ output */
+#define RK3528_SDR_CFG_COE1_PQ		4913
+#define RK3528_HDRVIVID_CTRL_S2H	0x203
+#define RK3528_SDR_SMGAIN_WORDS		64
+#define RK3528_SDR_SMGAIN_UNITY		(1024 | 1024 << 16)
+
+static const u32 rk3528_sdr_inv_gamma[] = {
+	0x00310000, 0x022100df, 0x068d0402, 0x0dbb09c8, 0x17de126b, 0x0f771e18,
+	0x16fe1306, 0x0df91b5f, 0x130a1066, 0x18f715e4, 0x1fc81c43, 0x1201101e,
+	0x16201402, 0x1ab5185b, 0x1fc51d2e, 0x116a100d, 0x145212d6, 0x177a15de,
+	0x1ae11926, 0x1e8a1cae, 0x105b0f63, 0x1262115a, 0x148b1372, 0x16d515ac,
+	0x19421807, 0x1bd11a85, 0x1e821d25, 0x100a1fe8, 0x117e10c2, 0x1304123f,
+	0x149b13ce, 0x1645156e, 0x18001720, 0x19ce18e5, 0x1bae1abb, 0x1da01ca4,
+	0x1fa51ea0, 0x10680fe3, 0x117910ef, 0x12931205, 0x13b71324, 0x14e4144c,
+	0x161b157f, 0x175c16ba, 0x18a61800, 0x19fa194f, 0x1b571aa7, 0x1cbf1c0a,
+	0x1e301d76, 0x1fab1eec, 0x10420fe2, 0x110810a4, 0x11d2116c, 0x12a11239,
+	0x1376130b, 0x144f13e2, 0x152e14be, 0x1611159f, 0x16fa1685, 0x17e81770,
+	0x18db1861, 0x19d31956, 0x1ad01a51, 0x1bd31b51, 0x1cdb1c56, 0x1de81d61,
+	0x1efa1e70, 0x0fcb1f85, 0x00001012,
+};
+
+static const u32 rk3528_sdr_inv_gamma_start[] = {
+	0x00510000, 0x009b006a, 0x011d00d4, 0x021f018e, 0x03f902e8, 0x00000400,
+};
+
+static const u32 rk3528_sdr_inv_gamma_change[] = {
+	0x000b0000, 0x0016000f, 0x0028001e, 0x004a0037, 0x00870064, 0x00000089,
+};
+
+static void rk3528_vop2_write_words(struct vop2 *vop2, u32 reg, const u32 *words,
+				    unsigned int n)
+{
+	unsigned int i;
+
+	for (i = 0; i < n; i++)
+		vop2_writel(vop2, reg + i * sizeof(u32), words[i]);
+}
+
+/* VP0's SDR to HDR stage, as its planes' colorop pipelines ask */
+static void rk3528_vop2_setup_sdr2hdr(struct vop2_video_port *vp)
+{
+	struct vop2 *vop2 = vp->vop2;
+	struct vop2_sdr2hdr s2h = {};
+	struct drm_plane *plane;
+	u32 ovl_ctrl, csc[5];
+	unsigned int i;
+
+	if (!vp->data->sdr2hdr_dly)
+		return;
+
+	drm_atomic_crtc_for_each_plane(plane, &vp->crtc) {
+		vop2_sdr2hdr_of(NULL, plane->state, &s2h);
+		break;
+	}
+	vp->sdr2hdr = s2h.on;
+
+	ovl_ctrl = vop2_readl(vop2, RK3576_OVL_CTRL(vp->id));
+	if (!s2h.on) {
+		vop2_writel(vop2, RK3576_OVL_CTRL(vp->id),
+			    ovl_ctrl & ~RK3576_OVL_CTRL__SDR2HDR_PATH);
+		vop2_writel(vop2, RK3528_SDR2HDR_CTRL, RK3528_SDR2HDR_CTRL__AUTO_GATING);
+		return;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(csc); i++)
+		csc[i] = s2h.csc[2 * i] | (2 * i + 1 < ARRAY_SIZE(s2h.csc) ?
+					   s2h.csc[2 * i + 1] << 16 : 0);
+	rk3528_vop2_write_words(vop2, RK3528_SDR_CSC_COE00_01, csc, ARRAY_SIZE(csc));
+	vop2_writel(vop2, RK3528_SDR_CFG_COE0, (u16)s2h.white & 0xfff);
+	vop2_writel(vop2, RK3528_SDR_CFG_COE1, RK3528_SDR_CFG_COE1_PQ);
+	rk3528_vop2_write_words(vop2, RK3528_SDRINVGAMMA_CURVE, rk3528_sdr_inv_gamma,
+				ARRAY_SIZE(rk3528_sdr_inv_gamma));
+	rk3528_vop2_write_words(vop2, RK3528_SDRINVGAMMA_STARTIDX, rk3528_sdr_inv_gamma_start,
+				ARRAY_SIZE(rk3528_sdr_inv_gamma_start));
+	rk3528_vop2_write_words(vop2, RK3528_SDRINVGAMMA_CHANGEIDX, rk3528_sdr_inv_gamma_change,
+				ARRAY_SIZE(rk3528_sdr_inv_gamma_change));
+	for (i = 0; i < RK3528_SDR_SMGAIN_WORDS; i++)
+		vop2_writel(vop2, RK3528_SDR_SMGAIN + i * sizeof(u32), RK3528_SDR_SMGAIN_UNITY);
+	vop2_writel(vop2, RK3528_HDRVIVID_CTRL, RK3528_HDRVIVID_CTRL_S2H);
+	vop2_writel(vop2, RK3528_SDR2HDR_CTRL, RK3528_SDR2HDR_CTRL__EN);
+	vop2_writel(vop2, RK3576_OVL_CTRL(vp->id), ovl_ctrl | RK3576_OVL_CTRL__SDR2HDR_PATH);
+}
+
 static void rk3528_vop2_setup_overlay(struct vop2_video_port *vp)
 {
 	struct vop2 *vop2 = vp->vop2;
@@ -2633,6 +2717,7 @@
 	vop2_writel(vop2, RK3528_OVL_SYS_PORT_SEL_IMD, port_sel);
 	rk3576_vop2_setup_layer_mixer(vp);
 	vop2_setup_alpha(vp);
+	rk3528_vop2_setup_sdr2hdr(vp);
 }
 
 static const struct vop2_ops rk3528_vop_ops = {
@@ -2651,6 +2736,7 @@
 		.offset = 0xc00,
 		.pixel_rate = 1,
 		.nlayers = 4,
+		.sdr2hdr_dly = 21,
 		.gamma_lut_len = 1024,
 	}, {
 		.id = 1,
