From: Artem Butusov <art.sormy@gmail.com>
Subject: [PATCH] arm64: dts: rockchip: rk3528: Add the crypto engine

The RK3528 has the RK3568's second-generation crypto engine at
0xffc40000, its clocks through SCMI, as the vendor's tree describes it.

Signed-off-by: Artem Butusov <art.sormy@gmail.com>
---
diff --git a/arch/arm64/boot/dts/rockchip/rk3528.dtsi b/arch/arm64/boot/dts/rockchip/rk3528.dtsi
--- a/arch/arm64/boot/dts/rockchip/rk3528.dtsi
+++ b/arch/arm64/boot/dts/rockchip/rk3528.dtsi
@@ -1425,6 +1425,17 @@
 		status = "disabled";
 	};
 
+	crypto: crypto@ffc40000 {
+		compatible = "rockchip,rk3528-crypto", "rockchip,rk3568-crypto";
+		reg = <0x0 0xffc40000 0x0 0x2000>;
+		interrupts = <GIC_SPI 19 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&scmi_clk SCMI_CORE_CRYPTO>, <&scmi_clk SCMI_ACLK_CRYPTO>,
+			 <&scmi_clk SCMI_HCLK_CRYPTO>;
+		clock-names = "core", "aclk", "hclk";
+		resets = <&cru SRST_CORE_CRYPTO>;
+		reset-names = "core";
+	};
+
 	rng: rng@ffc50000 {
 		compatible = "rockchip,rk3576-rng";
 		reg = <0x0 0xffc50000 0x0 0x200>;
