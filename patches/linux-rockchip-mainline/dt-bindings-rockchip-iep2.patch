From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Artem Butusov <art.sormy@gmail.com>
Date: Wed, 18 Nov 2026 00:51:29 -0500
Subject: [PATCH] dt-bindings: media: Add the Rockchip RK3528 IEP2 deinterlacer

The RK3528's IEP2 deinterlaces video frames in memory, behind an IOMMU
of its own, in the VO power domain.

Signed-off-by: Artem Butusov <art.sormy@gmail.com>
---
 .../bindings/media/rockchip,rk3528-iep.yaml   | 81 +++++++++++++++++++
 1 file changed, 81 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/media/rockchip,rk3528-iep.yaml

diff --git a/Documentation/devicetree/bindings/media/rockchip,rk3528-iep.yaml b/Documentation/devicetree/bindings/media/rockchip,rk3528-iep.yaml
new file mode 100644
index 0000000..574c746
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/rockchip,rk3528-iep.yaml
@@ -0,0 +1,81 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/rockchip,rk3528-iep.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Rockchip IEP2 deinterlacer
+
+maintainers:
+  - Artem Butusov <art.sormy@gmail.com>
+
+description:
+  The IEP2 deinterlaces video frames in memory, with edge-directed
+  interpolation, motion detection and comb, OSD and pulldown detection.
+
+properties:
+  compatible:
+    const: rockchip,rk3528-iep
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  clocks:
+    items:
+      - description: AXI clock
+      - description: AHB clock
+      - description: core clock
+
+  clock-names:
+    items:
+      - const: aclk
+      - const: hclk
+      - const: sclk
+
+  resets:
+    maxItems: 3
+
+  reset-names:
+    items:
+      - const: axi
+      - const: ahb
+      - const: core
+
+  iommus:
+    maxItems: 1
+
+  power-domains:
+    maxItems: 1
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - clocks
+  - clock-names
+  - resets
+  - reset-names
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/rockchip,rk3528-cru.h>
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+    #include <dt-bindings/power/rockchip,rk3528-power.h>
+    #include <dt-bindings/reset/rockchip,rk3528-cru.h>
+
+    iep@ff860000 {
+        compatible = "rockchip,rk3528-iep";
+        reg = <0xff860000 0x500>;
+        interrupts = <GIC_SPI 106 IRQ_TYPE_LEVEL_HIGH>;
+        clocks = <&cru ACLK_VDPP>, <&cru HCLK_VDPP>, <&cru CLK_CORE_VDPP>;
+        clock-names = "aclk", "hclk", "sclk";
+        resets = <&cru SRST_A_VDPP>, <&cru SRST_H_VDPP>, <&cru SRST_CORE_VDPP>;
+        reset-names = "axi", "ahb", "core";
+        iommus = <&iep_mmu>;
+        power-domains = <&power RK3528_PD_VO>;
+    };
