From: Artem Butusov <art.sormy@gmail.com>
Subject: [PATCH] PM / devfreq: rockchip-dfi: Add RK3528 support

The RK3528's DDR monitor is a single channel, as the RK3568's, and its
PMU GRF keeps the DRAM type and width in OS_REG18 and OS_REG19, laid
out as the RK3568's OS_REG2 and OS_REG3. Read them there, and count two
data clocks per cycle, as Rockchip's driver does.

Signed-off-by: Artem Butusov <art.sormy@gmail.com>
---
 drivers/devfreq/event/rockchip-dfi.c | 24 ++++++++++++++++++++----
 include/soc/rockchip/rk3528_grf.h    |  9 +++++++++
 2 files changed, 29 insertions(+), 4 deletions(-)

diff --git a/drivers/devfreq/event/rockchip-dfi.c b/drivers/devfreq/event/rockchip-dfi.c
index 255aee1..f9a5838 100644
--- a/drivers/devfreq/event/rockchip-dfi.c
+++ b/drivers/devfreq/event/rockchip-dfi.c
@@ -26,6 +26,7 @@
 
 #include <soc/rockchip/rockchip_grf.h>
 #include <soc/rockchip/rk3399_grf.h>
+#include <soc/rockchip/rk3528_grf.h>
 #include <soc/rockchip/rk3568_grf.h>
 #include <soc/rockchip/rk3588_grf.h>
 
@@ -737,13 +738,14 @@ static int rk3399_dfi_init(struct rockchip_dfi *dfi)
 	return 0;
 };
 
-static int rk3568_dfi_init(struct rockchip_dfi *dfi)
+static void rk3568_dfi_read_dram_info(struct rockchip_dfi *dfi, u32 reg2_offset,
+				      u32 reg3_offset)
 {
 	struct regmap *regmap_pmu = dfi->regmap_pmu;
 	u32 reg2, reg3;
 
-	regmap_read(regmap_pmu, RK3568_PMUGRF_OS_REG2, &reg2);
-	regmap_read(regmap_pmu, RK3568_PMUGRF_OS_REG3, &reg3);
+	regmap_read(regmap_pmu, reg2_offset, &reg2);
+	regmap_read(regmap_pmu, reg3_offset, &reg3);
 
 	/* lower 3 bits of the DDR type */
 	dfi->ddr_type = FIELD_GET(RK3568_PMUGRF_OS_REG2_DRAMTYPE_INFO, reg2);
@@ -762,9 +764,22 @@ static int rk3568_dfi_init(struct rockchip_dfi *dfi)
 
 	dfi->ddrmon_stride = 0x0; /* not relevant, we only have a single channel on this SoC */
 	dfi->ddrmon_ctrl_single = true;
+}
+
+static int rk3568_dfi_init(struct rockchip_dfi *dfi)
+{
+	rk3568_dfi_read_dram_info(dfi, RK3568_PMUGRF_OS_REG2, RK3568_PMUGRF_OS_REG3);
 
 	return 0;
-};
+}
+
+static int rk3528_dfi_init(struct rockchip_dfi *dfi)
+{
+	rk3568_dfi_read_dram_info(dfi, RK3528_PMUGRF_OS_REG18, RK3528_PMUGRF_OS_REG19);
+	dfi->count_multiplier = 2;
+
+	return 0;
+}
 
 static int rk3588_dfi_init(struct rockchip_dfi *dfi)
 {
@@ -809,6 +824,7 @@ static int rk3588_dfi_init(struct rockchip_dfi *dfi)
 
 static const struct of_device_id rockchip_dfi_id_match[] = {
 	{ .compatible = "rockchip,rk3399-dfi", .data = rk3399_dfi_init },
+	{ .compatible = "rockchip,rk3528-dfi", .data = rk3528_dfi_init },
 	{ .compatible = "rockchip,rk3568-dfi", .data = rk3568_dfi_init },
 	{ .compatible = "rockchip,rk3588-dfi", .data = rk3588_dfi_init },
 	{ },
diff --git a/include/soc/rockchip/rk3528_grf.h b/include/soc/rockchip/rk3528_grf.h
new file mode 100644
index 0000000..e9c24ce
--- /dev/null
+++ b/include/soc/rockchip/rk3528_grf.h
@@ -0,0 +1,9 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+#ifndef __SOC_RK3528_GRF_H
+#define __SOC_RK3528_GRF_H
+
+/* Laid out as the RK3568's OS_REG2 and OS_REG3 */
+#define RK3528_PMUGRF_OS_REG18		0x248
+#define RK3528_PMUGRF_OS_REG19		0x24c
+
+#endif /* __SOC_RK3528_GRF_H */
