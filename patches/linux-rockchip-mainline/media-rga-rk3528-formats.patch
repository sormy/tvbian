From: Artem Butusov <art.sormy@gmail.com>
Subject: [PATCH] media: rockchip: rga: RK3528 XRGB, 10-bit sources and its destination limit

The RK3528's RGA2E takes what its datasheet lists beyond the RGA2's
table: XRGB8888 either way, and a packed 10-bit YUV 4:2:0 or 4:2:2
source, the NV15 and NV20 a 10-bit decode writes. A 10-bit source is the
8-bit semi-planar code with bits 27 and 28 of SRC_INFO, as the vendor
kernel sets them; it is offered on the output queue only. Neither scaled
nor turned, it reads each row's first burst from the wrong place: the
vendor kernel's tile path, forced, reads it right. XRGB8888 as a source
loses its alpha swap on XBGR8888, so it is ARGB32's format, its X as
alpha.

A packed row has no whole bytes per pixel: compute each plane's corner
addresses in bytes from the format's own bits per pixel, which also ends
a division by zero for a 10-bit chroma plane.

Its destination is 4096 a side, as the vendor kernel's rga2e output
range: 4608x2592 never completed.

Its vertical upscale is right for a source at most 2048 wide: 2048 wide
to 4096x2304 reads 39.7 dB, 2064 wide 31.3, 2560 wide 21.6, its rows
wrong. A capture size that would need one comes back with no upscale,
and a job set up for one, by a format set after, is failed.

Signed-off-by: Artem Butusov <art.sormy@gmail.com>
---
  drivers/media/platform/rockchip/rga/rga-hw.c | 101 +++++++++++++++++++--------
  drivers/media/platform/rockchip/rga/rga-hw.h |   9 ++-
  drivers/media/platform/rockchip/rga/rga.c    |  28 ++++++++
  drivers/media/platform/rockchip/rga/rga.h    |   2 +
  4 files changed, 110 insertions(+), 30 deletions(-)

diff --git a/drivers/media/platform/rockchip/rga/rga-hw.c b/drivers/media/platform/rockchip/rga/rga-hw.c
index 2fed2f6..5d7c1b8 100644
--- a/drivers/media/platform/rockchip/rga/rga-hw.c
+++ b/drivers/media/platform/rockchip/rga/rga-hw.c
@@ -37,50 +37,52 @@ static unsigned int rga_get_scaling(unsigned int src, unsigned int dst)
 	return (src > dst) ? ((dst << 16) / src) : ((src << 16) / dst);
 }
 
+/* The bytes x pixels take in a plane: a chroma plane's by its subsampled pixels */
+static unsigned int rga_plane_bytes(const struct v4l2_format_info *info,
+				    unsigned int plane, unsigned int x)
+{
+	if (plane)
+		x /= info->hdiv;
+	return x * info->bpp[plane] / info->bpp_div[plane];
+}
+
 static struct rga_corners_addrs
 rga_get_corner_addrs(struct rga_frame *frm, struct rga_addrs *addrs,
 		     unsigned int x, unsigned int y, unsigned int w, unsigned int h)
 {
 	struct rga_corners_addrs corner_addrs;
 	struct rga_addrs *lt, *lb, *rt, *rb;
-	const struct v4l2_format_info *format_info;
-	unsigned int x_div = 0,
-		     y_div = 0, y_stride = 0, uv_stride = 0, pixel_width = 0;
+	const struct v4l2_format_info *info;
+	unsigned int y_div, y_stride, uv_stride;
 
 	lt = &corner_addrs.left_top;
 	lb = &corner_addrs.left_bottom;
 	rt = &corner_addrs.right_top;
 	rb = &corner_addrs.right_bottom;
 
-	format_info = v4l2_format_info(frm->pix.pixelformat);
-	/* x_div is only used for the u/v planes.
-	 * When the format doesn't have these, use 1 to avoid a division by zero.
-	 */
-	if (format_info->bpp[1])
-		x_div = format_info->hdiv * format_info->bpp_div[1] /
-			format_info->bpp[1];
-	else
-		x_div = 1;
-	y_div = format_info->vdiv;
+	info = v4l2_format_info(frm->pix.pixelformat);
+	y_div = info->vdiv;
 	y_stride = frm->pix.plane_fmt[0].bytesperline;
-	uv_stride = y_stride / x_div;
-	pixel_width = y_stride / frm->pix.width;
+	/* a chroma row's bytes in proportion to a luma row's */
+	uv_stride = info->bpp[1] ?
+		    y_stride * info->bpp[1] * info->bpp_div[0] /
+		    (info->bpp_div[1] * info->bpp[0] * info->hdiv) : y_stride;
 
-	lt->y_addr = addrs->y_addr + y * y_stride + x * pixel_width;
-	lt->u_addr = addrs->u_addr + (y / y_div) * uv_stride + x / x_div;
-	lt->v_addr = addrs->v_addr + (y / y_div) * uv_stride + x / x_div;
+	lt->y_addr = addrs->y_addr + y * y_stride + rga_plane_bytes(info, 0, x);
+	lt->u_addr = addrs->u_addr + (y / y_div) * uv_stride + rga_plane_bytes(info, 1, x);
+	lt->v_addr = addrs->v_addr + (y / y_div) * uv_stride + rga_plane_bytes(info, 1, x);
 
 	lb->y_addr = lt->y_addr + (h - 1) * y_stride;
 	lb->u_addr = lt->u_addr + (h / y_div - 1) * uv_stride;
 	lb->v_addr = lt->v_addr + (h / y_div - 1) * uv_stride;
 
-	rt->y_addr = lt->y_addr + (w - 1) * pixel_width;
-	rt->u_addr = lt->u_addr + w / x_div - 1;
-	rt->v_addr = lt->v_addr + w / x_div - 1;
+	rt->y_addr = lt->y_addr + rga_plane_bytes(info, 0, w - 1);
+	rt->u_addr = lt->u_addr + rga_plane_bytes(info, 1, w) - 1;
+	rt->v_addr = lt->v_addr + rga_plane_bytes(info, 1, w) - 1;
 
-	rb->y_addr = lb->y_addr + (w - 1) * pixel_width;
-	rb->u_addr = lb->u_addr + w / x_div - 1;
-	rb->v_addr = lb->v_addr + w / x_div - 1;
+	rb->y_addr = lb->y_addr + rga_plane_bytes(info, 0, w - 1);
+	rb->u_addr = lb->u_addr + rga_plane_bytes(info, 1, w) - 1;
+	rb->v_addr = lb->v_addr + rga_plane_bytes(info, 1, w) - 1;
 
 	return corner_addrs;
 }
@@ -190,6 +192,8 @@ static void rga_cmd_set_trans_info(struct rga_ctx *ctx)
 
 	src_info.data.format = in_fmt->hw_format;
 	src_info.data.swap = in_fmt->color_swap;
+	src_info.data.yuv10_en = in_fmt->yuv10;
+	src_info.data.yuv10_round_en = in_fmt->yuv10;
 	dst_info.data.format = out_fmt->hw_format;
 	dst_info.data.swap = out_fmt->color_swap;
 
@@ -284,6 +288,17 @@ static void rga_cmd_set_trans_info(struct rga_ctx *ctx)
 			rga_get_scaling(src_h - 1, scale_dst_h - 1);
 	}
 
+	/*
+	 * A 10-bit source neither scaled nor turned reads each row's first burst
+	 * from the wrong place: as the vendor kernel, force its tile path.
+	 */
+	if (in_fmt->yuv10 && src_info.data.rot_mode == RGA_SRC_ROT_MODE_0_DEGREE &&
+	    src_info.data.hscl_mode == RGA_SRC_HSCL_MODE_NO &&
+	    src_info.data.vscl_mode == RGA_SRC_VSCL_MODE_NO) {
+		src_info.data.hscl_mode = RGA_SRC_SCL_MODE_FORCE_TILE;
+		src_info.data.vscl_mode = RGA_SRC_SCL_MODE_FORCE_TILE;
+	}
+
 	/*
 	 * Calculate the framebuffer virtual strides and active size,
 	 * note that the step of vir_stride / vir_width is 4 byte words
@@ -507,6 +522,12 @@ static struct rga_fmt formats[] = {
 		.color_swap = RGA_COLOR_RB_SWAP,
 		.hw_format = RGA_COLOR_FMT_XBGR8888,
 	},
+	{
+		.fourcc = V4L2_PIX_FMT_XRGB32,
+		/* a source's alpha swap is lost on XBGR8888: ARGB32's, its X as alpha */
+		.color_swap = RGA_COLOR_ALPHA_SWAP,
+		.hw_format = RGA_COLOR_FMT_ABGR8888,
+	},
 	{
 		.fourcc = V4L2_PIX_FMT_RGB24,
 		.color_swap = RGA_COLOR_NONE_SWAP,
@@ -557,6 +578,18 @@ static struct rga_fmt formats[] = {
 		.color_swap = RGA_COLOR_NONE_SWAP,
 		.hw_format = RGA_COLOR_FMT_YUV422SP,
 	},
+	{
+		.fourcc = V4L2_PIX_FMT_NV15,
+		.color_swap = RGA_COLOR_NONE_SWAP,
+		.hw_format = RGA_COLOR_FMT_YUV420SP,
+		.yuv10 = true,
+	},
+	{
+		.fourcc = V4L2_PIX_FMT_NV20,
+		.color_swap = RGA_COLOR_NONE_SWAP,
+		.hw_format = RGA_COLOR_FMT_YUV422SP,
+		.yuv10 = true,
+	},
 	{
 		.fourcc = V4L2_PIX_FMT_YUV420,
 		.color_swap = RGA_COLOR_NONE_SWAP,
@@ -584,7 +617,8 @@ static void *rga_adjust_and_map_format(struct rga_ctx *ctx,
 		return &formats[0];
 
 	for (i = 0; i < ARRAY_SIZE(formats); i++) {
-		if (formats[i].fourcc == format->pixelformat)
+		if (formats[i].fourcc == format->pixelformat &&
+		    (is_output || !formats[i].yuv10))
 			return &formats[i];
 	}
 
@@ -594,11 +628,18 @@ static void *rga_adjust_and_map_format(struct rga_ctx *ctx,
 
 static int rga_enum_format(struct v4l2_fmtdesc *f)
 {
-	if (f->index >= ARRAY_SIZE(formats))
-		return -EINVAL;
+	bool output = V4L2_TYPE_IS_OUTPUT(f->type);
+	unsigned int i, index = 0;
 
-	f->pixelformat = formats[f->index].fourcc;
-	return 0;
+	for (i = 0; i < ARRAY_SIZE(formats); i++) {
+		if (formats[i].yuv10 && !output)
+			continue;
+		if (index++ == f->index) {
+			f->pixelformat = formats[i].fourcc;
+			return 0;
+		}
+	}
+	return -EINVAL;
 }
 
 const struct rga_hw rga2_hw = {
@@ -633,6 +674,8 @@ const struct rga_hw rga2e_hw = {
 	.max_width = MAX_WIDTH,
 	.min_height = MIN_HEIGHT,
 	.max_height = MAX_HEIGHT,
+	.max_out_size = RGA2E_MAX_OUT_SIZE,
+	.max_vscale_up_width = RGA2E_MAX_VSCALE_UP_WIDTH,
 	.max_scaling_factor = MAX_SCALING_FACTOR,
 	.stride_alignment = 4,
 	.features = RGA_FEATURE_FLIP
diff --git a/drivers/media/platform/rockchip/rga/rga-hw.h b/drivers/media/platform/rockchip/rga/rga-hw.h
index 4e51862..dfe3c44 100644
--- a/drivers/media/platform/rockchip/rga/rga-hw.h
+++ b/drivers/media/platform/rockchip/rga/rga-hw.h
@@ -13,6 +13,8 @@
 /* Hardware limits */
 #define MAX_WIDTH 8192
 #define MAX_HEIGHT 8192
+#define RGA2E_MAX_OUT_SIZE 4096
+#define RGA2E_MAX_VSCALE_UP_WIDTH 2048
 
 #define MIN_WIDTH 34
 #define MIN_HEIGHT 34
@@ -134,6 +136,7 @@
 #define RGA_SRC_VSCL_MODE_NO 0
 #define RGA_SRC_VSCL_MODE_DOWN 1
 #define RGA_SRC_VSCL_MODE_UP 2
+#define RGA_SRC_SCL_MODE_FORCE_TILE 3
 
 #define RGA_SRC_TRANS_ENABLE_R 1
 #define RGA_SRC_TRANS_ENABLE_G 2
@@ -223,7 +226,10 @@ union rga_src_info {
 		unsigned int dither_up_en:1;
 		unsigned int bic_coe_sel:2;
 		/* [26:31] */
-		unsigned int reserved:6;
+		unsigned int reserved0:1;
+		unsigned int yuv10_en:1;
+		unsigned int yuv10_round_en:1;
+		unsigned int reserved:3;
 	} data;
 };
 
@@ -443,6 +449,7 @@ struct rga_fmt {
 	u32 fourcc;
 	u8 color_swap;
 	u8 hw_format;
+	bool yuv10;	/* packed 10-bit samples, a source only */
 };
 
 #endif
diff --git a/drivers/media/platform/rockchip/rga/rga.c b/drivers/media/platform/rockchip/rga/rga.c
index 8a503e9..f731a9d 100644
--- a/drivers/media/platform/rockchip/rga/rga.c
+++ b/drivers/media/platform/rockchip/rga/rga.c
@@ -36,6 +36,15 @@ module_param(debug, int, 0644);
 /* a 4096x4096 job takes tens of milliseconds */
 #define RGA_WATCHDOG_MS 1000
 
+/* A vertical upscale of a source wider than the engine's line buffer, which it scales wrong */
+static bool rga_vscale_too_wide(const struct rga_ctx *ctx, u32 dst_w, u32 dst_h)
+{
+	u32 limit = ctx->rga->hw->max_vscale_up_width;
+	u32 rows = ctx->rotate == 90 || ctx->rotate == 270 ? dst_w : dst_h;
+
+	return limit && ctx->in.crop.width > limit && rows > ctx->in.crop.height;
+}
+
 static void device_run(void *prv)
 {
 	struct rga_ctx *ctx = prv;
@@ -50,6 +59,13 @@ static void device_run(void *prv)
 	}
 	spin_unlock_irqrestore(&rga->ctrl_lock, flags);
 
+	if (rga_vscale_too_wide(ctx, ctx->out.crop.width, ctx->out.crop.height)) {
+		v4l2_m2m_buf_done(v4l2_m2m_src_buf_remove(ctx->fh.m2m_ctx), VB2_BUF_STATE_ERROR);
+		v4l2_m2m_buf_done(v4l2_m2m_dst_buf_remove(ctx->fh.m2m_ctx), VB2_BUF_STATE_ERROR);
+		v4l2_m2m_job_finish(rga->m2m_dev, ctx->fh.m2m_ctx);
+		return;
+	}
+
 	rga->curr = ctx;
 
 	src = v4l2_m2m_next_src_buf(ctx->fh.m2m_ctx);
@@ -462,6 +478,10 @@ static int vidioc_try_fmt(struct file *file, void *priv, struct v4l2_format *f)
 		frmsize.step_width = 2;
 		frmsize.step_height = 2;
 	}
+	if (V4L2_TYPE_IS_CAPTURE(f->type) && hw->max_out_size) {
+		frmsize.max_width = min(frmsize.max_width, hw->max_out_size);
+		frmsize.max_height = min(frmsize.max_height, hw->max_out_size);
+	}
 
 	if (V4L2_TYPE_IS_CAPTURE(f->type)) {
 		const struct rga_frame *frm;
@@ -477,6 +497,14 @@ static int vidioc_try_fmt(struct file *file, void *priv, struct v4l2_format *f)
 		/* disallow values not announced in vidioc_enum_fmt */
 		pix_fmt->colorspace = frm->pix.colorspace;
 		pix_fmt->xfer_func = frm->pix.xfer_func;
+
+		/* no vertical upscale the engine would get wrong: the source's rows at most */
+		if (rga_vscale_too_wide(ctx, pix_fmt->width, pix_fmt->height)) {
+			if (ctx->rotate == 90 || ctx->rotate == 270)
+				pix_fmt->width = ctx->in.crop.height;
+			else
+				pix_fmt->height = ctx->in.crop.height;
+		}
 	}
 
 	hw->adjust_and_map_format(ctx, pix_fmt, V4L2_TYPE_IS_OUTPUT(f->type));
diff --git a/drivers/media/platform/rockchip/rga/rga.h b/drivers/media/platform/rockchip/rga/rga.h
index 00d977e..13bbe83 100644
--- a/drivers/media/platform/rockchip/rga/rga.h
+++ b/drivers/media/platform/rockchip/rga/rga.h
@@ -151,6 +151,8 @@ struct rga_hw {
 	size_t cmdbuf_size;
 	u32 min_width, min_height;
 	u32 max_width, max_height;
+	u32 max_out_size;	/* a destination's side, where less than a source's */
+	u32 max_vscale_up_width;	/* the widest source it scales up vertically */
 	u8 max_scaling_factor;
 	u8 stride_alignment;
 	u8 features;
