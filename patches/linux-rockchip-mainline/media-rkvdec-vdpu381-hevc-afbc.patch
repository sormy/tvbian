From: Artem Butusov <art.sormy@gmail.com>
Subject: [PATCH] media: rkvdec: Add AFBC output to the VDPU381 HEVC decoder

The VDPU381 writes its pictures as AFBC when asked, which a display
controller scans out at a fraction of the memory bandwidth a linear
NV12 picture takes. Offer the non-split AFBC YUV420 16x16 formats after
the linear ones for HEVC, 8-bit and 10-bit.

The decoder lays AFBC out as Rockchip's MPP does: a 16-byte header per
16x16 block, header rows aligned to 64 pixels and running 64 rows past
the picture, the payload after them on a 4K boundary. Register 20 holds
the payload's offset in bits 4 to 31 then, where a linear picture's luma
size starts at bit 0: describe both.

The picture starts 4 lines into its surface; report where through the
capture queue's compose selection, so a player crops them.

Signed-off-by: Artem Butusov <art.sormy@gmail.com>
---
 .../platform/rockchip/rkvdec/rkvdec-vdpu381-hevc.c |  5 +--
 .../platform/rockchip/rkvdec/rkvdec-vdpu381-regs.h | 39 ++++++++++++++++++++---
 .../platform/rockchip/rkvdec/rkvdec.c              | 72 +++++++++++++++++++++++++++++++++++++++++--
 .../platform/rockchip/rkvdec/rkvdec.h              | 32 +++++++++++++++++++
 4 files changed, 137 insertions(+), 11 deletions(-)

diff --git a/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-hevc.c b/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-hevc.c
index e1936e8..927d687 100644
--- a/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-hevc.c
+++ b/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-hevc.c
@@ -426,10 +426,7 @@ static void config_registers(struct rkvdec_ctx *ctx,
 	hor_virstride = dst_fmt->plane_fmt[0].bytesperline;
 	ver_virstride = dst_fmt->height;
 	y_virstride = hor_virstride * ver_virstride;
-
-	regs->common.reg018_y_hor_stride.y_hor_virstride = hor_virstride / 16;
-	regs->common.reg019_uv_hor_stride.uv_hor_virstride = hor_virstride / 16;
-	regs->common.reg020_y_stride.y_virstride = y_virstride / 16;
+	rkvdec_vdpu381_set_picture(&regs->common, dst_fmt, y_virstride);
 
 	/* Activate block gating */
 	regs->common.reg026_block_gating_en.inter_auto_gating_e = 1;
diff --git a/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-regs.h b/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-regs.h
index 7b92ac3..154f566 100644
--- a/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-regs.h
+++ b/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-regs.h
@@ -10,6 +10,8 @@
 
 #include <linux/types.h>
 
+#include "rkvdec.h"
+
 #ifndef _RKVDEC_REGS_H_
 #define _RKVDEC_REGS_H_
 
@@ -168,10 +170,16 @@ struct rkvdec_vdpu381_regs_common {
 		u32 reserved		: 16;
 	} reg019_uv_hor_stride;
 
-	struct {
-		u32 y_virstride		: 28;
-		u32 reserved		: 4;
-	} reg020_y_stride;
+	union {
+		struct {
+			u32 y_virstride		: 28;
+			u32 reserved		: 4;
+		} reg020_y_stride;
+		struct {
+			u32 reserved		: 4;
+			u32 payload_st_offset	: 28;
+		} reg020_fbc_payload_off;
+	};
 
 	struct {
 		u32 inter_error_prc_mode		: 1;
@@ -661,4 +669,27 @@ struct rkvdec_vdpu381_regs_vp9 {
 	struct rkvdec_vdpu381_regs_vp9_addr			vp9_addr;
 } __packed;
 
+/*
+ * The decoded picture's layout: linear by its stride and luma size, AFBC by
+ * its header row and its payload's offset.
+ */
+static inline void
+rkvdec_vdpu381_set_picture(struct rkvdec_vdpu381_regs_common *common,
+			   const struct v4l2_pix_format_mplane *pix, u32 y_virstride)
+{
+	u32 hor_virstride = pix->plane_fmt[0].bytesperline;
+
+	if (v4l2_is_format_afbc(pix->pixelformat)) {
+		hor_virstride = rkvdec_afbc_hdr_stride(pix->width);
+		common->reg012_secondary_en.fbc_e = 1;
+		common->reg020_fbc_payload_off.payload_st_offset =
+			rkvdec_afbc_payload_offset(pix->width, pix->height) / 16;
+	} else {
+		common->reg020_y_stride.y_virstride = y_virstride / 16;
+	}
+
+	common->reg018_y_hor_stride.y_hor_virstride = hor_virstride / 16;
+	common->reg019_uv_hor_stride.uv_hor_virstride = hor_virstride / 16;
+}
+
 #endif /* __RKVDEC_REGS_H__ */
diff --git a/drivers/media/platform/rockchip/rkvdec/rkvdec.c b/drivers/media/platform/rockchip/rkvdec/rkvdec.c
index a7335c8..b00297b 100644
--- a/drivers/media/platform/rockchip/rkvdec/rkvdec.c
+++ b/drivers/media/platform/rockchip/rkvdec/rkvdec.c
@@ -98,12 +98,33 @@ static u32 vdpu383_colmv_size(u16 width, u16 height)
 	return ALIGN(width, 64) * ALIGN(height, 16);
 }
 
+static void rkvdec_fill_afbc_pixfmt(struct v4l2_pix_format_mplane *pix_mp)
+{
+	const struct v4l2_format_info *info = v4l2_format_info(pix_mp->pixelformat);
+	struct v4l2_plane_pix_format *plane = &pix_mp->plane_fmt[0];
+	u32 hdr_stride = rkvdec_afbc_hdr_stride(pix_mp->width);
+	u32 blocks = hdr_stride / RKVDEC_AFBC_BLOCK *
+		     rkvdec_afbc_block_rows(pix_mp->height);
+	u32 block_bytes = pix_mp->pixelformat == V4L2_PIX_FMT_AFBC_YUV420_16x16_10 ?
+			  RKVDEC_AFBC_BLOCK_BYTES_10BIT : RKVDEC_AFBC_BLOCK_BYTES_8BIT;
+
+	pix_mp->num_planes = 1;
+	/* A framebuffer's pitch gives the display its header row */
+	plane->bytesperline = hdr_stride * info->bpp[0] / info->bpp_div[0];
+	plane->sizeimage = rkvdec_afbc_payload_offset(pix_mp->width, pix_mp->height) +
+			   blocks * block_bytes;
+}
+
 static void rkvdec_fill_decoded_pixfmt(struct rkvdec_ctx *ctx,
 				       struct v4l2_pix_format_mplane *pix_mp)
 {
 	const struct rkvdec_variant *variant = ctx->dev->variant;
 
-	v4l2_fill_pixfmt_mp(pix_mp, pix_mp->pixelformat, pix_mp->width, pix_mp->height);
+	if (v4l2_is_format_afbc(pix_mp->pixelformat))
+		rkvdec_fill_afbc_pixfmt(pix_mp);
+	else
+		v4l2_fill_pixfmt_mp(pix_mp, pix_mp->pixelformat, pix_mp->width,
+				    pix_mp->height);
 
 	ctx->colmv_offset = pix_mp->plane_fmt[0].sizeimage;
 
@@ -303,6 +324,25 @@ static const struct rkvdec_decoded_fmt_desc rkvdec_hevc_decoded_fmts[] = {
 	},
 };
 
+static const struct rkvdec_decoded_fmt_desc rkvdec_vdpu381_hevc_decoded_fmts[] = {
+	{
+		.fourcc = V4L2_PIX_FMT_NV12,
+		.image_fmt = RKVDEC_IMG_FMT_420_8BIT,
+	},
+	{
+		.fourcc = V4L2_PIX_FMT_NV15,
+		.image_fmt = RKVDEC_IMG_FMT_420_10BIT,
+	},
+	{
+		.fourcc = V4L2_PIX_FMT_AFBC_YUV420_16x16,
+		.image_fmt = RKVDEC_IMG_FMT_420_8BIT,
+	},
+	{
+		.fourcc = V4L2_PIX_FMT_AFBC_YUV420_16x16_10,
+		.image_fmt = RKVDEC_IMG_FMT_420_10BIT,
+	},
+};
+
 static const struct rkvdec_ctrl_desc rkvdec_h264_ctrl_descs[] = {
 	{
 		.cfg.id = V4L2_CID_STATELESS_H264_DECODE_PARAMS,
@@ -562,8 +602,8 @@ static const struct rkvdec_coded_fmt_desc vdpu381_coded_fmts[] = {
 		},
 		.ctrls = &vdpu38x_hevc_ctrls,
 		.ops = &rkvdec_vdpu381_hevc_fmt_ops,
-		.num_decoded_fmts = ARRAY_SIZE(rkvdec_hevc_decoded_fmts),
-		.decoded_fmts = rkvdec_hevc_decoded_fmts,
+		.num_decoded_fmts = ARRAY_SIZE(rkvdec_vdpu381_hevc_decoded_fmts),
+		.decoded_fmts = rkvdec_vdpu381_hevc_decoded_fmts,
 		.subsystem_flags = VB2_V4L2_FL_SUPPORTS_M2M_HOLD_CAPTURE_BUF,
 	},
 	{
@@ -893,6 +933,31 @@ static int rkvdec_g_capture_fmt(struct file *file, void *priv,
 	return 0;
 }
 
+static int rkvdec_g_selection(struct file *file, void *priv,
+			      struct v4l2_selection *s)
+{
+	struct rkvdec_ctx *ctx = file_to_rkvdec_ctx(file);
+	const struct v4l2_pix_format_mplane *pix = &ctx->decoded_fmt.fmt.pix_mp;
+	bool hevc = ctx->coded_fmt.fmt.pix_mp.pixelformat == V4L2_PIX_FMT_HEVC_SLICE;
+	u32 top = hevc && v4l2_is_format_afbc(pix->pixelformat) ?
+		  RKVDEC_AFBC_HEVC_TOP_LINES : 0;
+
+	if (s->type != V4L2_BUF_TYPE_VIDEO_CAPTURE)
+		return -EINVAL;
+
+	switch (s->target) {
+	case V4L2_SEL_TGT_COMPOSE:
+	case V4L2_SEL_TGT_COMPOSE_DEFAULT:
+		s->r = (struct v4l2_rect){ 0, top, pix->width, pix->height };
+		return 0;
+	case V4L2_SEL_TGT_COMPOSE_BOUNDS:
+		s->r = (struct v4l2_rect){ 0, 0, pix->width, pix->height + top };
+		return 0;
+	}
+
+	return -EINVAL;
+}
+
 static int rkvdec_enum_output_fmt(struct file *file, void *priv,
 				  struct v4l2_fmtdesc *f)
 {
@@ -933,6 +998,7 @@ static const struct v4l2_ioctl_ops rkvdec_ioctl_ops = {
 	.vidioc_g_fmt_vid_cap_mplane = rkvdec_g_capture_fmt,
 	.vidioc_enum_fmt_vid_out = rkvdec_enum_output_fmt,
 	.vidioc_enum_fmt_vid_cap = rkvdec_enum_capture_fmt,
+	.vidioc_g_selection = rkvdec_g_selection,
 
 	.vidioc_reqbufs = v4l2_m2m_ioctl_reqbufs,
 	.vidioc_querybuf = v4l2_m2m_ioctl_querybuf,
diff --git a/drivers/media/platform/rockchip/rkvdec/rkvdec.h b/drivers/media/platform/rockchip/rkvdec/rkvdec.h
index d73ec94..28d2b44 100644
--- a/drivers/media/platform/rockchip/rkvdec/rkvdec.h
+++ b/drivers/media/platform/rockchip/rkvdec/rkvdec.h
@@ -12,10 +12,12 @@
 #define RKVDEC_H_
 
 #include <linux/platform_device.h>
+#include <linux/sizes.h>
 #include <linux/videodev2.h>
 #include <linux/wait.h>
 #include <linux/clk.h>
 
+#include <media/v4l2-common.h>
 #include <media/v4l2-ctrls.h>
 #include <media/v4l2-device.h>
 #include <media/v4l2-ioctl.h>
@@ -144,6 +146,36 @@ struct rkvdec_dev {
 	const struct rkvdec_variant *variant;
 };
 
+/*
+ * The decoder's AFBC: 16x16 blocks, a 16-byte header for each, header rows
+ * aligned to 64 pixels and running 64 rows past the picture, the payload
+ * after them on a 4K boundary.
+ */
+#define RKVDEC_AFBC_BLOCK		16
+#define RKVDEC_AFBC_ROW_ALIGN		64
+#define RKVDEC_AFBC_EXTRA_ROWS		64
+#define RKVDEC_AFBC_BLOCK_BYTES_8BIT	384
+#define RKVDEC_AFBC_BLOCK_BYTES_10BIT	512
+/* An HEVC picture starts this many lines into its AFBC surface */
+#define RKVDEC_AFBC_HEVC_TOP_LINES	4
+
+static inline u32 rkvdec_afbc_hdr_stride(u32 width)
+{
+	return ALIGN(width, RKVDEC_AFBC_ROW_ALIGN);
+}
+
+static inline u32 rkvdec_afbc_block_rows(u32 height)
+{
+	return (ALIGN(height, RKVDEC_AFBC_BLOCK) + RKVDEC_AFBC_EXTRA_ROWS) /
+	       RKVDEC_AFBC_BLOCK;
+}
+
+static inline u32 rkvdec_afbc_payload_offset(u32 width, u32 height)
+{
+	return ALIGN(rkvdec_afbc_hdr_stride(width) * rkvdec_afbc_block_rows(height),
+		     SZ_4K);
+}
+
 struct rkvdec_ctx {
 	struct v4l2_fh fh;
 	struct v4l2_format coded_fmt;
