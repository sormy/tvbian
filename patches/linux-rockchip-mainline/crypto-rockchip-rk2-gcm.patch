  drivers/crypto/rockchip/Makefile          |   3 +-
  drivers/crypto/rockchip/rk2_crypto.c      |  69 ++++++--
  drivers/crypto/rockchip/rk2_crypto.h      |  34 ++++
  drivers/crypto/rockchip/rk2_crypto_aead.c | 268 ++++++++++++++++++++++++++++++
  5 files changed, 362 insertions(+), 14 deletions(-)

