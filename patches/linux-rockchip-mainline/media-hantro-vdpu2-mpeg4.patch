--- /dev/null
+++ b/drivers/media/platform/verisilicon/hantro_mpeg4.c
@@ -0,0 +1,44 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Hantro VPU codec driver: MPEG-4 Part 2 and H.263 decoding buffers
+ */
+
+#include "hantro.h"
+
+#define MPEG4_QTABLE_SIZE	(64 * 2)	/* intra, then inter */
+#define MPEG4_MV_BYTES_PER_MB	16
+
+static int hantro_mpeg4_alloc(struct hantro_dev *vpu, struct hantro_aux_buf *buf, size_t size)
+{
+	buf->size = size;
+	buf->cpu = dma_alloc_coherent(vpu->dev, size, &buf->dma, GFP_KERNEL);
+	return buf->cpu ? 0 : -ENOMEM;
+}
+
+int hantro_mpeg4_dec_init(struct hantro_ctx *ctx)
+{
+	struct hantro_mpeg4_dec_hw_ctx *mpeg4 = &ctx->mpeg4_dec;
+	struct hantro_dev *vpu = ctx->dev;
+	size_t mbs = MB_WIDTH(ctx->dst_fmt.width) * MB_HEIGHT(ctx->dst_fmt.height);
+	int ret;
+
+	ret = hantro_mpeg4_alloc(vpu, &mpeg4->qtable, MPEG4_QTABLE_SIZE);
+	if (ret)
+		return ret;
+
+	ret = hantro_mpeg4_alloc(vpu, &mpeg4->mv, mbs * MPEG4_MV_BYTES_PER_MB);
+	if (ret)
+		dma_free_coherent(vpu->dev, mpeg4->qtable.size, mpeg4->qtable.cpu,
+				  mpeg4->qtable.dma);
+	return ret;
+}
+
+void hantro_mpeg4_dec_exit(struct hantro_ctx *ctx)
+{
+	struct hantro_mpeg4_dec_hw_ctx *mpeg4 = &ctx->mpeg4_dec;
+	struct hantro_dev *vpu = ctx->dev;
+
+	dma_free_coherent(vpu->dev, mpeg4->mv.size, mpeg4->mv.cpu, mpeg4->mv.dma);
+	dma_free_coherent(vpu->dev, mpeg4->qtable.size, mpeg4->qtable.cpu,
+			  mpeg4->qtable.dma);
+}
