diff --git a/drivers/media/platform/verisilicon/rockchip_vpu2_hw_mpeg4_dec.c b/drivers/media/platform/verisilicon/rockchip_vpu2_hw_mpeg4_dec.c
new file mode 100644
index 0000000..0208087
--- /dev/null
+++ b/drivers/media/platform/verisilicon/rockchip_vpu2_hw_mpeg4_dec.c
@@ -0,0 +1,267 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Hantro VPU codec driver: Rockchip VDPU2 MPEG-4 Part 2 and H.263 decoding,
+ * the registers as Rockchip's MPP programs them
+ */
+
+#include <linux/bitfield.h>
+#include <linux/math64.h>
+#include <media/mpeg4-ctrls.h>
+#include <media/v4l2-mem2mem.h>
+#include "hantro.h"
+#include "hantro_hw.h"
+
+#define VDPU_SWREG(nr)			((nr) * 4)
+#define VDPU_NUM_REGS			160
+#define VDPU_REG_CLR_CACHE		0x810
+
+#define VDPU_REG_QTABLE_BASE		VDPU_SWREG(61)
+#define VDPU_REG_DIR_MV_BASE		VDPU_SWREG(62)
+#define VDPU_REG_DEC_OUT_BASE		VDPU_SWREG(63)
+#define VDPU_REG_RLC_VLC_BASE		VDPU_SWREG(64)
+#define VDPU_REG_REFER0_BASE		VDPU_SWREG(131)
+#define VDPU_REG_REFER2_BASE		VDPU_SWREG(134)
+#define VDPU_REG_REFER3_BASE		VDPU_SWREG(135)
+#define VDPU_REG_REFER1_BASE		VDPU_SWREG(148)
+
+#define VDPU_REG_DEC_E(v)		((v) ? BIT(0) : 0)
+#define VDPU_REG_FILTERING_DIS(v)	((v) ? BIT(8) : 0)
+#define VDPU_REG_INIT_QP(v)		(((v) << 25) & GENMASK(30, 25))
+#define VDPU_REG_STREAM_LEN(v)		(((v) << 0) & GENMASK(23, 0))
+#define VDPU_REG_APF_THRESHOLD(v)	(((v) << 17) & GENMASK(30, 17))
+#define VDPU_REG_DEC_MODE(v)		(((v) << 0) & GENMASK(3, 0))
+#define VDPU_REG_DEC_STRENDIAN_E(v)	((v) ? BIT(5) : 0)
+#define VDPU_REG_DEC_STRSWAP32_E(v)	((v) ? BIT(4) : 0)
+#define VDPU_REG_DEC_OUTSWAP32_E(v)	((v) ? BIT(3) : 0)
+#define VDPU_REG_DEC_INSWAP32_E(v)	((v) ? BIT(2) : 0)
+#define VDPU_REG_DEC_OUT_ENDIAN(v)	((v) ? BIT(1) : 0)
+#define VDPU_REG_DEC_IN_ENDIAN(v)	((v) ? BIT(0) : 0)
+#define VDPU_REG_DEC_MAX_BURST(v)	(((v) << 16) & GENMASK(20, 16))
+#define VDPU_REG_PIC_INTERLACE_E(v)	((v) ? BIT(17) : 0)
+#define VDPU_REG_PIC_FIELDMODE_E(v)	((v) ? BIT(16) : 0)
+#define VDPU_REG_PIC_B_E(v)		((v) ? BIT(15) : 0)
+#define VDPU_REG_PIC_INTER_E(v)		((v) ? BIT(14) : 0)
+#define VDPU_REG_WRITE_MVS_E(v)		((v) ? BIT(10) : 0)
+#define VDPU_REG_DEC_TIMEOUT_E(v)	((v) ? BIT(5) : 0)
+#define VDPU_REG_DEC_CLK_GATE_E(v)	((v) ? BIT(4) : 0)
+#define VDPU_REG_PIC_MB_WIDTH(v)	(((v) << 23) & GENMASK(31, 23))
+#define VDPU_REG_MB_WIDTH_OFF(v)	(((v) << 19) & GENMASK(22, 19))
+#define VDPU_REG_PIC_MB_HEIGHT_P(v)	(((v) << 11) & GENMASK(18, 11))
+#define VDPU_REG_MB_HEIGHT_OFF(v)	(((v) << 7) & GENMASK(10, 7))
+#define VDPU_REG_TOPFIELDFIRST_E(v)	((v) ? BIT(5) : 0)
+#define VDPU_REG_STRM_START_BIT(v)	(((v) << 26) & GENMASK(31, 26))
+#define VDPU_REG_SYNC_MARKERS_E(v)	((v) ? BIT(25) : 0)
+#define VDPU_REG_QUANT_TYPE_1_E(v)	((v) ? BIT(24) : 0)
+#define VDPU_REG_INTRA_DC_VLC_THR(v)	(((v) << 16) & GENMASK(18, 16))
+#define VDPU_REG_VOP_TIME_INCR(v)	(((v) << 0) & GENMASK(15, 0))
+#define VDPU_REG_ALT_SCAN_FLAG_E(v)	((v) ? BIT(19) : 0)
+#define VDPU_REG_FCODE_FWD_HOR(v)	(((v) << 15) & GENMASK(18, 15))
+#define VDPU_REG_FCODE_FWD_VER(v)	(((v) << 11) & GENMASK(14, 11))
+#define VDPU_REG_FCODE_BWD_HOR(v)	(((v) << 7) & GENMASK(10, 7))
+#define VDPU_REG_FCODE_BWD_VER(v)	(((v) << 3) & GENMASK(6, 3))
+#define VDPU_REG_FWD_MV_Y_QPEL(v)	((v) ? BIT(2) : 0)
+#define VDPU_REG_ROUNDING(v)		((v) ? BIT(1) : 0)
+#define VDPU_REG_PREV_PIC_TYPE(v)	((v) ? BIT(0) : 0)
+#define VDPU_REG_TRB_PER_TRD(v)		(((v) << 0) & GENMASK(26, 0))
+#define VDPU_REG_PRED_TAP0(v)		(((v) << 22) & GENMASK(31, 22))
+#define VDPU_REG_PRED_TAP1(v)		(((v) << 12) & GENMASK(21, 12))
+#define VDPU_REG_PRED_TAP2(v)		(((v) << 2) & GENMASK(11, 2))
+#define VDPU_REG_PRED_TAP3(v)		(((v) << 22) & GENMASK(31, 22))
+
+#define VDPU_DEC_MODE_MPEG4		1
+#define VDPU_DEC_MODE_H263		2
+#define TRB_PER_TRD_SHIFT		27
+#define VDPU_APF_THRESHOLD		1
+/* MPEG-4's quarter-pixel interpolation filter, half of it, as MPP sets it */
+#define QPEL_TAP0			-1
+#define QPEL_TAP1			3
+#define QPEL_TAP2			-6
+#define QPEL_TAP3			20
+/* H.263 carries no VOL: MPP gives it the 29.97 Hz picture clock's resolution */
+#define H263_TIME_INCREMENT_RESOLUTION	30000
+
+static const u8 zigzag[64] = {
+	0,   1,  8, 16,  9,  2,  3, 10,
+	17, 24, 32, 25, 18, 11,  4,  5,
+	12, 19, 26, 33, 40, 48, 41, 34,
+	27, 20, 13,  6,  7, 14, 21, 28,
+	35, 42, 49, 56, 57, 50, 43, 36,
+	29, 22, 15, 23, 30, 37, 44, 51,
+	58, 59, 52, 45, 38, 31, 39, 46,
+	53, 60, 61, 54, 47, 55, 62, 63
+};
+
+/* TRB/TRD for direct mode, at 2^27, as the frame and either field period has it */
+static u32 trb_per_trd(s64 trb, s64 trd)
+{
+	return trd ? div64_s64((trb << TRB_PER_TRD_SHIFT) + trd - 1, trd) : 0;
+}
+
+static void rockchip_vpu2_mpeg4_dec_set_quantisation(struct hantro_ctx *ctx,
+						     const struct v4l2_ctrl_mpeg4_quantisation *q)
+{
+	u8 *qtable = ctx->mpeg4_dec.qtable.cpu;
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(zigzag); i++) {
+		qtable[zigzag[i]] = q->intra_quantiser_matrix[i];
+		qtable[zigzag[i] + 64] = q->non_intra_quantiser_matrix[i];
+	}
+}
+
+static void rockchip_vpu2_mpeg4_dec_set_refs(struct hantro_dev *vpu, struct hantro_ctx *ctx,
+					     const struct v4l2_ctrl_mpeg4_vop *vop,
+					     dma_addr_t current_addr, bool h263)
+{
+	dma_addr_t forward = current_addr, backward = current_addr, addr;
+
+	switch (vop->vop_coding_type) {
+	case V4L2_MPEG4_VOP_TYPE_B:
+		addr = hantro_get_ref(ctx, vop->backward_ref_ts);
+		if (addr)
+			backward = addr;
+		fallthrough;
+	case V4L2_MPEG4_VOP_TYPE_P:
+		addr = hantro_get_ref(ctx, vop->forward_ref_ts);
+		if (addr)
+			forward = addr;
+	}
+
+	vdpu_write_relaxed(vpu, forward, VDPU_REG_REFER0_BASE);
+	vdpu_write_relaxed(vpu, forward, VDPU_REG_REFER1_BASE);
+	if (h263)
+		return;
+	vdpu_write_relaxed(vpu, backward, VDPU_REG_REFER2_BASE);
+	vdpu_write_relaxed(vpu, backward, VDPU_REG_REFER3_BASE);
+}
+
+int rockchip_vpu2_mpeg4_dec_run(struct hantro_ctx *ctx)
+{
+	struct hantro_dev *vpu = ctx->dev;
+	const struct v4l2_ctrl_mpeg4_quantisation *q;
+	const struct v4l2_ctrl_mpeg4_slice *slice;
+	const struct v4l2_ctrl_mpeg4_vol *vol;
+	const struct v4l2_ctrl_mpeg4_vop *vop;
+	struct vb2_v4l2_buffer *src_buf, *dst_buf;
+	dma_addr_t current_addr;
+	bool h263, b, p;
+	u32 reg;
+	int i;
+
+	src_buf = hantro_get_src_buf(ctx);
+	dst_buf = hantro_get_dst_buf(ctx);
+
+	hantro_start_prepare_run(ctx);
+
+	/* As MPP: the decoder's cache cleared and every register written, none left to chance */
+	vdpu_write_relaxed(vpu, 1, VDPU_REG_CLR_CACHE);
+	for (i = 0; i < VDPU_NUM_REGS; i++)
+		vdpu_write_relaxed(vpu, 0, VDPU_SWREG(i));
+
+	vol = hantro_get_ctrl(ctx, V4L2_CID_STATELESS_MPEG4_VOL);
+	vop = hantro_get_ctrl(ctx, V4L2_CID_STATELESS_MPEG4_VOP);
+	q = hantro_get_ctrl(ctx, V4L2_CID_STATELESS_MPEG4_QUANTISATION);
+	slice = hantro_get_ctrl(ctx, V4L2_CID_STATELESS_MPEG4_SLICE);
+	h263 = vol->flags & V4L2_MPEG4_VOL_FLAG_SHORT_VIDEO_HEADER;
+	b = vop->vop_coding_type == V4L2_MPEG4_VOP_TYPE_B;
+	p = vop->vop_coding_type == V4L2_MPEG4_VOP_TYPE_P;
+
+	/* The decoder parses video packet headers by it: zero hangs it */
+	if (!h263 && !vop->vop_time_increment_resolution) {
+		hantro_end_prepare_run(ctx);
+		return -EINVAL;
+	}
+
+	vdpu_write_relaxed(vpu, VDPU_REG_FILTERING_DIS(1), VDPU_SWREG(50));
+
+	reg = VDPU_REG_INIT_QP(slice->quant_scale) |
+	      VDPU_REG_STREAM_LEN(vb2_get_plane_payload(&src_buf->vb2_buf, 0));
+	vdpu_write_relaxed(vpu, reg, VDPU_SWREG(51));
+
+	vdpu_write_relaxed(vpu, VDPU_REG_APF_THRESHOLD(VDPU_APF_THRESHOLD), VDPU_SWREG(52));
+
+	reg = VDPU_REG_DEC_MODE(h263 ? VDPU_DEC_MODE_H263 : VDPU_DEC_MODE_MPEG4);
+	vdpu_write_relaxed(vpu, reg, VDPU_SWREG(53));
+
+	reg = VDPU_REG_DEC_STRENDIAN_E(1) |
+	      VDPU_REG_DEC_STRSWAP32_E(1) |
+	      VDPU_REG_DEC_OUTSWAP32_E(1) |
+	      VDPU_REG_DEC_INSWAP32_E(1) |
+	      VDPU_REG_DEC_OUT_ENDIAN(1) |
+	      VDPU_REG_DEC_IN_ENDIAN(1);
+	vdpu_write_relaxed(vpu, reg, VDPU_SWREG(54));
+
+	vdpu_write_relaxed(vpu, VDPU_REG_DEC_MAX_BURST(16), VDPU_SWREG(56));
+
+	reg = VDPU_REG_PRED_TAP0(QPEL_TAP0) |
+	      VDPU_REG_PRED_TAP1(QPEL_TAP1) |
+	      VDPU_REG_PRED_TAP2(QPEL_TAP2);
+	vdpu_write_relaxed(vpu, reg, VDPU_SWREG(59));
+	vdpu_write_relaxed(vpu, VDPU_REG_PRED_TAP3(QPEL_TAP3), VDPU_SWREG(153));
+
+	reg = VDPU_REG_PIC_INTERLACE_E(vol->flags & V4L2_MPEG4_VOL_FLAG_INTERLACED) |
+	      VDPU_REG_PIC_B_E(b) |
+	      VDPU_REG_PIC_INTER_E(vop->vop_coding_type != V4L2_MPEG4_VOP_TYPE_I) |
+	      VDPU_REG_WRITE_MVS_E(p && !h263) |
+	      VDPU_REG_DEC_TIMEOUT_E(1) |
+	      VDPU_REG_DEC_CLK_GATE_E(1);
+	vdpu_write_relaxed(vpu, reg, VDPU_SWREG(57));
+
+	/* H.263 pictures may end inside a macroblock, MPEG-4's per MPP do not */
+	reg = VDPU_REG_PIC_MB_WIDTH(MB_WIDTH(vol->width)) |
+	      VDPU_REG_PIC_MB_HEIGHT_P(MB_HEIGHT(vol->height)) |
+	      VDPU_REG_MB_WIDTH_OFF(h263 ? vol->width & (MB_DIM - 1) : 0) |
+	      VDPU_REG_MB_HEIGHT_OFF(h263 ? vol->height & (MB_DIM - 1) : 0) |
+	      VDPU_REG_TOPFIELDFIRST_E(vop->flags & V4L2_MPEG4_VOP_FLAG_TOP_FIELD_FIRST);
+	vdpu_write_relaxed(vpu, reg, VDPU_SWREG(120));
+
+	reg = VDPU_REG_STRM_START_BIT(slice->data_bit_offset) |
+	      VDPU_REG_SYNC_MARKERS_E(1) |
+	      VDPU_REG_QUANT_TYPE_1_E(vol->flags & V4L2_MPEG4_VOL_FLAG_QUANT_TYPE) |
+	      VDPU_REG_INTRA_DC_VLC_THR(vop->intra_dc_vlc_thr) |
+	      VDPU_REG_VOP_TIME_INCR(h263 ? H263_TIME_INCREMENT_RESOLUTION :
+				     vop->vop_time_increment_resolution);
+	vdpu_write_relaxed(vpu, reg, VDPU_SWREG(122));
+
+	/* MPP keeps the low bit of the last reference's type: whether it was predicted */
+	reg = VDPU_REG_ALT_SCAN_FLAG_E(vop->flags & V4L2_MPEG4_VOP_FLAG_ALTERNATE_VERTICAL_SCAN) |
+	      VDPU_REG_FCODE_FWD_HOR(h263 ? 1 : vop->vop_fcode_forward) |
+	      VDPU_REG_FCODE_FWD_VER(h263 ? 1 : vop->vop_fcode_forward) |
+	      VDPU_REG_FCODE_BWD_HOR(b ? vop->vop_fcode_backward : 0) |
+	      VDPU_REG_FCODE_BWD_VER(b ? vop->vop_fcode_backward : 0) |
+	      VDPU_REG_FWD_MV_Y_QPEL(vol->flags & V4L2_MPEG4_VOL_FLAG_QUARTER_SAMPLE) |
+	      VDPU_REG_ROUNDING(!b && !h263 && vop->flags & V4L2_MPEG4_VOP_FLAG_ROUNDING_TYPE) |
+	      VDPU_REG_PREV_PIC_TYPE(vop->last_ref_coding_type & 1);
+	vdpu_write_relaxed(vpu, reg, VDPU_SWREG(136));
+
+	if (b) {
+		vdpu_write_relaxed(vpu, VDPU_REG_TRB_PER_TRD(trb_per_trd(vop->trb, vop->trd)),
+				   VDPU_SWREG(137));
+		vdpu_write_relaxed(vpu, VDPU_REG_TRB_PER_TRD(trb_per_trd(2 * vop->trb - 1,
+									 2 * vop->trd - 1)),
+				   VDPU_SWREG(138));
+		vdpu_write_relaxed(vpu, VDPU_REG_TRB_PER_TRD(trb_per_trd(2 * vop->trb + 1,
+									 2 * vop->trd + 1)),
+				   VDPU_SWREG(139));
+	}
+
+	/* H.263 has no matrices, B pictures or direct mode: MPP leaves those registers zero */
+	if (!h263) {
+		rockchip_vpu2_mpeg4_dec_set_quantisation(ctx, q);
+		vdpu_write_relaxed(vpu, ctx->mpeg4_dec.qtable.dma, VDPU_REG_QTABLE_BASE);
+		vdpu_write_relaxed(vpu, ctx->mpeg4_dec.mv.dma, VDPU_REG_DIR_MV_BASE);
+	}
+
+	vdpu_write_relaxed(vpu, vb2_dma_contig_plane_dma_addr(&src_buf->vb2_buf, 0),
+			   VDPU_REG_RLC_VLC_BASE);
+	current_addr = vb2_dma_contig_plane_dma_addr(&dst_buf->vb2_buf, 0);
+	vdpu_write_relaxed(vpu, current_addr, VDPU_REG_DEC_OUT_BASE);
+	rockchip_vpu2_mpeg4_dec_set_refs(vpu, ctx, vop, current_addr, h263);
+
+	hantro_end_prepare_run(ctx);
+
+	reg = vdpu_read(vpu, VDPU_SWREG(57)) | VDPU_REG_DEC_E(1);
+	vdpu_write(vpu, reg, VDPU_SWREG(57));
+
+	return 0;
+}
