From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Artem Butusov <art.sormy@gmail.com>
Date: Wed, 18 Nov 2026 00:42:19 -0500
Subject: [PATCH] media: rockchip: rkvenc: Add the RK3528 VEPU540C HEVC back
 end

The RK3528's VEPU540C encodes HEVC as well as H.264. Program it with
the registers and tuning Rockchip's MPP gives this block: its HEVC
syntax, motion search, RDO and intra pre-decision words, one QP a
picture as for H.264. The block codes 32x32 CTUs with transforms up to
16x16, not the RK3568's 64x64 and 32x32, so the sequence takes both
sizes from the variant and the SPS states them. Its extension line
buffer steps by 32 pixels, not H.264's 64.

HEVC is held to 5120x2880, the largest size it encodes every time:
past it, from 6144x3456, a picture is now and then garbage with no
error to show for it. A raw size set before the coded format may
exceed it, so allocating buffers checks the size against the codec.

Signed-off-by: Artem Butusov <art.sormy@gmail.com>
---
 .../platform/rockchip/rkvenc/rkvenc-hevc.c    |   2 +
 .../platform/rockchip/rkvenc/rkvenc-nal.c     |  10 +-
 .../platform/rockchip/rkvenc/rkvenc-v4l2.c    |  35 +-
 .../rockchip/rkvenc/rkvenc-vepu540c-regs.h    |  71 ++++
 .../rockchip/rkvenc/rkvenc-vepu540c.c         | 348 ++++++++++++++++--
 .../platform/rockchip/rkvenc/rkvenc-vepu541.h |   2 +
 .../media/platform/rockchip/rkvenc/rkvenc.c   |  11 +-
 .../media/platform/rockchip/rkvenc/rkvenc.h   |   8 +
 8 files changed, 456 insertions(+), 31 deletions(-)

diff --git a/drivers/media/platform/rockchip/rkvenc/rkvenc-hevc.c b/drivers/media/platform/rockchip/rkvenc/rkvenc-hevc.c
index 49bf3cc..3b05466 100644
--- a/drivers/media/platform/rockchip/rkvenc/rkvenc-hevc.c
+++ b/drivers/media/platform/rockchip/rkvenc/rkvenc-hevc.c
@@ -31,6 +31,8 @@ int rkvenc_hevc_setup(struct rkvenc_ctx *ctx)
 	memset(seq, 0, sizeof(*seq));
 	seq->width = ctx->width;
 	seq->height = ctx->height;
+	seq->log2_ctb_size = ctx->dev->variant->hevc_log2_ctb_size;
+	seq->log2_max_tb_size = ctx->dev->variant->hevc_log2_max_tb_size;
 	seq->level_idc = rkvenc_hevc_level(ctx->c.level);
 	seq->log2_max_poc_lsb_m4 = 4;
 	seq->pic_init_qp = ctx->c.p_frame_qp;
diff --git a/drivers/media/platform/rockchip/rkvenc/rkvenc-nal.c b/drivers/media/platform/rockchip/rkvenc/rkvenc-nal.c
index b5a3f01..25e10fb 100644
--- a/drivers/media/platform/rockchip/rkvenc/rkvenc-nal.c
+++ b/drivers/media/platform/rockchip/rkvenc/rkvenc-nal.c
@@ -14,6 +14,8 @@
 #define HEVC_NAL_VPS		32
 #define HEVC_NAL_SPS		33
 #define HEVC_NAL_PPS		34
+#define HEVC_LOG2_MIN_CB_SIZE	3	/* 8x8 coding blocks */
+#define HEVC_LOG2_MIN_TB_SIZE	2	/* 4x4 transforms */
 
 struct nal_bw {
 	u8 buf[NAL_RBSP_MAX];
@@ -262,10 +264,10 @@ static void hevc_sps_write(struct nal_bw *bw, const struct rkvenc_hevc_seq *seq)
 	bw_ue(bw, 1);			/* sps_max_dec_pic_buffering_minus1 */
 	bw_ue(bw, 0);
 	bw_ue(bw, 0);
-	bw_ue(bw, 0);			/* min CU 8x8 */
-	bw_ue(bw, 3);			/* CTU 64x64 */
-	bw_ue(bw, 0);			/* min TU 4x4 */
-	bw_ue(bw, 3);			/* max TU 32x32 */
+	bw_ue(bw, HEVC_LOG2_MIN_CB_SIZE - 3);
+	bw_ue(bw, seq->log2_ctb_size - HEVC_LOG2_MIN_CB_SIZE);
+	bw_ue(bw, HEVC_LOG2_MIN_TB_SIZE - 2);
+	bw_ue(bw, seq->log2_max_tb_size - HEVC_LOG2_MIN_TB_SIZE);
 	bw_ue(bw, 0);
 	bw_ue(bw, 0);
 	bw_put(bw, 0, 1);
diff --git a/drivers/media/platform/rockchip/rkvenc/rkvenc-v4l2.c b/drivers/media/platform/rockchip/rkvenc/rkvenc-v4l2.c
index b049f23..50d482d 100644
--- a/drivers/media/platform/rockchip/rkvenc/rkvenc-v4l2.c
+++ b/drivers/media/platform/rockchip/rkvenc/rkvenc-v4l2.c
@@ -209,6 +209,16 @@ static u32 rkvenc_capture_size(struct rkvenc_ctx *ctx)
 	return ctx->width * ctx->height / 2 + RKVENC_HDR_MAX;
 }
 
+static void rkvenc_max_size(const struct rkvenc_dev *dev,
+			    enum rkvenc_codec codec, u32 *width, u32 *height)
+{
+	const struct rkvenc_variant *v = dev->variant;
+	bool hevc = codec == RKVENC_CODEC_HEVC && v->hevc_max_width;
+
+	*width = hevc ? v->hevc_max_width : dev->max_width;
+	*height = hevc ? v->hevc_max_height : dev->max_height;
+}
+
 static int rkvenc_queue_setup(struct vb2_queue *vq, unsigned int *num_buffers,
 			      unsigned int *num_planes, unsigned int sizes[],
 			      struct device *alloc_devs[])
@@ -216,7 +226,12 @@ static int rkvenc_queue_setup(struct vb2_queue *vq, unsigned int *num_buffers,
 	struct rkvenc_ctx *ctx = vb2_get_drv_priv(vq);
 	const struct rkvenc_fmt *fmt;
 	unsigned int i;
-	u32 size;
+	u32 size, max_w, max_h;
+
+	/* The raw size may have been set before a codec that cannot take it */
+	rkvenc_max_size(ctx->dev, ctx->codec, &max_w, &max_h);
+	if (ctx->width > max_w || ctx->height > max_h)
+		return -EINVAL;
 
 	if (V4L2_TYPE_IS_OUTPUT(vq->type)) {
 		fmt = rkvenc_find_fmt(rkvenc_output_fmts,
@@ -694,6 +709,17 @@ static int rkvenc_enum_fmt_vid_cap(struct file *file, void *priv,
 	return rkvenc_enum_fmt(file, priv, f, true);
 }
 
+static void rkvenc_clamp_size(const struct rkvenc_dev *dev,
+			      enum rkvenc_codec codec,
+			      struct v4l2_pix_format_mplane *pix)
+{
+	u32 max_w, max_h;
+
+	rkvenc_max_size(dev, codec, &max_w, &max_h);
+	pix->width = clamp(round_up(pix->width, 2), 16, max_w);
+	pix->height = clamp(round_up(pix->height, 2), 16, max_h);
+}
+
 static void rkvenc_try_fmt_vid_out(struct rkvenc_ctx *ctx, struct v4l2_format *f)
 {
 	struct v4l2_pix_format_mplane *pix = &f->fmt.pix_mp;
@@ -709,8 +735,7 @@ static void rkvenc_try_fmt_vid_out(struct rkvenc_ctx *ctx, struct v4l2_format *f
 	}
 
 	pix->field = V4L2_FIELD_NONE;
-	pix->width = clamp(round_up(pix->width, 2), 16, ctx->dev->max_width);
-	pix->height = clamp(round_up(pix->height, 2), 16, ctx->dev->max_height);
+	rkvenc_clamp_size(ctx->dev, ctx->codec, pix);
 	pix->num_planes = fmt->num_planes;
 
 	bpl = ALIGN(pix->width, 16);
@@ -738,8 +763,8 @@ static void rkvenc_try_fmt_vid_cap(struct rkvenc_ctx *ctx, struct v4l2_format *f
 	}
 
 	pix->field = V4L2_FIELD_NONE;
-	pix->width = clamp(round_up(pix->width, 2), 16, ctx->dev->max_width);
-	pix->height = clamp(round_up(pix->height, 2), 16, ctx->dev->max_height);
+	rkvenc_clamp_size(ctx->dev, fmt->fourcc == V4L2_PIX_FMT_HEVC ?
+			  RKVENC_CODEC_HEVC : RKVENC_CODEC_H264, pix);
 	pix->num_planes = 1;
 	pix->plane_fmt[0].bytesperline = 0;
 
