+/* MPP's HEVC coarse search RAM sizing, for a global motion of zero */
+static void vepu540c_hevc_me_build(const struct rkvenc_frame *f,
+				   struct rkvenc_vepu540c_img *img)
+{
+	u32 lftw = CIME_SRCH_LFTW * CIME_W_UNIT;
+	u32 rgtw = CIME_SRCH_RGTW * CIME_W_UNIT;
+	u32 uph = CIME_SRCH_UPH * CIME_H_UNIT;
+	u32 dwnh = CIME_SRCH_DWNH * CIME_H_UNIT;
+	u32 line_w = DIV_ROUND_UP(ALIGN(f->src.width, HEVC_PIC_ALIGN),
+				  HEVC_CTU_SIZE);
+	u32 srch_h2 = (round_up(uph, 8) + dwnh) / 2 + HEVC_CIME_CTU_H2;
+	u32 srch_w8 = (round_up(lftw, 8) + rgtw + 7) / 8 + HEVC_CIME_CTU_W8;
+	u32 rama_h2 = round_up(srch_h2, 4);
+	u32 h2 = HEVC_CIME_CTU_H2, ramb_h2 = srch_h2;
+
+	while (CIME_RAMA_SIZE >
+	       (h2 - HEVC_CIME_CTU_H2) * line_w + ramb_h2 * srch_w8 &&
+	       h2 < rama_h2) {
+		h2 += HEVC_CIME_CTU_H2;
+		ramb_h2 = ramb_h2 > 2 * HEVC_CIME_CTU_H2 ?
+			  ramb_h2 - HEVC_CIME_CTU_H2 : HEVC_CIME_CTU_H2;
+	}
+	if (srch_h2 == 2 * HEVC_CIME_CTU_H2) {
+		h2 += HEVC_CIME_CTU_H2;
+		ramb_h2 = HEVC_CIME_CTU_H2;
+	}
+	if (CIME_RAMA_SIZE <
+	    (h2 - HEVC_CIME_CTU_H2) * line_w + ramb_h2 * srch_w8)
+		h2 -= HEVC_CIME_CTU_H2;
+
+	vepu540c_set(img, VEPU540C_ME_RNGE,
+		     FIELD_PREP(VEPU540C_ME_RNGE_CIME_DWNH, CIME_SRCH_DWNH) |
+		     FIELD_PREP(VEPU540C_ME_RNGE_CIME_UPH, CIME_SRCH_UPH) |
+		     FIELD_PREP(VEPU540C_ME_RNGE_CIME_RGTW, CIME_SRCH_RGTW) |
+		     FIELD_PREP(VEPU540C_ME_RNGE_CIME_LFTW, CIME_SRCH_LFTW) |
+		     FIELD_PREP(VEPU540C_ME_RNGE_DLT_FRM_NUM,
+				HEVC_ME_DLT_FRM_NUM));
+	vepu540c_set(img, VEPU540C_ME_CFG,
+		     FIELD_PREP(VEPU540C_ME_CFG_SRGN_MAX_NUM, SRGN_MAX_NUM) |
+		     FIELD_PREP(VEPU540C_ME_CFG_CIME_DIST_THRE,
+				CIME_DIST_THRE) |
+		     FIELD_PREP(VEPU540C_ME_CFG_RME_SRCH_H, RME_SRCH) |
+		     FIELD_PREP(VEPU540C_ME_CFG_RME_SRCH_V, RME_SRCH));
+	vepu540c_set(img, VEPU540C_ME_CACH,
+		     FIELD_PREP(VEPU540C_ME_CACH_CIME_SIZE_RAMA,
+				((h2 - HEVC_CIME_CTU_H2) * line_w +
+				 HEVC_CIME_CTU_H2 * srch_w8) / 4) |
+		     FIELD_PREP(VEPU540C_ME_CACH_CIME_HGT_RAMA, h2 / 2) |
+		     FIELD_PREP(VEPU540C_ME_CACH_CME_LINEBUF_W, line_w) |
+		     FIELD_PREP(VEPU540C_ME_CACH_FME_PREFSU_EN,
+				HEVC_FME_PREFSU_EN));
+}
