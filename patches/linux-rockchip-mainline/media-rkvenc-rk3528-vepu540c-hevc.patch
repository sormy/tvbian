+static void vepu540c_hevc_par_build(const struct rkvenc_frame *f,
+				    struct rkvenc_vepu540c_img *img)
+{
+	const u32 *lambda = f->intra ? rkvenc_hevc_lambda_a :
+				       rkvenc_hevc_lambda_b;
+	u32 i;
+
+	for (i = 0; i <= VEPU540C_QP_MAX; i++)
+		vepu540c_set(img, VEPU540C_RDO_WGTA_QP(i), lambda[i]);
+	vepu540c_set(img, VEPU540C_IPRD_LAMB_SATD, HEVC_LAMBDA_SATD_OFST);
+
+	vepu540c_set(img, VEPU540C_RDO_QUANT,
+		     FIELD_PREP(VEPU540C_RDO_QUANT_BIAS_I, HEVC_QNT_BIAS_I) |
+		     FIELD_PREP(VEPU540C_RDO_QUANT_BIAS_P, HEVC_QNT_BIAS_P));
+
+	vepu540c_set(img, VEPU540C_CIME_SQI_CFG,
+		     VEPU540C_CIME_SQI_CFG_PMV_NUM | VEPU540C_CIME_SQI_CFG_FUSE |
+		     FIELD_PREP(VEPU540C_CIME_SQI_CFG_MOVE_LAMBDA,
+				HEVC_MOVE_LAMBDA) |
+		     FIELD_PREP(VEPU540C_CIME_SQI_CFG_RIME_PRELVL,
+				HEVC_RIME_PRE_EN) |
+		     FIELD_PREP(VEPU540C_CIME_SQI_CFG_RIME_PRERSU,
+				HEVC_RIME_PRE_EN));
+	vepu540c_set(img, VEPU540C_CIME_MVD_TH,
+		     FIELD_PREP(VEPU540C_CIME_MVD_TH0, 8) |
+		     FIELD_PREP(VEPU540C_CIME_MVD_TH1, 20) |
+		     FIELD_PREP(VEPU540C_CIME_MVD_TH2, 32));
+	vepu540c_set(img, VEPU540C_CIME_MADP_TH, 16);
+	vepu540c_set(img, VEPU540C_CIME_MULTI, rkvenc_bytes(8, 12, 16, 20));
+	vepu540c_set(img, VEPU540C_RIME_MVD_TH,
+		     FIELD_PREP(VEPU540C_RIME_MVD_TH0, 1) |
+		     FIELD_PREP(VEPU540C_RIME_MVD_TH1, 2));
+	vepu540c_set(img, VEPU540C_RIME_MADP_TH, rkvenc_pair(8, 16));
+	vepu540c_set(img, VEPU540C_RIME_MULTI,
+		     FIELD_PREP(VEPU540C_RIME_MULTI0, 4) |
+		     FIELD_PREP(VEPU540C_RIME_MULTI1, 8) |
+		     FIELD_PREP(VEPU540C_RIME_MULTI2, 12));
+	vepu540c_set(img, VEPU540C_CMV_ST_TH, rkvenc_bytes(64, 96, 128, 0));
+}
