+static void vepu540c_hevc_syntax_build(const struct rkvenc_frame *f,
+				       struct rkvenc_vepu540c_img *img)
+{
+	const struct rkvenc_hevc_seq *seq = f->hevc.seq;
+	const struct rkvenc_hevc_pic *pic = &f->hevc;
+	u32 ctus = DIV_ROUND_UP(f->src.width, HEVC_CTU_SIZE) *
+		   DIV_ROUND_UP(f->src.height, HEVC_CTU_SIZE);
+	u32 enc_pic, sli0, sli1;
+
+	enc_pic = FIELD_PREP(VEPU540C_ENC_PIC_STND, VEPU540C_ENC_PIC_STND_HEVC) |
+		  VEPU540C_ENC_PIC_BS_SCP |
+		  FIELD_PREP(VEPU540C_ENC_PIC_QP, f->qp) |
+		  FIELD_PREP(VEPU540C_ENC_PIC_TOT_POC_NUM, f->intra ? 0 : 1) |
+		  FIELD_PREP(VEPU540C_ENC_PIC_LOG2_CTU_NUM, order_base_2(ctus));
+	if (f->referenced)
+		enc_pic |= VEPU540C_ENC_PIC_CUR_FRM_REF;
+	vepu540c_set(img, VEPU540C_ENC_PIC, enc_pic);
+
+	vepu540c_set(img, VEPU540C_RDO_CFG,
+		     FIELD_PREP(VEPU540C_HEVC_RDO_CU_INTER_E, HEVC_CU_INTER_EN) |
+		     FIELD_PREP(VEPU540C_HEVC_RDO_CU_INTRA_E, HEVC_CU_INTRA_EN) |
+		     VEPU540C_HEVC_RDO_CCWA_E |
+		     VEPU540C_HEVC_RDO_LAMBDA_CU16_AVG |
+		     VEPU540C_HEVC_RDO_YUVSKIP_CALC |
+		     VEPU540C_RDO_CFG_ATF_E | VEPU540C_RDO_CFG_ATR_E);
+	vepu540c_set(img, VEPU540C_KLUT_OFST,
+		     FIELD_PREP(VEPU540C_KLUT_OFST_CHRM, HEVC_CHRM_KLUT_OFST) |
+		     FIELD_PREP(VEPU540C_KLUT_OFST_INTER_CHRM_DIST,
+				HEVC_INTER_CHRM_DIST));
+	vepu540c_set(img, VEPU540C_HEVC_SAO_CFG,
+		     FIELD_PREP(VEPU540C_HEVC_SAO_LAMBDA_MULTI,
+				HEVC_SAO_LAMBDA_MULTI));
+
+	vepu540c_set(img, VEPU540C_SYNT_NAL,
+		     FIELD_PREP(VEPU540C_HEVC_NAL_UNIT_TYPE, pic->nal_unit_type));
+	vepu540c_set(img, VEPU540C_SYNT_SPS,
+		     (seq->sao ? VEPU540C_HEVC_SPS_SAO_EN : 0) |
+		     FIELD_PREP(VEPU540C_HEVC_SPS_LOG2_MAX_POC_LSB,
+				seq->log2_max_poc_lsb_m4) |
+		     (seq->strong_intra_smoothing ?
+		      VEPU540C_HEVC_SPS_STRG_INTRA_SMTH : 0));
+	vepu540c_set(img, VEPU540C_SYNT_PPS,
+		     (seq->cabac_init_present ?
+		      VEPU540C_HEVC_PPS_CBC_INIT_PRSNT : 0) |
+		     FIELD_PREP(VEPU540C_SYNT_PPS_PIC_INIT_QP, seq->pic_init_qp) |
+		     VEPU540C_HEVC_PPS_CU_QP_DLT_EN);
+
+	sli0 = VEPU540C_HEVC_SLI0_MERGE_UP | VEPU540C_HEVC_SLI0_MERGE_LEFT |
+	       VEPU540C_HEVC_SLI0_PIC_OUT_FLG |
+	       FIELD_PREP(VEPU540C_HEVC_SLI0_SLI_TYPE,
+			  f->intra ? HEVC_SLICE_I : HEVC_SLICE_P);
+	if (seq->cabac_init_present)
+		sli0 |= VEPU540C_HEVC_SLI0_CBC_INIT_FLG;
+	if (seq->sao)
+		sli0 |= VEPU540C_HEVC_SLI0_SAO_LUMA | VEPU540C_HEVC_SLI0_SAO_CHRM;
+	vepu540c_set(img, VEPU540C_SYNT_SLI0, sli0);
+
+	/* The header QP must match the QP the picture is quantised with */
+	sli1 = FIELD_PREP(VEPU540C_HEVC_SLI1_SLI_QP, f->qp) |
+	       FIELD_PREP(VEPU540C_HEVC_SLI1_MAX_MRG_CND, seq->max_merge_cand) |
+	       VEPU540C_HEVC_SLI1_COL_FRM_L0 |
+	       FIELD_PREP(VEPU540C_HEVC_SLI1_TC_OFST,
+			  rkvenc_s2u(seq->tc_offset, 4)) |
+	       FIELD_PREP(VEPU540C_HEVC_SLI1_BETA_OFST,
+			  rkvenc_s2u(seq->beta_offset, 4));
+	if (seq->deblock_disabled)
+		sli1 |= VEPU540C_HEVC_SLI1_DBLK_DIS;
+	vepu540c_set(img, VEPU540C_SYNT_SLI1, sli1);
+	vepu540c_set(img, VEPU540C_SYNT_SLI2,
+		     FIELD_PREP(VEPU540C_HEVC_SLI2_POC_LSB, pic->poc_lsb));
+
+	/* A P picture's one reference, the picture before it */
+	if (!f->intra)
+		vepu540c_set(img, VEPU540C_HEVC_SYNT_REFM1,
+			     FIELD_PREP(VEPU540C_HEVC_REFM1_USED_BY_S0, 1) |
+			     FIELD_PREP(VEPU540C_HEVC_REFM1_NUM_NEG_PIC, 1));
+}
