From: Artem Butusov <art.sormy@gmail.com>
Subject: [PATCH] iommu/rockchip: Reset a bank stuck on a replayed fault

A master's write to an unmapped address leaves the bank with the write
in its replay buffer: each PAGE_FAULT_DONE replays it, it faults again,
and the bank never reaches STALL_ACTIVE (status 0x6b on an RK3528: idle,
a fault active, the replay buffer not empty). rk_iommu_enable() then
gives up before its force reset, every later enable fails the same way,
and the master's jobs come out blank until a reboot.

Such a bank is idle: no transfer runs that a reset could cut. Where the
stall times out with every bank idle and a fault active, reset it
unstalled. And after a fault, once the master is idle, enable the
stuck bank again from a work, so its next job runs without waiting for
the IOMMU's next resume.

Signed-off-by: Artem Butusov <art.sormy@gmail.com>
---
  drivers/iommu/rockchip-iommu.c | 55 +++++++++++++++++++++++++++++++++++++++++-
  1 file changed, 54 insertions(+), 1 deletion(-)

diff --git a/drivers/iommu/rockchip-iommu.c b/drivers/iommu/rockchip-iommu.c
index 228208b..541dffd 100644
--- a/drivers/iommu/rockchip-iommu.c
+++ b/drivers/iommu/rockchip-iommu.c
@@ -46,6 +46,8 @@
 #define RK_MMU_POLL_PERIOD_US		100
 #define RK_MMU_FORCE_RESET_TIMEOUT_US	100000
 #define RK_MMU_POLL_TIMEOUT_US		1000
+/* how long a faulting master may take to finish its job and go idle */
+#define RK_MMU_FAULT_IDLE_US		500000
 
 /* RK_MMU_STATUS fields */
 #define RK_MMU_STATUS_PAGING_ENABLED       BIT(0)
@@ -117,6 +119,7 @@ struct rk_iommu {
 	struct list_head node; /* entry in rk_iommu_domain.iommus */
 	struct iommu_domain *domain; /* domain to which iommu is attached */
 	const struct rk_iommu_ops *rk_ops;
+	struct work_struct fault_work; /* resets a bank left stuck by a fault */
 };
 
 struct rk_iommudata {
@@ -407,6 +410,25 @@ static bool rk_iommu_is_reset_done(struct rk_iommu *iommu)
 	return done;
 }
 
+/*
+ * A bank whose master is idle but whose faulted write is still in its replay
+ * buffer faults again on every PAGE_FAULT_DONE and never stalls. Idle, it has
+ * no transfer a reset could cut: it is reset unstalled.
+ */
+static bool rk_iommu_is_stuck_on_fault(struct rk_iommu *iommu)
+{
+	int i;
+
+	for (i = 0; i < iommu->num_mmu; i++) {
+		u32 status = rk_iommu_read(iommu->bases[i], RK_MMU_STATUS);
+
+		if (!(status & RK_MMU_STATUS_IDLE) ||
+		    !(status & RK_MMU_STATUS_PAGE_FAULT_ACTIVE))
+			return false;
+	}
+	return true;
+}
+
 static int rk_iommu_enable_stall(struct rk_iommu *iommu)
 {
 	int ret, i;
@@ -641,6 +663,7 @@ static irqreturn_t rk_iommu_irq(int irq, void *dev_id)
 
 			rk_iommu_base_command(iommu->bases[i], RK_MMU_CMD_ZAP_CACHE);
 			rk_iommu_base_command(iommu->bases[i], RK_MMU_CMD_PAGE_FAULT_DONE);
+			schedule_work(&iommu->fault_work);
 		}
 
 		if (int_status & RK_MMU_IRQ_BUS_ERROR)
@@ -937,6 +960,34 @@ static void rk_iommu_disable(struct rk_iommu *iommu)
 }
 
 /* Must be called with iommu powered on and attached */
+static int rk_iommu_enable(struct rk_iommu *iommu);
+
+/*
+ * A fault whose write stays in the replay buffer leaves the bank stuck once its
+ * master is idle, its later jobs faulting too. Enabled again, the bank is reset.
+ * A suspended IOMMU is reset by its next resume.
+ */
+static void rk_iommu_fault_work(struct work_struct *work)
+{
+	struct rk_iommu *iommu = container_of(work, struct rk_iommu, fault_work);
+	bool stuck;
+	int ret;
+
+	if (pm_runtime_get_if_in_use(iommu->dev) <= 0)
+		return;
+	if (clk_bulk_enable(iommu->num_clocks, iommu->clocks))
+		goto out;
+	ret = readx_poll_timeout(rk_iommu_is_stuck_on_fault, iommu, stuck, stuck,
+				 RK_MMU_POLL_PERIOD_US, RK_MMU_FAULT_IDLE_US);
+	clk_bulk_disable(iommu->num_clocks, iommu->clocks);
+	if (!ret && iommu->domain != &rk_identity_domain) {
+		dev_warn(iommu->dev, "a bank stuck on a fault, resetting it\n");
+		rk_iommu_enable(iommu);
+	}
+out:
+	pm_runtime_put(iommu->dev);
+}
+
 static int rk_iommu_enable(struct rk_iommu *iommu)
 {
 	struct iommu_domain *domain = iommu->domain;
@@ -949,7 +1000,7 @@ static int rk_iommu_enable(struct rk_iommu *iommu)
 		return ret;
 
 	ret = rk_iommu_enable_stall(iommu);
-	if (ret)
+	if (ret && !rk_iommu_is_stuck_on_fault(iommu))
 		goto out_disable_clocks;
 
 	ret = rk_iommu_force_reset(iommu);
@@ -1284,6 +1335,7 @@ static int rk_iommu_probe(struct platform_device *pdev)
 
 	pm_runtime_enable(dev);
 
+	INIT_WORK(&iommu->fault_work, rk_iommu_fault_work);
 	for (i = 0; i < iommu->num_irq; i++) {
 		int irq = platform_get_irq(pdev, i);
 
@@ -1327,6 +1379,7 @@ static void rk_iommu_shutdown(struct platform_device *pdev)
 
 		devm_free_irq(iommu->dev, irq, iommu);
 	}
+	cancel_work_sync(&iommu->fault_work);
 
 	pm_runtime_force_suspend(&pdev->dev);
 }
