From: Artem Butusov <art.sormy@gmail.com>
Subject: [PATCH] PM / devfreq: rockchip-dfi: Count DDR3

The DFI counts DDR3 with DDRMON_CTRL bit 15, the vendor kernel's
DDR2_3_EN, which the driver never sets: a DDR3 board's DFI refuses to
start ("unsupported memory type 0x3"), and a DMC on it sees no load.
Select it for DDR3, and clear it for the other types.

Signed-off-by: Artem Butusov <art.sormy@gmail.com>
---
 drivers/devfreq/event/rockchip-dfi.c | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/drivers/devfreq/event/rockchip-dfi.c b/drivers/devfreq/event/rockchip-dfi.c
index f9a5838..15e31c8 100644
--- a/drivers/devfreq/event/rockchip-dfi.c
+++ b/drivers/devfreq/event/rockchip-dfi.c
@@ -34,6 +34,7 @@
 
 /* DDRMON_CTRL */
 #define DDRMON_CTRL	0x04
+#define DDRMON_CTRL_DDR23		BIT(15)
 #define DDRMON_CTRL_LPDDR5		BIT(6)
 #define DDRMON_CTRL_DDR4		BIT(5)
 #define DDRMON_CTRL_LPDDR4		BIT(4)
@@ -125,9 +126,16 @@ static int rockchip_dfi_ddrtype_to_ctrl(struct rockchip_dfi *dfi, u32 *ctrl)
 	u32 ddrmon_ver;
 
 	switch (dfi->ddr_type) {
+	case ROCKCHIP_DDRTYPE_DDR3:
+		*ctrl = FIELD_PREP_WM16(DDRMON_CTRL_DDR23, 1) |
+			FIELD_PREP_WM16(DDRMON_CTRL_LPDDR23, 0) |
+			FIELD_PREP_WM16(DDRMON_CTRL_LPDDR4, 0) |
+			FIELD_PREP_WM16(DDRMON_CTRL_LPDDR5, 0);
+		break;
 	case ROCKCHIP_DDRTYPE_LPDDR2:
 	case ROCKCHIP_DDRTYPE_LPDDR3:
-		*ctrl = FIELD_PREP_WM16(DDRMON_CTRL_LPDDR23, 1) |
+		*ctrl = FIELD_PREP_WM16(DDRMON_CTRL_DDR23, 0) |
+			FIELD_PREP_WM16(DDRMON_CTRL_LPDDR23, 1) |
 			FIELD_PREP_WM16(DDRMON_CTRL_LPDDR4, 0) |
 			FIELD_PREP_WM16(DDRMON_CTRL_LPDDR5, 0);
 		break;
