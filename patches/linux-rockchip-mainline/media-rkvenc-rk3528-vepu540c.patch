diff --git a/drivers/media/platform/rockchip/rkvenc/rkvenc-ref.c b/drivers/media/platform/rockchip/rkvenc/rkvenc-ref.c
index b0f15d3..aabd67b 100644
--- a/drivers/media/platform/rockchip/rkvenc/rkvenc-ref.c
+++ b/drivers/media/platform/rockchip/rkvenc/rkvenc-ref.c
@@ -14,6 +14,7 @@ enum {
 	RKVENC_BUF_BODY,
 	RKVENC_BUF_DSP,
 	RKVENC_BUF_CMV,
+	RKVENC_BUF_EBUF,
 };
 
 static void rkvenc_ref_free_slot(struct rkvenc_ctx *ctx, unsigned int i)
@@ -27,10 +28,12 @@ static void rkvenc_ref_free_slot(struct rkvenc_ctx *ctx, unsigned int i)
 	sizes[RKVENC_BUF_BODY] = ctx->slot_sz.rfp_body;
 	sizes[RKVENC_BUF_DSP] = ctx->slot_sz.dsp;
 	sizes[RKVENC_BUF_CMV] = ctx->slot_sz.cmv;
+	sizes[RKVENC_BUF_EBUF] = ctx->slot_sz.ebuf;
 	handles[RKVENC_BUF_HDR] = ctx->slot[i].rfp_hdr;
 	handles[RKVENC_BUF_BODY] = ctx->slot[i].rfp_body;
 	handles[RKVENC_BUF_DSP] = ctx->slot[i].dsp;
 	handles[RKVENC_BUF_CMV] = ctx->slot[i].cmv;
+	handles[RKVENC_BUF_EBUF] = ctx->slot[i].ebuf;
 
 	for (b = 0; b < RKVENC_SLOT_BUFS; b++) {
 		if (ctx->slot_cpu[i][b])
@@ -53,7 +56,8 @@ int rkvenc_ref_alloc(struct rkvenc_ctx *ctx)
 	if (ctx->slots_alloc)
 		return 0;
 
-	rkvenc_vepu541_slot_sizes(ctx->codec, ctx->width, ctx->height, sz);
+	ctx->dev->variant->ops->slot_sizes(ctx->codec, ctx->width, ctx->height,
+					   sz);
 
 	for (i = 0; i < RKVENC_SLOTS; i++) {
 		cpu = dma_alloc_attrs(dev, sz->rfp_hdr, &dma, GFP_KERNEL,
@@ -63,12 +67,15 @@ int rkvenc_ref_alloc(struct rkvenc_ctx *ctx)
 		ctx->slot_cpu[i][RKVENC_BUF_HDR] = cpu;
 		ctx->slot[i].rfp_hdr = lower_32_bits(dma);
 
-		cpu = dma_alloc_attrs(dev, sz->rfp_body, &dma, GFP_KERNEL,
-				      DMA_ATTR_NO_KERNEL_MAPPING);
-		if (!cpu)
-			goto err;
-		ctx->slot_cpu[i][RKVENC_BUF_BODY] = cpu;
-		ctx->slot[i].rfp_body = lower_32_bits(dma);
+		if (sz->rfp_body) {
+			cpu = dma_alloc_attrs(dev, sz->rfp_body, &dma,
+					      GFP_KERNEL,
+					      DMA_ATTR_NO_KERNEL_MAPPING);
+			if (!cpu)
+				goto err;
+			ctx->slot_cpu[i][RKVENC_BUF_BODY] = cpu;
+			ctx->slot[i].rfp_body = lower_32_bits(dma);
+		}
 
 		cpu = dma_alloc_attrs(dev, sz->dsp, &dma, GFP_KERNEL,
 				      DMA_ATTR_NO_KERNEL_MAPPING);
@@ -87,6 +94,15 @@ int rkvenc_ref_alloc(struct rkvenc_ctx *ctx)
 		} else {
 			ctx->slot[i].cmv = 0;
 		}
+
+		if (sz->ebuf) {
+			cpu = dma_alloc_attrs(dev, sz->ebuf, &dma, GFP_KERNEL,
+					      DMA_ATTR_NO_KERNEL_MAPPING);
+			if (!cpu)
+				goto err;
+			ctx->slot_cpu[i][RKVENC_BUF_EBUF] = cpu;
+			ctx->slot[i].ebuf = lower_32_bits(dma);
+		}
 	}
 
 	ctx->slots_alloc = true;
diff --git a/drivers/media/platform/rockchip/rkvenc/rkvenc-v4l2.c b/drivers/media/platform/rockchip/rkvenc/rkvenc-v4l2.c
index 3be496f..b049f23 100644
--- a/drivers/media/platform/rockchip/rkvenc/rkvenc-v4l2.c
+++ b/drivers/media/platform/rockchip/rkvenc/rkvenc-v4l2.c
@@ -45,6 +45,12 @@ rkvenc_find_fmt(const struct rkvenc_fmt *fmts, unsigned int n, u32 fourcc)
 	return NULL;
 }
 
+/* H.264 comes first, so that a core without HEVC lists only the head */
+static unsigned int rkvenc_num_capture_fmts(struct rkvenc_dev *dev)
+{
+	return dev->variant->h264_only ? 1 : ARRAY_SIZE(rkvenc_capture_fmts);
+}
+
 static bool rkvenc_is_h264(u32 fourcc)
 {
 	return fourcc == V4L2_PIX_FMT_H264;
@@ -663,9 +669,10 @@ static int rkvenc_querycap(struct file *file, void *priv,
 static int rkvenc_enum_fmt(struct file *file, void *priv,
 			   struct v4l2_fmtdesc *f, bool capture)
 {
+	struct rkvenc_ctx *ctx = fh_to_rkvenc_ctx(file->private_data);
 	const struct rkvenc_fmt *fmts = capture ? rkvenc_capture_fmts
 						: rkvenc_output_fmts;
-	unsigned int n = capture ? ARRAY_SIZE(rkvenc_capture_fmts)
+	unsigned int n = capture ? rkvenc_num_capture_fmts(ctx->dev)
 				 : ARRAY_SIZE(rkvenc_output_fmts);
 
 	if (f->index >= n)
@@ -723,7 +730,7 @@ static void rkvenc_try_fmt_vid_cap(struct rkvenc_ctx *ctx, struct v4l2_format *f
 	const struct rkvenc_fmt *fmt;
 
 	fmt = rkvenc_find_fmt(rkvenc_capture_fmts,
-			      ARRAY_SIZE(rkvenc_capture_fmts),
+			      rkvenc_num_capture_fmts(ctx->dev),
 			      pix->pixelformat);
 	if (!fmt) {
 		fmt = &rkvenc_capture_fmts[0];
