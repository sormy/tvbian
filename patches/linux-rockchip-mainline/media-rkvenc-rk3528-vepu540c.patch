 .../platform/rockchip/rkvenc/rkvenc-vepu541.h |   2 +
 .../media/platform/rockchip/rkvenc/rkvenc.c   | 153 +++--
 .../media/platform/rockchip/rkvenc/rkvenc.h   |  36 +-
