diff --git a/drivers/media/platform/rockchip/rkvenc/Kconfig b/drivers/media/platform/rockchip/rkvenc/Kconfig
index 1d76314..a49cf7e 100644
--- a/drivers/media/platform/rockchip/rkvenc/Kconfig
+++ b/drivers/media/platform/rockchip/rkvenc/Kconfig
@@ -1,6 +1,6 @@
 # SPDX-License-Identifier: GPL-2.0-only
 config VIDEO_ROCKCHIP_RKVENC
-	tristate "Rockchip RKVENC (vepu540/vepu541) H.264/HEVC encoder"
+	tristate "Rockchip RKVENC (vepu540/vepu540c/vepu541) H.264/HEVC encoder"
 	depends on ARCH_ROCKCHIP || COMPILE_TEST
 	depends on VIDEO_DEV
 	select MEDIA_CONTROLLER
@@ -8,7 +8,8 @@ config VIDEO_ROCKCHIP_RKVENC
 	select V4L2_MEM2MEM_DEV
 	help
 	  Support for the Rockchip RKVENC v1 hardware video encoder found
-	  in the RV1109/RV1126 (vepu541) and RK3566/RK3568 (vepu540) SoCs.
+	  in the RV1109/RV1126 (vepu541) and RK3566/RK3568 (vepu540) SoCs,
+	  and for the H.264 encoder of the RK3528 (vepu540c).
 
 	  It encodes NV12 raw frames into H.264 (AVC) or HEVC (H.265)
 	  bitstreams using a stateful memory-to-memory V4L2 interface.
