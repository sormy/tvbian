From: Artem Butusov <art.sormy@gmail.com>
Subject: [PATCH] media: rockchip: rga: Convert by the frames' matrix and range

The RGA chose its colour conversion by colorspace alone and wrote the
same mode either way: an RGB frame to YUV came out full range, white at
255, while the capture format, its quantization left default, said
limited. The driver offers V4L2_FMT_FLAG_CSC_QUANTIZATION and ignored
it.

Take the matrix and range from ycbcr_enc and quantization, their
defaults resolved, as the vendor kernel's modes number them: YUV to RGB
1, 2 and 3 for BT.601 limited, BT.601 full and BT.709 limited; RGB to
YUV 1, 2 and 3 for BT.601 full, BT.601 limited and BT.709 limited. The
engine has no full-range BT.709: a capture asking for it gets limited.

Signed-off-by: Artem Butusov <art.sormy@gmail.com>
---
  drivers/media/platform/rockchip/rga/rga-hw.c | 39 ++++++++++++++++------------
  drivers/media/platform/rockchip/rga/rga.c    |  4 +++
  2 files changed, 27 insertions(+), 16 deletions(-)

diff --git a/drivers/media/platform/rockchip/rga/rga-hw.c b/drivers/media/platform/rockchip/rga/rga-hw.c
index 5d7c1b8..062f604 100644
--- a/drivers/media/platform/rockchip/rga/rga-hw.c
+++ b/drivers/media/platform/rockchip/rga/rga-hw.c
@@ -87,6 +87,19 @@ rga_get_corner_addrs(struct rga_frame *frm, struct rga_addrs *addrs,
 	return corner_addrs;
 }
 
+/* A YUV frame's matrix and range, its defaults resolved; BT.709 is limited range alone */
+static bool rga_csc_full(const struct v4l2_pix_format_mplane *pix, bool *bt709)
+{
+	u32 enc = pix->ycbcr_enc == V4L2_YCBCR_ENC_DEFAULT ?
+		  V4L2_MAP_YCBCR_ENC_DEFAULT(pix->colorspace) : pix->ycbcr_enc;
+	u32 quant = pix->quantization == V4L2_QUANTIZATION_DEFAULT ?
+		    V4L2_MAP_QUANTIZATION_DEFAULT(false, pix->colorspace, enc) :
+		    pix->quantization;
+
+	*bt709 = enc == V4L2_YCBCR_ENC_709;
+	return quant == V4L2_QUANTIZATION_FULL_RANGE && !*bt709;
+}
+
 static struct rga_addrs *rga_lookup_draw_pos(struct rga_corners_addrs *corner_addrs,
 					     u32 rotate_mode,
 					     u32 mirr_mode)
@@ -173,6 +186,7 @@ static void rga_cmd_set_trans_info(struct rga_ctx *ctx)
 	union rga_dst_vir_info dst_vir_info;
 	union rga_dst_act_info dst_act_info;
 	u32 in_stride, out_stride;
+	bool full, bt709;
 	struct rga_fmt *in_fmt = ctx->in.fmt;
 	struct rga_fmt *out_fmt = ctx->out.fmt;
 
@@ -204,26 +218,19 @@ static void rga_cmd_set_trans_info(struct rga_ctx *ctx)
 
 	if (RGA_COLOR_FMT_IS_YUV(in_fmt->hw_format) &&
 	    RGA_COLOR_FMT_IS_RGB(out_fmt->hw_format)) {
-		switch (ctx->in.pix.colorspace) {
-		case V4L2_COLORSPACE_REC709:
-			src_info.data.csc_mode = RGA_SRC_CSC_MODE_BT709_R0;
-			break;
-		default:
-			src_info.data.csc_mode = RGA_SRC_CSC_MODE_BT601_R0;
-			break;
-		}
+		full = rga_csc_full(&ctx->in.pix, &bt709);
+		src_info.data.csc_mode = bt709 ? RGA_SRC_CSC_MODE_BT709_R0 :
+					 full ? RGA_SRC_CSC_MODE_BT601_R1 :
+					 RGA_SRC_CSC_MODE_BT601_R0;
 	}
 
+	/* the destination's modes count the other way: R0 is full range */
 	if (RGA_COLOR_FMT_IS_RGB(in_fmt->hw_format) &&
 	    RGA_COLOR_FMT_IS_YUV(out_fmt->hw_format)) {
-		switch (ctx->out.pix.colorspace) {
-		case V4L2_COLORSPACE_REC709:
-			dst_info.data.csc_mode = RGA_SRC_CSC_MODE_BT709_R0;
-			break;
-		default:
-			dst_info.data.csc_mode = RGA_DST_CSC_MODE_BT601_R0;
-			break;
-		}
+		full = rga_csc_full(&ctx->out.pix, &bt709);
+		dst_info.data.csc_mode = bt709 ? RGA_DST_CSC_MODE_BT709_R0 :
+					 full ? RGA_DST_CSC_MODE_BT601_R0 :
+					 RGA_DST_CSC_MODE_BT601_R1;
 	}
 
 	if (ctx->hflip)
diff --git a/drivers/media/platform/rockchip/rga/rga.c b/drivers/media/platform/rockchip/rga/rga.c
index f731a9d..7c9d93a 100644
--- a/drivers/media/platform/rockchip/rga/rga.c
+++ b/drivers/media/platform/rockchip/rga/rga.c
@@ -494,6 +494,10 @@ static int vidioc_try_fmt(struct file *file, void *priv, struct v4l2_format *f)
 			pix_fmt->quantization = frm->pix.quantization;
 			pix_fmt->ycbcr_enc = frm->pix.ycbcr_enc;
 		}
+		/* the engine's BT.709 is limited range alone */
+		if (pix_fmt->ycbcr_enc == V4L2_YCBCR_ENC_709 &&
+		    pix_fmt->quantization == V4L2_QUANTIZATION_FULL_RANGE)
+			pix_fmt->quantization = V4L2_QUANTIZATION_LIM_RANGE;
 		/* disallow values not announced in vidioc_enum_fmt */
 		pix_fmt->colorspace = frm->pix.colorspace;
 		pix_fmt->xfer_func = frm->pix.xfer_func;
