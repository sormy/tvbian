diff --git a/drivers/media/platform/rockchip/vdpp/rockchip-vdpp-m2m.c b/drivers/media/platform/rockchip/vdpp/rockchip-vdpp-m2m.c
new file mode 100644
index 0000000..3a52213
--- /dev/null
+++ b/drivers/media/platform/rockchip/vdpp/rockchip-vdpp-m2m.c
@@ -0,0 +1,709 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Rockchip VDPP: an NV12 frame scaled to the CAPTURE size, as the vendor's
+ * MPP programs the RK3528's VDPP, with its enhancement off
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/pm_runtime.h>
+#include <linux/reset.h>
+#include <linux/slab.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-ioctl.h>
+#include <media/v4l2-mem2mem.h>
+#include <media/videobuf2-dma-contig.h>
+#include <media/videobuf2-v4l2.h>
+
+#include "rockchip-vdpp-regs.h"
+#include "rockchip-vdpp-zme.h"
+
+#define VDPP_NAME		"rockchip-vdpp"
+
+#define VDPP_MIN_SIZE		128
+#define VDPP_MAX_WIDTH		1920
+#define VDPP_MAX_HEIGHT		1088
+#define VDPP_SIZE_STEP		2
+#define VDPP_WIDTH_ALIGN	16	/* the engine works in whole 16-pixel columns */
+#define VDPP_SRC_HEIGHT_ALIGN	8	/* and reads whole 8-line rows */
+#define VDPP_DST_HEIGHT_ALIGN	1
+#define VDPP_STRIDE_UNIT	4	/* stride registers count 32-bit words */
+
+#define VDPP_FMT_YUV420		3
+#define VDPP_YUV_SWAP_SP_UV	0
+#define VDPP_TIMEOUT_CYCLES	0x8ffffff
+#define VDPP_INT_ERRORS		(VDPP_INT_CONFIG_ERROR | VDPP_INT_TIMEOUT | VDPP_INT_BUS_ERROR)
+#define VDPP_RESET_TIMEOUT_US	5
+#define VDPP_CRU_RESET_US	5
+
+struct vdpp_dev {
+	struct v4l2_device v4l2_dev;
+	struct video_device vfd;
+	struct device *dev;
+	struct v4l2_m2m_dev *m2m_dev;
+	struct mutex dev_mutex;	/* serialises the video device's ioctls */
+	void __iomem *base;
+	void __iomem *zme;
+	struct clk_bulk_data *clks;
+	int num_clks;
+	struct reset_control *rstc;	/* held while streaming: the engine is the IEP2's too */
+};
+
+struct vdpp_ctx {
+	struct v4l2_fh fh;
+	struct vdpp_dev *vdpp;
+	struct v4l2_pix_format src_fmt;
+	struct v4l2_pix_format dst_fmt;
+	struct v4l2_rect crop;
+};
+
+static inline void vdpp_write(struct vdpp_dev *vdpp, u32 reg, u32 val)
+{
+	writel_relaxed(val, vdpp->base + reg);
+}
+
+static inline u32 vdpp_read(struct vdpp_dev *vdpp, u32 reg)
+{
+	return readl_relaxed(vdpp->base + reg);
+}
+
+static inline struct vdpp_ctx *vdpp_file2ctx(struct file *file)
+{
+	return container_of(file_to_v4l2_fh(file), struct vdpp_ctx, fh);
+}
+
+static u32 vdpp_pic_size(u32 width, u32 height, u32 height_align)
+{
+	u32 w = ALIGN(width, VDPP_WIDTH_ALIGN);
+	u32 h = ALIGN(height, height_align);
+
+	return VDPP_PIC_WIDTH(w - 1) | VDPP_PIC_RIGHT_REDUNDANT(w - width) |
+	       VDPP_PIC_HEIGHT(h - 1) | VDPP_PIC_DOWN_REDUNDANT(h - height);
+}
+
+static void vdpp_config(struct vdpp_dev *vdpp, struct vdpp_ctx *ctx)
+{
+	const struct v4l2_pix_format *dst = &ctx->dst_fmt;
+	const struct v4l2_rect *crop = &ctx->crop;
+
+	vdpp_write(vdpp, VDPP_CONFIG0,
+		   VDPP_SRC_FMT(VDPP_FMT_YUV420) | VDPP_SRC_YUV_SWAP(VDPP_YUV_SWAP_SP_UV) |
+		   VDPP_DST_FMT(VDPP_FMT_YUV420) | VDPP_DST_YUV_SWAP(VDPP_YUV_SWAP_SP_UV));
+	vdpp_write(vdpp, VDPP_WORK_MODE, VDPP_WORK_MODE_VEP);
+	vdpp_write(vdpp, VDPP_CLK_GATE, VDPP_CLK_ON_ALL);
+
+	vdpp_write(vdpp, VDPP_SRC_VIR_STRIDE,
+		   VDPP_VIR_STRIDE(ctx->src_fmt.bytesperline / VDPP_STRIDE_UNIT));
+	vdpp_write(vdpp, VDPP_DST_VIR_STRIDE,
+		   VDPP_VIR_STRIDE(dst->bytesperline / VDPP_STRIDE_UNIT));
+	vdpp_write(vdpp, VDPP_SRC_PIC_SIZE,
+		   vdpp_pic_size(crop->width, crop->height, VDPP_SRC_HEIGHT_ALIGN));
+	vdpp_write(vdpp, VDPP_DST_PIC_SIZE,
+		   vdpp_pic_size(dst->width, dst->height, VDPP_DST_HEIGHT_ALIGN));
+	vdpp_write(vdpp, VDPP_TIMEOUT_CFG, VDPP_TIMEOUT_CFG_EN | VDPP_TIMEOUT_CYCLES);
+
+	vdpp_zme_config(vdpp->zme, crop->width, crop->height, dst->width, dst->height);
+}
+
+static void vdpp_set_frame(struct vdpp_dev *vdpp, const struct v4l2_pix_format *pix,
+			   struct vb2_v4l2_buffer *buf, u32 reg_y, u32 reg_uv)
+{
+	dma_addr_t y = vb2_dma_contig_plane_dma_addr(&buf->vb2_buf, 0);
+
+	vdpp_write(vdpp, reg_y, y);
+	vdpp_write(vdpp, reg_uv, y + pix->bytesperline * pix->height);
+}
+
+static void vdpp_device_run(void *priv)
+{
+	struct vdpp_ctx *ctx = priv;
+	struct vdpp_dev *vdpp = ctx->vdpp;
+	struct vb2_v4l2_buffer *src, *dst;
+
+	src = v4l2_m2m_next_src_buf(ctx->fh.m2m_ctx);
+	dst = v4l2_m2m_next_dst_buf(ctx->fh.m2m_ctx);
+	v4l2_m2m_buf_copy_metadata(src, dst);
+
+	vdpp_config(vdpp, ctx);
+	vdpp_set_frame(vdpp, &ctx->src_fmt, src, VDPP_SRC_ADDR_Y, VDPP_SRC_ADDR_UV);
+	vdpp_set_frame(vdpp, &ctx->dst_fmt, dst, VDPP_DST_ADDR_Y, VDPP_DST_ADDR_UV);
+	vdpp_write(vdpp, VDPP_INT_EN, VDPP_INT_FRM_DONE | VDPP_INT_OSD_MAX | VDPP_INT_ERRORS);
+
+	/* registers before the start */
+	wmb();
+	writel(VDPP_FRM_EN, vdpp->base + VDPP_FRM_START);
+}
+
+static void vdpp_reset(struct vdpp_dev *vdpp)
+{
+	u32 status;
+
+	writel(VDPP_ACLK_SRESET_P, vdpp->base + VDPP_CONFIG0);
+	if (!readl_poll_timeout_atomic(vdpp->base + VDPP_STATUS, status,
+				       status & VDPP_ARST_FINISH_DONE, 0,
+				       VDPP_RESET_TIMEOUT_US))
+		return;
+
+	dev_warn(vdpp->dev, "soft reset timed out, resetting through the CRU\n");
+	reset_control_assert(vdpp->rstc);
+	udelay(VDPP_CRU_RESET_US);
+	reset_control_deassert(vdpp->rstc);
+}
+
+static irqreturn_t vdpp_irq(int irq, void *data)
+{
+	struct vdpp_dev *vdpp = data;
+	enum vb2_buffer_state state = VB2_BUF_STATE_DONE;
+	struct vdpp_ctx *ctx;
+	u32 status;
+
+	/* the line is shared with the IEP2 and the IOMMU; an unclocked VDPP cannot be read */
+	if (pm_runtime_get_if_in_use(vdpp->dev) <= 0)
+		return IRQ_NONE;
+
+	if ((vdpp_read(vdpp, VDPP_WORK_MODE) & VDPP_WORK_MODE_MASK) != VDPP_WORK_MODE_VEP)
+		goto none;
+
+	status = vdpp_read(vdpp, VDPP_INT_STS);
+	vdpp_write(vdpp, VDPP_INT_CLR, VDPP_INT_ALL);
+	if (!(status & (VDPP_INT_FRM_DONE | VDPP_INT_ERRORS)))
+		goto none;
+
+	ctx = v4l2_m2m_get_curr_priv(vdpp->m2m_dev);
+	if (!ctx) {
+		dev_err(vdpp->dev, "interrupt with no job running\n");
+		goto handled;
+	}
+
+	if (status & VDPP_INT_ERRORS) {
+		dev_err(vdpp->dev, "job failed, status %#x\n", status);
+		state = VB2_BUF_STATE_ERROR;
+		vdpp_reset(vdpp);
+	}
+
+	v4l2_m2m_buf_done(v4l2_m2m_dst_buf_remove(ctx->fh.m2m_ctx), state);
+	v4l2_m2m_buf_done(v4l2_m2m_src_buf_remove(ctx->fh.m2m_ctx), state);
+	v4l2_m2m_job_finish(vdpp->m2m_dev, ctx->fh.m2m_ctx);
+
+handled:
+	pm_runtime_put(vdpp->dev);
+	return IRQ_HANDLED;
+none:
+	pm_runtime_put(vdpp->dev);
+	return IRQ_NONE;
+}
+
+static void vdpp_prepare_format(struct v4l2_pix_format *pix)
+{
+	pix->pixelformat = V4L2_PIX_FMT_NV12;
+	pix->field = V4L2_FIELD_NONE;
+	pix->width = ALIGN(clamp(pix->width, VDPP_MIN_SIZE, VDPP_MAX_WIDTH), VDPP_SIZE_STEP);
+	pix->height = ALIGN(clamp(pix->height, VDPP_MIN_SIZE, VDPP_MAX_HEIGHT), VDPP_SIZE_STEP);
+	pix->bytesperline = ALIGN(pix->width, VDPP_WIDTH_ALIGN);
+	/* chroma for the whole rows the engine reads */
+	pix->sizeimage = pix->bytesperline *
+			 (pix->height + ALIGN(pix->height, VDPP_SRC_HEIGHT_ALIGN) / 2);
+}
+
+static void vdpp_reset_crop(struct vdpp_ctx *ctx)
+{
+	ctx->crop = (struct v4l2_rect) {
+		.width = ctx->src_fmt.width,
+		.height = ctx->src_fmt.height,
+	};
+}
+
+static bool vdpp_scale_supported(const struct vdpp_ctx *ctx)
+{
+	return ctx->crop.width <= ctx->dst_fmt.width * VDPP_ZME_MAX_DOWNSCALE &&
+	       ctx->crop.height <= ctx->dst_fmt.height * VDPP_ZME_MAX_DOWNSCALE;
+}
+
+static int vdpp_querycap(struct file *file, void *priv, struct v4l2_capability *cap)
+{
+	strscpy(cap->driver, VDPP_NAME, sizeof(cap->driver));
+	strscpy(cap->card, VDPP_NAME, sizeof(cap->card));
+	snprintf(cap->bus_info, sizeof(cap->bus_info), "platform:%s", VDPP_NAME);
+	return 0;
+}
+
+static int vdpp_enum_fmt(struct file *file, void *priv, struct v4l2_fmtdesc *f)
+{
+	if (f->index)
+		return -EINVAL;
+
+	f->pixelformat = V4L2_PIX_FMT_NV12;
+	return 0;
+}
+
+static int vdpp_enum_framesizes(struct file *file, void *priv,
+				struct v4l2_frmsizeenum *fsize)
+{
+	if (fsize->index || fsize->pixel_format != V4L2_PIX_FMT_NV12)
+		return -EINVAL;
+
+	fsize->type = V4L2_FRMSIZE_TYPE_STEPWISE;
+	fsize->stepwise.min_width = VDPP_MIN_SIZE;
+	fsize->stepwise.max_width = VDPP_MAX_WIDTH;
+	fsize->stepwise.step_width = VDPP_SIZE_STEP;
+	fsize->stepwise.min_height = VDPP_MIN_SIZE;
+	fsize->stepwise.max_height = VDPP_MAX_HEIGHT;
+	fsize->stepwise.step_height = VDPP_SIZE_STEP;
+	return 0;
+}
+
+static int vdpp_g_fmt_vid_cap(struct file *file, void *priv, struct v4l2_format *f)
+{
+	f->fmt.pix = vdpp_file2ctx(file)->dst_fmt;
+	return 0;
+}
+
+static int vdpp_g_fmt_vid_out(struct file *file, void *priv, struct v4l2_format *f)
+{
+	f->fmt.pix = vdpp_file2ctx(file)->src_fmt;
+	return 0;
+}
+
+static int vdpp_try_fmt(struct file *file, void *priv, struct v4l2_format *f)
+{
+	vdpp_prepare_format(&f->fmt.pix);
+	return 0;
+}
+
+static int vdpp_s_fmt(struct file *file, struct v4l2_format *f,
+		      struct v4l2_pix_format *dst)
+{
+	struct vdpp_ctx *ctx = vdpp_file2ctx(file);
+
+	if (vb2_is_busy(v4l2_m2m_get_vq(ctx->fh.m2m_ctx, f->type)))
+		return -EBUSY;
+
+	vdpp_prepare_format(&f->fmt.pix);
+	*dst = f->fmt.pix;
+	return 0;
+}
+
+static int vdpp_s_fmt_vid_cap(struct file *file, void *priv, struct v4l2_format *f)
+{
+	return vdpp_s_fmt(file, f, &vdpp_file2ctx(file)->dst_fmt);
+}
+
+static int vdpp_s_fmt_vid_out(struct file *file, void *priv, struct v4l2_format *f)
+{
+	struct vdpp_ctx *ctx = vdpp_file2ctx(file);
+	int ret;
+
+	ret = vdpp_s_fmt(file, f, &ctx->src_fmt);
+	if (ret)
+		return ret;
+
+	vdpp_reset_crop(ctx);
+	ctx->dst_fmt.colorspace = f->fmt.pix.colorspace;
+	ctx->dst_fmt.xfer_func = f->fmt.pix.xfer_func;
+	ctx->dst_fmt.ycbcr_enc = f->fmt.pix.ycbcr_enc;
+	ctx->dst_fmt.quantization = f->fmt.pix.quantization;
+	return 0;
+}
+
+static int vdpp_g_selection(struct file *file, void *priv, struct v4l2_selection *s)
+{
+	struct vdpp_ctx *ctx = vdpp_file2ctx(file);
+	bool output = V4L2_TYPE_IS_OUTPUT(s->type);
+	const struct v4l2_pix_format *pix = output ? &ctx->src_fmt : &ctx->dst_fmt;
+
+	switch (s->target) {
+	case V4L2_SEL_TGT_CROP:
+		if (!output)
+			return -EINVAL;
+		s->r = ctx->crop;
+		return 0;
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+		if (!output)
+			return -EINVAL;
+		break;
+	case V4L2_SEL_TGT_COMPOSE:
+	case V4L2_SEL_TGT_COMPOSE_DEFAULT:
+	case V4L2_SEL_TGT_COMPOSE_BOUNDS:
+		if (output)
+			return -EINVAL;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	s->r = (struct v4l2_rect) { .width = pix->width, .height = pix->height };
+	return 0;
+}
+
+/* the crop keeps the frame's top left: the engine's alignment for another is unknown */
+static int vdpp_s_selection(struct file *file, void *priv, struct v4l2_selection *s)
+{
+	struct vdpp_ctx *ctx = vdpp_file2ctx(file);
+	u32 max_w = min(ctx->src_fmt.width, ctx->dst_fmt.width * VDPP_ZME_MAX_DOWNSCALE);
+	u32 max_h = min(ctx->src_fmt.height, ctx->dst_fmt.height * VDPP_ZME_MAX_DOWNSCALE);
+
+	if (!V4L2_TYPE_IS_OUTPUT(s->type) || s->target != V4L2_SEL_TGT_CROP)
+		return -EINVAL;
+
+	s->r.left = 0;
+	s->r.top = 0;
+	s->r.width = ALIGN(clamp(s->r.width, VDPP_MIN_SIZE, max_w), VDPP_SIZE_STEP);
+	s->r.height = ALIGN(clamp(s->r.height, VDPP_MIN_SIZE, max_h), VDPP_SIZE_STEP);
+	ctx->crop = s->r;
+	return 0;
+}
+
+static const struct v4l2_ioctl_ops vdpp_ioctl_ops = {
+	.vidioc_querycap		= vdpp_querycap,
+	.vidioc_enum_framesizes		= vdpp_enum_framesizes,
+	.vidioc_enum_fmt_vid_cap	= vdpp_enum_fmt,
+	.vidioc_g_fmt_vid_cap		= vdpp_g_fmt_vid_cap,
+	.vidioc_try_fmt_vid_cap		= vdpp_try_fmt,
+	.vidioc_s_fmt_vid_cap		= vdpp_s_fmt_vid_cap,
+	.vidioc_enum_fmt_vid_out	= vdpp_enum_fmt,
+	.vidioc_g_fmt_vid_out		= vdpp_g_fmt_vid_out,
+	.vidioc_try_fmt_vid_out		= vdpp_try_fmt,
+	.vidioc_s_fmt_vid_out		= vdpp_s_fmt_vid_out,
+	.vidioc_g_selection		= vdpp_g_selection,
+	.vidioc_s_selection		= vdpp_s_selection,
+	.vidioc_reqbufs			= v4l2_m2m_ioctl_reqbufs,
+	.vidioc_querybuf		= v4l2_m2m_ioctl_querybuf,
+	.vidioc_qbuf			= v4l2_m2m_ioctl_qbuf,
+	.vidioc_dqbuf			= v4l2_m2m_ioctl_dqbuf,
+	.vidioc_prepare_buf		= v4l2_m2m_ioctl_prepare_buf,
+	.vidioc_create_bufs		= v4l2_m2m_ioctl_create_bufs,
+	.vidioc_expbuf			= v4l2_m2m_ioctl_expbuf,
+	.vidioc_streamon		= v4l2_m2m_ioctl_streamon,
+	.vidioc_streamoff		= v4l2_m2m_ioctl_streamoff,
+};
+
+static struct v4l2_pix_format *vdpp_queue_fmt(struct vb2_queue *vq)
+{
+	struct vdpp_ctx *ctx = vb2_get_drv_priv(vq);
+
+	return V4L2_TYPE_IS_OUTPUT(vq->type) ? &ctx->src_fmt : &ctx->dst_fmt;
+}
+
+static int vdpp_queue_setup(struct vb2_queue *vq, unsigned int *nbuffers,
+			    unsigned int *nplanes, unsigned int sizes[],
+			    struct device *alloc_devs[])
+{
+	unsigned int size = vdpp_queue_fmt(vq)->sizeimage;
+
+	if (*nplanes)
+		return sizes[0] < size ? -EINVAL : 0;
+
+	sizes[0] = size;
+	*nplanes = 1;
+	return 0;
+}
+
+static int vdpp_buf_prepare(struct vb2_buffer *vb)
+{
+	unsigned int size = vdpp_queue_fmt(vb->vb2_queue)->sizeimage;
+
+	if (vb2_plane_size(vb, 0) < size)
+		return -EINVAL;
+
+	if (!V4L2_TYPE_IS_OUTPUT(vb->vb2_queue->type))
+		vb2_set_plane_payload(vb, 0, size);
+	return 0;
+}
+
+static void vdpp_buf_queue(struct vb2_buffer *vb)
+{
+	struct vdpp_ctx *ctx = vb2_get_drv_priv(vb->vb2_queue);
+
+	v4l2_m2m_buf_queue(ctx->fh.m2m_ctx, to_vb2_v4l2_buffer(vb));
+}
+
+static void vdpp_queue_cleanup(struct vb2_queue *vq, enum vb2_buffer_state state)
+{
+	struct vdpp_ctx *ctx = vb2_get_drv_priv(vq);
+	struct vb2_v4l2_buffer *vbuf;
+
+	for (;;) {
+		vbuf = V4L2_TYPE_IS_OUTPUT(vq->type) ?
+			v4l2_m2m_src_buf_remove(ctx->fh.m2m_ctx) :
+			v4l2_m2m_dst_buf_remove(ctx->fh.m2m_ctx);
+		if (!vbuf)
+			break;
+		v4l2_m2m_buf_done(vbuf, state);
+	}
+}
+
+static int vdpp_claim_engine(struct vdpp_dev *vdpp)
+{
+	int ret;
+
+	ret = reset_control_acquire(vdpp->rstc);
+	if (ret)
+		return ret;
+
+	ret = pm_runtime_resume_and_get(vdpp->dev);
+	if (ret < 0)
+		reset_control_release(vdpp->rstc);
+	return ret;
+}
+
+static int vdpp_start_streaming(struct vb2_queue *vq, unsigned int count)
+{
+	struct vdpp_ctx *ctx = vb2_get_drv_priv(vq);
+	int ret = 0;
+
+	if (!vdpp_scale_supported(ctx))
+		ret = -EINVAL;
+	else if (V4L2_TYPE_IS_OUTPUT(vq->type))
+		ret = vdpp_claim_engine(ctx->vdpp);
+
+	if (ret < 0)
+		vdpp_queue_cleanup(vq, VB2_BUF_STATE_QUEUED);
+	return ret;
+}
+
+static void vdpp_stop_streaming(struct vb2_queue *vq)
+{
+	struct vdpp_ctx *ctx = vb2_get_drv_priv(vq);
+
+	if (V4L2_TYPE_IS_OUTPUT(vq->type)) {
+		pm_runtime_put(ctx->vdpp->dev);
+		reset_control_release(ctx->vdpp->rstc);
+	}
+
+	vdpp_queue_cleanup(vq, VB2_BUF_STATE_ERROR);
+}
+
+static const struct vb2_ops vdpp_qops = {
+	.queue_setup		= vdpp_queue_setup,
+	.buf_prepare		= vdpp_buf_prepare,
+	.buf_queue		= vdpp_buf_queue,
+	.start_streaming	= vdpp_start_streaming,
+	.stop_streaming		= vdpp_stop_streaming,
+};
+
+static int vdpp_init_vq(struct vdpp_ctx *ctx, struct vb2_queue *vq,
+			enum v4l2_buf_type type)
+{
+	vq->type = type;
+	vq->io_modes = VB2_MMAP | VB2_DMABUF;
+	vq->drv_priv = ctx;
+	vq->buf_struct_size = sizeof(struct v4l2_m2m_buffer);
+	vq->ops = &vdpp_qops;
+	vq->mem_ops = &vb2_dma_contig_memops;
+	vq->timestamp_flags = V4L2_BUF_FLAG_TIMESTAMP_COPY;
+	vq->lock = &ctx->vdpp->dev_mutex;
+	vq->dev = ctx->vdpp->dev;
+	return vb2_queue_init(vq);
+}
+
+static int vdpp_queue_init(void *priv, struct vb2_queue *src_vq, struct vb2_queue *dst_vq)
+{
+	int ret;
+
+	ret = vdpp_init_vq(priv, src_vq, V4L2_BUF_TYPE_VIDEO_OUTPUT);
+	if (ret)
+		return ret;
+
+	return vdpp_init_vq(priv, dst_vq, V4L2_BUF_TYPE_VIDEO_CAPTURE);
+}
+
+static int vdpp_open(struct file *file)
+{
+	struct vdpp_dev *vdpp = video_drvdata(file);
+	struct vdpp_ctx *ctx;
+	int ret;
+
+	if (mutex_lock_interruptible(&vdpp->dev_mutex))
+		return -ERESTARTSYS;
+
+	ctx = kzalloc_obj(*ctx);
+	if (!ctx) {
+		ret = -ENOMEM;
+		goto unlock;
+	}
+
+	ctx->src_fmt.width = VDPP_MAX_WIDTH;
+	ctx->src_fmt.height = VDPP_MAX_HEIGHT;
+	vdpp_prepare_format(&ctx->src_fmt);
+	ctx->dst_fmt = ctx->src_fmt;
+	vdpp_reset_crop(ctx);
+
+	v4l2_fh_init(&ctx->fh, video_devdata(file));
+	ctx->vdpp = vdpp;
+
+	ctx->fh.m2m_ctx = v4l2_m2m_ctx_init(vdpp->m2m_dev, ctx, &vdpp_queue_init);
+	if (IS_ERR(ctx->fh.m2m_ctx)) {
+		ret = PTR_ERR(ctx->fh.m2m_ctx);
+		kfree(ctx);
+		goto unlock;
+	}
+
+	v4l2_fh_add(&ctx->fh, file);
+	ret = 0;
+unlock:
+	mutex_unlock(&vdpp->dev_mutex);
+	return ret;
+}
+
+static int vdpp_release(struct file *file)
+{
+	struct vdpp_dev *vdpp = video_drvdata(file);
+	struct vdpp_ctx *ctx = vdpp_file2ctx(file);
+
+	mutex_lock(&vdpp->dev_mutex);
+	v4l2_fh_del(&ctx->fh, file);
+	v4l2_fh_exit(&ctx->fh);
+	v4l2_m2m_ctx_release(ctx->fh.m2m_ctx);
+	kfree(ctx);
+	mutex_unlock(&vdpp->dev_mutex);
+	return 0;
+}
+
+static const struct v4l2_file_operations vdpp_fops = {
+	.owner		= THIS_MODULE,
+	.open		= vdpp_open,
+	.release	= vdpp_release,
+	.poll		= v4l2_m2m_fop_poll,
+	.unlocked_ioctl	= video_ioctl2,
+	.mmap		= v4l2_m2m_fop_mmap,
+};
+
+static const struct video_device vdpp_video_device = {
+	.name		= VDPP_NAME,
+	.vfl_dir	= VFL_DIR_M2M,
+	.fops		= &vdpp_fops,
+	.ioctl_ops	= &vdpp_ioctl_ops,
+	.minor		= -1,
+	.release	= video_device_release_empty,
+	.device_caps	= V4L2_CAP_VIDEO_M2M | V4L2_CAP_STREAMING,
+};
+
+static const struct v4l2_m2m_ops vdpp_m2m_ops = {
+	.device_run	= vdpp_device_run,
+};
+
+static int vdpp_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct vdpp_dev *vdpp;
+	int irq, ret;
+
+	vdpp = devm_kzalloc(dev, sizeof(*vdpp), GFP_KERNEL);
+	if (!vdpp)
+		return -ENOMEM;
+
+	vdpp->dev = dev;
+	vdpp->vfd = vdpp_video_device;
+
+	vdpp->base = devm_platform_ioremap_resource_byname(pdev, "vdpp");
+	if (IS_ERR(vdpp->base))
+		return PTR_ERR(vdpp->base);
+
+	vdpp->zme = devm_platform_ioremap_resource_byname(pdev, "zme");
+	if (IS_ERR(vdpp->zme))
+		return PTR_ERR(vdpp->zme);
+
+	vdpp->num_clks = devm_clk_bulk_get_all(dev, &vdpp->clks);
+	if (vdpp->num_clks < 0)
+		return dev_err_probe(dev, vdpp->num_clks, "failed to get clocks\n");
+
+	vdpp->rstc = devm_reset_control_array_get_exclusive_released(dev);
+	if (IS_ERR(vdpp->rstc))
+		return dev_err_probe(dev, PTR_ERR(vdpp->rstc), "failed to get resets\n");
+
+	irq = platform_get_irq(pdev, 0);
+	if (irq < 0)
+		return irq;
+
+	ret = devm_request_irq(dev, irq, vdpp_irq, IRQF_SHARED, dev_name(dev), vdpp);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to request IRQ\n");
+
+	mutex_init(&vdpp->dev_mutex);
+
+	ret = v4l2_device_register(dev, &vdpp->v4l2_dev);
+	if (ret)
+		return ret;
+
+	vdpp->m2m_dev = v4l2_m2m_init(&vdpp_m2m_ops);
+	if (IS_ERR(vdpp->m2m_dev)) {
+		ret = PTR_ERR(vdpp->m2m_dev);
+		goto err_v4l2;
+	}
+
+	vdpp->vfd.lock = &vdpp->dev_mutex;
+	vdpp->vfd.v4l2_dev = &vdpp->v4l2_dev;
+	video_set_drvdata(&vdpp->vfd, vdpp);
+	platform_set_drvdata(pdev, vdpp);
+	pm_runtime_enable(dev);
+
+	ret = video_register_device(&vdpp->vfd, VFL_TYPE_VIDEO, -1);
+	if (ret)
+		goto err_m2m;
+
+	return 0;
+
+err_m2m:
+	pm_runtime_disable(dev);
+	v4l2_m2m_release(vdpp->m2m_dev);
+err_v4l2:
+	v4l2_device_unregister(&vdpp->v4l2_dev);
+	return ret;
+}
+
+static void vdpp_remove(struct platform_device *pdev)
+{
+	struct vdpp_dev *vdpp = platform_get_drvdata(pdev);
+
+	video_unregister_device(&vdpp->vfd);
+	v4l2_m2m_release(vdpp->m2m_dev);
+	v4l2_device_unregister(&vdpp->v4l2_dev);
+	pm_runtime_disable(&pdev->dev);
+}
+
+static int vdpp_runtime_resume(struct device *dev)
+{
+	struct vdpp_dev *vdpp = dev_get_drvdata(dev);
+
+	return clk_bulk_prepare_enable(vdpp->num_clks, vdpp->clks);
+}
+
+static int vdpp_runtime_suspend(struct device *dev)
+{
+	struct vdpp_dev *vdpp = dev_get_drvdata(dev);
+
+	clk_bulk_disable_unprepare(vdpp->num_clks, vdpp->clks);
+	return 0;
+}
+
+static const struct dev_pm_ops vdpp_pm_ops = {
+	RUNTIME_PM_OPS(vdpp_runtime_suspend, vdpp_runtime_resume, NULL)
+};
+
+static const struct of_device_id vdpp_dt_match[] = {
+	{ .compatible = "rockchip,rk3528-vdpp" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, vdpp_dt_match);
+
+static struct platform_driver vdpp_driver = {
+	.probe		= vdpp_probe,
+	.remove		= vdpp_remove,
+	.driver		= {
+		.name		= VDPP_NAME,
+		.of_match_table	= vdpp_dt_match,
+		.pm		= pm_ptr(&vdpp_pm_ops),
+	},
+};
+module_platform_driver(vdpp_driver);
+
+MODULE_AUTHOR("Artem Butusov <art.sormy@gmail.com>");
+MODULE_DESCRIPTION("Rockchip VDPP scaler");
+MODULE_LICENSE("GPL");
diff --git a/drivers/media/platform/rockchip/vdpp/rockchip-vdpp-regs.h b/drivers/media/platform/rockchip/vdpp/rockchip-vdpp-regs.h
new file mode 100644
index 0000000..311cd6d
--- /dev/null
+++ b/drivers/media/platform/rockchip/vdpp/rockchip-vdpp-regs.h
@@ -0,0 +1,95 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Rockchip VDPP registers, as Rockchip's MPP names them
+ */
+
+#ifndef __ROCKCHIP_VDPP_REGS_H__
+#define __ROCKCHIP_VDPP_REGS_H__
+
+#include <linux/bits.h>
+
+#define VDPP_FRM_START			0x0000
+#define     VDPP_FRM_EN				BIT(0)
+
+#define VDPP_CONFIG0			0x0004
+#define     VDPP_ACLK_SRESET_P			BIT(21)
+#define     VDPP_DST_YUV_SWAP(x)		(((x) & 3) << 12)
+#define     VDPP_DST_FMT(x)			(((x) & 3) << 8)
+#define     VDPP_SRC_YUV_SWAP(x)		(((x) & 3) << 4)
+#define     VDPP_SRC_FMT(x)			((x) & 3)
+
+#define VDPP_WORK_MODE			0x0008
+#define     VDPP_WORK_MODE_VEP			2
+#define     VDPP_WORK_MODE_MASK			GENMASK(1, 0)
+
+#define VDPP_CLK_GATE			0x0010
+#define     VDPP_CLK_ON_ALL			GENMASK(11, 0)
+
+#define VDPP_STATUS			0x0014
+#define     VDPP_ARST_FINISH_DONE		BIT(0)
+
+#define VDPP_INT_EN			0x0020
+#define VDPP_INT_CLR			0x0024
+#define VDPP_INT_STS			0x0028
+#define     VDPP_INT_CONFIG_ERROR		BIT(6)
+#define     VDPP_INT_TIMEOUT			BIT(5)
+#define     VDPP_INT_BUS_ERROR			BIT(4)
+#define     VDPP_INT_OSD_MAX			BIT(1)
+#define     VDPP_INT_FRM_DONE			BIT(0)
+#define     VDPP_INT_ALL			GENMASK(31, 0)
+
+#define VDPP_SRC_VIR_STRIDE		0x0030
+#define VDPP_DST_VIR_STRIDE		0x0034
+#define     VDPP_VIR_STRIDE(x)			((x) & 0xffff)
+
+#define VDPP_SRC_PIC_SIZE		0x0038
+#define VDPP_DST_PIC_SIZE		0x003c
+#define     VDPP_PIC_DOWN_REDUNDANT(x)		(((x) & 7) << 28)
+#define     VDPP_PIC_HEIGHT(x)			(((x) & 0x7ff) << 16)
+#define     VDPP_PIC_RIGHT_REDUNDANT(x)		(((x) & 0xf) << 12)
+#define     VDPP_PIC_WIDTH(x)			((x) & 0x7ff)
+
+#define VDPP_TIMEOUT_CFG		0x0050
+#define     VDPP_TIMEOUT_CFG_EN			BIT(31)
+
+#define VDPP_SRC_ADDR_Y			0x0060
+#define VDPP_SRC_ADDR_UV		0x0064
+#define VDPP_DST_ADDR_Y			0x0068
+#define VDPP_DST_ADDR_UV		0x006c
+
+/* the scaler's own register window */
+#define VDPP_ZME_YRGB_HOR_COE		0x0000
+#define VDPP_ZME_YRGB_VER_COE		0x0200
+#define VDPP_ZME_CBCR_HOR_COE		0x0400
+#define VDPP_ZME_CBCR_VER_COE		0x0600
+#define     VDPP_ZME_COE_PAIR(a, b)		(((a) & 0x3ff) | (((b) & 0x3ff) << 16))
+
+#define VDPP_ZME_CTRL			0x0800
+#define     VDPP_ZME_AUTO_GATING_EN		BIT(31)
+#define     VDPP_ZME_FORMAT_OUT(x)		(((x) & 0xf) << 8)
+#define     VDPP_ZME_FORMAT_IN(x)		(((x) & 0xf) << 4)
+
+/* each plane's scaling registers, at these offsets from its base */
+#define VDPP_ZME_YRGB			0x0810
+#define VDPP_ZME_CBCR			0x0830
+#define VDPP_ZME_SCL_CTRL		0x0000
+#define     VDPP_ZME_XSU_BYPASS			BIT(18)
+#define     VDPP_ZME_YS_BYPASS			BIT(17)
+#define     VDPP_ZME_XSD_BYPASS			BIT(16)
+#define     VDPP_ZME_DERING_EN			BIT(8)
+#define     VDPP_ZME_YSCL_MODE(x)		(((x) & 3) << 6)
+#define     VDPP_ZME_YSU_EN			BIT(5)
+#define     VDPP_ZME_YSD_EN			BIT(4)
+#define     VDPP_ZME_XSCL_MODE(x)		(((x) & 3) << 2)
+#define     VDPP_ZME_XSU_EN			BIT(1)
+#define     VDPP_ZME_XSD_EN			BIT(0)
+#define VDPP_ZME_DERING			0x000c
+#define     VDPP_ZME_DERING_DELTA(x)		(((x) & 0x1f) << 24)
+#define     VDPP_ZME_DERING_ALPHA(x)		(((x) & 0x1f) << 16)
+#define     VDPP_ZME_DERING_SEN1(x)		(((x) & 0x1f) << 8)
+#define     VDPP_ZME_DERING_SEN0(x)		((x) & 0x1f)
+#define VDPP_ZME_XSCL_FACTOR		0x0010
+#define VDPP_ZME_YSCL_FACTOR		0x0014
+#define     VDPP_ZME_SCL_FACTOR(x)		((x) & 0xffff)
+
+#endif
