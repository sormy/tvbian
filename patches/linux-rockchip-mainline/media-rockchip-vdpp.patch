+
+static u32 vdpp_zme_shift(u32 act, u32 dsp)
+{
+	return act < dsp ? VDPP_ZME_UP_SHIFT : VDPP_ZME_DOWN_SHIFT;
+}
+
+static u32 vdpp_zme_factor(u32 act, u32 dsp)
+{
+	return ((act - 1) << vdpp_zme_shift(act, dsp)) / (dsp - 1);
+}
+
+static unsigned int vdpp_zme_ratio(u32 act, u32 dsp)
+{
+	u32 shift = vdpp_zme_shift(act, dsp);
+	u32 permille = (VDPP_ZME_PERMILLE << shift) / ((act << shift) / dsp);
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(vdpp_zme_ratio_min); i++)
+		if (permille >= vdpp_zme_ratio_min[i])
+			break;
+	return i;
+}
+
+static void vdpp_zme_write_coe(void __iomem *zme, u32 reg,
+			       const s16 (*coe)[VDPP_ZME_TAPS])
+{
+	unsigned int phase, tap;
+
+	for (phase = 0; phase < VDPP_ZME_PHASES; phase++) {
+		for (tap = 0; tap < VDPP_ZME_TAPS; tap += 2) {
+			writel_relaxed(VDPP_ZME_COE_PAIR(coe[phase][tap], coe[phase][tap + 1]),
+				       zme + reg);
+			reg += sizeof(u32);
+		}
+	}
+}
+
+static void vdpp_zme_plane(void __iomem *zme, const struct vdpp_zme_plane *plane,
+			   u32 src_w, u32 src_h, u32 dst_w, u32 dst_h)
+{
+	u32 ctrl = VDPP_ZME_XSCL_MODE(VDPP_ZME_SCL_MULTI_PHASE) |
+		   VDPP_ZME_YSCL_MODE(VDPP_ZME_SCL_MULTI_PHASE) | VDPP_ZME_DERING_EN;
+
+	ctrl |= src_w > dst_w ? VDPP_ZME_XSD_EN : VDPP_ZME_XSD_BYPASS;
+	ctrl |= src_w < dst_w ? VDPP_ZME_XSU_EN : VDPP_ZME_XSU_BYPASS;
+	if (src_h > dst_h)
+		ctrl |= VDPP_ZME_YSD_EN;
+	else if (src_h < dst_h)
+		ctrl |= VDPP_ZME_YSU_EN;
+	else
+		ctrl |= VDPP_ZME_YS_BYPASS;
+
+	writel_relaxed(ctrl, zme + plane->scl + VDPP_ZME_SCL_CTRL);
+	writel_relaxed(VDPP_ZME_DERING_SEN0(VDPP_ZME_DERING_SEN0_DEF) |
+		       VDPP_ZME_DERING_SEN1(VDPP_ZME_DERING_SEN1_DEF) |
+		       VDPP_ZME_DERING_ALPHA(VDPP_ZME_DERING_ALPHA_DEF) |
+		       VDPP_ZME_DERING_DELTA(VDPP_ZME_DERING_DELTA_DEF),
+		       zme + plane->scl + VDPP_ZME_DERING);
+	writel_relaxed(VDPP_ZME_SCL_FACTOR(vdpp_zme_factor(src_w, dst_w)),
+		       zme + plane->scl + VDPP_ZME_XSCL_FACTOR);
+	writel_relaxed(VDPP_ZME_SCL_FACTOR(vdpp_zme_factor(src_h, dst_h)),
+		       zme + plane->scl + VDPP_ZME_YSCL_FACTOR);
+
+	vdpp_zme_write_coe(zme, plane->hor_coe, vdpp_zme_tap8[vdpp_zme_ratio(src_w, dst_w)]);
+	vdpp_zme_write_coe(zme, plane->ver_coe, vdpp_zme_tap6[vdpp_zme_ratio(src_h, dst_h)]);
+}
+
+void vdpp_zme_config(void __iomem *zme, u32 src_w, u32 src_h, u32 dst_w, u32 dst_h)
+{
+	writel_relaxed(VDPP_ZME_FORMAT_IN(VDPP_ZME_FMT_YUV420) |
+		       VDPP_ZME_FORMAT_OUT(VDPP_ZME_FMT_YUV420) | VDPP_ZME_AUTO_GATING_EN,
+		       zme + VDPP_ZME_CTRL);
+	vdpp_zme_plane(zme, &vdpp_zme_yrgb, src_w, src_h, dst_w, dst_h);
+	vdpp_zme_plane(zme, &vdpp_zme_cbcr,
+		       src_w / VDPP_ZME_CHROMA_DIV, src_h / VDPP_ZME_CHROMA_DIV,
+		       dst_w / VDPP_ZME_CHROMA_DIV, dst_h / VDPP_ZME_CHROMA_DIV);
+}
