From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Artem Butusov <art.sormy@gmail.com>
Date: Wed, 18 Nov 2026 01:43:55 -0500
Subject: [PATCH] dt-bindings: media: Add the Rockchip RK3528 VDPP

The RK3528's VDPP scales and enhances video frames in memory, sharing
its clocks, resets, interrupt and IOMMU with the IEP2 deinterlacer.

Signed-off-by: Artem Butusov <art.sormy@gmail.com>
---
 .../bindings/media/rockchip,rk3528-vdpp.yaml  | 91 +++++++++++++++++++
 1 file changed, 91 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/media/rockchip,rk3528-vdpp.yaml

diff --git a/Documentation/devicetree/bindings/media/rockchip,rk3528-vdpp.yaml b/Documentation/devicetree/bindings/media/rockchip,rk3528-vdpp.yaml
new file mode 100644
index 0000000..dba7aae
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/rockchip,rk3528-vdpp.yaml
@@ -0,0 +1,91 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/rockchip,rk3528-vdpp.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Rockchip VDPP video post-processor
+
+maintainers:
+  - Artem Butusov <art.sormy@gmail.com>
+
+description:
+  The VDPP scales and enhances video frames in memory. It shares its
+  clocks, resets, interrupt and IOMMU with the IEP2 deinterlacer, and
+  runs one job at a time with it.
+
+properties:
+  compatible:
+    const: rockchip,rk3528-vdpp
+
+  reg:
+    items:
+      - description: control registers
+      - description: scaler registers
+
+  reg-names:
+    items:
+      - const: vdpp
+      - const: zme
+
+  interrupts:
+    maxItems: 1
+
+  clocks:
+    items:
+      - description: AXI clock
+      - description: AHB clock
+      - description: core clock
+
+  clock-names:
+    items:
+      - const: aclk
+      - const: hclk
+      - const: sclk
+
+  resets:
+    maxItems: 3
+
+  reset-names:
+    items:
+      - const: axi
+      - const: ahb
+      - const: core
+
+  iommus:
+    maxItems: 1
+
+  power-domains:
+    maxItems: 1
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - interrupts
+  - clocks
+  - clock-names
+  - resets
+  - reset-names
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/rockchip,rk3528-cru.h>
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+    #include <dt-bindings/power/rockchip,rk3528-power.h>
+    #include <dt-bindings/reset/rockchip,rk3528-cru.h>
+
+    vdpp@ff861000 {
+        compatible = "rockchip,rk3528-vdpp";
+        reg = <0xff861000 0x100>, <0xff862000 0x900>;
+        reg-names = "vdpp", "zme";
+        interrupts = <GIC_SPI 106 IRQ_TYPE_LEVEL_HIGH>;
+        clocks = <&cru ACLK_VDPP>, <&cru HCLK_VDPP>, <&cru CLK_CORE_VDPP>;
+        clock-names = "aclk", "hclk", "sclk";
+        resets = <&cru SRST_A_VDPP>, <&cru SRST_H_VDPP>, <&cru SRST_CORE_VDPP>;
+        reset-names = "axi", "ahb", "core";
+        iommus = <&iep_mmu>;
+        power-domains = <&power RK3528_PD_VO>;
+    };
