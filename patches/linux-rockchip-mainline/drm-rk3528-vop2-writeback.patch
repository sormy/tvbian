From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Artem Butusov <art.sormy@gmail.com>
Date: Wed, 18 Nov 2026 13:06:11 -0500
Subject: [PATCH] drm/rockchip: vop2: add a writeback connector for the RK3528

The RK3528 VOP can write the output of a video port back to memory, in
ARGB8888, BGR888, RGB565 or NV12, scaled down in width and by two in
height, converting RGB to YUV but not back; of an interlaced mode it
writes one field. Expose it as a writeback connector.

The engine runs while enabled, so, as in the Rockchip BSP, a job enables
it with the port's cfg_done, the next frame start stops it, and the job
completes at the frame start after that. A job holds a vblank reference
until then, so the frame start interrupt stays on.

A writeback encoder drives no interface, so the video port skips it when
it routes its outputs, and it is made a clone of every other encoder so
it can run beside the output of its port.

A job ends unwritten when its port stops or the writeback moves to
another port, its vsyncs no longer coming, and a writeback is refused
while every job slot is pending, so no completion ever signals the
wrong job. The engine is stopped before such a job ends:
left on past its port's last frame, it wrote on once the IOMMU was
detached, its buffer's address taken as physical memory.

Signed-off-by: Artem Butusov <art.sormy@gmail.com>
---
 drivers/gpu/drm/rockchip/rockchip_drm_drv.c  |  19 ++
 drivers/gpu/drm/rockchip/rockchip_drm_vop2.c | 303 +++++++++++++++++++
 drivers/gpu/drm/rockchip/rockchip_drm_vop2.h |  36 +++
 drivers/gpu/drm/rockchip/rockchip_vop2_reg.c |  18 ++
 4 files changed, 376 insertions(+)

diff --git a/drivers/gpu/drm/rockchip/rockchip_drm_drv.c b/drivers/gpu/drm/rockchip/rockchip_drm_drv.c
index da32c34..0957439 100644
--- a/drivers/gpu/drm/rockchip/rockchip_drm_drv.c
+++ b/drivers/gpu/drm/rockchip/rockchip_drm_drv.c
@@ -142,6 +142,23 @@ static void rockchip_iommu_cleanup(struct drm_device *drm_dev)
 	iommu_domain_free(private->domain);
 }
 
+/* A writeback encoder may run beside any other encoder on its CRTC */
+static void rockchip_drm_set_writeback_clones(struct drm_device *drm)
+{
+	struct drm_encoder *wb, *encoder;
+
+	drm_for_each_encoder(wb, drm) {
+		if (wb->encoder_type != DRM_MODE_ENCODER_VIRTUAL)
+			continue;
+
+		drm_for_each_encoder(encoder, drm) {
+			encoder->possible_clones |= drm_encoder_mask(encoder) |
+						    drm_encoder_mask(wb);
+			wb->possible_clones |= drm_encoder_mask(encoder);
+		}
+	}
+}
+
 static int rockchip_drm_bind(struct device *dev)
 {
 	struct drm_device *drm_dev;
@@ -182,6 +199,8 @@ static int rockchip_drm_bind(struct device *dev)
 	if (ret)
 		goto err_free;
 
+	rockchip_drm_set_writeback_clones(drm_dev);
+
 	ret = rockchip_drm_init_iommu(drm_dev);
 	if (ret)
 		goto err_unbind_all;
diff --git a/drivers/gpu/drm/rockchip/rockchip_drm_vop2.c b/drivers/gpu/drm/rockchip/rockchip_drm_vop2.c
index f62d4a1..caef37c 100644
--- a/drivers/gpu/drm/rockchip/rockchip_drm_vop2.c
+++ b/drivers/gpu/drm/rockchip/rockchip_drm_vop2.c
@@ -21,11 +21,14 @@
 
 #include <drm/drm.h>
 #include <drm/drm_atomic.h>
+#include <drm/drm_atomic_helper.h>
 #include <drm/drm_atomic_uapi.h>
 #include <drm/drm_blend.h>
 #include <drm/drm_crtc.h>
 #include <linux/debugfs.h>
 #include <drm/drm_debugfs.h>
+#include <drm/drm_edid.h>
+#include <drm/drm_fourcc.h>
 #include <drm/drm_flip_work.h>
 #include <drm/drm_framebuffer.h>
 #include <drm/drm_gem_framebuffer_helper.h>
@@ -1070,6 +1073,8 @@ static bool vop2_gamma_lut_in_use(struct vop2 *vop2, struct vop2_video_port *vp)
 	return gamma_en_vp_id != nr_vps && gamma_en_vp_id != vp->id;
 }
 
+static void vop2_wb_cancel(struct vop2_video_port *vp);
+
 static void vop2_crtc_atomic_disable(struct drm_crtc *crtc,
 				     struct drm_atomic_commit *state)
 {
@@ -1086,6 +1091,9 @@ static void vop2_crtc_atomic_disable(struct drm_crtc *crtc,
 	old_crtc_state = drm_atomic_get_old_crtc_state(state, crtc);
 	drm_atomic_helper_disable_planes_on_crtc(old_crtc_state, false);
 
+	if (vop2->data->wb && FIELD_GET(RK3568_LUT_PORT_SEL__WB_VP,
+					vop2_readl(vop2, RK3568_LUT_PORT_SEL)) == vp->id)
+		vop2_wb_cancel(vp);
 	drm_crtc_vblank_off(crtc);
 	vop2_crtc_disable_irq(vp, VP_INT_POST_BUF_EMPTY);
 
@@ -1868,6 +1876,10 @@ static void vop2_crtc_atomic_enable(struct drm_crtc *crtc,
 	drm_for_each_encoder_mask(encoder, crtc->dev, crtc_state->encoder_mask) {
 		struct rockchip_encoder *rkencoder = to_rockchip_encoder(encoder);
 
+		/* The writeback encoder drives no interface */
+		if (!rkencoder->crtc_endpoint_id)
+			continue;
+
 		/*
 		 * for drive a high resolution(4KP120, 8K), vop on rk3588/rk3576 need
 		 * process multi(1/2/4/8) pixels per cycle, so the dclk feed by the
@@ -2054,6 +2066,80 @@ static int vop2_crtc_atomic_check_gamma(struct vop2_video_port *vp,
 	return 0;
 }
 
+/*
+ * It converts RGB to YUV only. The encoders set the port's bus format after
+ * the connectors' checks, so the writeback's format is checked here.
+ */
+/* The engine stops at the port's next frame start */
+static void vop2_wb_stop(struct vop2 *vop2)
+{
+	regmap_clear_bits(vop2->map, RK3568_WB_CTRL, RK3568_WB_CTRL__ENABLE);
+	regmap_set_bits(vop2->map, RK3568_REG_CFG_DONE,
+			RK3568_REG_CFG_DONE__WB_CFG_DONE |
+			RK3568_REG_CFG_DONE__WB_CFG_DONE << 16 |
+			RK3568_REG_CFG_DONE__GLB_CFG_DONE_EN);
+}
+
+/*
+ * Every writeback still pending ends unwritten: the port it waits on stops,
+ * or the writeback moves to another port, and its vsyncs no longer come.
+ * The engine stops first: left on past its port's last frame, it writes on
+ * once the IOMMU is detached, its buffer's address taken as physical.
+ */
+static void vop2_wb_cancel(struct vop2_video_port *vp)
+{
+	struct vop2 *vop2 = vp->vop2;
+	unsigned long flags;
+	int i;
+
+	spin_lock_irqsave(&vop2->wb_lock, flags);
+	vop2_wb_stop(vop2);
+	for (i = 0; i < VOP2_WB_JOB_MAX; i++) {
+		if (!vop2->wb_job_vsyncs[i])
+			continue;
+		vop2->wb_job_vsyncs[i] = 0;
+		drm_writeback_signal_completion(&vop2->wb, -ETIMEDOUT);
+		drm_crtc_vblank_put(&vp->crtc);
+	}
+	spin_unlock_irqrestore(&vop2->wb_lock, flags);
+}
+
+static bool vop2_wb_slots_full(struct vop2 *vop2)
+{
+	unsigned long flags;
+	bool full = true;
+	int i;
+
+	spin_lock_irqsave(&vop2->wb_lock, flags);
+	for (i = 0; i < VOP2_WB_JOB_MAX; i++)
+		full &= !!vop2->wb_job_vsyncs[i];
+	spin_unlock_irqrestore(&vop2->wb_lock, flags);
+	return full;
+}
+
+static int vop2_wb_check_output(struct vop2_video_port *vp, struct drm_atomic_commit *state,
+				struct drm_crtc_state *crtc_state)
+{
+	struct drm_connector_state *conn_state =
+		drm_atomic_get_new_connector_state(state, &vp->vop2->wb.base);
+	struct drm_framebuffer *fb;
+
+	if (!conn_state || conn_state->crtc != &vp->crtc ||
+	    !conn_state->writeback_job || !conn_state->writeback_job->fb)
+		return 0;
+
+	fb = conn_state->writeback_job->fb;
+	if (!fb->format->is_yuv &&
+	    is_yuv_output(to_rockchip_crtc_state(crtc_state)->bus_format))
+		return -EINVAL;
+
+	/* a job's slot is freed when it completes: none is taken from one still pending */
+	if (vop2_wb_slots_full(vp->vop2))
+		return -EBUSY;
+
+	return 0;
+}
+
 static int vop2_crtc_atomic_check(struct drm_crtc *crtc,
 				  struct drm_atomic_commit *state)
 {
@@ -2067,6 +2153,10 @@ static int vop2_crtc_atomic_check(struct drm_crtc *crtc,
 	if (ret)
 		return ret;
 
+	ret = vop2_wb_check_output(vp, state, crtc_state);
+	if (ret)
+		return ret;
+
 	drm_atomic_crtc_state_for_each_plane(plane, crtc_state)
 		nplanes++;
 
@@ -2103,6 +2193,168 @@ static void vop2_crtc_queue_event(struct drm_crtc *crtc)
 	spin_unlock_irq(&crtc->dev->event_lock);
 }
 
+enum vop2_wb_format {
+	VOP2_WB_ARGB8888 = 0,
+	VOP2_WB_BGR888 = 1,
+	VOP2_WB_RGB565 = 2,
+	VOP2_WB_YUV420SP = 4,
+};
+
+static struct vop2 *connector_to_vop2(struct drm_connector *connector)
+{
+	return container_of(connector, struct vop2, wb.base);
+}
+
+static enum vop2_wb_format vop2_wb_format(u32 format)
+{
+	switch (format) {
+	case DRM_FORMAT_RGB888:	/* the engine's BGR888: B first in memory */
+		return VOP2_WB_BGR888;
+	case DRM_FORMAT_RGB565:
+		return VOP2_WB_RGB565;
+	case DRM_FORMAT_NV12:
+		return VOP2_WB_YUV420SP;
+	default:
+		return VOP2_WB_ARGB8888;
+	}
+}
+
+static int vop2_wb_get_modes(struct drm_connector *connector)
+{
+	const struct vop2_wb_data *wb = connector_to_vop2(connector)->data->wb;
+
+	return drm_add_modes_noedid(connector, wb->max_output.width, wb->max_output.height);
+}
+
+/* The lines it writes a frame: one field of an interlaced mode */
+static u16 vop2_wb_lines(const struct drm_display_mode *mode)
+{
+	return mode->flags & DRM_MODE_FLAG_INTERLACE ? mode->vdisplay / 2 :
+						       mode->vdisplay;
+}
+
+static int vop2_wb_atomic_check(struct drm_connector *connector,
+				struct drm_atomic_commit *state)
+{
+	struct drm_connector_state *conn_state =
+		drm_atomic_get_new_connector_state(state, connector);
+	const struct vop2_wb_data *wb = connector_to_vop2(connector)->data->wb;
+	const struct drm_display_mode *mode;
+	struct drm_crtc_state *crtc_state;
+	struct drm_framebuffer *fb;
+
+	if (!conn_state->writeback_job || !conn_state->writeback_job->fb)
+		return 0;
+
+	crtc_state = drm_atomic_get_new_crtc_state(state, conn_state->crtc);
+	mode = &crtc_state->mode;
+	fb = conn_state->writeback_job->fb;
+
+	/* It scales down in width, by two in height, and writes rows unpadded */
+	if (fb->width > mode->hdisplay || fb->width > wb->max_output.width ||
+	    (fb->height != vop2_wb_lines(mode) &&
+	     fb->height != vop2_wb_lines(mode) / 2) ||
+	    fb->pitches[0] != drm_format_info_min_pitch(fb->format, 0, fb->width))
+		return -EINVAL;
+
+	return drm_atomic_helper_check_wb_connector_state(connector, state);
+}
+
+static void vop2_wb_commit(struct vop2_video_port *vp, struct drm_atomic_commit *state)
+{
+	struct vop2 *vop2 = vp->vop2;
+	struct drm_connector_state *conn_state =
+		drm_atomic_get_new_connector_state(state, &vop2->wb.base);
+	struct drm_crtc_state *crtc_state = drm_atomic_get_new_crtc_state(state, &vp->crtc);
+	struct rockchip_crtc_state *vcstate = to_rockchip_crtc_state(crtc_state);
+	u16 hdisplay = crtc_state->mode.hdisplay;
+	struct drm_framebuffer *fb;
+	u32 ctrl, fifo_throd;
+	unsigned int old_vp;
+
+	if (!conn_state || conn_state->crtc != &vp->crtc ||
+	    !conn_state->writeback_job || !conn_state->writeback_job->fb)
+		return;
+
+	fb = conn_state->writeback_job->fb;
+
+	if (drm_crtc_vblank_get(&vp->crtc)) {
+		drm_writeback_queue_job(&vop2->wb, conn_state);
+		drm_writeback_signal_completion(&vop2->wb, -EINVAL);
+		return;
+	}
+
+	ctrl = FIELD_PREP(RK3568_WB_CTRL__AXI_UV_ID, vop2->data->wb->axi_uv_id) |
+	       FIELD_PREP(RK3568_WB_CTRL__AXI_YRGB_ID, vop2->data->wb->axi_yrgb_id) |
+	       FIELD_PREP(RK3568_WB_CTRL__FORMAT, vop2_wb_format(fb->format->format)) |
+	       RK3568_WB_CTRL__ENABLE;
+	if (fb->width < hdisplay)
+		ctrl |= RK3568_WB_CTRL__SCALE_X_EN;
+	if (fb->height < vop2_wb_lines(&crtc_state->mode))
+		ctrl |= RK3568_WB_CTRL__SCALE_Y_EN;
+	if (fb->format->is_yuv && !vcstate->yuv_overlay)
+		ctrl |= RK3568_WB_CTRL__R2Y_EN;
+
+	fifo_throd = min_t(u32, fb->pitches[0] >> 4, vop2->data->wb->fifo_depth);
+
+	old_vp = FIELD_GET(RK3568_LUT_PORT_SEL__WB_VP, vop2_readl(vop2, RK3568_LUT_PORT_SEL));
+	if (old_vp != vp->id && old_vp < vop2->data->nr_vps)
+		vop2_wb_cancel(&vop2->vps[old_vp]);
+	regmap_update_bits(vop2->map, RK3568_LUT_PORT_SEL, RK3568_LUT_PORT_SEL__WB_VP,
+			   FIELD_PREP(RK3568_LUT_PORT_SEL__WB_VP, vp->id));
+	vop2_writel(vop2, RK3568_WB_YRGB_MST,
+		    to_rockchip_obj(fb->obj[0])->dma_addr + fb->offsets[0]);
+	if (fb->format->is_yuv)
+		vop2_writel(vop2, RK3568_WB_CBR_MST,
+			    to_rockchip_obj(fb->obj[1])->dma_addr + fb->offsets[1]);
+	vop2_writel(vop2, RK3568_WB_XSCAL_FACTOR,
+		    FIELD_PREP(RK3568_WB_XSCAL_FACTOR__FACTOR,
+			       vop2_scale_factor(hdisplay, fb->width)) |
+		    FIELD_PREP(RK3568_WB_XSCAL_FACTOR__FIFO_THROD, fifo_throd));
+
+	spin_lock_irq(&vop2->wb_lock);
+	drm_writeback_queue_job(&vop2->wb, conn_state);
+	vop2->wb_job_vsyncs[vop2->wb_job_index] = VOP2_WB_JOB_VSYNCS;
+	vop2->wb_job_index = (vop2->wb_job_index + 1) % VOP2_WB_JOB_MAX;
+	vop2_writel(vop2, RK3568_WB_CTRL, ctrl);
+	spin_unlock_irq(&vop2->wb_lock);
+}
+
+static const struct drm_connector_helper_funcs vop2_wb_connector_helper_funcs = {
+	.get_modes = vop2_wb_get_modes,
+	.atomic_check = vop2_wb_atomic_check,
+};
+
+static const struct drm_connector_funcs vop2_wb_connector_funcs = {
+	.fill_modes = drm_helper_probe_single_connector_modes,
+	.reset = drm_atomic_helper_connector_reset,
+	.atomic_duplicate_state = drm_atomic_helper_connector_duplicate_state,
+	.atomic_destroy_state = drm_atomic_helper_connector_destroy_state,
+};
+
+static int vop2_wb_init(struct vop2 *vop2)
+{
+	const struct vop2_wb_data *wb = vop2->data->wb;
+	struct drm_encoder *encoder = &vop2->wb_encoder.encoder;
+	struct drm_crtc *crtc;
+	int ret;
+
+	if (!wb)
+		return 0;
+
+	ret = drmm_encoder_init(vop2->drm, encoder, NULL, DRM_MODE_ENCODER_VIRTUAL, NULL);
+	if (ret)
+		return ret;
+
+	drm_for_each_crtc(crtc, vop2->drm)
+		encoder->possible_crtcs |= drm_crtc_mask(crtc);
+
+	drm_connector_helper_add(&vop2->wb.base, &vop2_wb_connector_helper_funcs);
+
+	return drmm_writeback_connector_init(vop2->drm, &vop2->wb, &vop2_wb_connector_funcs,
+					     encoder, wb->formats, wb->nformats);
+}
+
 static void vop2_crtc_atomic_flush(struct drm_crtc *crtc,
 				   struct drm_atomic_commit *state)
 {
@@ -2122,6 +2374,9 @@ static void vop2_crtc_atomic_flush(struct drm_crtc *crtc,
 
 	vop2_post_config(crtc, false, crtc_state, old_crtc_state);
 
+	if (vop2->data->wb)
+		vop2_wb_commit(vp, state);
+
 	vop2_cfg_done(vp);
 
 	vop2_crtc_queue_event(crtc);
@@ -2460,6 +2715,48 @@ static irqreturn_t rk3576_vp_isr(int irq, void *data)
 	return ret;
 }
 
+/*
+ * The writeback engine runs while enabled. The commit's cfg_done latches it
+ * at the next frame start, or at the one after where the commit lands
+ * between a frame start and its interrupt; so a job's second frame start
+ * stops it at the third, where the job ends with a whole frame written.
+ */
+static void vop2_wb_handle_vsync(struct vop2_video_port *vp)
+{
+	struct vop2 *vop2 = vp->vop2;
+	bool stop = false;
+	int i;
+
+	if (!vop2->data->wb)
+		return;
+
+	if (FIELD_GET(RK3568_LUT_PORT_SEL__WB_VP,
+		      vop2_readl(vop2, RK3568_LUT_PORT_SEL)) != vp->id)
+		return;
+
+	spin_lock(&vop2->wb_lock);
+
+	for (i = 0; i < VOP2_WB_JOB_MAX; i++) {
+		if (!vop2->wb_job_vsyncs[i])
+			continue;
+
+		switch (--vop2->wb_job_vsyncs[i]) {
+		case 1:
+			stop = true;
+			break;
+		case 0:
+			drm_writeback_signal_completion(&vop2->wb, 0);
+			drm_crtc_vblank_put(&vp->crtc);
+			break;
+		}
+	}
+
+	if (stop)
+		vop2_wb_stop(vop2);
+
+	spin_unlock(&vop2->wb_lock);
+}
+
 static irqreturn_t vop2_isr(int irq, void *data)
 {
 	struct vop2 *vop2 = data;
@@ -2490,6 +2787,7 @@ static irqreturn_t vop2_isr(int irq, void *data)
 			}
 
 			if (irqs & VP_INT_FS_FIELD) {
+				vop2_wb_handle_vsync(vp);
 				drm_crtc_handle_vblank(crtc);
 				spin_lock(&crtc->dev->event_lock);
 				if (vp->event) {
@@ -2985,6 +3283,7 @@ static int vop2_bind(struct device *dev, struct device *master, void *data)
 
 	mutex_init(&vop2->vop2_lock);
 	mutex_init(&vop2->ovl_lock);
+	spin_lock_init(&vop2->wb_lock);
 
 	ret = devm_request_irq(dev, vop2->irq, vop2_isr, IRQF_SHARED, dev_name(dev), vop2);
 	if (ret)
@@ -2994,6 +3293,10 @@ static int vop2_bind(struct device *dev, struct device *master, void *data)
 	if (ret)
 		return ret;
 
+	ret = vop2_wb_init(vop2);
+	if (ret)
+		goto err_crtcs;
+
 	if (vop2->version >= VOP_VERSION_RK3576) {
 		struct drm_crtc *crtc;
 
diff --git a/drivers/gpu/drm/rockchip/rockchip_drm_vop2.h b/drivers/gpu/drm/rockchip/rockchip_drm_vop2.h
index 4750dbf..c4b8441 100644
--- a/drivers/gpu/drm/rockchip/rockchip_drm_vop2.h
+++ b/drivers/gpu/drm/rockchip/rockchip_drm_vop2.h
@@ -9,6 +9,7 @@
 
 #include <linux/regmap.h>
 #include <drm/drm_modes.h>
+#include <drm/drm_writeback.h>
 #include <dt-bindings/soc/rockchip,vop2.h>
 #include "rockchip_drm_drv.h"
 #include "rockchip_drm_vop.h"
@@ -273,6 +274,19 @@ struct vop2_ops {
 	void (*setup_overlay)(struct vop2_video_port *vp);
 };
 
+/* A writeback job ends three frame starts after its commit */
+#define VOP2_WB_JOB_VSYNCS	3
+#define VOP2_WB_JOB_MAX		2
+
+struct vop2_wb_data {
+	const u32 *formats;
+	unsigned int nformats;
+	struct vop_rect max_output;
+	u16 fifo_depth;
+	u8 axi_yrgb_id;
+	u8 axi_uv_id;
+};
+
 struct vop2_data {
 	u8 nr_vps;
 	u64 feature;
@@ -291,6 +305,7 @@ struct vop2_data {
 	unsigned int win_size;
 	unsigned int regs_dump_size;
 	unsigned int soc_id;
+	const struct vop2_wb_data *wb;
 };
 
 struct vop2 {
@@ -353,6 +368,13 @@ struct vop2 {
 	 */
 	struct mutex ovl_lock;
 
+	struct drm_writeback_connector wb;
+	struct rockchip_encoder wb_encoder;
+	/* protects the writeback job ring against the vsync interrupt */
+	spinlock_t wb_lock;
+	u8 wb_job_vsyncs[VOP2_WB_JOB_MAX];
+	u8 wb_job_index;
+
 	/* must be put at the end of the struct */
 	struct vop2_win win[];
 };
@@ -651,6 +673,20 @@ enum dst_factor_mode {
 #define RK3568_HDR_OETF_XN1			0x2300
 
 #define RK3568_REG_CFG_DONE__GLB_CFG_DONE_EN		BIT(15)
+#define RK3568_REG_CFG_DONE__WB_CFG_DONE		BIT(14)
+
+#define RK3568_WB_CTRL__AXI_UV_ID			GENMASK(31, 27)
+#define RK3568_WB_CTRL__AXI_YRGB_ID			GENMASK(26, 19)
+#define RK3568_WB_CTRL__SCALE_Y_EN			BIT(8)
+#define RK3568_WB_CTRL__SCALE_X_EN			BIT(7)
+#define RK3568_WB_CTRL__R2Y_EN				BIT(5)
+#define RK3568_WB_CTRL__FORMAT				GENMASK(3, 1)
+#define RK3568_WB_CTRL__ENABLE				BIT(0)
+
+#define RK3568_WB_XSCAL_FACTOR__FACTOR			GENMASK(29, 16)
