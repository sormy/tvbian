From: Artem Butusov <art.sormy@gmail.com>
Subject: [PATCH] media: verisilicon: A test parameter that fails the next VDPU2 decode

The VDPU2's recovery from a job that times out or faults is untested:
no stream found makes one, and a watchdog shortened to make one ends
jobs the core is still running, which no recovery is meant to survive.

Add fail_next_job: 1 leaves the next decode unstarted, so it times out
on an idle core; 2 points its output where nothing is mapped, so it
faults on the IOMMU. The parameter clears itself.

Signed-off-by: Artem Butusov <art.sormy@gmail.com>
---
  drivers/media/platform/verisilicon/hantro_hw.h     |  1 +
  .../verisilicon/rockchip_vpu2_hw_h264_dec.c        |  2 ++
  .../verisilicon/rockchip_vpu2_hw_mpeg2_dec.c       |  2 ++
  .../verisilicon/rockchip_vpu2_hw_mpeg4_dec.c       |  2 ++
  .../verisilicon/rockchip_vpu2_hw_vp8_dec.c         |  3 ++-
  .../media/platform/verisilicon/rockchip_vpu_hw.c   | 30 ++++++++++++++++++++++
  6 files changed, 39 insertions(+), 1 deletion(-)

diff --git a/drivers/media/platform/verisilicon/hantro_hw.h b/drivers/media/platform/verisilicon/hantro_hw.h
index 2239e6c..19c3d7d 100644
--- a/drivers/media/platform/verisilicon/hantro_hw.h
+++ b/drivers/media/platform/verisilicon/hantro_hw.h
@@ -443,6 +443,7 @@ void hantro_irq_done(struct hantro_dev *vpu,
 		     enum vb2_buffer_state result);
 void hantro_start_prepare_run(struct hantro_ctx *ctx);
 void hantro_end_prepare_run(struct hantro_ctx *ctx);
+bool rockchip_vpu2_dec_test_start(struct hantro_dev *vpu);
 
 irqreturn_t hantro_g1_irq(int irq, void *dev_id);
 void hantro_g1_reset(struct hantro_ctx *ctx);
diff --git a/drivers/media/platform/verisilicon/rockchip_vpu2_hw_h264_dec.c b/drivers/media/platform/verisilicon/rockchip_vpu2_hw_h264_dec.c
index 6da87f5..d93dfaa 100644
--- a/drivers/media/platform/verisilicon/rockchip_vpu2_hw_h264_dec.c
+++ b/drivers/media/platform/verisilicon/rockchip_vpu2_hw_h264_dec.c
@@ -483,6 +483,8 @@ int rockchip_vpu2_h264_dec_run(struct hantro_ctx *ctx)
 
 	hantro_end_prepare_run(ctx);
 
+	if (!rockchip_vpu2_dec_test_start(vpu))
+		return 0;
 	/* Start decoding! */
 	reg = vdpu_read(vpu, VDPU_SWREG(57)) | VDPU_REG_DEC_E(1);
 	vdpu_write(vpu, reg, VDPU_SWREG(57));
diff --git a/drivers/media/platform/verisilicon/rockchip_vpu2_hw_mpeg2_dec.c b/drivers/media/platform/verisilicon/rockchip_vpu2_hw_mpeg2_dec.c
index 50a3a3e..6764ac1 100644
--- a/drivers/media/platform/verisilicon/rockchip_vpu2_hw_mpeg2_dec.c
+++ b/drivers/media/platform/verisilicon/rockchip_vpu2_hw_mpeg2_dec.c
@@ -241,6 +241,8 @@ int rockchip_vpu2_mpeg2_dec_run(struct hantro_ctx *ctx)
 	/* Kick the watchdog and start decoding */
 	hantro_end_prepare_run(ctx);
 
+	if (!rockchip_vpu2_dec_test_start(vpu))
+		return 0;
 	reg = vdpu_read(vpu, VDPU_SWREG(57)) | VDPU_REG_DEC_E(1);
 	vdpu_write(vpu, reg, VDPU_SWREG(57));
 
diff --git a/drivers/media/platform/verisilicon/rockchip_vpu2_hw_mpeg4_dec.c b/drivers/media/platform/verisilicon/rockchip_vpu2_hw_mpeg4_dec.c
index a816489..91d1f8b 100644
--- a/drivers/media/platform/verisilicon/rockchip_vpu2_hw_mpeg4_dec.c
+++ b/drivers/media/platform/verisilicon/rockchip_vpu2_hw_mpeg4_dec.c
@@ -260,6 +260,8 @@ int rockchip_vpu2_mpeg4_dec_run(struct hantro_ctx *ctx)
 
 	hantro_end_prepare_run(ctx);
 
+	if (!rockchip_vpu2_dec_test_start(vpu))
+		return 0;
 	reg = vdpu_read(vpu, VDPU_SWREG(57)) | VDPU_REG_DEC_E(1);
 	vdpu_write(vpu, reg, VDPU_SWREG(57));
 
diff --git a/drivers/media/platform/verisilicon/rockchip_vpu2_hw_vp8_dec.c b/drivers/media/platform/verisilicon/rockchip_vpu2_hw_vp8_dec.c
index d079075..c01d5e2 100644
--- a/drivers/media/platform/verisilicon/rockchip_vpu2_hw_vp8_dec.c
+++ b/drivers/media/platform/verisilicon/rockchip_vpu2_hw_vp8_dec.c
@@ -594,7 +594,8 @@ int rockchip_vpu2_vp8_dec_run(struct hantro_ctx *ctx)
 
 	hantro_end_prepare_run(ctx);
 
-	hantro_reg_write(vpu, &vp8_dec_start_dec, 1);
+	if (rockchip_vpu2_dec_test_start(vpu))
+		hantro_reg_write(vpu, &vp8_dec_start_dec, 1);
 
 	return 0;
 }
diff --git a/drivers/media/platform/verisilicon/rockchip_vpu_hw.c b/drivers/media/platform/verisilicon/rockchip_vpu_hw.c
index 8feef61..406ef54 100644
--- a/drivers/media/platform/verisilicon/rockchip_vpu_hw.c
+++ b/drivers/media/platform/verisilicon/rockchip_vpu_hw.c
@@ -17,6 +17,36 @@
 #include "rockchip_vpu2_regs.h"
 #include "rockchip_vpu981_regs.h"
 
+enum rockchip_vpu2_test_failure {
+	ROCKCHIP_VPU2_TEST_NONE,
+	ROCKCHIP_VPU2_TEST_TIMEOUT,
+	ROCKCHIP_VPU2_TEST_FAULT,
+};
+
+static int fail_next_job;
+module_param(fail_next_job, int, 0644);
+MODULE_PARM_DESC(fail_next_job,
+		 "Test: the next VDPU2 decode is never started, so it times out (1), or writes where nothing is mapped (2)");
+
+/* An IOVA the DMA API allocates only when the space is nearly full */
+#define ROCKCHIP_VPU2_UNMAPPED_IOVA	0x1000
+
+/*
+ * Whether to start the decode: the recovery under test, as no stream makes a
+ * job time out or fault. A job never started times out on an idle core.
+ */
+bool rockchip_vpu2_dec_test_start(struct hantro_dev *vpu)
+{
+	switch (xchg(&fail_next_job, ROCKCHIP_VPU2_TEST_NONE)) {
+	case ROCKCHIP_VPU2_TEST_TIMEOUT:
+		return false;
+	case ROCKCHIP_VPU2_TEST_FAULT:
+		vdpu_write(vpu, ROCKCHIP_VPU2_UNMAPPED_IOVA, VDPU_REG_ADDR_DST);
+		break;
+	}
+	return true;
+}
+
 #define RK3066_ACLK_MAX_FREQ (300 * 1000 * 1000)
 #define RK3288_ACLK_MAX_FREQ (400 * 1000 * 1000)
 
