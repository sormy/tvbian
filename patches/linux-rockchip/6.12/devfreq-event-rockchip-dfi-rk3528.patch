From: Artem Butusov <art.sormy@gmail.com>
Subject: [PATCH] PM / devfreq: rockchip-dfi: Add the RK3528

The 6.12 driver has no RK3528 entry, so its DFI never probes and the
DMC, which needs it as its devfreq event, stays in deferred probe: the
DDR never scales. Add it as 6.1 has it: one channel, the DRAM type in
PMUGRF_OS_REG18/19, counted at rate 2. The RK3528 has no separate PMU
GRF and its trees name the GRF, so fall back to "rockchip,grf".

Signed-off-by: Artem Butusov <art.sormy@gmail.com>
---
--- a/drivers/devfreq/event/rockchip-dfi.c
+++ b/drivers/devfreq/event/rockchip-dfi.c
@@ -31,6 +31,9 @@
 #include <soc/rockchip/rk3572_grf.h>
 #include <soc/rockchip/rk3588_grf.h>
 
+/* the RK3528 has no separate PMU GRF: its registers sit in the GRF, from 0x70000 */
+#define RK3528_PMUGRF_OS_REG18		0x70248
+
 #define DMC_MAX_CHANNELS	4
 
 #define HIWORD_UPDATE(val, mask)	((val) | (mask) << 16)
@@ -965,6 +968,23 @@
 	return rockchip_dfi_init_clocks(dfi);
 };
 
+static int rk3528_dfi_init(struct rockchip_dfi *dfi)
+{
+	dfi->max_channels = 1;
+	if (rockchip_dfi_get_dram_info(dfi, RK3528_PMUGRF_OS_REG18))
+		return -EINVAL;
+
+	dfi->ddrmon_stride = 0x0; /* not relevant, we only have a single channel on this SoC */
+	dfi->ddrmon_ctrl_single = true;
+
+	dfi->count_rate = 2;
+
+	/* no clk management */
+	dfi->num_clks = 0;
+
+	return 0;
+};
+
 static int rk3562_dfi_init(struct rockchip_dfi *dfi)
 {
 	dfi->max_channels = 1;
@@ -1077,6 +1097,7 @@
 
 static const struct of_device_id rockchip_dfi_id_match[] = {
 	{ .compatible = "rockchip,rk3399-dfi", .data = rk3399_dfi_init },
+	{ .compatible = "rockchip,rk3528-dfi", .data = rk3528_dfi_init },
 	{ .compatible = "rockchip,rk3562-dfi", .data = rk3562_dfi_init },
 	{ .compatible = "rockchip,rk3568-dfi", .data = rk3568_dfi_init },
 	{ .compatible = "rockchip,rk3588-dfi", .data = rk3588_dfi_init },
@@ -1110,6 +1131,8 @@
 
 	node = of_parse_phandle(np, "rockchip,pmu", 0);
 	if (!node)
+		node = of_parse_phandle(np, "rockchip,grf", 0);
+	if (!node)
 		return dev_err_probe(&pdev->dev, -ENODEV, "Can't find pmu_grf registers\n");
 
 	dfi->regmap_pmu = syscon_node_to_regmap(node);
