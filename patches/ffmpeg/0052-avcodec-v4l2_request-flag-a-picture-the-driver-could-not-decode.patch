From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Artem Butusov <art.sormy@gmail.com>
Date: Fri, 20 Nov 2026 12:00:00 -0500
Subject: [PATCH] avcodec/v4l2_request: flag a picture the driver could not decode

A stateless driver completes a job it cannot run with the CAPTURE buffer
marked V4L2_BUF_FLAG_ERROR, and the picture in it is left blank. The
request hwaccel returned it as any other frame. Set
FF_DECODE_ERROR_INVALID_BITSTREAM on it, as the mem2mem decoders do, so
a player can tell a failing decoder from a decoded picture.
---
diff --git a/libavcodec/v4l2_request.c b/libavcodec/v4l2_request.c
index 0e00de3..8b002f0 100644
--- a/libavcodec/v4l2_request.c
+++ b/libavcodec/v4l2_request.c
@@ -208,10 +208,15 @@ static int v4l2_request_dequeue_buffer(V4L2RequestContext *ctx,
         return AVERROR(errno);
 
     // Mark the buffer as dequeued
-    if (V4L2_TYPE_IS_OUTPUT(buffer.type))
+    if (V4L2_TYPE_IS_OUTPUT(buffer.type)) {
         ctx->queued_output &= ~(1 << buffer.index);
-    else
+    } else {
         ctx->queued_capture &= ~(1 << buffer.index);
+        if (buffer.flags & V4L2_BUF_FLAG_ERROR)
+            ctx->failed_capture |= 1ULL << buffer.index;
+        else
+            ctx->failed_capture &= ~(1ULL << buffer.index);
+    }
 
     return 0;
 }
@@ -543,7 +548,14 @@ static int v4l2_request_post_process(void *logctx, AVFrame *frame)
     v4l2_request_offset_frame(ctx, frame);
 
     // Wait on CAPTURE buffer before returning the frame to application
-    return v4l2_request_wait_on_capture(ctx, index);
+    int ret = v4l2_request_wait_on_capture(ctx, index);
+    if (ret)
+        return ret;
+
+    // A job the driver could not decode leaves its picture blank: say so, as the mem2mem decoders do
+    if (ctx->failed_capture & (1ULL << index))
+        frame->decode_error_flags |= FF_DECODE_ERROR_INVALID_BITSTREAM;
+    return 0;
 }
 
 int ff_v4l2_request_reset_picture(AVCodecContext *avctx, V4L2RequestPictureContext *pic)
diff --git a/libavcodec/v4l2_request.h b/libavcodec/v4l2_request.h
index 64cc588..c3b038f 100644
--- a/libavcodec/v4l2_request.h
+++ b/libavcodec/v4l2_request.h
@@ -51,6 +51,8 @@ typedef struct V4L2RequestContext {
     uint32_t queued_output;
     uint32_t queued_request;
     uint64_t queued_capture;
+    // CAPTURE buffers the driver gave back marked V4L2_BUF_FLAG_ERROR, a job it could not decode
+    uint64_t failed_capture;
     struct v4l2_ext_control *init_controls;
     int nb_init_controls;
 } V4L2RequestContext;
