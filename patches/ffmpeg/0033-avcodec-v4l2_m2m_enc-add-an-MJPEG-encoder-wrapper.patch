From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Artem Butusov <art.sormy@gmail.com>
Date: Sat, 31 Oct 2026 10:21:09 -0400
Subject: [PATCH] avcodec/v4l2_m2m_enc: add an MJPEG encoder wrapper

Stateful JPEG encoders take V4L2_PIX_FMT_MJPEG like any other format.
The only setting is the quality, from -q:v as FFmpeg's own MJPEG encoder
reads it, 2 best and 31 worst; frames go in at full range, as JPEG keeps
them.
---
 configure                 |  1 +
 libavcodec/allcodecs.c    |  1 +
 libavcodec/v4l2_m2m_enc.c | 29 ++++++++++++++++++++++-------
 3 files changed, 24 insertions(+), 7 deletions(-)

diff --git a/configure b/configure
index b7481a3..feda70f 100755
--- a/configure
+++ b/configure
@@ -3732,6 +3732,7 @@ mpeg4_rkmpp_decoder_select="mpeg4_unpack_bframes_bsf"
 mpeg4_v4l2m2m_decoder_deps="v4l2_m2m mpeg4_v4l2_m2m"
 mpeg4_v4l2m2m_decoder_select="mpeg4_unpack_bframes_bsf"
 mjpeg_v4l2m2m_decoder_deps="v4l2_m2m mjpeg_v4l2_m2m"
+mjpeg_v4l2m2m_encoder_deps="v4l2_m2m mjpeg_v4l2_m2m"
 mpeg4_v4l2m2m_encoder_deps="v4l2_m2m mpeg4_v4l2_m2m"
 vc1_cuvid_decoder_deps="cuvid"
 vc1_mmal_decoder_deps="mmal"
diff --git a/libavcodec/allcodecs.c b/libavcodec/allcodecs.c
index 1512ac5..571f3eb 100644
--- a/libavcodec/allcodecs.c
+++ b/libavcodec/allcodecs.c
@@ -209,6 +209,7 @@ extern const FFCodec ff_mpeg2video_decoder;
 extern const FFCodec ff_mpeg4_encoder;
 extern const FFCodec ff_mpeg4_decoder;
 extern const FFCodec ff_mjpeg_v4l2m2m_decoder;
+extern const FFCodec ff_mjpeg_v4l2m2m_encoder;
 extern const FFCodec ff_mpeg4_rkmpp_decoder;
 extern const FFCodec ff_mpeg4_v4l2m2m_decoder;
 extern const FFCodec ff_mpeg4_mmal_decoder;
diff --git a/libavcodec/v4l2_m2m_enc.c b/libavcodec/v4l2_m2m_enc.c
index 33c3c7a..a7c3ae6 100644
--- a/libavcodec/v4l2_m2m_enc.c
+++ b/libavcodec/v4l2_m2m_enc.c
@@ -197,6 +197,20 @@ static int v4l2_prepare_encoder(V4L2m2mContext *s)
     if (avctx->framerate.num || avctx->framerate.den)
         v4l2_set_timeperframe(s, avctx->framerate.den, avctx->framerate.num);
 
+    /* JPEG has a quality and nothing else: -q:v as FFmpeg's MJPEG takes it, 2 best, 31 worst */
+    if (avctx->codec_id == AV_CODEC_ID_MJPEG) {
+        struct v4l2_control ctrl = {
+            .id    = V4L2_CID_JPEG_COMPRESSION_QUALITY,
+            .value = av_clip(103 - 3 * avctx->global_quality / FF_QP2LAMBDA, 1, 100),
+        };
+
+        if ((avctx->flags & AV_CODEC_FLAG_QSCALE) &&
+            ioctl(s->fd, VIDIOC_S_CTRL, &ctrl) < 0)
+            av_log(avctx, AV_LOG_WARNING, "Failed to set JPEG quality: %s\n",
+                   strerror(errno));
+        return 0;
+    }
+
     /* set ext ctrls */
     v4l2_set_ext_ctrl(s, MPEG_CID(HEADER_MODE), MPEG_VIDEO(HEADER_MODE_SEPARATE), "header mode", 0);
     v4l2_set_ext_ctrl(s, MPEG_CID(BITRATE) , avctx->bit_rate, "bit rate", 1);
@@ -531,7 +545,7 @@ static const FFCodecDefault v4l2_m2m_defaults[] = {
         .version    = LIBAVUTIL_VERSION_INT, \
     };
 
-#define M2MENC(NAME, LONGNAME, OPTIONS_NAME, CODEC) \
+#define M2MENC(NAME, LONGNAME, OPTIONS_NAME, CODEC, RANGE) \
     M2MENC_CLASS(NAME, OPTIONS_NAME) \
     const FFCodec ff_ ## NAME ## _v4l2m2m_encoder = { \
         .p.name         = #NAME "_v4l2m2m" , \
@@ -545,14 +559,15 @@ static const FFCodecDefault v4l2_m2m_defaults[] = {
         .close          = v4l2_encode_close, \
         .defaults       = v4l2_m2m_defaults, \
         .p.capabilities = AV_CODEC_CAP_HARDWARE | AV_CODEC_CAP_DELAY, \
-        .color_ranges   = AVCOL_RANGE_MPEG, \
+        .color_ranges   = RANGE, \
         .caps_internal  = FF_CODEC_CAP_NOT_INIT_THREADSAFE | \
                           FF_CODEC_CAP_INIT_CLEANUP, \
         .p.wrapper_name = "v4l2m2m", \
     }
 
-M2MENC(mpeg4,"MPEG4", mpeg4_options, AV_CODEC_ID_MPEG4);
-M2MENC(h263, "H.263", options,       AV_CODEC_ID_H263);
-M2MENC(h264, "H.264", options,       AV_CODEC_ID_H264);
-M2MENC(hevc, "HEVC",  options,       AV_CODEC_ID_HEVC);
-M2MENC(vp8,  "VP8",   options,       AV_CODEC_ID_VP8);
+M2MENC(mpeg4,"MPEG4", mpeg4_options, AV_CODEC_ID_MPEG4, AVCOL_RANGE_MPEG);
+M2MENC(h263, "H.263", options,       AV_CODEC_ID_H263,  AVCOL_RANGE_MPEG);
+M2MENC(h264, "H.264", options,       AV_CODEC_ID_H264,  AVCOL_RANGE_MPEG);
+M2MENC(hevc, "HEVC",  options,       AV_CODEC_ID_HEVC,  AVCOL_RANGE_MPEG);
+M2MENC(mjpeg,"MJPEG", options,       AV_CODEC_ID_MJPEG, AVCOL_RANGE_JPEG);
+M2MENC(vp8,  "VP8",   options,       AV_CODEC_ID_VP8,   AVCOL_RANGE_MPEG);
-- 
2.47.3

