From: Artem Butusov <art.sormy@gmail.com>
Subject: [PATCH] avcodec/h264dec: add a decode_order option

Some callers keep their own picture buffer and reorder pictures
themselves: a hardware-decoder front end that hands each picture back
to the surface it was decoded for, a bitstream analyser that needs
every picture in coding order, a low-latency pipeline that knows its
stream. The reorder logic held pictures back by POC and dropped a
picture older than the last one output, so with has_b_frames at 0 a
B-frame never left the decoder at all.

decode_order hands every picture out in decode order, unreordered. It
is off by default: a player wants display order.
---
diff --git a/libavcodec/h264_slice.c b/libavcodec/h264_slice.c
--- a/libavcodec/h264_slice.c	2026-11-13 15:06:28.907391458 +0000
+++ b/libavcodec/h264_slice.c	2026-11-13 15:06:28.910784750 +0000
@@ -1306,6 +1306,11 @@
     H264Picture *cur = h->cur_pic_ptr;
     int i, pics, out_of_order, out_idx;
 
+    if (h->decode_order) {
+        h->next_output_pic = cur;
+        return 0;
+    }
+
     cur->mmco_reset = h->mmco_reset;
     h->mmco_reset = 0;
 
diff --git a/libavcodec/h264dec.c b/libavcodec/h264dec.c
--- a/libavcodec/h264dec.c	2026-11-13 15:06:28.906623958 +0000
+++ b/libavcodec/h264dec.c	2026-11-13 15:06:28.909103458 +0000
@@ -1096,6 +1096,7 @@
     { "x264_build", "Assume this x264 version if no x264 version found in any SEI", OFFSET(x264_build), AV_OPT_TYPE_INT, {.i64 = -1}, -1, INT_MAX, VD },
     { "skip_gray", "Do not return gray gap frames", OFFSET(skip_gray), AV_OPT_TYPE_BOOL, {.i64 = 0}, 0, 1, VD },
     { "noref_gray", "Avoid using gray gap frames as references", OFFSET(noref_gray), AV_OPT_TYPE_BOOL, {.i64 = 1}, 0, 1, VD },
+    { "decode_order", "Output each picture once decoded, in decode order", OFFSET(decode_order), AV_OPT_TYPE_BOOL, {.i64 = 0}, 0, 1, VD },
     { NULL },
 };
 
diff --git a/libavcodec/h264dec.h b/libavcodec/h264dec.h
--- a/libavcodec/h264dec.h	2026-11-13 15:06:28.905728333 +0000
+++ b/libavcodec/h264dec.h	2026-11-13 15:06:28.908598708 +0000
@@ -579,6 +579,7 @@
     int non_gray;                       ///< Did we encounter a intra frame after a gray gap frame
     int noref_gray;
     int skip_gray;
+    int decode_order;
 } H264Context;
 
 extern const uint16_t ff_h264_mb_sizes[4];
