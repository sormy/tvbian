From 036b8a13b00ab05aeee43c655e7653de97d971d3 Mon Sep 17 00:00:00 2001
From: Artem Butusov <art.sormy@gmail.com>
Date: Sat, 31 Oct 2026 08:27:28 -0400
Subject: [PATCH 1/3] avcodec/v4l2_m2m_dec: unpack the B-frames of a packed
 MPEG-4 stream

DivX and Xvid in AVI pack a B-frame into the packet of the P-frame before
it and send an empty placeholder after; the decoder then made two pictures
of one packet and none of the next, and the timestamps, which follow the
packets, landed on the wrong pictures. mpeg4_unpack_bframes gives the
decoder one picture per packet, as the other hardware wrappers ask.
---
 configure                 | 1 +
 libavcodec/v4l2_m2m_dec.c | 2 +-
 2 files changed, 2 insertions(+), 1 deletion(-)

diff --git a/configure b/configure
index c9e07fa..37c9cb6 100755
--- a/configure
+++ b/configure
@@ -3723,6 +3723,7 @@ mpeg4_mediacodec_encoder_deps="mediacodec"
 mpeg4_mediacodec_encoder_select="extract_extradata_bsf"
 mpeg4_mmal_decoder_deps="mmal"
 mpeg4_v4l2m2m_decoder_deps="v4l2_m2m mpeg4_v4l2_m2m"
+mpeg4_v4l2m2m_decoder_select="mpeg4_unpack_bframes_bsf"
 mjpeg_v4l2m2m_decoder_deps="v4l2_m2m mjpeg_v4l2_m2m"
 mpeg4_v4l2m2m_encoder_deps="v4l2_m2m mpeg4_v4l2_m2m"
 vc1_cuvid_decoder_deps="cuvid"
diff --git a/libavcodec/v4l2_m2m_dec.c b/libavcodec/v4l2_m2m_dec.c
index 9311547..3b86fd9 100644
--- a/libavcodec/v4l2_m2m_dec.c
+++ b/libavcodec/v4l2_m2m_dec.c
@@ -405,7 +405,7 @@ M2MDEC(h264,  "H.264", AV_CODEC_ID_H264,       "h264_mp4toannexb");
 M2MDEC(hevc,  "HEVC",  AV_CODEC_ID_HEVC,       "hevc_mp4toannexb");
 M2MDEC(mpeg1, "MPEG1", AV_CODEC_ID_MPEG1VIDEO, NULL);
 M2MDEC(mpeg2, "MPEG2", AV_CODEC_ID_MPEG2VIDEO, NULL);
-M2MDEC(mpeg4, "MPEG4", AV_CODEC_ID_MPEG4,      NULL);
+M2MDEC(mpeg4, "MPEG4", AV_CODEC_ID_MPEG4,      "mpeg4_unpack_bframes");
 M2MDEC(mjpeg, "MJPEG", AV_CODEC_ID_MJPEG,      NULL);
 M2MDEC(h263,  "H.263", AV_CODEC_ID_H263,       NULL);
 M2MDEC(vc1 ,  "VC1",   AV_CODEC_ID_VC1,        NULL);
-- 
