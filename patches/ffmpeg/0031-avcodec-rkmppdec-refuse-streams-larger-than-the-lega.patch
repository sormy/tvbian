From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Artem Butusov <art.sormy@gmail.com>
Date: Sat, 31 Oct 2026 09:56:39 -0400
Subject: [PATCH] avcodec/rkmppdec: refuse streams larger than the legacy VPU
 decodes

MPEG-2, MPEG-4 and VP8 run on the legacy VPU, which stops at 1920x1088.
Wider VP8 decoded to broken pictures and wider MPEG-2 and MPEG-4 to no
frames; the decoder now fails to open, so a player picks another.
The limit is the RK3528 family's, where it was measured, read from the
device tree's compatible; on other chips MPP decides.
---
 libavcodec/rkmpp_soc.h | 47 +++++++++++++++++++++++++++++++++++++++++++++++
 libavcodec/rkmppdec.c  | 21 +++++++++++++++++++++
 2 files changed, 68 insertions(+)

diff --git a/libavcodec/rkmpp_soc.h b/libavcodec/rkmpp_soc.h
new file mode 100644
--- /dev/null
+++ b/libavcodec/rkmpp_soc.h
@@ -0,0 +1,47 @@
+/*
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#ifndef AVCODEC_RKMPP_SOC_H
+#define AVCODEC_RKMPP_SOC_H
+
+#include <stdio.h>
+#include <string.h>
+
+#include "libavutil/macros.h"
+
+/* the machine's device tree names the RK3528 family: its limits were measured there */
+static inline int ff_rkmpp_is_rk3528(void)
+{
+    static const char *const family[] = { "rockchip,rk3528", "rockchip,rk3528a", "rockchip,rk3518" };
+    char compatible[1024];
+    size_t len, at, i;
+    FILE *f = fopen("/proc/device-tree/compatible", "rb");
+
+    if (!f)
+        return 0;
+    len = fread(compatible, 1, sizeof(compatible) - 1, f);
+    fclose(f);
+    compatible[len] = '\0';
+    for (at = 0; at < len; at += strlen(compatible + at) + 1)
+        for (i = 0; i < FF_ARRAY_ELEMS(family); i++)
+            if (!strcmp(compatible + at, family[i]))
+                return 1;
+    return 0;
+}
+
+#endif /* AVCODEC_RKMPP_SOC_H */
diff --git a/libavcodec/rkmppdec.c b/libavcodec/rkmppdec.c
--- a/libavcodec/rkmppdec.c
+++ b/libavcodec/rkmppdec.c
@@ -31,6 +31,7 @@
 #include "decode.h"
 #include "decode_bsf.h"
 #include "hwconfig.h"
+#include "rkmpp_soc.h"
 #include "libavutil/refstruct.h"
 #include "libavutil/buffer.h"
 #include "libavutil/common.h"
@@ -84,6 +85,19 @@ static MppCodingType rkmpp_get_codingtype(AVCodecContext *avctx)
     }
 }
 
+/* MPEG-2, MPEG-4 and VP8 run on the legacy VPU, which stops at 1920x1088. */
+static int rkmpp_exceeds_hardware(AVCodecContext *avctx)
+{
+    switch (avctx->codec_id) {
+    case AV_CODEC_ID_MPEG2VIDEO:
+    case AV_CODEC_ID_MPEG4:
+    case AV_CODEC_ID_VP8:
+        return avctx->width > 1920 || avctx->height > 1088;
+    default:
+        return 0;
+    }
+}
+
 static uint32_t rkmpp_get_frameformat(MppFrameFormat mppformat)
 {
     int afbc = MPP_FRAME_FMT_IS_AFBC(mppformat);
@@ -273,6 +287,13 @@ static av_cold int rkmpp_init_decoder(AVCodecContext *avctx)
         goto fail;
     }
 
+    if (ff_rkmpp_is_rk3528() && rkmpp_exceeds_hardware(avctx)) {
+        av_log(avctx, AV_LOG_ERROR, "%dx%d is larger than the hardware decodes\n",
+               avctx->width, avctx->height);
+        ret = AVERROR(ENOSYS);
+        goto fail;
+    }
+
     ret = mpp_check_support_format(MPP_CTX_DEC, codectype);
     if (ret != MPP_OK) {
         av_log(avctx, AV_LOG_ERROR, "Codec type (%d) unsupported by MPP\n", avctx->codec_id);
