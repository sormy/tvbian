 libavcodec/Makefile             |   2 +
 libavcodec/h263dec.c            |   6 +
 libavcodec/hwaccels.h           |   2 +
 libavcodec/mpeg4-ctrls.h        | 112 ++++++++
 libavcodec/mpeg4videodec.c      |   3 +
 libavcodec/v4l2_request_mpeg4.c | 472 ++++++++++++++++++++++++++++++++
 7 files changed, 601 insertions(+)
 create mode 100644 libavcodec/mpeg4-ctrls.h
 create mode 100644 libavcodec/v4l2_request_mpeg4.c

