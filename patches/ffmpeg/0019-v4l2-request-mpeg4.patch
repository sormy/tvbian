+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#include "config_components.h"
+
+#include "libavutil/intreadwrite.h"
+#include "get_bits.h"
+#include "h263.h"
+#include "hwaccel_internal.h"
+#include "hwconfig.h"
+#include "mpeg4-ctrls.h"
+#include "mpeg4video.h"
+#include "mpeg4videodec.h"
+#include "mpeg4videodefs.h"
+#include "mpegvideo.h"
+#include "v4l2_request.h"
+
+#define H263_GBSC_ZEROS 16
+#define H263_GN_EOS     31
+
+typedef struct V4L2RequestControlsMPEG4 {
+    V4L2RequestPictureContext pic;
+    struct v4l2_ctrl_mpeg4_vol vol;
+    struct v4l2_ctrl_mpeg4_vop vop;
+    struct v4l2_ctrl_mpeg4_quantisation quantisation;
+    struct v4l2_ctrl_mpeg4_slice slice;
+    bool first_slice;
+} V4L2RequestControlsMPEG4;
+
+/* A run of macroblocks the engine decodes in one go */
+typedef struct MPEG4Run {
+    int bit;    // its first macroblock's bit in the VOP data
+    int mb;     // its first macroblock
+    int qscale;
+} MPEG4Run;
+
+static int mpeg4_intra_dc_vlc_thr(const Mpeg4DecContext *ctx)
+{
+    switch (ctx->intra_dc_threshold) {
+    case 13: return 1;
+    case 15: return 2;
+    case 17: return 3;
+    case 19: return 4;
+    case 21: return 5;
+    case 23: return 6;
+    case 0:  return 7;
+    }
+    return 0;
+}
+
+static void v4l2_request_mpeg4_fill_vol(AVCodecContext *avctx,
+                                        struct v4l2_ctrl_mpeg4_vol *vol)
+{
+    const H263DecContext *h = avctx->priv_data;
+    const Mpeg4DecContext *ctx = avctx->priv_data;
+    const MPVContext *s = &h->c;
+
+    *vol = (struct v4l2_ctrl_mpeg4_vol) {
+        .width = s->width,
+        .height = s->height,
+    };
+
+    if (avctx->codec_id != AV_CODEC_ID_MPEG4) {
+        vol->flags = V4L2_MPEG4_VOL_FLAG_SHORT_VIDEO_HEADER;
+        return;
+    }
+
+    vol->sprite_enable = ctx->vol_sprite_usage;
+    vol->sprite_warping_accuracy = ctx->sprite_warping_accuracy;
+    vol->no_of_sprite_warping_points = ctx->num_sprite_warping_points;
+
+    if (s->workaround_bugs & FF_BUG_EDGE)
+        vol->bugs |= V4L2_MPEG4_BUG_EDGE;
+    if (s->workaround_bugs & FF_BUG_QPEL_CHROMA)
+        vol->bugs |= V4L2_MPEG4_BUG_QPEL_CHROMA;
+    if (s->workaround_bugs & FF_BUG_QPEL_CHROMA2)
+        vol->bugs |= V4L2_MPEG4_BUG_QPEL_CHROMA2;
+    if (s->workaround_bugs & FF_BUG_HPEL_CHROMA)
+        vol->bugs |= V4L2_MPEG4_BUG_HPEL_CHROMA;
+    if (ctx->divx_version == 500 && ctx->divx_build == 413)
+        vol->bugs |= V4L2_MPEG4_BUG_SPRITE_UNSCALED;
+
+    if (!s->progressive_sequence)
+        vol->flags |= V4L2_MPEG4_VOL_FLAG_INTERLACED;
+    if (ctx->mpeg_quant)
+        vol->flags |= V4L2_MPEG4_VOL_FLAG_QUANT_TYPE;
+    if (s->quarter_sample)
+        vol->flags |= V4L2_MPEG4_VOL_FLAG_QUARTER_SAMPLE;
+    if (!ctx->resync_marker)
+        vol->flags |= V4L2_MPEG4_VOL_FLAG_RESYNC_MARKER_DISABLE;
+    if (h->data_partitioning)
+        vol->flags |= V4L2_MPEG4_VOL_FLAG_DATA_PARTITIONED;
+    if (ctx->rvlc)
+        vol->flags |= V4L2_MPEG4_VOL_FLAG_REVERSIBLE_VLC;
+    if (ctx->sprite_brightness_change)
+        vol->flags |= V4L2_MPEG4_VOL_FLAG_SPRITE_BRIGHTNESS_CHANGE;
+}
+
+/* Tools outside H.263 baseline and MPEG-4 Advanced Simple the controls cannot carry */
+static bool v4l2_request_mpeg4_unsupported(AVCodecContext *avctx)
+{
+    const H263DecContext *h = avctx->priv_data;
+    const Mpeg4DecContext *ctx = avctx->priv_data;
+
+    // the driver refuses interlaced B-VOPs
+    if (avctx->codec_id == AV_CODEC_ID_MPEG4)
+        return ctx->shape != RECT_SHAPE || ctx->new_pred || ctx->scalability ||
+               (!h->c.progressive_sequence && !h->c.low_delay);
+
+    return h->h263_long_vectors || h->c.obmc || h->pb_frame || h->umvplus ||
+           h->c.h263_aic || h->loop_filter || h->h263_slice_structured ||
+           h->alt_inter_vlc || h->modified_quant || h->custom_pcf ||
+           h->c.no_rounding;
+}
+
+static int v4l2_request_mpeg4_start_frame(AVCodecContext *avctx,
+                                          av_unused const AVBufferRef *buf_ref,
+                                          av_unused const uint8_t *buffer,
+                                          av_unused uint32_t size)
+{
+    const H263DecContext *h = avctx->priv_data;
+    const Mpeg4DecContext *ctx = avctx->priv_data;
+    const MPVContext *s = &h->c;
+    V4L2RequestControlsMPEG4 *controls = s->cur_pic.ptr->hwaccel_picture_private;
+    struct v4l2_ctrl_mpeg4_vop *vop = &controls->vop;
+    int ret;
+
+    if (v4l2_request_mpeg4_unsupported(avctx))
+        return AVERROR_PATCHWELCOME;
+
+    ret = ff_v4l2_request_start_frame(avctx, &controls->pic, s->cur_pic.ptr->f);
+    if (ret)
+        return ret;
+
+    v4l2_request_mpeg4_fill_vol(avctx, &controls->vol);
+
+    *vop = (struct v4l2_ctrl_mpeg4_vop) {
+        .vop_coding_type = s->pict_type - AV_PICTURE_TYPE_I,
+        .vop_fcode_forward = 1,
+    };
+
+    switch (s->pict_type) {
+    case AV_PICTURE_TYPE_B:
+        if (s->next_pic.ptr)
+            vop->backward_ref_ts = ff_v4l2_request_get_capture_timestamp(s->next_pic.ptr->f);
+        av_fallthrough;
+    case AV_PICTURE_TYPE_P:
+    case AV_PICTURE_TYPE_S:
+        if (s->last_pic.ptr)
+            vop->forward_ref_ts = ff_v4l2_request_get_capture_timestamp(s->last_pic.ptr->f);
+    }
+
+    controls->first_slice = true;
+
+    if (avctx->codec_id != AV_CODEC_ID_MPEG4)
+        return 0;
+
+    vop->intra_dc_vlc_thr = mpeg4_intra_dc_vlc_thr(ctx);
+    vop->vop_fcode_forward = ctx->f_code;
+    vop->vop_fcode_backward = ctx->b_code;
+    vop->trb = s->pb_time;
+    vop->trd = s->pp_time;
+    vop->trb_field = s->pb_field_time;
+    vop->trd_field = s->pp_field_time;
+
+    for (int i = 0; i < FF_ARRAY_ELEMS(vop->sprite_trajectory_du); i++) {
+        vop->sprite_trajectory_du[i] = ctx->sprite_traj[i][0];
+        vop->sprite_trajectory_dv[i] = ctx->sprite_traj[i][1];
+    }
+
+    if (s->no_rounding)
+        vop->flags |= V4L2_MPEG4_VOP_FLAG_ROUNDING_TYPE;
+    if (s->top_field_first)
+        vop->flags |= V4L2_MPEG4_VOP_FLAG_TOP_FIELD_FIRST;
+    if (s->alternate_scan)
+        vop->flags |= V4L2_MPEG4_VOP_FLAG_ALTERNATE_VERTICAL_SCAN;
+
+    for (int i = 0; i < 64; i++) {
+        int n = s->idsp.idct_permutation[ff_zigzag_direct[i]];
+        controls->quantisation.intra_quantiser_matrix[i] = s->intra_matrix[n];
+        controls->quantisation.non_intra_quantiser_matrix[i] = s->inter_matrix[n];
+    }
+
+    return 0;
+}
+
+/*
+ * The next video packet's header from byte from on, byte-aligned with its
+ * resync marker: its first byte, or size if none.
+ */
+static int mpeg4_next_packet(AVCodecContext *avctx, const uint8_t *buffer,
+                             int size, int from, MPEG4Run *run)
+{
+    const Mpeg4DecContext *ctx = avctx->priv_data;
+    const MPVContext *s = &ctx->h.c;
+    int zeros = ff_mpeg4_get_video_packet_prefix_length(s->pict_type,
+                                                        ctx->f_code, ctx->b_code);
+    int mb_bits = av_log2(s->mb_num - 1) + 1;
+
+    for (int i = from; i < size; i++) {
+        GetBitContext gb;
+        int mb, qscale;
+
+        if (buffer[i] || buffer[i + 1])
+            continue;
+        // a start code: the next VOP
+        if (buffer[i + 2] == 1)
+            return i;
+        if (AV_RB32(buffer + i) >> (31 - zeros) != 1)
+            continue;
+
+        init_get_bits8(&gb, buffer + i, size - i);
+        skip_bits_long(&gb, zeros + 1);
+        mb = get_bits(&gb, mb_bits);
+        qscale = get_bits(&gb, ctx->quant_precision);
+        if (mb <= run->mb || mb >= s->mb_num)
+            continue;
+
+        if (get_bits1(&gb)) {
+            // header_extension_code: the VOP header again
+            while (get_bits1(&gb))
+                ;
+            skip_bits(&gb, 1 + ctx->time_increment_bits + 1 + 2 + 3);
+            if (s->pict_type == AV_PICTURE_TYPE_S &&
+                ctx->vol_sprite_usage == GMC_SPRITE)
+                return AVERROR_PATCHWELCOME;
+            if (s->pict_type != AV_PICTURE_TYPE_I)
+                skip_bits(&gb, 3);
+            if (s->pict_type == AV_PICTURE_TYPE_B)
+                skip_bits(&gb, 3);
+        }
+
+        run->bit = i * 8 + get_bits_count(&gb);
+        run->mb = mb;
+        if (qscale)
+            run->qscale = qscale;
+        return i;
+    }
+
+    return size;
+}
+
+/*
+ * The next GOB header from bit from on, anywhere: GSTUF makes byte
+ * alignment optional. The first byte of its start code, or size if none.
+ */
+static int h263_next_gob(AVCodecContext *avctx, const uint8_t *buffer,
+                         int size, int from, MPEG4Run *run)
+{
+    const H263DecContext *h = avctx->priv_data;
+    const MPVContext *s = &h->c;
+
+    // 16 zeros and a one span a whole zero byte, and start in the 8 bits before its end
+    for (int i = from / 8 + 1; i < size; i++) {
+        uint64_t window;
+
+        if (buffer[i])
+            continue;
+
+        window = AV_RB64(buffer + i - 1);
+        for (int k = 1; k <= 8; k++) {
+            int bit = (i - 1) * 8 + k;
+            GetBitContext gb;
+            int gn, mb, qscale;
+
+            if (bit <= from || (window << k) >> (63 - H263_GBSC_ZEROS) != 1)
+                continue;
+
+            init_get_bits8(&gb, buffer, size);
+            skip_bits_long(&gb, bit + H263_GBSC_ZEROS + 1);
+            gn = get_bits(&gb, 5);
+            if (!gn || gn == H263_GN_EOS)
+                return bit / 8;
+
+            mb = gn * h->gob_index * s->mb_width;
+            skip_bits(&gb, 2); // GFID
+            qscale = get_bits(&gb, 5);
+            if (mb <= run->mb || mb >= s->mb_num || !qscale)
+                continue;
+
+            run->bit = get_bits_count(&gb);
+            run->mb = mb;
+            run->qscale = qscale;
+            return bit / 8;
+        }
+    }
+
+    return size;
+}
+
+static int v4l2_request_mpeg4_queue(AVCodecContext *avctx, bool last_slice)
+{
+    const MPVContext *s = avctx->priv_data;
+    V4L2RequestControlsMPEG4 *controls = s->cur_pic.ptr->hwaccel_picture_private;
+    struct v4l2_ext_control control[] = {
+        {
+            .id = V4L2_CID_STATELESS_MPEG4_VOL,
+            .ptr = &controls->vol,
+            .size = sizeof(controls->vol),
+        },
+        {
+            .id = V4L2_CID_STATELESS_MPEG4_VOP,
+            .ptr = &controls->vop,
+            .size = sizeof(controls->vop),
+        },
+        {
+            .id = V4L2_CID_STATELESS_MPEG4_QUANTISATION,
+            .ptr = &controls->quantisation,
+            .size = sizeof(controls->quantisation),
+        },
+        {
+            .id = V4L2_CID_STATELESS_MPEG4_SLICE,
+            .ptr = &controls->slice,
+            .size = sizeof(controls->slice),
+        },
+    };
+    int ret;
+
+    ret = ff_v4l2_request_decode_slice(avctx, &controls->pic, control,
+                                       FF_ARRAY_ELEMS(control),
+                                       controls->first_slice, last_slice);
+    controls->first_slice = false;
+    return ret;
+}
+
+/* Bytes start to end hold the run's macroblocks, which end at mb_end */
+static int v4l2_request_mpeg4_append(AVCodecContext *avctx, const uint8_t *buffer,
+                                     const MPEG4Run *run, int end, int mb_end)
+{
+    const MPVContext *s = avctx->priv_data;
+    V4L2RequestControlsMPEG4 *controls = s->cur_pic.ptr->hwaccel_picture_private;
+    int start = run->bit / 8;
+
+    controls->slice = (struct v4l2_ctrl_mpeg4_slice) {
+        .bit_size = (end - start) * 8,
+        .data_bit_offset = run->bit % 8,
+        .macroblock_number = run->mb,
+        .num_macroblocks = mb_end - run->mb,
+        .quant_scale = run->qscale,
+    };
+
+    return ff_v4l2_request_append_output(avctx, &controls->pic,
+                                         buffer + start, end - start);
+}
+
+/* FFmpeg hands over the whole VOP once: each packet or GOB is queued as it is found */
+static int v4l2_request_mpeg4_decode_slice(AVCodecContext *avctx,
+                                           const uint8_t *buffer, uint32_t size)
+{
+    const H263DecContext *h = avctx->priv_data;
+    const MPVContext *s = &h->c;
+    V4L2RequestControlsMPEG4 *controls = s->cur_pic.ptr->hwaccel_picture_private;
+    bool mpeg4 = avctx->codec_id == AV_CODEC_ID_MPEG4;
+    bool packets = mpeg4 ? ((const Mpeg4DecContext *)avctx->priv_data)->resync_marker : true;
+    MPEG4Run run = {
+        .bit = get_bits_count(&h->gb) % 8,
+        .qscale = s->qscale,
+    };
+
+    while (packets) {
+        MPEG4Run next = run;
+        int end, ret;
+
+        end = mpeg4 ? mpeg4_next_packet(avctx, buffer, size, run.bit / 8 + 1, &next)
+                    : h263_next_gob(avctx, buffer, size, run.bit, &next);
+        if (end < 0)
+            return end;
+        if (next.mb == run.mb)
+            break;
+
+        // a GOB header can share its first byte with the macroblocks before it
+        ret = v4l2_request_mpeg4_append(avctx, buffer, &run,
+                                        mpeg4 ? end : end + 1, next.mb);
+        if (!ret)
+            ret = v4l2_request_mpeg4_queue(avctx, false);
+        if (!ret)
+            ret = ff_v4l2_request_reset_picture(avctx, &controls->pic);
+        if (ret)
+            return ret;
+
+        run = next;
+    }
+
+    return v4l2_request_mpeg4_append(avctx, buffer, &run, size, s->mb_num);
+}
+
+static int v4l2_request_mpeg4_end_frame(AVCodecContext *avctx)
+{
+    return v4l2_request_mpeg4_queue(avctx, true);
+}
+
+static int v4l2_request_mpeg4_init(AVCodecContext *avctx)
+{
+    struct v4l2_ctrl_mpeg4_vol vol;
+    struct v4l2_ext_control control[] = {
+        {
+            .id = V4L2_CID_STATELESS_MPEG4_VOL,
+            .ptr = &vol,
+            .size = sizeof(vol),
+        },
+    };
+
+    if (v4l2_request_mpeg4_unsupported(avctx))
+        return AVERROR_PATCHWELCOME;
+
+    /*
+     * The VOL as the probe: a driver refusing its tools fails the init,
+     * and decoding falls back to software.
+     */
+    v4l2_request_mpeg4_fill_vol(avctx, &vol);
+    return ff_v4l2_request_init(avctx, control, FF_ARRAY_ELEMS(control), NULL);
+}
+
+static int v4l2_request_mpeg4_frame_params(AVCodecContext *avctx,
+                                           AVBufferRef *hw_frames_ctx)
+{
+    return ff_v4l2_request_frame_params(avctx, hw_frames_ctx,
+                                        V4L2_PIX_FMT_MPEG4_SLICE, 8);
+}
