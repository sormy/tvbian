From: Artem Butusov <art.sormy@gmail.com>
Subject: [PATCH] avcodec/v4l2_buffers: copy a multi-buffer frame by its planes

A frame for a format V4L2 keeps one plane a buffer (YUV444M, NV12M) was
copied buffer by buffer, frame->buf[i] whole into the V4L2 plane i. A
frame from av_frame_get_buffer() holds every plane in buf[0]: buf[1] is
NULL, and the header the encoder makes for a global header (a black
frame, for Matroska) crashed on it. A frame whose stride is not the
driver's was copied wrong besides.

Copy each plane by rows from frame->data[i] at frame->linesize[i] to the
driver's stride.

Signed-off-by: Artem Butusov <art.sormy@gmail.com>
---
  libavcodec/v4l2_buffers.c | 15 ++++++++++++---
  1 file changed, 12 insertions(+), 3 deletions(-)

diff --git a/libavcodec/v4l2_buffers.c b/libavcodec/v4l2_buffers.c
index 4f9e5da..888c036 100644
--- a/libavcodec/v4l2_buffers.c
+++ b/libavcodec/v4l2_buffers.c
@@ -648,10 +648,19 @@ static int v4l2_buffer_swframe_to_buf(const AVFrame *frame, V4L2Buffer *out)
         return 0;
     }
 
+    /* each plane by rows at the driver's stride: a frame may hold every plane in one buffer */
     for (i = 0; i < out->num_planes; i++) {
-        ret = v4l2_bufref_to_buf(out, i, frame->buf[i]->data, frame->buf[i]->size, 0);
-        if (ret)
-            return ret;
+        const AVPixFmtDescriptor *desc = av_pix_fmt_desc_get(frame->format);
+        int pitch = out->plane_info[i].bytesperline;
+        int rows = i ? AV_CEIL_RSHIFT(frame->height, desc->log2_chroma_h) : frame->height;
+
+        if (pitch * rows > out->plane_info[i].length)
+            return AVERROR(EINVAL);
+        av_image_copy_plane(out->plane_info[i].mm_addr, pitch,
+                            frame->data[i], frame->linesize[i],
+                            av_image_get_linesize(frame->format, frame->width, i), rows);
+        out->planes[i].bytesused = pitch * rows;
+        out->planes[i].length = out->plane_info[i].length;
     }
 
     return 0;
