From 0b73edd6acbf55c5352f0cbb17cf9ee2cd69c760 Mon Sep 17 00:00:00 2001
From: Artem Butusov <art.sormy@gmail.com>
Date: Mon, 26 Oct 2026 18:30:00 -0400
Subject: [PATCH] avcodec/v4l2_request: ask the decoder to scale to
 capture_max_width and capture_max_height

capture_max_width and capture_max_height, options of the v4l2request
device, ask a decoder that can scale for a picture that fits within
them: a COMPOSE rectangle with V4L2_SEL_FLAG_LE on the CAPTURE queue
before its buffers are allocated, G_FMT then reporting the scaled
format. The limits bound the visible picture, so the rectangle grows by
the coded picture's margin. A decoder that cannot scale refuses or
answers with the full size.

get_buffer gives a hardware frame the coded size; a scaled frame takes
the CAPTURE size back after decoding, and the stream's crop is scaled
by the ratio.
---
 libavcodec/v4l2_request.c         | 22 +++++++++++++++
 libavutil/hwcontext_v4l2request.c | 46 +++++++++++++++++++++++++++++++
 libavutil/hwcontext_v4l2request.h | 10 +++++++
 3 files changed, 78 insertions(+)

diff --git a/libavcodec/v4l2_request.c b/libavcodec/v4l2_request.c
index 36eec85..123ef31 100644
--- a/libavcodec/v4l2_request.c
+++ b/libavcodec/v4l2_request.c
@@ -490,12 +490,32 @@ int ff_v4l2_request_decode_frame(AVCodecContext *avctx,
     return v4l2_request_queue_decode(avctx, pic, control, count, true, true);
 }
 
+// A frame the decoder scaled down by a power of two takes the CAPTURE size,
+// which get_buffer overrode with the coded one, and the stream's crop, scaled
+static void v4l2_request_scale_frame(AVCodecContext *avctx, AVFrame *frame)
+{
+    AVHWFramesContext *hwfc = (AVHWFramesContext *)frame->hw_frames_ctx->data;
+    int ratio = avctx->coded_width / hwfc->width;
+
+    if (ratio <= 1)
+        return;
+
+    frame->width  = hwfc->width;
+    frame->height = hwfc->height;
+    frame->crop_left  /= ratio;
+    frame->crop_top   /= ratio;
+    frame->crop_right  = frame->width  - frame->crop_left - avctx->width  / ratio;
+    frame->crop_bottom = frame->height - frame->crop_top  - avctx->height / ratio;
+}
+
 static int v4l2_request_post_process(void *logctx, AVFrame *frame)
 {
     uint32_t index = v4l2_request_frameindex(frame);
     FrameDecodeData *fdd = frame->private_ref;
     V4L2RequestContext *ctx = fdd->hwaccel_priv;
 
+    v4l2_request_scale_frame(logctx, frame);
+
     // Wait on CAPTURE buffer before returning the frame to application
     return v4l2_request_wait_on_capture(ctx, index);
 }
@@ -654,6 +674,8 @@ int ff_v4l2_request_frame_params(AVCodecContext *avctx,
     // Set parameters used during frames context initialization
     fctx->pixelformat = pixelformat;
     fctx->bit_depth = bit_depth;
+    fctx->visible_width = avctx->width;
+    fctx->visible_height = avctx->height;
     if (ctx) {
         fctx->init_controls = ctx->init_controls;
         fctx->nb_init_controls = ctx->nb_init_controls;
diff --git a/libavutil/hwcontext_v4l2request.c b/libavutil/hwcontext_v4l2request.c
index b6633d9..cdfbc31 100644
--- a/libavutil/hwcontext_v4l2request.c
+++ b/libavutil/hwcontext_v4l2request.c
@@ -29,9 +29,11 @@
 #include <libudev.h>
 
 #include "avassert.h"
+#include "dict.h"
 #include "hwcontext_drm.h"
 #include "hwcontext_internal.h"
 #include "hwcontext_v4l2request_internal.h"
+#include "mathematics.h"
 #include "mem.h"
 
 typedef struct V4L2RequestVideoDecoder {
@@ -44,6 +46,10 @@ typedef struct V4L2RequestVideoDecoder {
 typedef struct V4L2RequestDeviceContext {
     V4L2RequestVideoDecoder *decoders;
     int nb_decoders;
+
+    // ask for a CAPTURE picture no larger than this, 0 for full size
+    int capture_max_width;
+    int capture_max_height;
 } V4L2RequestDeviceContext;
 
 typedef struct V4L2RequestFramesContext {
@@ -209,10 +215,16 @@ static int v4l2request_device_create(AVHWDeviceContext *hwdev, const char *devic
                                      AVDictionary *opts, int flags)
 {
     V4L2RequestDeviceContext *hwctx = hwdev->hwctx;
+    AVDictionaryEntry *entry;
 
     hwctx->decoders = NULL;
     hwctx->nb_decoders = 0;
 
+    if ((entry = av_dict_get(opts, "capture_max_width", NULL, 0)))
+        hwctx->capture_max_width = strtol(entry->value, NULL, 10);
+    if ((entry = av_dict_get(opts, "capture_max_height", NULL, 0)))
+        hwctx->capture_max_height = strtol(entry->value, NULL, 10);
+
     // TODO: enumerate V4L2 Request API capable video decoders
     //       and fill hwctx->decoders and hwctx->nb_decoders,
     //       limit to decoders for the media 'device' when specified
@@ -302,6 +314,38 @@ static int v4l2request_select_capture_format(AVHWFramesContext *hwfc)
     return AVERROR(errno);
 }
 
+// A decoder that scales takes a COMPOSE rectangle smaller than the coded
+// picture and fits the picture in it; G_FMT then reports the scaled CAPTURE
+// format. The limits bound the visible picture, so the rectangle grows by the
+// coded picture's margin.
+static void v4l2request_request_compose(AVHWFramesContext *hwfc)
+{
+    V4L2RequestDeviceContext *hwctx = hwfc->device_ctx->hwctx;
+    AVV4L2RequestFramesContext *fctx = hwfc->hwctx;
+    int visible_width  = fctx->visible_width  ? fctx->visible_width  : hwfc->width;
+    int visible_height = fctx->visible_height ? fctx->visible_height : hwfc->height;
+    int max_width  = hwctx->capture_max_width  ? hwctx->capture_max_width  : INT_MAX;
+    int max_height = hwctx->capture_max_height ? hwctx->capture_max_height : INT_MAX;
+    struct v4l2_selection selection = {
+        .type   = V4L2_BUF_TYPE_VIDEO_CAPTURE,
+        .target = V4L2_SEL_TGT_COMPOSE,
+        .flags  = V4L2_SEL_FLAG_LE,
+    };
+
+    if (visible_width <= max_width && visible_height <= max_height)
+        return;
+
+    selection.r.width  = FFMIN(hwfc->width,
+                               av_rescale_rnd(FFMIN(max_width, visible_width), hwfc->width,
+                                              visible_width, AV_ROUND_UP));
+    selection.r.height = FFMIN(hwfc->height,
+                               av_rescale_rnd(FFMIN(max_height, visible_height), hwfc->height,
+                                              visible_height, AV_ROUND_UP));
+
+    if (ioctl(fctx->internal->video_fd, VIDIOC_S_SELECTION, &selection) < 0)
+        av_log(hwfc, AV_LOG_DEBUG, "CAPTURE COMPOSE not taken, full size\n");
+}
+
 static int v4l2request_try_framesize(AVHWFramesContext *hwfc,
                                      uint32_t pixelformat)
 {
@@ -508,6 +552,8 @@ static int v4l2request_probe_video_device(AVHWFramesContext *hwfc,
         goto fail;
     }
 
+    v4l2request_request_compose(hwfc);
+
     // Query CAPTURE buffer capabilities
     buffers = (struct v4l2_create_buffers) {
         .count = 0,
diff --git a/libavutil/hwcontext_v4l2request.h b/libavutil/hwcontext_v4l2request.h
index ec6bead..1374267 100644
--- a/libavutil/hwcontext_v4l2request.h
+++ b/libavutil/hwcontext_v4l2request.h
@@ -65,6 +65,16 @@ typedef struct AVV4L2RequestFramesContext {
      */
     struct v4l2_ext_control *init_controls;
     int nb_init_controls;
+
+    /**
+     * Optional visible picture size, which the device's capture_max_width and
+     * capture_max_height bound when the decoder can scale; 0 for the frames
+     * context size.
+     *
+     * These fields should be set by caller before av_hwframe_ctx_init() is called.
+     */
+    int visible_width;
+    int visible_height;
 } AVV4L2RequestFramesContext;
 
 #endif /* AVUTIL_HWCONTEXT_V4L2REQUEST_H */
