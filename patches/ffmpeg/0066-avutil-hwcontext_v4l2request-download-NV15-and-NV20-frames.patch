From: Artem Butusov <art.sormy@gmail.com>
Subject: [PATCH] avutil/hwcontext_v4l2request: download NV15 and NV20 frames

A decoder writing its 10-bit pictures packed, NV15 or NV20 (rkvdec),
had them mapped to YUV420P10 and YUV422P10 but offered no format to
download to: a player reading the picture on the CPU, or a test
comparing it, got nothing. Unpack them to P010 and P210, each sample
in the high ten bits.

Signed-off-by: Artem Butusov <art.sormy@gmail.com>
---
  libavutil/hwcontext_v4l2request.c | 50 +++++++++++++++++++++++++++++++++++----
  1 file changed, 46 insertions(+), 4 deletions(-)

diff --git a/libavutil/hwcontext_v4l2request.c b/libavutil/hwcontext_v4l2request.c
index 1fc7907..c6d46ad 100644
--- a/libavutil/hwcontext_v4l2request.c
+++ b/libavutil/hwcontext_v4l2request.c
@@ -1251,6 +1251,40 @@ fail:
     return ret;
 }
 
+/* Whether the decoder writes NV15 or NV20, the 10-bit layouts unpacked on download */
+static int v4l2request_packed_10bit(AVHWFramesContext *hwfc)
+{
+    AVV4L2RequestFramesContext *fctx = hwfc->hwctx;
+    const struct v4l2_format *fmt = &fctx->internal->capture.format;
+    uint32_t pixelformat = V4L2_TYPE_IS_MULTIPLANAR(fmt->type) ? fmt->fmt.pix_mp.pixelformat :
+                                                                 fmt->fmt.pix.pixelformat;
+
+    return pixelformat == V4L2_PIX_FMT_NV15 || pixelformat == V4L2_PIX_FMT_NV20;
+}
+
+/* NV15 and NV20 rows: four 10-bit samples in five bytes, the first in the low bits */
+static void v4l2request_unpack_10bit(uint16_t *dst, const uint8_t *src, int samples)
+{
+    for (int i = 0; i < samples; i += 4, src += 5) {
+        uint64_t v = src[0] | src[1] << 8 | src[2] << 16 | (uint64_t)src[3] << 24 |
+                     (uint64_t)src[4] << 32;
+
+        for (int k = 0; k < 4 && i + k < samples; k++)
+            dst[i + k] = ((v >> (10 * k)) & 0x3ff) << 6;
+    }
+}
+
+static int v4l2request_unpack_frame(AVFrame *dst, const AVFrame *map, int chroma_rows)
+{
+    for (int y = 0; y < dst->height; y++)
+        v4l2request_unpack_10bit((uint16_t *)(dst->data[0] + y * dst->linesize[0]),
+                                 map->data[0] + y * map->linesize[0], dst->width);
+    for (int y = 0; y < chroma_rows; y++)
+        v4l2request_unpack_10bit((uint16_t *)(dst->data[1] + y * dst->linesize[1]),
+                                 map->data[1] + y * map->linesize[1], dst->width);
+    return 0;
+}
+
 static int v4l2request_transfer_get_formats(AVHWFramesContext *hwfc,
                                             enum AVHWFrameTransferDirection dir,
                                             enum AVPixelFormat **formats)
@@ -1267,9 +1301,12 @@ static int v4l2request_transfer_get_formats(AVHWFramesContext *hwfc,
     fmts[0] = hwfc->sw_format;
     fmts[1] = AV_PIX_FMT_NONE;
 
-    if (hwfc->sw_format == AV_PIX_FMT_YUV420P ||
-        hwfc->sw_format == AV_PIX_FMT_YUV420P10 ||
-        hwfc->sw_format == AV_PIX_FMT_YUV422P10)
+    /* NV15 and NV20 come out unpacked, the samples in the high bits */
+    if (v4l2request_packed_10bit(hwfc))
+        fmts[0] = hwfc->sw_format == AV_PIX_FMT_YUV420P10 ? AV_PIX_FMT_P010 : AV_PIX_FMT_P210;
+    else if (hwfc->sw_format == AV_PIX_FMT_YUV420P ||
+             hwfc->sw_format == AV_PIX_FMT_YUV420P10 ||
+             hwfc->sw_format == AV_PIX_FMT_YUV422P10)
         fmts[0] = AV_PIX_FMT_NONE;
 
     *formats = fmts;
@@ -1297,7 +1334,12 @@ static int v4l2request_transfer_data_from(AVHWFramesContext *hwfc,
     map->width  = dst->width;
     map->height = dst->height;
 
-    ret = av_frame_copy(dst, map);
+    if (v4l2request_packed_10bit(hwfc) && dst->format == AV_PIX_FMT_P010)
+        ret = v4l2request_unpack_frame(dst, map, (dst->height + 1) / 2);
+    else if (v4l2request_packed_10bit(hwfc) && dst->format == AV_PIX_FMT_P210)
+        ret = v4l2request_unpack_frame(dst, map, dst->height);
+    else
+        ret = av_frame_copy(dst, map);
     if (ret)
         goto fail;
 
