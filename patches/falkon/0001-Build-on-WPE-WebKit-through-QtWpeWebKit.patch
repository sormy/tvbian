Subject: [PATCH] Build on WPE WebKit through QtWpeWebKit

FALKON_WPE=ON builds Falkon against QtWpeWebKit, a QtWebEngine-compatible
layer over WPE WebKit, instead of QtWebEngine. PyFalkon is off in that
build, since PySide's bindings are QtWebEngine's, and the speed-dial
thumbnailer does not load its QtWebEngine QML scene.

---
diff --git a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -59,8 +59,16 @@
     find_package(Qt6 ${REQUIRED_QT_VERSION} CONFIG REQUIRED NetworkPrivate)
 endif()
 
-find_package(Qt6WebEngineCore ${QT_MIN_VERSION} REQUIRED)
-find_package(Qt6WebEngineWidgets ${QT_MIN_VERSION} REQUIRED)
+option(FALKON_WPE "Use WPE WebKit through QtWpeWebKit instead of QtWebEngine" OFF)
+if (FALKON_WPE)
+    find_package(QtWpeWebKit REQUIRED)
+    add_definitions(-DFALKON_WPE)
+    set(FALKON_WEBENGINE_LIBRARIES QtWpeWebKit::qtwpewebkit)
+else()
+    find_package(Qt6WebEngineCore ${QT_MIN_VERSION} REQUIRED)
+    find_package(Qt6WebEngineWidgets ${QT_MIN_VERSION} REQUIRED)
+    set(FALKON_WEBENGINE_LIBRARIES Qt6::WebEngineWidgets)
+endif()
 if (BUILD_TESTING)
     find_package(Qt6 ${QT_MIN_VERSION} REQUIRED COMPONENTS Test)
 endif()
@@ -139,7 +147,8 @@
 
 # Optional: PySide6
 option(BUILD_PYTHON_SUPPORT "Support for Python plugins" ON)
-if (BUILD_PYTHON_SUPPORT)
+# PySide's bindings are QtWebEngine's
+if (BUILD_PYTHON_SUPPORT AND NOT FALKON_WPE)
     find_package(Python3 COMPONENTS Development)
     find_package(PySide6 "6.4.0")
     find_package(Shiboken6 "6.4.0")
diff --git a/src/lib/CMakeLists.txt b/src/lib/CMakeLists.txt
--- a/src/lib/CMakeLists.txt
+++ b/src/lib/CMakeLists.txt
@@ -594,13 +594,14 @@
 
 add_library(FalkonPrivate SHARED ${SRCS} ${LOGGING_SRCS})
 
-get_property(QT_WEBENGINE_INCLUDE_DIRS TARGET Qt6::WebEngineCore PROPERTY INTERFACE_INCLUDE_DIRECTORIES)
-
-target_include_directories(FalkonPrivate SYSTEM PUBLIC ${QT_WEBENGINE_INCLUDE_DIRS})
+if (NOT FALKON_WPE)
+    get_property(QT_WEBENGINE_INCLUDE_DIRS TARGET Qt6::WebEngineCore PROPERTY INTERFACE_INCLUDE_DIRECTORIES)
+    target_include_directories(FalkonPrivate SYSTEM PUBLIC ${QT_WEBENGINE_INCLUDE_DIRS})
+endif()
 
 target_link_libraries(FalkonPrivate
     Qt6::Widgets
-    Qt6::WebEngineWidgets
+    ${FALKON_WEBENGINE_LIBRARIES}
     Qt6::Network
     Qt6::NetworkPrivate
     Qt6::Sql
diff --git a/src/lib/tools/pagethumbnailer.cpp b/src/lib/tools/pagethumbnailer.cpp
--- a/src/lib/tools/pagethumbnailer.cpp
+++ b/src/lib/tools/pagethumbnailer.cpp
@@ -33,7 +33,10 @@
     , m_loadTitle(false)
 {
     m_view->setAttribute(Qt::WA_DontShowOnScreen);
+    // Without QtWebEngine's QML scene, start() reports no thumbnail
+#ifndef FALKON_WPE
     m_view->setSource(QUrl(QSL("qrc:data/thumbnailer.qml")));
+#endif
     m_view->rootContext()->setContextProperty(QSL("thumbnailer"), this);
     m_view->show();
 }
