#!/bin/sh
# GStreamer's va plugin loads a driver it does not know only so
echo GST_VA_ALL_DRIVERS=1
# no box here decodes AV1 in hardware, nor fast enough on its CPU: unlisted, browsers ask for VP9.
# GStreamer's own V4L2 stateless decoders drive the same engines as this driver and fail in WebKit
# (they need GstVideoMeta): unlisted, so its va decoders, at the same rank, are picked
rank=av1dec:NONE,dav1ddec:NONE,avdec_av1:NONE,avdec_libdav1d:NONE
stateless="h264 h265 vp8 vp9 mpeg2 av1"
for codec in $stateless; do rank=$rank,v4l2sl${codec}dec:NONE; done
# a second decoder's elements are named for its node, v4l2slvideo6h264dec
for node in /sys/class/video4linux/video*; do
  [ -e "$node" ] || continue
  for codec in $stateless; do rank=$rank,v4l2sl${node##*/}${codec}dec:NONE; done
done
# GStreamer ranks its va encoders out, so a call in WebKit picks openh264enc: the box's first
rank=$rank,vah264enc:PRIMARY,vah265enc:PRIMARY,vajpegenc:PRIMARY
# meson's decoder hands a picture out after later packets, which GStreamer, syncing each first,
# never sends: its va decoders unlisted, its own V4L2 decoders feed ahead; the encoders stay
if [ -d /sys/bus/platform/drivers/meson-vdec ]; then
  rank=$rank,vah264dec:NONE,vah265dec:NONE,vavp8dec:NONE,vavp9dec:NONE,vaav1dec:NONE,vampeg2dec:NONE,vajpegdec:NONE,vavp8alphadecodebin:NONE,vavp9alphadecodebin:NONE
fi
echo GST_PLUGIN_FEATURE_RANK=$rank
# Firefox's decoder sandbox opens /dev/video* alone: MPP and the stateless decoders need more
stateless_drivers="cedrus rkvdec hantro-vpu"
for driver in $stateless_drivers; do
  [ -d /sys/bus/platform/drivers/$driver ] && echo MOZ_DISABLE_RDD_SANDBOX=1 && exit 0
done
[ ! -e /dev/mpp_service ] || echo MOZ_DISABLE_RDD_SANDBOX=1
