+		interrupt-names = "gp", "gpmmu", "pp", "pp0", "ppmmu0", "pp1", "ppmmu1";
+		clocks = <&cru ACLK_GPU_MALI>, <&cru ACLK_GPU_MALI>;
+		clock-names = "bus", "core";
 		assigned-clocks = <&scmi_clk SCMI_CLK_GPU>;
