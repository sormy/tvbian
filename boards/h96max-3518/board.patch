+		esmart_lb_mode = [02];
+		/* support-multi-area dropped: an Esmart sub-window (win1-3) never reaches HDMI */
 		phandle = <0xea>;
 
 		vop_out: ports {
@@ -1746,7 +1753,8 @@
 		status = "okay";
 		remote_pwm_id = <0x03>;
