 * patch adding a name the tree uses or a dtsi change it keeps, which may in
 * turn need others before it:
 *   patches/linux-rockchip/6.12/bluetooth-hci-h4-serdev.patch:
 *     "aicsemi,aic8800-bt"
 *   patches/linux-rockchip-mainline/dt-bindings-rk3528.patch:
 *     "rockchip,rk3528-vdec", "rockchip,rk3528-tsadc", rockchip,grf, rockchip,hw-tshut-mode,
 *     rockchip,hw-tshut-polarity, rockchip,hw-tshut-temp, "rockchip,rk3528-vop", rockchip,pmu,
 *     "rockchip,rk3528-dw-hdmi", "rockchip,rk3528-hdmi-phy", "rockchip,rk3528-codec"
 *   patches/linux-rockchip-mainline/dt-bindings-rk3528-audio.patch:
