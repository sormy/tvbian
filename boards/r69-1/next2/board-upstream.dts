 *     "rockchip,rk3528-iep"
 *   patches/linux-rockchip-mainline/dt-bindings-rockchip-vdpp.patch:
 *     "rockchip,rk3528-vdpp"
 *   patches/linux-rockchip-mainline/dt-bindings-rockchip-iommu-dlr.patch:
 *     rockchip,disable-device-link-resume
 *   patches/linux-rockchip-mainline/dt-bindings-rockchip-grf-rk3528-pmu.patch:
 *     "rockchip,rk3528-pmu-grf"
 *   patches/linux-rockchip-mainline/dt-bindings-rk3528-gpu-grf.patch:
 *     "rockchip,rk3528-gpu-grf"
 *   patches/linux-rockchip-mainline/dt-bindings-devfreq-rockchip-dfi-rk3528.patch:
 *     "rockchip,rk3528-dfi"
 *   patches/linux-rockchip-mainline/dt-bindings-rockchip-rk3528-dmc.patch:
 *     "rockchip,rk3528-dmc"
 *   patches/linux-rockchip-mainline/media-rkvdec-rk3528.patch:
 *     "rockchip,rk3528-vdec"
 *   patches/linux-rockchip-mainline/media-hantro-rk3528-bindings.patch:
 *     "rockchip,rk3528-vpu"
 *   patches/linux-rockchip-mainline/media-hantro-rk3528.patch:
 *     "rockchip,rk3528-vpu"
 *   patches/linux-rockchip-mainline/media-rga-rk3528.patch:
 *     "rockchip,rk3528-rga"
 *   patches/linux-rockchip-mainline/media-rockchip-iep2.patch:
 *     "rockchip,rk3528-iep"
 *   patches/linux-rockchip-mainline/devfreq-rockchip-dfi-rk3528.patch:
 *     "rockchip,rk3528-dfi"
 *   patches/linux-rockchip-mainline/devfreq-rk3528-dmc.patch:
 *     "rockchip,rk3528-dmc"
 *   patches/linux-rockchip-mainline/thermal-rk3528.patch:
 *     "rockchip,rk3528-tsadc", rockchip,hw-tshut-mode
 *   patches/linux-rockchip-mainline/cpufreq-rockchip-pvtm.patch:
 *     "rockchip,rk3528", "rockchip,rk3528-mali", rockchip,grf, rockchip,pvtm-freq,
 *     rockchip,pvtm-offset, rockchip,pvtm-sample-time, rockchip,pvtm-volt,
 *     rockchip,pvtm-voltage-sel
 *   patches/linux-rockchip-mainline/drm-rk3528.patch:
 *     "rockchip,rk3528-dw-hdmi", "rockchip,rk3528-vop", "rockchip,rk3528-hdmi-phy"
 *   patches/linux-rockchip-mainline/drm-rk3528-tve.patch:
 *     "rockchip,rk3528-tve", rockchip,grf
 *   patches/linux-rockchip-mainline/iommu-rockchip-attach-only.patch:
 *     rockchip,disable-device-link-resume
 *   patches/linux-rockchip-mainline/arm64-dts-rk3528-media-display.patch:
 *     &core_grf, &rmii0_phy nvmem-cells, &rmii0_phy nvmem-cell-names, &test_version,
 *     &macphy_txlevel, &vdac_out_current, &spdif, &rng, &rga, &rga_mmu, &iep, &iep_mmu, &vdpp,
 *     &jpegd, &jpegd_mmu, &vpu, &vdpu_mmu, &vdec_mmu, &vdec, &sram, &sai2, &acodec, &vop, &vop_mmu,
 *     &tve, &rkvenc, &rkvenc_mmu, &hdmi, &hdmiphy, &sai3, &tsadc, &display_subsystem
 *   patches/linux-rockchip-mainline/arm64-dts-rk3528-dfi.patch:
 *     &pmu_grf, &dfi
 *   patches/linux-rockchip-mainline/arm64-dts-rk3528-gpu-grf.patch:
 *     &gpu_grf
 *   patches/linux-rockchip-mainline/arm64-dts-rk3528-gpu-bus-clock.patch:
 *     &gpu assigned-clock-rates
 *   patches/linux-rockchip-mainline/arm64-dts-rk3528-dmc.patch:
 *     &dmc, &dmc_opp_table
 *   patches/linux-rockchip-mainline/media-rc-keymaps-r69-1.patch:
 *     "rc-r69-1"
 *   patches/linux-rockchip-mainline/asoc-rk3528-codec.patch:
 *     "rockchip,rk3528-codec"
 *   patches/linux-rockchip-mainline/media-rkjpegd-v7-bindings.patch:
 *     "rockchip,rk3588-jpegd"
 *   patches/linux-rockchip-mainline/media-rkjpegd-v7-driver.patch:
 *     "rockchip,rk3588-jpegd"
 *   patches/linux-rockchip-mainline/media-rkvenc-rk3528-bindings.patch:
 *     "rockchip,rk3528-rkvenc"
 *   patches/linux-rockchip-mainline/media-rkvenc-rk3528-vepu540c.patch:
 *     "rockchip,rk3528-rkvenc"
 *   patches/linux-rockchip-mainline/media-rockchip-vdpp.patch:
 *     "rockchip,rk3528-vdpp"
 * Left out, the distribution's, not the board's:
 *   /reserved-memory/ramoops@110000
 */

#include "rk3528.dtsi"
#include <dt-bindings/power/rockchip,rk3528-power.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/pinctrl/rockchip.h>
#include <dt-bindings/input/linux-event-codes.h>
#include <dt-bindings/thermal/thermal.h>

/ {
	compatible = "r69-1,rk3518-tvbox", "rockchip,rk3528";
	model = "R69-1 (XR821_V1.1)";

	aliases {
		ethernet0 = &gmac0;
		i2c0 = &i2c0;
		i2c1 = &i2c1;
		i2c2 = &i2c2;
		i2c3 = &i2c3;
		i2c4 = &i2c4;
		i2c5 = &i2c5;
		i2c6 = &i2c6;
		i2c7 = &i2c7;
		serial0 = &uart0;
		serial1 = &uart1;
		serial2 = &uart2;
		serial3 = &uart3;
		serial4 = &uart4;
		serial5 = &uart5;
		serial6 = &uart6;
		serial7 = &uart7;
		spi0 = &spi0;
		spi1 = &spi1;
	};

	cpus {
		idle-states {
			entry-method = "psci";

			CPU_SLEEP0: cpu-sleep0 {
				compatible = "arm,idle-state";
				local-timer-stop;
				arm,psci-suspend-param = <0x10000>;
				entry-latency-us = <120>;
				exit-latency-us = <250>;
				min-residency-us = <900>;
				status = "disabled";
			};

			CPU_SLEEP1: cpu-sleep {
				compatible = "arm,idle-state";
				local-timer-stop;
				arm,psci-suspend-param = <0x10000>;
				entry-latency-us = <120>;
				exit-latency-us = <250>;
				min-residency-us = <900>;
				status = "okay";
			};
		};
	};

	firmware {
		optee {
			compatible = "linaro,optee-tz";
			method = "smc";
		};
	};

	reserved-memory {
		cma {
			compatible = "shared-dma-pool";
			reusable;
			size = <0x00 0x800000>;
			linux,cma-default;
		};
	};

	arm-pmu {
		compatible = "arm,cortex-a53-pmu";
		interrupts = <GIC_SPI 171 IRQ_TYPE_LEVEL_HIGH>,
		             <GIC_SPI 172 IRQ_TYPE_LEVEL_HIGH>,
		             <GIC_SPI 173 IRQ_TYPE_LEVEL_HIGH>,
		             <GIC_SPI 174 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-affinity = <&cpu0>, <&cpu1>, <&cpu2>, <&cpu3>;
	};

	thermal_zones: thermal-zones {
		soc_thermal: soc-thermal {
			polling-delay-passive = <20>;
			polling-delay = <1000>;
			sustainable-power = <638>;
			thermal-sensors = <&tsadc 0>;

			trips {
				threshold: trip-point-0 {
					temperature = <95000>;
					hysteresis = <2000>;
					type = "passive";
				};

				target: trip-point-1 {
					temperature = <110000>;
					hysteresis = <2000>;
					type = "passive";
				};

				soc_crit: soc-crit {
					temperature = <120000>;
					hysteresis = <2000>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&target>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
					contribution = <1024>;
				};

				map1 {
					trip = <&target>;
					cooling-device = <&gpu THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
					contribution = <1024>;
				};
			};
		};
	};

	acodec_sound: acodec-sound {
		compatible = "simple-audio-card";
		simple-audio-card,name = "rk3528-acodec";
		simple-audio-card,format = "i2s";
		simple-audio-card,mclk-fs = <256>;
		status = "okay";

		simple-audio-card,cpu {
			sound-dai = <&sai2>;
		};

		simple-audio-card,codec {
			sound-dai = <&acodec>;
		};
	};

	adc_keys: adc-keys {
		compatible = "adc-keys";
		io-channels = <&saradc 1>;
		io-channel-names = "buttons";
		keyup-threshold-microvolt = <1800000>;
		poll-interval = <100>;
		status = "okay";

		button-recovery {
			press-threshold-microvolt = <1750>;
			linux,code = <KEY_VENDOR>;
			label = "recovery";
		};
	};

	dc_12v: dc-12v {
		compatible = "regulator-fixed";
		regulator-name = "dc_12v";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <12000000>;
		regulator-max-microvolt = <12000000>;
	};

	spdif-sound {
		compatible = "simple-audio-card";
		simple-audio-card,name = "ROCKCHIP,SPDIF";
		simple-audio-card,mclk-fs = <128>;
		status = "okay";

		simple-audio-card,cpu {
			sound-dai = <&spdif>;
		};

		simple-audio-card,codec {
			sound-dai = <&spdif_out>;
		};
	};

	spdif_out: spdif-out {
		compatible = "linux,spdif-dit";
		#sound-dai-cells = <0>;
		status = "okay";
	};

	vcc5v0_sys: vcc5v0-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&dc_12v>;
	};

	vcc5v0_host: vcc5v0-host-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_host";
		regulator-boot-on;
		regulator-always-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		enable-active-high;
		gpio = <&gpio4 RK_PB5 GPIO_ACTIVE_HIGH>;
		vin-supply = <&vcc5v0_sys>;
		pinctrl-names = "default";
		pinctrl-0 = <&vcc5v0_host_en>;
	};

	vcc5v0_otg: vcc5v0-otg-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_otg";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		enable-active-high;
		gpio = <&gpio4 RK_PC2 GPIO_ACTIVE_HIGH>;
		vin-supply = <&vcc5v0_sys>;
		pinctrl-names = "default";
		pinctrl-0 = <&vcc5v0_otg_en>;
	};

	vccio_sd: vccio-sd {
		compatible = "regulator-gpio";
		regulator-name = "vccio_sd";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <3300000>;
		gpios = <&gpio4 RK_PB6 GPIO_ACTIVE_HIGH>;
		vin-supply = <&vcc5v0_sys>;
		states = <1800000 0 3300000 1>;
	};

	vdd_cpu: vdd_logic: vdd_gpu: vdd-cpu {
		compatible = "pwm-regulator";
		pwms = <&pwm1 0 5000 1>;
		regulator-name = "vdd_cpu";
		regulator-min-microvolt = <746000>;
		regulator-max-microvolt = <1201000>;
		regulator-always-on;
		regulator-boot-on;
		regulator-settling-time-up-us = <250>;
		pwm-supply = <&vcc5v0_sys>;
		status = "okay";
	};

	vdd_0v9_s3: vdd-0v9-s3 {
		compatible = "regulator-fixed";
		regulator-name = "vdd_0v9_s3";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <900000>;
		regulator-max-microvolt = <900000>;
		vin-supply = <&vcc5v0_sys>;
	};

	vdd_1v8_s3: vdd-1v8-s3 {
		compatible = "regulator-fixed";
		regulator-name = "vdd_1v8_s3";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		vin-supply = <&vcc5v0_sys>;
	};

	vcc_3v3_s3: vcc-3v3-s3 {
		compatible = "regulator-fixed";
		regulator-name = "vcc_3v3_s3";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&vcc5v0_sys>;
	};

	vcc_sd: vcc-sd {
		compatible = "regulator-fixed";
		gpio = <&gpio4 RK_PA1 GPIO_ACTIVE_LOW>;
		regulator-name = "vcc_sd";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&vcc_3v3_s3>;
	};

	vcc_ddr_s3: vcc-ddr-s3 {
		compatible = "regulator-fixed";
		regulator-name = "vcc_ddr_s3";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <1200000>;
		regulator-max-microvolt = <1200000>;
		vin-supply = <&vcc5v0_sys>;
	};

	sdio_pwrseq: sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		pinctrl-names = "default";
		post-power-on-delay-ms = <200>;
		reset-gpios = <&gpio3 RK_PB2 GPIO_ACTIVE_LOW>;
		pinctrl-0 = <&wifi_enable_h>, <&clkm1_32k_out>;
		status = "okay";
	};

	leds {
		compatible = "gpio-leds";

		/* lit when driven low, measured: the factory tree's active-high leaves it dark while up */
		normal_led: led-power {
			gpios = <&gpio4 RK_PC1 GPIO_ACTIVE_LOW>;
			default-state = "on";
			retain-state-suspended;
			retain-state-shutdown;
			label = "power";
		};

		standby_led: led-standby {
			gpios = <&gpio4 RK_PB3 GPIO_ACTIVE_LOW>;
			default-state = "off";
			retain-state-suspended;
			retain-state-shutdown;
			label = "standby";
		};
	};

	ir-receiver {
		compatible = "gpio-ir-receiver";
		gpios = <&gpio4 RK_PC6 GPIO_ACTIVE_LOW>;
		linux,rc-map-name = "rc-r69-1";
		pinctrl-names = "default";
		pinctrl-0 = <&ir_rx_gpio>;
	};

	hdmi-sound {
		compatible = "simple-audio-card";
		simple-audio-card,name = "rockchip,hdmi";
		simple-audio-card,format = "i2s";
		simple-audio-card,mclk-fs = <128>;

		simple-audio-card,cpu {
			sound-dai = <&sai3>;
			dai-tdm-slot-num = <2>;
			dai-tdm-slot-width = <32>;
		};

		simple-audio-card,codec {
			sound-dai = <&hdmi>;
		};
	};
};

&acodec {
	pa-ctl-gpios = <&gpio0 RK_PA0 GPIO_ACTIVE_HIGH>;
	status = "okay";
};

&combphy {
	status = "okay";
};

&cpu0 {
	#cooling-cells = <2>;
	dynamic-power-coefficient = <147>;
	cpu-idle-states = <&CPU_SLEEP0>;
	cpu-supply = <&vdd_cpu>;
};

&cpu1 {
	cpu-idle-states = <&CPU_SLEEP0>;
};

&cpu2 {
	cpu-idle-states = <&CPU_SLEEP1>;
};

&cpu3 {
	cpu-idle-states = <&CPU_SLEEP1>;
};

&cpu_opp_table {
	rockchip,pvtm-voltage-sel = <0 1420 0>, <1410 1444 1>, <1445 1474 2>, <1475 1509 3>,
	                            <1510 1544 4>, <1545 1579 5>, <1580 1619 6>,
	                            <1620 1689 7>, <1690 1744 8>, <1745 1799 9>,
	                            <1800 9999 10>;
	rockchip,pvtm-offset = <0x18>;
	rockchip,pvtm-sample-time = <1100>;
	rockchip,pvtm-freq = <1416000>;
	rockchip,pvtm-volt = <950000>;
	rockchip,grf = <&core_grf>;
	/delete-node/ opp-1608000000;
	/delete-node/ opp-1800000000;
	/delete-node/ opp-2016000000;

	opp-1200000000 {
		opp-microvolt = <900000 900000 1000000>;
	};

	opp-1416000000 {
		opp-microvolt = <962500 962500 1000000>;
		opp-microvolt-L1 = <950000 950000 1000000>;
		opp-microvolt-L2 = <937500 937500 1000000>;
		opp-microvolt-L3 = <925000 925000 1000000>;
		opp-microvolt-L4 = <912500 912500 1000000>;
		opp-microvolt-L0 = <962500 962500 1000000>;
		opp-microvolt-L5 = <900000 900000 1000000>;
		opp-microvolt-L6 = <900000 900000 1000000>;
		opp-microvolt-L7 = <900000 900000 1000000>;
		opp-microvolt-L8 = <900000 900000 1000000>;
		opp-microvolt-L9 = <900000 900000 1000000>;
		opp-microvolt-L10 = <900000 900000 1000000>;
	};
};

&dmc {
	center-supply = <&vdd_cpu>;
	status = "okay";
};

&dmc_opp_table {
	opp-324000000 {
		opp-hz = /bits/ 64 <324000000>;
		opp-microvolt = <900000 900000 1000000>;
	};

	opp-666000000 {
		opp-hz = /bits/ 64 <666000000>;
		opp-microvolt = <900000 900000 1000000>;
	};

	opp-1056000000 {
		opp-hz = /bits/ 64 <1056000000>;
		opp-microvolt = <900000 900000 1000000>;
	};

	opp-780000000 {
		opp-hz = /bits/ 64 <780000000>;
		opp-microvolt = <900000 900000 1000000>;
	};
};

&gmac0 {
	clock_in_out = "input";
	status = "okay";
};

&gpu {
	#cooling-cells = <2>;
	mali-supply = <&vdd_cpu>;
	dynamic-power-coefficient = <724>;
	status = "okay";
};

&gpu_opp_table {
	rockchip,pvtm-voltage-sel = <0 809 0>, <810 830 1>, <831 850 2>, <851 880 3>,
	                            <881 890 4>, <891 910 5>, <911 930 6>, <931 950 7>,
	                            <951 970 8>, <971 995 9>, <1000 9999 10>;
	rockchip,pvtm-offset = <24>;
	rockchip,pvtm-sample-time = <1100>;
	rockchip,pvtm-freq = <800000>;
	rockchip,pvtm-volt = <950000>;
	rockchip,grf = <&gpu_grf>;
	/delete-node/ opp-500000000;
	/delete-node/ opp-600000000;

	opp-800000000 {
		opp-microvolt = <962500 962500 1000000>;
		opp-microvolt-L1 = <950000 950000 1000000>;
		opp-microvolt-L2 = <937500 937500 1000000>;
		opp-microvolt-L3 = <925000 925000 1000000>;
		opp-microvolt-L4 = <912500 912500 1000000>;
		opp-microvolt-L5 = <900000 900000 1000000>;
		opp-microvolt-L0 = <962500 962500 1000000>;
		opp-microvolt-L6 = <900000 900000 1000000>;
		opp-microvolt-L7 = <900000 900000 1000000>;
		opp-microvolt-L8 = <900000 900000 1000000>;
		opp-microvolt-L9 = <900000 900000 1000000>;
		opp-microvolt-L10 = <900000 900000 1000000>;
	};
};

&hdmi {
	pinctrl-names = "default";
	pinctrl-0 = <&hdmi_pins>;
	hpd-gpios = <&gpio0 RK_PA2 GPIO_ACTIVE_HIGH>;
	ddc-i2c-bus = <&i2c2>;
	status = "okay";
};

&hdmi_pins {
	rockchip,pins = <0 RK_PA3 1 &pcfg_pull_none>;
};

&hdmiphy {
	status = "okay";
};

&i2c2 {
	pinctrl-0 = <&i2c2m0_xfer>;
	status = "okay";
};

&iep {
	status = "okay";
};

&iep_mmu {
	status = "okay";
};

&jpegd {
	status = "okay";
};

&jpegd_mmu {
	status = "okay";
};

&otp {
	cpu_mbist_vmin: cpu-mbist-vmin@9 {
		reg = <0x09 0x01>;
		bits = <0 3>;
	};

	gpu_mbist_vmin: gpu-mbist-vmin@9 {
		reg = <0x09 0x01>;
		bits = <3 2>;
	};

	logic_mbist_vmin: logic-mbist-vmin@9 {
		reg = <0x09 0x01>;
		bits = <5 2>;
	};

	log_leakage: log-leakage@1b {
		reg = <0x1b 0x01>;
	};

	macphy_bgs: macphy-bgs@2d {
		reg = <0x2d 0x01>;
	};

	cpu_opp_info: cpu-opp-info@32 {
		reg = <0x32 0x06>;
	};

	gpu_opp_info: gpu-opp-info@38 {
		reg = <0x38 0x06>;
	};

	dmc_opp_info: dmc-opp-info@3e {
		reg = <0x3e 0x06>;
	};

	cpu_tsadc_trim_l: cpu-tsadc-trim-l@44 {
		reg = <0x44 0x01>;
	};

	cpu_tsadc_trim_h: cpu-tsadc-trim-h@45 {
		reg = <0x45 0x01>;
	};

	cpu_code1: cpu-code1@52 {
		reg = <0x52 0x02>;
	};
};

&pinctrl {
	pwm3 {
		ir_rx_gpio: ir-rx-gpio {
			rockchip,pins = <4 RK_PC6 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	pcfg_output_high_pull_up: pcfg-output-high-pull-up {
		output-high;
		bias-pull-up;
	};

	pcfg_output_high_pull_down: pcfg-output-high-pull-down {
		output-high;
		bias-pull-down;
	};

	pcfg_output_high_pull_none: pcfg-output-high-pull-none {
		output-high;
		bias-disable;
	};

	pcfg_output_low_pull_up: pcfg-output-low-pull-up {
		output-low;
		bias-pull-up;
	};

	pcfg_output_low_pull_down: pcfg-output-low-pull-down {
		output-low;
		bias-pull-down;
	};

	pcfg_output_low_pull_none: pcfg-output-low-pull-none {
		output-low;
		bias-disable;
	};

	usb {
		vcc5v0_host_en: vcc5v0-host-en-pins {
			rockchip,pins = <4 RK_PB5 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		vcc5v0_otg_en: vcc5v0-otg-en-pins {
			rockchip,pins = <4 RK_PC1 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	sdio-pwrseq {
		wifi_enable_h: wifi-enable-h-pins {
			rockchip,pins = <3 RK_PB2 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};

&power {
	power-domain@5 {
		status = "okay";
	};
};

&pwm0 {
	status = "okay";
};

&pwm1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pwm1m0_pins>;
	status = "okay";
};

&pwm2 {
	status = "okay";
};

&pwm4 {
	status = "okay";
};

&pwm5 {
	status = "okay";
};

&pwm7 {
	status = "okay";
};

&rga {
	status = "okay";
};

&rga_mmu {
	status = "okay";
};

&rkvenc {
	status = "okay";
};

&rkvenc_mmu {
	status = "okay";
};

&sai2 {
	status = "okay";
};

&sai3 {
	status = "okay";
};

&saradc {
	vref-supply = <&vdd_1v8_s3>;
	status = "okay";
};

&sdhci {
	max-frequency = <100000000>;
	bus-width = <8>;
	no-sd;
	no-sdio;
	non-removable;
	mmc-hs200-1_8v;
	status = "okay";
};

&sdio1 {
	max-frequency = <100000000>;
	pinctrl-0 = <&sdio1_bus4>, <&sdio1_cmd>, <&sdio1_clk>;
	no-sd;
	no-mmc;
	bus-width = <4>;
	disable-wp;
	cap-sd-highspeed;
	cap-sdio-irq;
	keep-power-in-suspend;
	non-removable;
	mmc-pwrseq = <&sdio_pwrseq>;
	sd-uhs-sdr104;
	status = "okay";
};

&sdmmc {
	pinctrl-0 = <&sdmmc_clk>, <&sdmmc_cmd>, <&sdmmc_det>, <&sdmmc_bus4>;
	bus-width = <4>;
	cap-mmc-highspeed;
	cap-sd-highspeed;
	disable-wp;
	vmmc-supply = <&vcc_sd>;
	status = "okay";
};

&spdif {
	status = "okay";
};

&tsadc {
	status = "okay";
};

&tve {
	status = "okay";
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0m0_xfer>;
	status = "okay";
};

&uart2 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart2m0_xfer>, <&uart2m0_ctsn>, <&uart2m0_rtsn>;
	status = "okay";

	bluetooth {
		compatible = "aicsemi,aic8800-bt"; /* the AIC8800's Bluetooth half */
		max-speed = <1500000>;
		reset-gpios = <&gpio3 RK_PC1 GPIO_ACTIVE_LOW>;
		device-wakeup-gpios = <&gpio3 RK_PB4 GPIO_ACTIVE_HIGH>;
	};
};

&usb2phy {
	status = "okay";
};

&usb2phy_host {
	phy-supply = <&vcc5v0_host>;
	status = "okay";
};

&usb2phy_otg {
	phy-supply = <&vcc5v0_otg>;
	status = "okay";
};

&usb_host0_ehci {
	status = "okay";
};

&usb_host0_ohci {
	status = "okay";
};

&usb_host0_xhci {
	dr_mode = "host";
	status = "okay";
};

/*
 * No power-domains on purpose.  rk3528.dtsi leaves
 * power-domain@RK3528_PD_RKVDEC disabled, so referencing it makes both
 * devices fail with deferred probe timeouts.  The vendor DTB does not
 * use a power domain here either: the RK3528 vdec domain is defined with
 * a zero power mask, i.e. bus idle handshake only, permanently powered.
 */
&vdec {
	status = "okay";
};

/*
 * The vendor DTB uses the BSP-only "rockchip,iommu-v2"; mainline reaches
 * the same v2 ops through "rockchip,rk3568-iommu".
 */
&vdec_mmu {
	status = "okay";
};

&vdpp {
	status = "okay";
};

&vdpu_mmu {
	status = "okay";
};

&vop {
	esmart_lb_mode = [02]; /* Esmart0 a 4K line buffer for HDMI */
	status = "okay";
};

&vop_mmu {
	status = "okay";
};

/* VDPU2, as on RK3568: MPEG-2, VP8 and H.264 behind the decoder at +0x400. */
&vpu {
	status = "okay";
};

&wdt {
	status = "okay";
};
