#include "sun50i-h616.dtsi"
#include <dt-bindings/clock/sun50i-h616-ccu.h>
#include <dt-bindings/clock/sun6i-rtc.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/linux-event-codes.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/thermal/thermal.h>

/ {
	model = "Tanix TX1 (QHZIW_H313_TX1_EMCP_V2.0)";
	/* board first; the SoC last, which sun50i-cpufreq-nvmem keys on */
	compatible = "tanix-tx1-v2,h313-tvbox", "allwinner,sun50i-h616";

	thermal-zones {
		cpu-thermal {
			cooling-maps {
				map0 {
					trip = <&cpu_target>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
					contribution = <1024>;
				};

				map1 {
					trip = <&cpu_target>;
					cooling-device = <&gpu THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
					contribution = <1024>;
				};
			};
		};
	};

	/* ethernet0: U-Boot's stable Wi-Fi MAC */
	aliases {
		serial0 = &uart0;
		ethernet0 = &sdio_wifi;
		serial1 = &uart1;
		serial2 = &uart2;
		serial3 = &uart3;
		serial4 = &uart4;
		serial5 = &uart5;
		spi0 = &spi0;
		spi1 = &spi1;
		mmc0 = &mmc0;
		mmc2 = &mmc2;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	cpu_opp_table: opp-table-cpu {
		compatible = "allwinner,sun50i-h616-operating-points";
		nvmem-cells = <&cpu_speed_grade>;
		opp-shared;

		opp-480000000 {
			opp-hz = /bits/ 64 <480000000>;
			opp-microvolt-speed4 = <900000>;
			clock-latency-ns = <244144>;
			opp-supported-hw = <0x10>;
		};

		opp-600000000 {
			opp-hz = /bits/ 64 <600000000>;
			opp-microvolt-speed4 = <900000>;
			clock-latency-ns = <244144>;
			opp-supported-hw = <0x10>;
		};

		opp-792000000 {
			opp-hz = /bits/ 64 <792000000>;
			opp-microvolt-speed4 = <940000>;
			clock-latency-ns = <244144>;
			opp-supported-hw = <0x10>;
		};

		opp-1008000000 {
			opp-hz = /bits/ 64 <1008000000>;
			opp-microvolt-speed4 = <1020000>;
			clock-latency-ns = <244144>;
			opp-supported-hw = <0x10>;
		};

		opp-1200000000 {
			opp-hz = /bits/ 64 <1200000000>;
			opp-microvolt-speed4 = <1100000>;
			clock-latency-ns = <244144>;
			opp-supported-hw = <0x10>;
		};

		opp-1344000000 {
			opp-hz = /bits/ 64 <1344000000>;
			opp-microvolt-speed4 = <1120000>;
			clock-latency-ns = <244144>;
			opp-supported-hw = <0x10>;
		};
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0x00 0x40000000 0x00 0x20000000>;
	};

	gpu_opp_table: opp-table-gpu {
		compatible = "operating-points-v2";

		opp-504000000 {
			opp-hz = /bits/ 64 <504000000>;
			opp-microvolt = <950000>;
		};

		opp-540000000 {
			opp-hz = /bits/ 64 <540000000>;
			opp-microvolt = <950000>;
		};

		opp-576000000 {
			opp-hz = /bits/ 64 <576000000>;
			opp-microvolt = <950000>;
		};

		opp-600000000 {
			opp-hz = /bits/ 64 <600000000>;
			opp-microvolt = <950000>;
		};
	};

	reg_usb1_vbus: usb1-vbus {
		compatible = "regulator-fixed";
		regulator-name = "usb1-vbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpio = <&pio 7 8 GPIO_ACTIVE_HIGH>; /* PH8 */
		enable-active-high;
	};

	connector {
		compatible = "hdmi-connector";
		type = "a";

		port {
			hdmi_con_in: endpoint {
				remote-endpoint = <&hdmi_out_con>;
			};
		};
	};

	/* stock's wlan: 32 kHz on PG10, regon PG18, chip_en PG19, 200 ms */
	wifi_pwrseq: pwrseq {
		compatible = "mmc-pwrseq-simple";
		clocks = <&rtc CLK_OSC32K_FANOUT>;
		clock-names = "ext_clock";
		pinctrl-names = "default";
		pinctrl-0 = <&clk_losc_pins_a>;
		assigned-clocks = <&rtc CLK_OSC32K_FANOUT>;
		assigned-clock-parents = <&ccu CLK_PLL_SYSTEM_32K>;
		reset-gpios = <&pio 6 18 GPIO_ACTIVE_LOW>, <&pio 6 19 GPIO_ACTIVE_LOW>; /* PG18, PG19 */
		post-power-on-delay-ms = <200>;
	};

	leds {
		compatible = "gpio-leds";

		led-0 {
			label = "power";
			function = LED_FUNCTION_POWER;
			color = <LED_COLOR_ID_BLUE>;
			gpios = <&pio 7 6 GPIO_ACTIVE_HIGH>; /* PH6 */
			default-state = "on";
			retain-state-suspended;
			retain-state-shutdown;
		};

		led-1 {
			label = "standby";
			function = LED_FUNCTION_STANDBY;
			gpios = <&pio 7 7 GPIO_ACTIVE_HIGH>; /* PH7 */
			default-state = "off";
			retain-state-suspended;
			retain-state-shutdown;
		};
	};

	/* the recovery button on PH9 (board.md), stock's recovery_key */
	gpio-keys {
		compatible = "gpio-keys";

		key {
			label = "recovery";
			linux,code = <KEY_VENDOR>;
			gpios = <&pio 7 9 GPIO_ACTIVE_LOW>; /* PH9 */
		};
	};
};

&ahub {
	status = "okay";
};

&codec {
	allwinner,audio-routing = "Line Out", "LINEOUT";
	status = "okay";
};

&cpu0 {
	operating-points-v2 = <&cpu_opp_table>;
	dynamic-power-coefficient = <100>;
	cpu-supply = <&reg_dcdc2>;
};

&cpu1 {
	operating-points-v2 = <&cpu_opp_table>;
};

&cpu2 {
	operating-points-v2 = <&cpu_opp_table>;
};

&cpu3 {
	operating-points-v2 = <&cpu_opp_table>;
};

&cpu_critical {
	temperature = <115000>;
};

&de {
	status = "okay";
};

&ehci0 {
	status = "okay";
};

&ehci1 {
	status = "okay";
};

&ehci2 {
	status = "okay";
};

&ehci3 {
	status = "okay";
};

&gpu {
	#cooling-cells = <2>;
	operating-points-v2 = <&gpu_opp_table>;
	mali-supply = <&reg_dcdc1>;
	status = "okay";
};

&hdmi {
	status = "okay";
};

&hdmi_out {
	hdmi_out_con: endpoint {
		remote-endpoint = <&hdmi_con_in>;
	};
};

&hdmi_sound {
	status = "okay";
};

&i2c3 {
	clock-frequency = <200000>;
	pinctrl-names = "default";
	pinctrl-0 = <&twi3_pins_a>;
	status = "okay";
};

&ir {
	pinctrl-0 = <&s_cir0_pins_a>;
	/* the stock remote: the TX3 mini's buttons, as their labels read */
	linux,rc-map-name = "rc-tanix-tx1-v2";
	status = "okay";
};

&mmc1 {
	pinctrl-0 = <&sdc1_pins_a>;
	bus-width = <4>;
	keep-power-in-suspend;
	no-mmc;
	no-sd;
	mmc-pwrseq = <&wifi_pwrseq>;
	non-removable;
	vmmc-supply = <&reg_dldo1>;
	vqmmc-supply = <&reg_dldo1>;
	status = "okay";

	sdio_wifi: wifi@1 {
		reg = <1>;
	};
};

/* the eMMC, which the vendor's U-Boot enables at boot */
&mmc2 {
	pinctrl-0 = <&sdc2_pins_a>, <&sdc2_pins_c>;
	max-frequency = <50000000>;
	bus-width = <8>;
	non-removable;
	no-sdio;
	no-sd;
	mmc-ddr-1_8v;
	/* stock's tuned DDR52 sample delay, sdc_tm4_sm2_freq0 in its runtime tree */
	allwinner,sample-delay = <20>;
	vmmc-supply = <&reg_dldo1>;
	/* the eMMC's bank, PC, measures 3.3 V */
	vqmmc-supply = <&reg_dldo1>;
	status = "okay";
};

&ohci0 {
	status = "okay";
};

&ohci1 {
	status = "okay";
};

&ohci2 {
	status = "okay";
};

&ohci3 {
	status = "okay";
};

&pio {
	input-debounce = <0 0 0 0 0 0 0>;
	/* each bank's rail at the voltage PIO_POW_VAL measures on the box */
	vcc-pc-supply = <&reg_dldo1>;
	vcc-pf-supply = <&reg_dldo1>;
	vcc-pg-supply = <&reg_dldo1>;
	vcc-ph-supply = <&reg_dldo1>;
	vcc-pi-supply = <&reg_dldo1>;

	clk_losc_pins_a: clk-losc-a-pins {
		pins = "PG10";
		function = "clock";
		drive-strength = <30>;
		bias-pull-up;
	};

	s_cir0_pins_a: s-cir0-a-pins {
		pins = "PH10";
		function = "ir_rx";
		drive-strength = <30>;
		bias-pull-up;
	};

	uart1_pins_a: uart1-a-pins {
		pins = "PG6", "PG7", "PG8", "PG9";
		function = "uart1";
		drive-strength = <20>;
		bias-pull-up;
	};

	twi3_pins_a: twi3-a-pins {
		pins = "PA10", "PA11";
		function = "i2c3";
		drive-strength = <20>;
		bias-pull-up;
	};

	sdc1_pins_a: sdc1-a-pins {
		pins = "PG0", "PG1", "PG2", "PG3", "PG4", "PG5";
		function = "mmc1";
		drive-strength = <40>;
		bias-pull-up;
	};

	sdc2_pins_a: sdc2-a-pins {
		pins = "PC1", "PC5", "PC6", "PC8", "PC9", "PC10", "PC11", "PC13", "PC14", "PC15", "PC16";
		function = "mmc2";
		drive-strength = <30>;
		bias-pull-up;
	};

	sdc2_pins_c: sdc2-c-pins {
		pins = "PC0";
		function = "mmc2";
		drive-strength = <30>;
		bias-pull-down;
	};

	uart0_pins_a: uart0-a-pins {
		pins = "PH0", "PH1";
		function = "uart0";
		bias-pull-up;
	};
};

&pwm {
	status = "okay";
};

&r_i2c {
	pinctrl-0 = <&s_twi0_pins_a>;
	clock-frequency = <200000>;
	status = "okay";

	pmu0: pmic@36 {
		compatible = "x-powers,axp313a";
		reg = <0x36>;
		#interrupt-cells = <1>;
		interrupt-controller;

		regulators {
			reg_dcdc1: dcdc1 {
				regulator-name = "axp1530-dcdc1";
				regulator-always-on;
				regulator-min-microvolt = <950000>;
				regulator-max-microvolt = <950000>;
			};

			reg_dcdc2: dcdc2 {
				regulator-name = "axp1530-dcdc2";
				regulator-ramp-delay = <200>;
				regulator-always-on;
				regulator-min-microvolt = <900000>;
				regulator-max-microvolt = <1120000>;
			};

			reg_dcdc3: dcdc3 {
				regulator-name = "axp1530-dcdc3";
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1840000>;
				regulator-always-on;
			};

			reg_aldo1: aldo1 {
				regulator-name = "axp1530-aldo1";
				regulator-always-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
			};

			reg_dldo1: dldo1 {
				regulator-name = "axp1530-dldo1";
				regulator-always-on;
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
			};
		};
	};
};

&r_pio {
	s_twi0_pins_a: s-twi0-a-pins {
		pins = "PL0", "PL1";
		function = "s_i2c";
		drive-strength = <20>;
		bias-pull-up;
	};
};

/* the AV jack's composite output */
&tve {
	status = "okay";
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_pins_a>;
	status = "okay";
};

&uart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart1_pins_a>;
	uart-has-rtscts;
	status = "okay";
};

&usbotg {
	dr_mode = "host";
	status = "okay";
};

&usbphy {
	usb1_vbus-supply = <&reg_usb1_vbus>;
	status = "okay";
};
