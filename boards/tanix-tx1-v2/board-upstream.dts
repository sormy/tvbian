 *     "rc-tanix-tx1-v2"
 *   patches/linux-sunxi/0088-media-rc-keymaps-Add-the-Tanix-TX1-V2-remote.patch:
 *     "rc-tanix-tx1-v2"
 *   patches/linux-sunxi/0089-drm-sun4i-tv-Add-the-H616-TV-encoder.patch:
 *     "allwinner,sun50i-h616-tv-encoder"
