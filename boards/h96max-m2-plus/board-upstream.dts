/dts-v1/;

/*
 * Written by tools/dtcx/upstream.py from board.dts: a view, not edited.
 * Over rockchip-linux/kernel at 77168c8d5ab8.
 */

#include "rk3528-evb1-ddr4-v10.dts"
#include <dt-bindings/clock/rk3528-cru.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pinctrl/rockchip.h>
#include <dt-bindings/input/linux-event-codes.h>
#include <dt-bindings/suspend/rockchip-rk3528.h>

/ {
	/* The radio driver selects board NV settings from the first compatible. */
	compatible = "h96max-m2-plus,rk3528-tvbox", "rockchip,rk3528-evb1-ddr4-v10", "rockchip,rk3528";
	model = "H96 Max M2 Plus (M2_P_ZX_20250328)";

	/* the HDMI DDC lines as a full I2C bus: dw-hdmi's own master reads the EDID but refuses DDC/CI */
	hdmi_ddc: i2c-hdmi-ddc {
		compatible = "i2c-gpio";
		sda-gpios = <&gpio0 RK_PA5 GPIO_OPEN_DRAIN>;
		scl-gpios = <&gpio0 RK_PA4 GPIO_OPEN_DRAIN>;
		i2c-gpio,delay-us = <5>;
		pinctrl-names = "default";
		pinctrl-0 = <&hdmi_ddc_gpio>;
		#address-cells = <1>;
		#size-cells = <0>;
	};

	seekwcn_boot: seekwcn_boot {
		compatible = "seekwave,sv6160lite";
		dma_type = <0x01>;
		seekwave_nv_name = "SEEKWAVE_NV_SWT6652.bin";
		gpio_host_wake = <&gpio3 RK_PB3 GPIO_ACTIVE_LOW>;
		gpio_chip_wake = <&gpio3 RK_PB4 GPIO_ACTIVE_HIGH>;
		gpio_chip_en = <&gpio3 RK_PB2 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};

	leds: gpio-leds {
		compatible = "gpio-leds";

		/* Shared LED hooks address these names. */
		power {
			gpios = <&gpio4 RK_PC1 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "none";
			default-state = "on";
			retain-state-suspended;
			retain-state-shutdown;
		};

		standby {
			gpios = <&gpio4 RK_PB3 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "none";
			default-state = "off";
			retain-state-suspended;
			retain-state-shutdown;
		};
	};
};

&adc_keys {
	vol-up-key {
		/* The recovery button, not a volume key: mainline's code for one. */
		linux,code = <KEY_VENDOR>;
	};
};

&cpu0_opp_table {
	rockchip,pvtm-voltage-sel = <0 1320 0>, <1321 1350 1>, <1351 1375 2>, <1376 1405 3>,
	                            <1406 1435 4>, <1436 1470 5>, <1471 1505 6>,
	                            <1506 1540 7>, <1541 1575 8>, <1576 1610 9>,
	                            <1611 1640 10>, <1641 9999 11>;
};

&dmc {
	system-status-level = <1 8>;
};

&dmc_opp_table {
	rockchip,leakage-voltage-sel = <1 10 0>, <11 14 1>, <15 22 2>, <23 28 3>,
	                               <29 254 4>;
};

&gmac1 {
	status = "disabled";
};

&gpu {
	/* Mainline lima bindings replace the vendor Mali names. */
	interrupt-names = "gp", "gpmmu", "pp", "pp0", "ppmmu0", "pp1", "ppmmu1";
	clocks = <&cru ACLK_GPU_MALI>, <&cru ACLK_GPU_MALI>;
	clock-names = "bus", "core";
};

&gpu_bus_opp_table {
	rockchip,leakage-voltage-sel = <1 22 0>, <23 254 1>;
};

&gpu_opp_table {
	rockchip,pvtm-voltage-sel = <0 750 0>, <751 770 1>, <771 790 2>, <791 810 3>,
	                            <811 830 4>, <831 850 5>, <851 870 6>, <871 890 7>,
	                            <891 9999 8>;
};

&gpu_power_model {
	ls = <0xffffc2d6 0x1071a 0x00>;
	ts = <0x302a42 0x1d55a 0xfffff636 0x27>;
};

&hdmi {
	ddc-i2c-bus = <&hdmi_ddc>;
};

&hdmi_pins {
	rockchip,pins = <0 RK_PA3 1 &pcfg_pull_none>;
};

&i2c6 {
	status = "disabled";
};

&pinctrl {
	hdmi {
		hdmi_ddc_gpio: hdmi-ddc-gpio {
			rockchip,pins = <0 RK_PA4 RK_FUNC_GPIO &pcfg_pull_none>,
			                <0 RK_PA5 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};

&pwm3 {
	/* Register IR as an ATF wake source. */
	remote_support_psci = <0x01>;

	ir_key4 {
		rockchip,usercode = <0x7f80>;
		rockchip,key_table = <0xec KEY_REPLY>, <0xd8 KEY_BACK>, <0xc7 KEY_UP>,
		                     <0xbf KEY_DOWN>, <0xc8 KEY_LEFT>, <0xc6 KEY_RIGHT>,
		                     <0x8c KEY_HOME>, <0x78 KEY_VOLUMEUP>,
		                     <0x76 KEY_VOLUMEDOWN>, <0x7e KEY_POWER>,
		                     <0x7c KEY_MENU>, <0xb7 KEY_TEXT>;
	};

	ir_key5 {
		rockchip,usercode = <0xfeaa>;
		rockchip,key_table = <0xec KEY_REPLY>, <0xe6 KEY_BACK>, <0xe9 KEY_UP>,
		                     <0xe5 KEY_DOWN>, <0xae KEY_LEFT>, <0xaf KEY_RIGHT>,
		                     <0xee KEY_HOME>, <0xe7 KEY_VOLUMEUP>,
		                     <0xef KEY_VOLUMEDOWN>, <0xbf KEY_POWER>,
		                     <0xbe KEY_MUTE>, <0xb3 KEY_MENU>, <0xff KEY_TEXT>,
		                     <0xb1 KEY_RED>, <0xf2 KEY_GREEN>, <0xf3 KEY_3>,
		                     <0xb5 KEY_4>, <0xf6 KEY_5>, <0xf7 KEY_6>,
		                     <0xb9 KEY_YELLOW>, <0xfa KEY_BLUE>, <0xfb KEY_9>,
		                     <0xfe KEY_0>, <0xbd KEY_BACKSPACE>, <0xbc KEY_F13>,
		                     <0xf0 KEY_F16>, <0xb4 KEY_PREVIOUS>, <0xb8 KEY_A>,
		                     <0xb0 KEY_NEXT>;
	};

	ir_key6 {
		rockchip,usercode = <0xfb04>;
		/* The bundled remote, onto the canonical keymap: cog, voice, mouse, OK, home and the four app keys. */
		rockchip,key_table = <0xf7 KEY_POWER>, <0xd0 KEY_TOUCHPAD_TOGGLE>,
		                     <0xb5 KEY_MENU>, <0x5b KEY_SEARCH>, <0x4d KEY_CONFIG>,
		                     <0xba KEY_UP>, <0xb9 KEY_DOWN>, <0xb8 KEY_LEFT>,
		                     <0xb7 KEY_RIGHT>, <0xbb KEY_OK>, <0xe5 KEY_BACK>,
		                     <0xe4 KEY_BACKSPACE>, <0xd2 KEY_HOMEPAGE>,
		                     <0xfd KEY_VOLUMEUP>, <0xfc KEY_VOLUMEDOWN>,
		                     <0xf6 KEY_MUTE>, <0xff KEY_CHANNELUP>,
		                     <0xfe KEY_CHANNELDOWN>, <0xe8 KEY_F4>, <0x6f KEY_F5>,
		                     <0x9e KEY_1>, <0x9d KEY_2>, <0x9c KEY_3>, <0x9b KEY_4>,
		                     <0x9a KEY_5>, <0x99 KEY_6>, <0x98 KEY_7>, <0x97 KEY_8>,
		                     <0x96 KEY_9>, <0x9f KEY_0>, <0x04 KEY_RED>,
		                     <0x14 KEY_YELLOW>, <0x4c KEY_BLUE>, <0x4b KEY_GREEN>;
	};

	ir_key7 {
		rockchip,usercode = <0xfe01>;
		rockchip,key_table = <0xec KEY_REPLY>, <0xe6 KEY_BACK>, <0xe9 KEY_UP>,
		                     <0xe5 KEY_DOWN>, <0xae KEY_LEFT>, <0xaf KEY_RIGHT>,
		                     <0xee KEY_HOME>, <0xe7 KEY_VOLUMEUP>,
		                     <0xef KEY_VOLUMEDOWN>, <0xbf KEY_POWER>,
		                     <0xbe KEY_MUTE>, <0xb3 KEY_MENU>, <0xff KEY_TEXT>,
		                     <0xb1 KEY_1>, <0xf2 KEY_2>, <0xf3 KEY_3>, <0xb5 KEY_4>,
		                     <0xf6 KEY_5>, <0xf7 KEY_6>, <0xb9 KEY_7>, <0xfa KEY_8>,
		                     <0xfb KEY_9>, <0xfe KEY_0>, <0xbd KEY_BACKSPACE>,
		                     <0xbc KEY_F13>, <0xf0 KEY_F16>, <0xb4 KEY_PREVIOUS>,
		                     <0xb8 KEY_A>, <0xb0 KEY_NEXT>;
	};

	ir_key8 {
		rockchip,key_table = <0x31 KEY_REPLY>, <0x6a KEY_BACK>, <0x35 KEY_UP>,
		                     <0x2d KEY_DOWN>, <0x66 KEY_LEFT>, <0x3e KEY_RIGHT>,
		                     <0x7f KEY_VOLUMEUP>, <0x7e KEY_VOLUMEDOWN>,
		                     <0x23 KEY_POWER>, <0x63 KEY_MUTE>, <0x6d KEY_1>,
		                     <0x6c KEY_2>, <0x33 KEY_3>, <0x71 KEY_4>, <0x70 KEY_5>,
		                     <0x37 KEY_6>, <0x75 KEY_7>, <0x74 KEY_8>, <0x3b KEY_9>,
		                     <0x78 KEY_0>, <0x73 KEY_PAGEDOWN>, <0x22 KEY_PAGEUP>,
		                     <0x72 KEY_SETUP>, <0x7a 0xf9>, <0x79 0xfa>,
		                     <0x77 0xfb>, <0x2f 0xfc>, <0x32 0xfd>, <0x6e 0xfe>,
		                     <0x7c 0xff>, <0x3c BTN_0>, <0x3a KEY_HELP>,
		                     <0x67 BTN_1>, <0x25 BTN_3>, <0x7d KEY_MENU>,
		                     <0x3f KEY_EQUAL>, <0x29 KEY_TEXT>,
		                     <0x26 KEY_PLAYPAUSE>, <0x76 KEY_BLUE>,
		                     <0x7b KEY_YELLOW>, <0x69 KEY_F8>;
	};

	ir_key9 {
		rockchip,key_table = <0x81 KEY_REPLY>, <0x80 KEY_BACK>, <0x85 KEY_UP>,
		                     <0x87 KEY_DOWN>, <0x84 KEY_LEFT>, <0x86 KEY_RIGHT>,
		                     <0x99 KEY_VOLUMEUP>, <0x9a KEY_VOLUMEDOWN>,
		                     <0x96 KEY_POWER>, <0x9b KEY_MUTE>, <0x89 KEY_1>,
		                     <0x8a KEY_2>, <0x8b KEY_3>, <0x8c KEY_4>, <0x8d KEY_5>,
		                     <0x8e KEY_6>, <0x8f KEY_7>, <0x90 KEY_8>, <0x91 KEY_9>,
		                     <0x88 KEY_0>, <0x83 KEY_PAGEDOWN>, <0x82 KEY_PAGEUP>,
		                     <0x95 KEY_SETUP>, <0x97 0xf9>, <0x98 0xfa>,
		                     <0xc6 BTN_4>, <0xd6 0xfb>, <0xd7 0x10e>, <0xcc 0xfc>,
		                     <0xc3 BTN_8>, <0xd1 0xfd>, <0xd2 0xfe>, <0xd3 0xff>,
		                     <0xd4 BTN_0>, <0xc7 0xfd>, <0xc8 0xfe>, <0xc9 0xff>,
		                     <0xca BTN_0>, <0xcd BTN_9>, <0xce 0x10a>,
		                     <0xcf KEY_HELP>, <0xd0 0x10b>, <0x9c BTN_1>,
		                     <0x93 BTN_2>, <0x92 BTN_3>, <0xc0 KEY_END>,
		                     <0xc1 BTN_7>, <0x9d KEY_PLAYPAUSE>, <0xc4 KEY_STOP>,
		                     <0x94 KEY_EQUAL>, <0x9e KEY_YELLOW>, <0x9f KEY_BLUE>,
		                     <0xcb BTN_5>, <0xc5 BTN_6>;
	};
};

&reboot_mode {
	mode-bootloader = <0x5242c301>;
	mode-charge = <0x5242c30b>;
	mode-fastboot = <0x5242c309>;
	mode-loader = <0x5242c301>;
	mode-normal = <0x5242c300>;
	mode-recovery = <0x5242c303>;
	mode-ums = <0x5242c30c>;
	mode-panic = <0x5242c307>;
	mode-watchdog = <0x5242c308>;
	/* Factory SPL reads this flag to enter Maskrom. */
	mode-maskrom = <0xef08a53c>;
};

&rockchip_suspend {
	rockchip,sleep-mode-config = <RKPM_SLP_ARMPD>;
	rockchip,wakeup-config = <(RKPM_CPU0_WKUP_EN | RKPM_GPIO_WKUP_EN)>;
	rockchip,pwm-regulator-config = <(RKPM_PWM0_M0_REGULATOR_EN | RKPM_PWM1_M0_REGULATOR_EN)>;
};

&route_hdmi {
	/delete-property/ logo,kernel;
	logo,mode = "fullscreen";
};

&route_tve {
	/delete-property/ logo,kernel;
	logo,mode = "fullscreen";
};

&sai0 {
	pinctrl-0 = <&i2s0m0_lrck>, <&i2s0m0_sclk>, <&i2s0m0_sdi>, <&i2s0m0_sdo>;
	status = "okay";
};

&sai1 {
	status = "disabled";
};

&sdhci {
	/delete-property/ mmc-hs400-1_8v;
	/delete-property/ mmc-hs400-enhanced-strobe;
	max-frequency = <100000000>;
	mmc-hs200-1_8v;
};

&sdio0 {
	status = "disabled";
};

&sdio1 {
	max-frequency = <200000000>;
	no-sd;
	no-mmc;
	supports-sdio;
	bus-width = <4>;
	disable-wp;
	cap-sd-highspeed;
	cap-sdio-irq;
	keep-power-in-suspend;
	non-removable;
	mmc-pwrseq = <&sdio_pwrseq>;
	pinctrl-names = "default";
	pinctrl-0 = <&sdio1_bus4>, <&sdio1_cmd>, <&sdio1_clk>;
	sd-uhs-sdr104;
	status = "okay";
};

&sdio1_bus4 {
	rockchip,pins = <3 RK_PA6 1 &pcfg_pull_up_drv_level_3>,
	                <3 RK_PA7 1 &pcfg_pull_up_drv_level_3>,
	                <3 RK_PB0 1 &pcfg_pull_up_drv_level_3>,
	                <3 RK_PB1 1 &pcfg_pull_up_drv_level_3>;
};

&sdio1_clk {
	rockchip,pins = <3 RK_PA4 1 &pcfg_pull_up_drv_level_3>;
};

&sdio1_cmd {
	rockchip,pins = <3 RK_PA5 1 &pcfg_pull_up_drv_level_3>;
};

&sdio_pwrseq {
	reset-gpios = <&gpio3 RK_PB2 GPIO_ACTIVE_LOW>;
	/* Each failed init retries after a power-off; a reset this long restarts a chip left running by a warm reboot. */
	power-off-delay-us = <200000>;
};

&tve {
	rockchip,tve-upsample = <0x02>;
};

&usbdrd_dwc3 {
	dr_mode = "host";
};

&vcc5v0_otg {
	gpio = <&gpio4 RK_PB4 GPIO_ACTIVE_HIGH>;
};

&vop {
	/delete-property/ support-multi-area;
	/* Give Esmart0 a 4K line buffer; sub-windows do not reach HDMI. */
	esmart_lb_mode = [02];
};

&wdt {
	/* Let systemd recover a hung kernel. */
	status = "okay";
};

&wifi_enable_h {
	rockchip,pins = <3 RK_PB2 RK_FUNC_GPIO &pcfg_pull_none>;
};

&wireless_bluetooth {
	status = "disabled";
};

&wireless_wlan {
	status = "disabled";
};
