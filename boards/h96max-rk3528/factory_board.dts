		clocks = <&cru HCLK_SDIO1>, <&cru CCLK_SRC_SDIO1>, <&grf_cru 5>, <&grf_cru 6>;
		clock-names = "biu", "ciu", "ciu-drive", "ciu-sample";
		fifo-depth = <256>;
		resets = <&cru SRST_HRESETN_SDIO1>;
		reset-names = "reset";
