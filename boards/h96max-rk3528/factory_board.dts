	otp: otp@ffce0000 {
		compatible = "rockchip,rk3528-otp";
		reg = <0x00 0xffce0000 0x00 0x4000>;
		#address-cells = <1>;
		#size-cells = <1>;
		clocks = <&cru CLK_USER_OTPC_NS>, <&cru CLK_SBPI_OTPC_NS>, <&cru PCLK_OTPC_NS>;
		clock-names = "usr", "sbpi", "apb";
		resets = <&cru SRST_RESETN_USER_OTPC_NS>,
		         <&cru SRST_RESETN_SBPI_OTPC_NS>,
		         <&cru SRST_PRESETN_OTPC_NS>;
		reset-names = "usr", "sbpi", "apb";
		phandle = <0x109>;

		cpu_code: cpu-code@2 {
			reg = <0x02 0x02>;
			phandle = <0x11>;
		};

		otp_cpu_version: cpu-version@8 {
			reg = <0x08 0x01>;
			bits = <3 3>;
			phandle = <0x10>;
		};

		otp_id: id@a {
			reg = <0x0a 0x10>;
			phandle = <0x0f>;
		};

		cpu_leakage: cpu-leakage@1a {
			reg = <0x1a 0x01>;
			phandle = <0x0c>;
		};

		log_leakage: log-leakage@1b {
			reg = <0x1b 0x01>;
			phandle = <0x19>;
		};

		gpu_leakage: gpu-leakage@1c {
			reg = <0x1c 0x01>;
			phandle = <0x29>;
		};

		test_version: test-version@29 {
			reg = <0x29 0x01>;
			phandle = <0x39>;
		};

		macphy_bgs: macphy-bgs@2d {
			reg = <0x2d 0x01>;
			phandle = <0x65>;
		};

		macphy_txlevel: macphy-txlevel@2e {
			reg = <0x2e 0x02>;
			phandle = <0x66>;
		};

		vdac_out_current: vdac-out-current@30 {
			reg = <0x30 0x01>;
			phandle = <0x38>;
		};

		cpu_opp_info: cpu-opp-info@32 {
			reg = <0x32 0x06>;
			phandle = <0x0d>;
		};

		gpu_opp_info: gpu-opp-info@38 {
			reg = <0x38 0x06>;
			phandle = <0x2a>;
		};

		dmc_opp_info: dmc-opp-info@3e {
			reg = <0x3e 0x06>;
			phandle = <0x1a>;
		};
	};

