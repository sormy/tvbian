/dts-v1/;

/* dt-bindings from rockchip-linux/kernel develop-6.1 (77168c8d5ab82399f65a80e9f807b50ba37cf483), include/ */
#include <dt-bindings/clock/rk3528-cru.h>
#include <dt-bindings/power/rk3528-power.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/pinctrl/rockchip.h>
#include <dt-bindings/input/linux-event-codes.h>
#include <dt-bindings/thermal/thermal.h>

/ {
	compatible = "rockchip,rk3528-evb2-ddr3-v10", "rockchip,rk3528";
	interrupt-parent = <&gic>;
	#address-cells = <2>;
	#size-cells = <2>;
	model = "Rockchip RK3528 EVB2 DDR3 V10 Board";

	aliases {
		ethernet0 = "/ethernet@ffbd0000";
		ethernet1 = "/ethernet@ffbe0000";
		gpio0 = "/pinctrl/gpio@ff610000";
		gpio1 = "/pinctrl/gpio@ffaf0000";
		gpio2 = "/pinctrl/gpio@ffb00000";
		gpio3 = "/pinctrl/gpio@ffb10000";
		gpio4 = "/pinctrl/gpio@ffb20000";
		i2c0 = "/i2c@ffa50000";
		i2c1 = "/i2c@ffa58000";
		i2c2 = "/i2c@ffa60000";
		i2c3 = "/i2c@ffa68000";
		i2c4 = "/i2c@ffa70000";
		i2c5 = "/i2c@ffa78000";
		i2c6 = "/i2c@ffa80000";
		i2c7 = "/i2c@ffa88000";
		serial0 = "/serial@ff9f0000";
		serial1 = "/serial@ff9f8000";
		serial2 = "/serial@ffa00000";
		serial3 = "/serial@ffa08000";
		serial4 = "/serial@ffa10000";
		serial5 = "/serial@ffa18000";
		serial6 = "/serial@ffa20000";
		serial7 = "/serial@ffa28000";
		spi0 = "/spi@ff9c0000";
		spi1 = "/spi@ff9d0000";
		spi2 = "/spi@ffc00000";
	};

	clocks {
		compatible = "simple-bus";
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		xin24m: xin24m {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <24000000>;
			clock-output-names = "xin24m";
			phandle = <0x77>;
		};

		mclkin_sai0: mclkin-sai0 {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <0>;
			clock-output-names = "i2s0_mclkin";
			phandle = <0x9b>;
		};

		mclkin_sai1: mclkin-sai1 {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <0>;
			clock-output-names = "i2s1_mclkin";
			phandle = <0x9c>;
		};

		mclkout_sai0: mclkout-sai0@ff340014 {
			compatible = "rockchip,clk-out";
			reg = <0x00 0xff340014 0x00 0x04>;
			clocks = <&cru MCLK_SAI_I2S0>;
			#clock-cells = <0>;
			clock-output-names = "mclk_sai0_to_io";
			rockchip,bit-shift = <1>;
			rockchip,bit-set-to-disable;
			phandle = <0x9d>;
		};

		mclkout_sai1: mclkout-sai1@ff320004 {
			compatible = "rockchip,clk-out";
			reg = <0x00 0xff320004 0x00 0x04>;
			clocks = <&cru MCLK_SAI_I2S1>;
			#clock-cells = <0>;
			clock-output-names = "mclk_sai1_to_io";
			rockchip,bit-shift = <14>;
			rockchip,bit-set-to-disable;
			phandle = <0x9e>;
		};
	};

	cpus {
		#address-cells = <2>;
		#size-cells = <0>;

		cpu-map {

			cluster0 {

				core0 {
					cpu = <&cpu0>;
				};

				core1 {
					cpu = <&cpu1>;
				};

				core2 {
					cpu = <&cpu2>;
				};

				core3 {
					cpu = <&cpu3>;
				};
			};
		};

		cpu0: cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x00 0x00>;
			enable-method = "psci";
			clocks = <&scmi_clk SCMI_CLK_CPU>;
			#cooling-cells = <2>;
			dynamic-power-coefficient = <147>;
			operating-points-v2 = <&cpu0_opp_table>;
			cpu-idle-states = <&CPU_SLEEP0>;
			cpu-supply = <&vdd_cpu>;
			phandle = <0x03>;
		};

		cpu1: cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x00 0x01>;
			enable-method = "psci";
			clocks = <&scmi_clk SCMI_CLK_CPU>;
			operating-points-v2 = <&cpu0_opp_table>;
			cpu-idle-states = <&CPU_SLEEP0>;
			phandle = <0x04>;
		};

		cpu2: cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x00 0x02>;
			enable-method = "psci";
			clocks = <&scmi_clk SCMI_CLK_CPU>;
			operating-points-v2 = <&cpu0_opp_table>;
			cpu-idle-states = <&CPU_SLEEP1>;
			phandle = <0x05>;
		};

		cpu3: cpu@3 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x00 0x03>;
			enable-method = "psci";
			clocks = <&scmi_clk SCMI_CLK_CPU>;
			operating-points-v2 = <&cpu0_opp_table>;
			cpu-idle-states = <&CPU_SLEEP1>;
			phandle = <0x06>;
		};

		idle-states {
			entry-method = "psci";

			CPU_SLEEP0: cpu-sleep0 {
				compatible = "arm,idle-state";
				local-timer-stop;
				arm,psci-suspend-param = <0x10000>;
				entry-latency-us = <120>;
				exit-latency-us = <250>;
				min-residency-us = <900>;
				status = "disabled";
				phandle = <0x09>;
			};

			CPU_SLEEP1: cpu-sleep {
				compatible = "arm,idle-state";
				local-timer-stop;
				arm,psci-suspend-param = <0x10000>;
				entry-latency-us = <120>;
				exit-latency-us = <250>;
				min-residency-us = <900>;
				status = "okay";
				phandle = <0x0b>;
			};
		};
	};

	cpu0_opp_table: cpu0-opp-table {
		compatible = "operating-points-v2";
		opp-shared;
		nvmem-cells = <&cpu_leakage>, <&cpu_opp_info>;
		nvmem-cell-names = "leakage", "opp-info";
		rockchip,video-4k-freq = <1200000>;
		rockchip,pvtm-voltage-sel = <0 1320 0 1321 1350 1 1351 1375 2 1376 1405 3 1406 1435 4 1436 1470 5 1471 1505 6 1506 1540 7 1541 1575 8 1576 1610 9 1611 1640 10 1641 9999 11>;
		rockchip,pvtm-pvtpll;
		rockchip,pvtm-offset = <0x18>;
		rockchip,pvtm-sample-time = <1100>;
		rockchip,pvtm-freq = <1608000>;
		rockchip,pvtm-volt = <900000>;
		rockchip,pvtm-ref-temp = <40>;
		rockchip,pvtm-temp-prop = <0x00 0x00>;
		rockchip,pvtm-thermal-zone = "soc-thermal";
		rockchip,grf = <&grf>;
		phandle = <0x08>;

		opp-408000000 {
			opp-hz = /bits/ 64 <408000000>;
			opp-microvolt = <825000 825000 1100000>;
			opp-microvolt-L0 = <862500 862500 1100000>;
			opp-microvolt-L1 = <862500 862500 1100000>;
			opp-microvolt-L2 = <862500 862500 1100000>;
			opp-microvolt-L3 = <862500 862500 1100000>;
			opp-microvolt-L4 = <862500 862500 1100000>;
			opp-microvolt-L5 = <837500 837500 1100000>;
			clock-latency-ns = <40000>;
			opp-suspend;
		};

		opp-600000000 {
			opp-hz = /bits/ 64 <600000000>;
			opp-microvolt = <825000 825000 1100000>;
			opp-microvolt-L0 = <862500 862500 1100000>;
			opp-microvolt-L1 = <862500 862500 1100000>;
			opp-microvolt-L2 = <862500 862500 1100000>;
			opp-microvolt-L3 = <862500 862500 1100000>;
			opp-microvolt-L4 = <862500 862500 1100000>;
			opp-microvolt-L5 = <837500 837500 1100000>;
			clock-latency-ns = <40000>;
		};

		opp-816000000 {
			opp-hz = /bits/ 64 <816000000>;
			opp-microvolt = <825000 825000 1100000>;
			opp-microvolt-L0 = <862500 862500 1100000>;
			opp-microvolt-L1 = <862500 862500 1100000>;
			opp-microvolt-L2 = <862500 862500 1100000>;
			opp-microvolt-L3 = <862500 862500 1100000>;
			opp-microvolt-L4 = <862500 862500 1100000>;
			opp-microvolt-L5 = <837500 837500 1100000>;
			clock-latency-ns = <40000>;
		};

		opp-1008000000 {
			opp-hz = /bits/ 64 <1008000000>;
			opp-microvolt = <825000 825000 1100000>;
			opp-microvolt-L0 = <862500 862500 1100000>;
			opp-microvolt-L1 = <862500 862500 1100000>;
			opp-microvolt-L2 = <862500 862500 1100000>;
			opp-microvolt-L3 = <862500 862500 1100000>;
			opp-microvolt-L4 = <862500 862500 1100000>;
			opp-microvolt-L5 = <837500 837500 1100000>;
			clock-latency-ns = <40000>;
		};

		opp-1200000000 {
			opp-hz = /bits/ 64 <1200000000>;
			opp-microvolt = <825000 825000 1100000>;
			opp-microvolt-L0 = <900000 900000 1100000>;
			opp-microvolt-L1 = <887500 887500 1100000>;
			opp-microvolt-L2 = <875000 875000 1100000>;
			opp-microvolt-L3 = <875000 875000 1100000>;
			opp-microvolt-L4 = <862500 862500 1100000>;
			opp-microvolt-L5 = <850000 850000 1100000>;
			opp-microvolt-L6 = <837500 837500 1100000>;
			clock-latency-ns = <40000>;
		};

		opp-1416000000 {
			opp-hz = /bits/ 64 <1416000000>;
			opp-microvolt = <962500 962500 1100000>;
			opp-microvolt-L1 = <950000 950000 1100000>;
			opp-microvolt-L2 = <950000 950000 1100000>;
			opp-microvolt-L3 = <937500 937500 1100000>;
			opp-microvolt-L4 = <925000 925000 1100000>;
			opp-microvolt-L5 = <912500 912500 1100000>;
			opp-microvolt-L6 = <900000 900000 1100000>;
			opp-microvolt-L7 = <887500 887000 1100000>;
			opp-microvolt-L8 = <875000 875000 1100000>;
			opp-microvolt-L9 = <862500 862500 1100000>;
			opp-microvolt-L10 = <850000 850000 1100000>;
			opp-microvolt-L11 = <850000 850000 1100000>;
			clock-latency-ns = <40000>;
		};

		opp-1608000000 {
			opp-hz = /bits/ 64 <1608000000>;
			opp-microvolt = <1012500 1012500 1100000>;
			opp-microvolt-L2 = <1000000 1000000 1100000>;
			opp-microvolt-L3 = <987500 987500 1100000>;
			opp-microvolt-L4 = <975000 975000 1100000>;
			opp-microvolt-L5 = <962500 962500 1100000>;
			opp-microvolt-L6 = <950000 950000 1100000>;
			opp-microvolt-L7 = <937500 937500 1100000>;
			opp-microvolt-L8 = <925000 925000 1100000>;
			opp-microvolt-L9 = <912500 912500 1100000>;
			opp-microvolt-L10 = <900000 900000 1100000>;
			opp-microvolt-L11 = <887500 887500 1100000>;
			clock-latency-ns = <40000>;
		};

		opp-1800000000 {
			opp-hz = /bits/ 64 <1800000000>;
			opp-microvolt = <1062500 1062500 1100000>;
			opp-microvolt-L1 = <1050000 1050000 1100000>;
			opp-microvolt-L2 = <1037500 1037500 1100000>;
			opp-microvolt-L3 = <1025000 1025000 1100000>;
			opp-microvolt-L4 = <1012500 1012500 1100000>;
			opp-microvolt-L5 = <1000000 1000000 1100000>;
			opp-microvolt-L6 = <987500 987500 1100000>;
			opp-microvolt-L7 = <975000 975000 1100000>;
			opp-microvolt-L8 = <962500 962500 1100000>;
			opp-microvolt-L9 = <950000 950000 1100000>;
			opp-microvolt-L10 = <937500 937500 1100000>;
			opp-microvolt-L11 = <925000 925000 1100000>;
			clock-latency-ns = <40000>;
		};

		opp-2016000000 {
			opp-hz = /bits/ 64 <2016000000>;
			opp-microvolt = <1100000 1100000 1100000>;
			opp-microvolt-L1 = <1087500 1087500 1100000>;
			opp-microvolt-L2 = <1075000 1075000 1100000>;
			opp-microvolt-L3 = <1062500 1062500 1100000>;
			opp-microvolt-L4 = <1050000 1050000 1100000>;
			opp-microvolt-L5 = <1037500 1037500 1100000>;
			opp-microvolt-L6 = <1025000 1025000 1100000>;
			opp-microvolt-L7 = <1012500 1012500 1100000>;
			opp-microvolt-L8 = <1000000 1000000 1100000>;
			opp-microvolt-L9 = <987500 987500 1100000>;
			opp-microvolt-L10 = <975000 975000 1100000>;
			opp-microvolt-L11 = <962500 962500 1100000>;
			clock-latency-ns = <40000>;
		};
	};

	arm-pmu {
		compatible = "arm,cortex-a53-pmu";
		interrupts = <GIC_SPI 171 IRQ_TYPE_LEVEL_HIGH>,
		             <GIC_SPI 172 IRQ_TYPE_LEVEL_HIGH>,
		             <GIC_SPI 173 IRQ_TYPE_LEVEL_HIGH>,
		             <GIC_SPI 174 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-affinity = <&cpu0>, <&cpu1>, <&cpu2>, <&cpu3>;
	};

	cpuinfo {
		compatible = "rockchip,cpuinfo";
		nvmem-cells = <&otp_id>, <&otp_cpu_version>, <&cpu_code>;
		nvmem-cell-names = "id", "cpu-version", "cpu-code";
	};

	display_subsystem: display-subsystem {
		compatible = "rockchip,display-subsystem";
		ports = <&vop_out>;
		status = "okay";
		memory-region = <&drm_logo>, <&drm_cubic_lut>;
		memory-region-names = "drm-logo", "drm-cubic-lut";
		phandle = <0x9f>;

		route {

			route_hdmi: route-hdmi {
				status = "okay";
				logo,uboot = "logo.bmp";
				logo,mode = "fullscreen";
				charge_logo,mode = "center";
				connect = <&vp0_out_hdmi>;
				phandle = <0xa0>;
			};

			route_tve: route-tve {
				status = "okay";
				logo,uboot = "logo.bmp";
				logo,mode = "fullscreen";
				charge_logo,mode = "center";
				connect = <&vp1_out_tve>;
				phandle = <0xa1>;
			};
		};
	};

	dmc: dmc {
		compatible = "rockchip,rk3528-dmc";
		clocks = <&scmi_clk SCMI_CLK_DDR>;
		clock-names = "dmc_clk";
		operating-points-v2 = <&dmc_opp_table>;
		status = "okay";
		center-supply = <&vdd_logic>;
		phandle = <0xa2>;
	};

	dmc_opp_table: dmc-opp-table {
		compatible = "operating-points-v2";
		nvmem-cells = <&log_leakage>, <&dmc_opp_info>;
		nvmem-cell-names = "leakage", "opp-info";
		rockchip,temp-hysteresis = <5000>;
		rockchip,low-temp = <10000>;
		rockchip,low-temp-min-volt = <900000>;
		rockchip,leakage-voltage-sel = <1 10 0 11 14 1 15 22 2 23 28 3 29 254 4>;
		phandle = <0x17>;

		opp-920000000 {
			opp-hz = /bits/ 64 <920000000>;
			opp-microvolt = <850000 850000 1000000>;
		};

		opp-1056000000 {
			opp-hz = /bits/ 64 <1056000000>;
			opp-microvolt = <850000 850000 1000000>;
			opp-microvolt-L0 = <875000 875000 1000000>;
			opp-microvolt-L1 = <850000 850000 1000000>;
			opp-microvolt-L2 = <850000 850000 1000000>;
			opp-microvolt-L3 = <850000 850000 1000000>;
			opp-microvolt-L4 = <850000 850000 1000000>;
		};

		opp-1184000000 {
			opp-hz = /bits/ 64 <1184000000>;
			opp-microvolt = <900000 900000 1000000>;
			opp-microvolt-L0 = <950000 950000 1000000>;
			opp-microvolt-L1 = <925000 925000 1000000>;
			opp-microvolt-L2 = <900000 900000 1000000>;
			opp-microvolt-L3 = <875000 875000 1000000>;
			opp-microvolt-L4 = <862500 862500 1000000>;
			status = "disabled";
		};
	};

	firmware {

		scmi: scmi {
			compatible = "arm,scmi-smc";
			shmem = <&scmi_shmem>;
			arm,smc-id = <0x82000010>;
			#address-cells = <1>;
			#size-cells = <0>;
			phandle = <0xa3>;

			scmi_clk: protocol@14 {
				reg = <0x14>;
				#clock-cells = <1>;
				assigned-clocks = <&scmi_clk SCMI_CLK_CPU>;
				assigned-clock-rates = <1200000000>;
				phandle = <0x07>;
			};
		};

		optee {
			compatible = "linaro,optee-tz";
			method = "smc";
		};
	};

	mpp_srv: mpp-srv {
		compatible = "rockchip,mpp-service";
		rockchip,taskqueue-count = <5>;
		rockchip,resetgroup-count = <5>;
		status = "okay";
		phandle = <0x2d>;
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	rkvtunnel: rkvtunnel {
		compatible = "rockchip,video-tunnel";
		status = "okay";
		phandle = <0xa4>;
	};

	rockchip_suspend: rockchip-suspend {
		compatible = "rockchip,pm-rk3528";
		status = "okay";
		rockchip,sleep-debug-en = <0x01>;
		rockchip,sleep-mode-config = <0x01>;
		rockchip,wakeup-config = <0x11>;
		rockchip,virtual-poweroff = <0x01>;
		rockchip,pwm-regulator-config = <0x03>;
		phandle = <0xa5>;
	};

	rockchip_system_monitor: rockchip-system-monitor {
		compatible = "rockchip,system-monitor";
		rockchip,thermal-zone = "soc-thermal";
		rockchip,polling-delay = <200>;
		rockchip,temp-hysteresis = <5000>;
		rockchip,offline-cpu-temp = <105000>;
		rockchip,temp-offline-cpus = "2-3";
		phandle = <0xa6>;
	};

	thermal_zones: thermal-zones {
		phandle = <0xa7>;

		soc_thermal: soc-thermal {
			polling-delay-passive = <20>;
			polling-delay = <1000>;
			sustainable-power = <638>;
			thermal-sensors = <&tsadc 0>;
			phandle = <0xa8>;

			trips {

				threshold: trip-point-0 {
					temperature = <95000>;
					hysteresis = <2000>;
					type = "passive";
					phandle = <0xa9>;
				};

				target: trip-point-1 {
					temperature = <110000>;
					hysteresis = <2000>;
					type = "passive";
					phandle = <0x1d>;
				};

				soc_crit: soc-crit {
					temperature = <120000>;
					hysteresis = <2000>;
					type = "critical";
					phandle = <0xaa>;
				};
			};

			cooling-maps {

				map0 {
					trip = <&target>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
					contribution = <1024>;
				};

				map1 {
					trip = <&target>;
					cooling-device = <&gpu THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
					contribution = <1024>;
				};
			};
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupts = <GIC_PPI 13 (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_LOW)>,
		             <GIC_PPI 14 (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_LOW)>,
		             <GIC_PPI 11 (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_LOW)>,
		             <GIC_PPI 10 (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_LOW)>;
	};

	scmi_shmem: scmi-shmem@10f000 {
		compatible = "arm,scmi-shmem";
		reg = <0x00 0x10f000 0x00 0x100>;
		phandle = <0x1b>;
	};

	sram: sram@fe480000 {
		compatible = "mmio-sram";
		reg = <0x00 0xfe480000 0x00 0xc000>;
		#address-cells = <1>;
		#size-cells = <1>;
		ranges = <0x00 0x00 0xfe480000 0xc000>;
		phandle = <0xab>;

		rkvdec_sram: rkvdec-sram@0 {
			reg = <0x00 0xc000>;
			phandle = <0x2e>;
		};
	};

	pcie2x1: pcie@fe4f0000 {
		compatible = "rockchip,rk3528-pcie", "snps,dw-pcie";
		#address-cells = <3>;
		#size-cells = <2>;
		bus-range = <0x00 0xff>;
		clocks = <&cru ACLK_PCIE>,
		         <&cru HCLK_PCIE_SLV>,
		         <&cru HCLK_PCIE_DBI>,
		         <&cru PCLK_CRU_PCIE>,
		         <&cru CLK_PCIE_AUX>,
		         <&cru PCLK_PCIE>,
		         <&cru PCLK_PCIE_PHY>;
		clock-names = "aclk", "hclk_slv", "hclk_dbi", "pclk_cru", "aux", "pclk", "pipe";
		device_type = "pci";
		interrupts = <GIC_SPI 158 IRQ_TYPE_LEVEL_HIGH>,
		             <GIC_SPI 157 IRQ_TYPE_LEVEL_HIGH>,
		             <GIC_SPI 156 IRQ_TYPE_LEVEL_HIGH>,
		             <GIC_SPI 155 IRQ_TYPE_LEVEL_HIGH>,
		             <GIC_SPI 154 IRQ_TYPE_LEVEL_HIGH>,
		             <GIC_SPI 153 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "msi", "pmc", "sys", "legacy", "msg", "err";
		#interrupt-cells = <1>;
		interrupt-map-mask = <0x00 0x00 0x00 0x07>;
		interrupt-map = <0x00 0x00 0x00 0x01 0x1f 0x00 0x00 0x00 0x00 0x02 0x1f 0x01 0x00 0x00 0x00 0x03 0x1f 0x02 0x00 0x00 0x00 0x04 0x1f 0x03>;
		linux,pci-domain = <0x00>;
		num-ib-windows = <0x08>;
		num-ob-windows = <0x08>;
		num-viewport = <0x04>;
		max-link-speed = <0x02>;
		num-lanes = <0x01>;
		phys = <&combphy_pu 2>;
		phy-names = "pcie-phy";
		ranges = <0x800 0x00 0xfc000000 0x00 0xfc000000 0x00 0x100000 0x81000000 0x00 0xfc100000 0x00 0xfc100000 0x00 0x100000 0x82000000 0x00 0xfc200000 0x00 0xfc200000 0x00 0x1e00000 0xc3000000 0x01 0x00 0x01 0x00 0x00 0x40000000>;
		reg = <0x00 0xfe4f0000 0x00 0x10000>, <0x01 0x40000000 0x00 0x400000>;
		reg-names = "pcie-apb", "pcie-dbi";
		resets = <&cru SRST_RESETN_PCIE_POWER_UP>,
		         <&cru SRST_PRESETN_PCIE>,
		         <&cru SRST_PRESETN_CRU_PCIE>;
		reset-names = "pcie", "periph", "preset_cru";
		status = "disabled";
		phandle = <0xac>;

		pcie2x1_intc: legacy-interrupt-controller {
			interrupt-controller;
			#address-cells = <0>;
			#interrupt-cells = <1>;
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 155 IRQ_TYPE_EDGE_RISING>;
			phandle = <0x1f>;
		};
	};

	usbdrd30: usbdrd {
		compatible = "rockchip,rk3528-dwc3", "rockchip,rk3399-dwc3";
		clocks = <&cru CLK_REF_USB3OTG>, <&cru CLK_SUSPEND_USB3OTG>, <&cru ACLK_USB3OTG>;
		clock-names = "ref_clk", "suspend_clk", "bus_clk";
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		status = "okay";
		phandle = <0xad>;

		usbdrd_dwc3: dwc3@fe500000 {
			compatible = "snps,dwc3";
			reg = <0x00 0xfe500000 0x00 0x400000>;
			interrupts = <GIC_SPI 152 IRQ_TYPE_LEVEL_HIGH>;
			dr_mode = "host";
			phys = <&u2phy_otg>;
			phy-names = "usb2-phy";
			phy_type = "utmi_wide";
			resets = <&cru SRST_ARESETN_USB3OTG>;
			reset-names = "usb3-otg";
			snps,dis_enblslpm_quirk;
			snps,dis-u1u2-quirk;
			snps,dis-u2-freeclk-exists-quirk;
			snps,dis-del-phy-power-chg-quirk;
			snps,dis-tx-ipgap-linecheck-quirk;
			snps,xhci-trb-ent-quirk;
			snps,dis_rxdet_inp3_quirk;
			quirk-skip-phy-init;
			status = "okay";
			extcon = <&usb2phy>;
			maximum-speed = "high-speed";
			snps,dis_u2_susphy_quirk;
			snps,usb2-lpm-disable;
			phandle = <0xae>;
		};
	};

	gic: interrupt-controller@fed01000 {
		compatible = "arm,gic-400";
		#interrupt-cells = <3>;
		#address-cells = <0>;
		interrupt-controller;
		reg = <0x00 0xfed01000 0x00 0x1000 0x00 0xfed02000 0x00 0x2000 0x00 0xfed04000 0x00 0x2000 0x00 0xfed06000 0x00 0x2000>;
		interrupts = <GIC_PPI 9 (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_LOW)>;
		phandle = <0x01>;
	};

	usb_host0_ehci: usb@ff100000 {
		compatible = "generic-ehci";
		reg = <0x00 0xff100000 0x00 0x40000>;
		interrupts = <GIC_SPI 143 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&cru HCLK_USBHOST>, <&cru HCLK_USBHOST_ARB>, <&usb2phy>;
		clock-names = "usbhost", "arbiter", "utmi";
		phys = <&u2phy_host>;
		phy-names = "usb2-phy";
		status = "okay";
		phandle = <0xaf>;
	};

	usb_host0_ohci: usb@ff140000 {
		compatible = "generic-ohci";
		reg = <0x00 0xff140000 0x00 0x40000>;
		interrupts = <GIC_SPI 144 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&cru HCLK_USBHOST>, <&cru HCLK_USBHOST_ARB>, <&usb2phy>;
		clock-names = "usbhost", "arbiter", "utmi";
		phys = <&u2phy_host>;
		phy-names = "usb2-phy";
		status = "okay";
		phandle = <0xb0>;
	};

