&hdmi {
	pinctrl-names = "default";
	pinctrl-0 = <&hdmi_pins>;
	hpd-gpios = <&gpio0 RK_PA2 GPIO_ACTIVE_HIGH>;
	ddc-i2c-bus = <&i2c2>;
	status = "okay";
};

&hdmi_pins {
	rockchip,pins = <0 RK_PA3 1 &pcfg_pull_none>;
};

&hdmiphy {
	status = "okay";
};

&i2c2 {
	pinctrl-0 = <&i2c2m0_xfer>;
	status = "okay";
};

&iep {
	status = "okay";
};

&iep_mmu {
	status = "okay";
};

&jpegd {
	status = "okay";
};

&jpegd_mmu {
	status = "okay";
};

&otp {
	log_leakage: log-leakage@1b {
		reg = <0x1b 0x01>;
	};

	macphy_bgs: macphy-bgs@2d {
		reg = <0x2d 0x01>;
	};

	cpu_opp_info: cpu-opp-info@32 {
		reg = <0x32 0x06>;
	};

	gpu_opp_info: gpu-opp-info@38 {
		reg = <0x38 0x06>;
	};

	dmc_opp_info: dmc-opp-info@3e {
		reg = <0x3e 0x06>;
	};
};

&pinctrl {
	pwm3 {
		ir_rx_gpio: ir-rx-gpio {
			rockchip,pins = <4 RK_PC6 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	pcfg_output_high_pull_up: pcfg-output-high-pull-up {
		output-high;
		bias-pull-up;
	};

	pcfg_output_high_pull_down: pcfg-output-high-pull-down {
		output-high;
		bias-pull-down;
	};

	pcfg_output_high_pull_none: pcfg-output-high-pull-none {
		output-high;
		bias-disable;
	};

	pcfg_output_low_pull_up: pcfg-output-low-pull-up {
		output-low;
		bias-pull-up;
	};

	pcfg_output_low_pull_down: pcfg-output-low-pull-down {
		output-low;
		bias-pull-down;
	};

	pcfg_output_low_pull_none: pcfg-output-low-pull-none {
		output-low;
		bias-disable;
	};

	usb {
		vcc5v0_host_en: vcc5v0-host-en-pins {
			rockchip,pins = <4 RK_PB5 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		vcc5v0_otg_en: vcc5v0-otg-en-pins {
			rockchip,pins = <4 RK_PC1 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	sdio-pwrseq {
		wifi_enable_h: wifi-enable-h-pins {
			rockchip,pins = <4 RK_PA4 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};

&power {
	power-domain@5 {
		status = "okay";
	};
};

&pwm2 {
	pinctrl-names = "default";
	pinctrl-0 = <&pwm2m0_pins>;
	status = "okay";
};

&pwm4 {
	pinctrl-names = "default";
	pinctrl-0 = <&pwm4m0_pins>;
	status = "okay";
};

&pwm7 {
	pinctrl-names = "default";
	pinctrl-0 = <&pwm7m0_pins>;
	status = "okay";
};

&rga {
	status = "okay";
};

&rga_mmu {
	status = "okay";
};

&rkvenc {
	status = "okay";
};

&rkvenc_mmu {
	status = "okay";
};

&sai2 {
	status = "okay";
};

&sai3 {
	status = "okay";
};

&saradc {
	vref-supply = <&vdd_1v8_s3>;
	status = "okay";
};

&sdhci {
	bus-width = <8>;
	no-sd;
	no-sdio;
	non-removable;
	mmc-hs400-1_8v;
	mmc-hs400-enhanced-strobe;
	status = "okay";
};

&sdio0 {
	pinctrl-0 = <&sdio0_bus4>, <&sdio0_cmd>, <&sdio0_clk>;
	no-sd;
	no-mmc;
	bus-width = <4>;
	disable-wp;
	cap-sd-highspeed;
	cap-sdio-irq;
	keep-power-in-suspend;
	non-removable;
	mmc-pwrseq = <&sdio_pwrseq>;
	sd-uhs-sdr104;
	status = "okay";
};

&sdmmc {
	pinctrl-0 = <&sdmmc_clk>, <&sdmmc_cmd>, <&sdmmc_det>, <&sdmmc_bus4>;
	bus-width = <4>;
	cap-mmc-highspeed;
	cap-sd-highspeed;
	disable-wp;
	sd-uhs-sdr12;
	sd-uhs-sdr25;
	sd-uhs-sdr50;
	sd-uhs-sdr104;
	vqmmc-supply = <&vccio_sd>;
	vmmc-supply = <&vcc_sd>;
	status = "okay";
};

&spdif {
	status = "okay";
};

&tsadc {
	status = "okay";
};

&tve {
	status = "okay";
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0m0_xfer>;
	status = "okay";
};

&uart2 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart2m1_xfer>, <&uart2m1_ctsn>, <&uart2m1_rtsn>;
	status = "okay";

	bluetooth {
		compatible = "aicsemi,aic8800-bt"; /* the AIC8800's Bluetooth half */
		max-speed = <1500000>;
		reset-gpios = <&gpio1 RK_PC1 GPIO_ACTIVE_LOW>;
		device-wakeup-gpios = <&gpio1 RK_PB4 GPIO_ACTIVE_HIGH>;
	};
};

&usb2phy {
	status = "okay";
};

&usb2phy_host {
	phy-supply = <&vcc5v0_host>;
	status = "okay";
};

&usb2phy_otg {
	phy-supply = <&vcc5v0_otg>;
	status = "okay";
};

&usb_host0_ehci {
	status = "okay";
};

&usb_host0_ohci {
	status = "okay";
};

&usb_host0_xhci {
	dr_mode = "host";
	phys = <&usb2phy_otg>;
	phy-names = "usb2-phy";
	snps,dis-u1u2-quirk;
	maximum-speed = "high-speed";
	snps,usb2-lpm-disable;
	status = "okay";
};

/*
 * No power-domains on purpose.  rk3528.dtsi leaves
 * power-domain@RK3528_PD_RKVDEC disabled, so referencing it makes both
 * devices fail with deferred probe timeouts.  The vendor DTB does not
 * use a power domain here either: the RK3528 vdec domain is defined with
 * a zero power mask, i.e. bus idle handshake only, permanently powered.
 */
&vdec {
	status = "okay";
};

/*
 * The vendor DTB uses the BSP-only "rockchip,iommu-v2"; mainline reaches
 * the same v2 ops through "rockchip,rk3568-iommu".
 */
&vdec_mmu {
	status = "okay";
};

&vdpp {
	status = "okay";
};

&vdpu_mmu {
	status = "okay";
};

&vop {
	esmart_lb_mode = [02]; /* Esmart0 a 4K line buffer for HDMI */
	status = "okay";
};

&vop_mmu {
	status = "okay";
};

/* VDPU2, as on RK3568: MPEG-2, VP8 and H.264 behind the decoder at +0x400. */
&vpu {
	status = "okay";
};

&wdt {
	status = "okay";
};
