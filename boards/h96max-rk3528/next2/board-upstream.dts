 *   patches/linux-rockchip-mainline/dt-bindings-rockchip-iommu-dlr.patch:
 *     rockchip,disable-device-link-resume
 *   patches/linux-rockchip-mainline/dt-bindings-rockchip-grf-rk3528-pmu.patch:
 *     "rockchip,rk3528-pmu-grf"
 *   patches/linux-rockchip-mainline/dt-bindings-rk3528-gpu-grf.patch:
 *     "rockchip,rk3528-gpu-grf"
