		cru: clock-controller@ff4a0000 {
			compatible = "rockchip,rk3528-cru";
			reg = <0x0 0xff4a0000 0x0 0x30000>;
			assigned-clocks =
				<&cru XIN_OSC0_DIV>, <&cru PLL_GPLL>,
				<&cru PLL_PPLL>, <&cru PLL_CPLL>,
				<&cru ARMCLK>, <&cru CLK_MATRIX_250M_SRC>,
				<&cru CLK_MATRIX_500M_SRC>,
				<&cru CLK_MATRIX_50M_SRC>,
				<&cru CLK_MATRIX_100M_SRC>,
				<&cru CLK_MATRIX_150M_SRC>,
				<&cru CLK_MATRIX_200M_SRC>,
				<&cru CLK_MATRIX_300M_SRC>,
				<&cru CLK_MATRIX_339M_SRC>,
				<&cru CLK_MATRIX_400M_SRC>,
				<&cru CLK_MATRIX_600M_SRC>,
				<&cru CLK_PPLL_50M_MATRIX>,
				<&cru CLK_PPLL_100M_MATRIX>,
				<&cru CLK_PPLL_125M_MATRIX>,
				<&cru ACLK_BUS_VOPGL_ROOT>;
			assigned-clock-rates =
				<32768>, <1188000000>,
				<1000000000>, <996000000>,
				<408000000>, <250000000>,
				<500000000>,
				<50000000>,
				<100000000>,
				<150000000>,
				<200000000>,
				<300000000>,
				<340000000>,
				<400000000>,
				<600000000>,
				<50000000>,
				<100000000>,
				<125000000>,
				<500000000>;
			clocks = <&xin24m>, <&gmac0_clk>;
			clock-names = "xin24m", "gmac0";
			#clock-cells = <1>;
			#reset-cells = <1>;
		};

		ioc_grf: syscon@ff540000 {
			compatible = "rockchip,rk3528-ioc-grf", "syscon";
			reg = <0x0 0xff540000 0x0 0x40000>;
		};

		pmu: power-management@ff600000 {
			compatible = "rockchip,rk3528-pmu", "syscon", "simple-mfd";
			reg = <0x0 0xff600000 0x0 0x2000>;

			power: power-controller {
				compatible = "rockchip,rk3528-power-controller";
				#power-domain-cells = <1>;
				#address-cells = <1>;
				#size-cells = <0>;

				power-domain@4 {
					reg = <RK3528_PD_GPU>;
					clocks = <&cru ACLK_GPU_MALI>,
						 <&cru PCLK_GPU_ROOT>;
					pm_qos = <&qos_gpu_m0>,
						 <&qos_gpu_m1>;
					#power-domain-cells = <0>;
				};

				power-domain@5 {
					reg = <RK3528_PD_RKVDEC>;
					pm_qos = <&qos_rkvdec>;
					#power-domain-cells = <0>;
					status = "okay";
				};

				power-domain@6 {
					reg = <RK3528_PD_RKVENC>;
					pm_qos = <&qos_rkvenc>;
					#power-domain-cells = <0>;
				};

				power-domain@7 {
					reg = <RK3528_PD_VO>;
					pm_qos = <&qos_gmac0>,
						 <&qos_hdcp>,
						 <&qos_jpegdec>,
						 <&qos_rga2_m0ro>,
						 <&qos_rga2_m0wo>,
						 <&qos_sdmmc0>,
						 <&qos_usb2host>,
						 <&qos_vdpp>,
						 <&qos_vop>;
					#power-domain-cells = <0>;
				};

				power-domain@8 {
					reg = <RK3528_PD_VPU>;
					pm_qos = <&qos_emmc>,
						 <&qos_fspi>,
						 <&qos_gmac1>,
						 <&qos_pcie>,
						 <&qos_sdio0>,
						 <&qos_sdio1>,
						 <&qos_tsp>,
						 <&qos_usb3otg>,
						 <&qos_vpu>;
					#power-domain-cells = <0>;
				};
			};
		};

		gpu: gpu@ff700000 {
			compatible = "rockchip,rk3528-mali", "arm,mali-450";
			reg = <0x0 0xff700000 0x0 0x40000>;
			assigned-clocks = <&cru ACLK_GPU_MALI>,
					  <&scmi_clk SCMI_CLK_GPU>;
			assigned-clock-rates = <498000000>, <300000000>;
			clocks = <&cru ACLK_GPU_MALI>, <&scmi_clk SCMI_CLK_GPU>;
			clock-names = "bus", "core";
			interrupts = <GIC_SPI 88 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 89 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 86 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 92 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 93 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 90 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 91 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "gp",
					  "gpmmu",
					  "pp",
					  "pp0",
					  "ppmmu0",
					  "pp1",
					  "ppmmu1";
			power-domains = <&power RK3528_PD_GPU>;
			resets = <&cru SRST_A_GPU>;
			operating-points-v2 = <&gpu_opp_table>;
			#cooling-cells = <2>;
			status = "okay";
			mali-supply = <&vdd_gpu>;
			dynamic-power-coefficient = <724>;
		};

		vop: vop@ff840000 {
			compatible = "rockchip,rk3528-vop";
			reg = <0x0 0xff840000 0x0 0x3000>;
			reg-names = "vop";
			interrupts = <GIC_SPI 109 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru ACLK_VOP>, <&cru HCLK_VOP>, <&cru DCLK_VOP0>,
			 <&cru DCLK_VOP1>;
			clock-names = "aclk", "hclk", "dclk_vp0", "dclk_vp1";
			assigned-clocks = <&cru DCLK_VOP0>;
			assigned-clock-parents = <&hdmiphy>;
			iommus = <&vop_mmu>;
			power-domains = <&power RK3528_PD_VO>;
			resets = <&cru SRST_A_VOP>, <&cru SRST_H_VOP>,
			 <&cru SRST_D_VOP0>, <&cru SRST_D_VOP1>;
			status = "okay";

			vop_out: ports {
				#address-cells = <1>;
				#size-cells = <0>;

				vp0: port@0 {
					reg = <0>;
					#address-cells = <1>;
					#size-cells = <0>;

					vp0_out_hdmi: endpoint@2 {
						reg = <ROCKCHIP_VOP2_EP_HDMI0>;
						remote-endpoint = <&hdmi_in_vp0>;
					};
				};

				vp1: port@1 {
					reg = <1>;
					#address-cells = <1>;
					#size-cells = <0>;

					vp1_out_tve: endpoint@ROCKCHIP_VOP2_EP_RGB0 {
						reg = <ROCKCHIP_VOP2_EP_RGB0>;
						remote-endpoint = <&tve_in_vp1>;
					};
				};
			};
		};

		hdmi: hdmi@ff8d0000 {
			compatible = "rockchip,rk3528-dw-hdmi";
			reg = <0x0 0xff8d0000 0x0 0x20000>;
			interrupts = <GIC_SPI 102 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru PCLK_HDMI>, <&cru CLK_SFR_HDMI>, <&cru CLK_CEC_HDMI>;
			clock-names = "iahb", "isfr", "cec";
			phys = <&hdmiphy>;
			phy-names = "hdmi";
			power-domains = <&power RK3528_PD_VO>;
			reg-io-width = <4>;
			rockchip,grf = <&vo_grf>;
			pinctrl-names = "default";
			pinctrl-0 = <&hdmi_pins>;
			#sound-dai-cells = <0>;
			hpd-gpios = <&gpio0 RK_PA2 GPIO_ACTIVE_HIGH>;
			status = "okay";
			ddc-i2c-bus = <&i2c2>;

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				hdmi_in: port@0 {
					reg = <0>;

					hdmi_in_vp0: endpoint {
						remote-endpoint = <&vp0_out_hdmi>;
					};
				};

				hdmi_out: port@1 {
					reg = <1>;
				};
			};
		};

		spi0: spi@ff9c0000 {
			compatible = "rockchip,rk3528-spi",
				     "rockchip,rk3066-spi";
			reg = <0x0 0xff9c0000 0x0 0x1000>;
			clocks = <&cru CLK_SPI0>, <&cru PCLK_SPI0>;
			clock-names = "spiclk", "apb_pclk";
			interrupts = <GIC_SPI 131 IRQ_TYPE_LEVEL_HIGH>;
			dmas = <&dmac 25>, <&dmac 24>;
			dma-names = "tx", "rx";
			power-domains = <&power RK3528_PD_RKVENC>;
			#address-cells = <1>;
			#size-cells = <0>;
			pinctrl-names = "default";
			pinctrl-0 = <&spi0_csn0>, <&spi0_csn1>, <&spi0_pins>;
			status = "disabled";
