		i2c1: i2c@ffa58000 {
			compatible = "rockchip,rk3528-i2c",
				     "rockchip,rk3399-i2c";
			reg = <0x0 0xffa58000 0x0 0x1000>;
			clocks = <&cru CLK_I2C1>, <&cru PCLK_I2C1>;
