		i2c0: i2c@ffa50000 {
			compatible = "rockchip,rk3528-i2c",
				     "rockchip,rk3399-i2c";
			reg = <0x0 0xffa50000 0x0 0x1000>;
			clocks = <&cru CLK_I2C0>, <&cru PCLK_I2C0>;
			clock-names = "i2c", "pclk";
			interrupts = <GIC_SPI 61 IRQ_TYPE_LEVEL_HIGH>;
			power-domains = <&power RK3528_PD_RKVENC>;
