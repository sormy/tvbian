	acodec_sound: acodec-sound {
		compatible = "simple-audio-card";
		status = "okay";
		simple-audio-card,name = "rk3528-acodec";
		simple-audio-card,format = "i2s";
		simple-audio-card,mclk-fs = <256>;

		simple-audio-card,cpu {
			sound-dai = <&sai2>;
		};

		simple-audio-card,codec {
			sound-dai = <&acodec>;
		};
	};

	adc_keys: adc-keys {
		compatible = "adc-keys";
		status = "okay";
		io-channels = <&saradc 1>;
		io-channel-names = "buttons";
		keyup-threshold-microvolt = <1800000>;
		poll-interval = <100>;

		button-recovery {
			press-threshold-microvolt = <1750>;
			linux,code = <KEY_VENDOR>;
			label = "recovery";
		};
	};

	dc_12v: dc-12v {
		compatible = "regulator-fixed";
		regulator-name = "dc_12v";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <12000000>;
		regulator-max-microvolt = <12000000>;
	};

	leds: gpio-leds {
		compatible = "gpio-leds";

		pwr-wifi {
			gpios = <&gpio1 RK_PA6 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "none";
			default-state = "on";
		};
	};

	spdif-sound {
		compatible = "simple-audio-card";
		status = "okay";
		simple-audio-card,name = "ROCKCHIP,SPDIF";
		simple-audio-card,mclk-fs = <128>;

		simple-audio-card,cpu {
			sound-dai = <&spdif>;
		};

		simple-audio-card,codec {
			sound-dai = <&spdif_out>;
		};
	};

	spdif_out: spdif-out {
		compatible = "linux,spdif-dit";
		status = "okay";
		#sound-dai-cells = <0>;
	};

	vcc5v0_sys: vcc5v0-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&dc_12v>;
	};

	vcc5v0_host: vcc5v0-host-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_host";
		regulator-boot-on;
		regulator-always-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		enable-active-high;
		gpio = <&gpio4 RK_PB5 GPIO_ACTIVE_HIGH>;
		vin-supply = <&vcc5v0_sys>;
		pinctrl-names = "default";
		pinctrl-0 = <&vcc5v0_host_en>;
	};

	vcc5v0_otg: vcc5v0-otg-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_otg";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		enable-active-high;
		gpio = <&gpio4 RK_PC1 GPIO_ACTIVE_HIGH>;
		vin-supply = <&vcc5v0_sys>;
		pinctrl-names = "default";
		pinctrl-0 = <&vcc5v0_otg_en>;
	};

	vccio_sd: vccio-sd {
		compatible = "regulator-gpio";
		regulator-name = "vccio_sd";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <3300000>;
		gpios = <&gpio4 RK_PB6 GPIO_ACTIVE_HIGH>;
		vin-supply = <&vcc5v0_sys>;
		states = <1800000 0 3300000 1>;
	};

	vdd_logic: vdd-logic {
		compatible = "pwm-regulator";
		pwms = <&pwm2 0 5000 1>;
		regulator-name = "vdd_logic";
		regulator-min-microvolt = <705000>;
		regulator-max-microvolt = <1006000>;
		regulator-always-on;
		regulator-boot-on;
		regulator-settling-time-up-us = <250>;
		pwm-supply = <&vcc5v0_sys>;
		status = "okay";
	};

	vdd_cpu: vdd-cpu {
		compatible = "pwm-regulator";
		pwms = <&pwm7 0 5000 1>;
		regulator-name = "vdd_cpu";
		regulator-min-microvolt = <746000>;
		regulator-max-microvolt = <1201000>;
		regulator-always-on;
		regulator-boot-on;
		regulator-settling-time-up-us = <250>;
		pwm-supply = <&vcc5v0_sys>;
		status = "okay";
	};

	vdd_gpu: vdd-gpu {
		compatible = "pwm-regulator";
		pwms = <&pwm4 0 5000 1>;
		regulator-name = "vdd_gpu";
		regulator-min-microvolt = <705000>;
		regulator-max-microvolt = <1148000>;
		regulator-always-on;
		regulator-boot-on;
		regulator-settling-time-up-us = <250>;
		pwm-supply = <&vcc5v0_sys>;
		status = "okay";
	};

	vdd_0v9_s3: vdd-0v9-s3 {
		compatible = "regulator-fixed";
		regulator-name = "vdd_0v9_s3";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <900000>;
		regulator-max-microvolt = <900000>;
		vin-supply = <&vcc5v0_sys>;
	};

	vdd_1v8_s3: vdd-1v8-s3 {
		compatible = "regulator-fixed";
		regulator-name = "vdd_1v8_s3";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		vin-supply = <&vcc5v0_sys>;
	};

	vcc_3v3_s3: vcc-3v3-s3 {
		compatible = "regulator-fixed";
		regulator-name = "vcc_3v3_s3";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&vcc5v0_sys>;
	};

	vcc_sd: vcc-sd {
		compatible = "regulator-fixed";
		gpio = <&gpio4 RK_PA1 GPIO_ACTIVE_LOW>;
		regulator-name = "vcc_sd";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&vcc_3v3_s3>;
	};

	vcc_ddr_s3: vcc-ddr-s3 {
		compatible = "regulator-fixed";
		regulator-name = "vcc_ddr_s3";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <1200000>;
		regulator-max-microvolt = <1200000>;
		vin-supply = <&vcc5v0_sys>;
	};

	sdio_pwrseq: sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		pinctrl-names = "default";
		pinctrl-0 = <&wifi_enable_h>, <&clkm1_32k_out>;
		reset-gpios = <&gpio4 RK_PA4 GPIO_ACTIVE_LOW>;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		cma {
			compatible = "shared-dma-pool";
			reusable;
			size = <0x00 0x800000>;
			linux,cma-default;
		};

		ramoops: ramoops@110000 {
			compatible = "ramoops";
			reg = <0x00 0x110000 0x00 0xe0000>;
			console-size = <0x80000>;
			pmsg-size = <0x30000>;
			ftrace-size = <0x00>;
			record-size = <0x14000>;
		};

		scmi_shmem: shmem@10f000 {
			compatible = "arm,scmi-shmem";
			reg = <0x0 0x0010f000 0x0 0x100>;
			no-map;
		};
	};

	xin24m: clock-xin24m {
		compatible = "fixed-clock";
		clock-frequency = <24000000>;
		clock-output-names = "xin24m";
		#clock-cells = <0>;
	};

	gmac0_clk: clock-gmac50m {
		compatible = "fixed-clock";
		clock-frequency = <50000000>;
		clock-output-names = "gmac0";
		#clock-cells = <0>;
	};

	soc {
		compatible = "simple-bus";
		ranges = <0x0 0xfc000000 0x0 0xfc000000 0x0 0x44000000>;
		#address-cells = <2>;
		#size-cells = <2>;

		pcie: pcie@fe000000 {
			compatible = "rockchip,rk3528-pcie",
				     "rockchip,rk3568-pcie";
			reg = <0x0 0xfe000000 0x0 0x400000>,
			      <0x0 0xfe4f0000 0x0 0x010000>,
			      <0x0 0xfc000000 0x0 0x100000>;
			reg-names = "dbi", "apb", "config";
			bus-range = <0x0 0xff>;
			clocks = <&cru ACLK_PCIE>, <&cru HCLK_PCIE_SLV>,
				 <&cru HCLK_PCIE_DBI>, <&cru PCLK_PCIE>,
				 <&cru CLK_PCIE_AUX>;
			clock-names = "aclk_mst", "aclk_slv",
				      "aclk_dbi", "pclk",
				      "aux";
			device_type = "pci";
			interrupts = <GIC_SPI 156 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 157 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 154 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 155 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 153 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 158 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "sys", "pmc", "msg", "legacy", "err",
					  "msi";
			#interrupt-cells = <1>;
			interrupt-map-mask = <0 0 0 7>;
			interrupt-map = <0 0 0 1 &pcie_intc 0>,
					<0 0 0 2 &pcie_intc 1>,
					<0 0 0 3 &pcie_intc 2>,
					<0 0 0 4 &pcie_intc 3>;
			linux,pci-domain = <0>;
			max-link-speed = <2>;
			num-lanes = <1>;
			phys = <&combphy PHY_TYPE_PCIE>;
			phy-names = "pcie-phy";
			power-domains = <&power RK3528_PD_VPU>;
			ranges = <0x01000000 0x0 0xfc100000 0x0 0xfc100000 0x0 0x00100000>,
				 <0x02000000 0x0 0xfc200000 0x0 0xfc200000 0x0 0x01e00000>,
				 <0x03000000 0x1 0x00000000 0x1 0x00000000 0x0 0x40000000>;
			resets = <&cru SRST_PCIE_POWER_UP>, <&cru SRST_P_PCIE>;
			reset-names = "pwr", "pipe";
			#address-cells = <3>;
			#size-cells = <2>;
			status = "disabled";

			pcie_intc: legacy-interrupt-controller {
				interrupt-controller;
				interrupt-parent = <&gic>;
				interrupts = <GIC_SPI 155 IRQ_TYPE_EDGE_RISING>;
				#address-cells = <0>;
				#interrupt-cells = <1>;
			};
		};

		core_grf: syscon@ff300000 {
			compatible = "rockchip,rk3528-core-grf", "syscon";
			reg = <0x0 0xff300000 0x0 0x10000>;
		};

		gpu_grf: syscon@ff310000 {
			compatible = "rockchip,rk3528-gpu-grf", "syscon";
			reg = <0x0 0xff310000 0x0 0x10000>;
		};

		vpu_grf: syscon@ff340000 {
			compatible = "rockchip,rk3528-vpu-grf", "syscon";
			reg = <0x0 0xff340000 0x0 0x8000>;
		};

		pipe_phy_grf: syscon@ff348000 {
			compatible = "rockchip,rk3528-pipe-phy-grf", "syscon";
			reg = <0x0 0xff348000 0x0 0x8000>;
		};

		vo_grf: syscon@ff360000 {
			compatible = "rockchip,rk3528-vo-grf", "syscon";
			reg = <0x0 0xff360000 0x0 0x10000>;
		};

		pmu_grf: syscon@ff370000 {
			compatible = "rockchip,rk3528-pmu-grf", "syscon";
			reg = <0x0 0xff370000 0x0 0x10000>;
		};

		dfi: dfi@ff930000 {
			compatible = "rockchip,rk3528-dfi";
			reg = <0x0 0xff930000 0x0 0x400>;
			rockchip,pmu = <&pmu_grf>;
		};

		pwm3: pwm@ffa90030 {
			compatible = "rockchip,rk3528-pwm",
				     "rockchip,rk3328-pwm";
			reg = <0x0 0xffa90030 0x0 0x10>;
			clocks = <&cru CLK_PWM0>, <&cru PCLK_PWM0>;
			clock-names = "pwm", "pclk";
			#pwm-cells = <3>;
			status = "disabled";
		};

		rga: rga@ff850000 {
			compatible = "rockchip,rk3528-rga", "rockchip,rk3288-rga";
			reg = <0x0 0xff850000 0x0 0x180>;
			interrupts = <GIC_SPI 105 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru ACLK_RGA2E>, <&cru HCLK_RGA2E>, <&cru CLK_CORE_RGA2E>;
			clock-names = "aclk", "hclk", "sclk";
			resets = <&cru SRST_CORE_RGA2E>, <&cru SRST_A_RGA2E>, <&cru SRST_H_RGA2E>;
			reset-names = "core", "axi", "ahb";
			iommus = <&rga_mmu>;
			power-domains = <&power RK3528_PD_VO>;
			status = "okay";
		};

		rga_mmu: iommu@ff850f00 {
			compatible = "rockchip,rk3568-iommu";
			reg = <0x0 0xff850f00 0x0 0x100>;
			interrupts = <GIC_SPI 105 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru ACLK_RGA2E>, <&cru HCLK_RGA2E>;
			clock-names = "aclk", "iface";
			#iommu-cells = <0>;
			power-domains = <&power RK3528_PD_VO>;
			status = "okay";
		};

		iep: iep@ff860000 {
			compatible = "rockchip,rk3528-iep";
			reg = <0x0 0xff860000 0x0 0x500>;
			interrupts = <GIC_SPI 106 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru ACLK_VDPP>, <&cru HCLK_VDPP>, <&cru CLK_CORE_VDPP>;
			clock-names = "aclk", "hclk", "sclk";
			assigned-clocks = <&cru ACLK_VDPP>, <&cru CLK_CORE_VDPP>;
			assigned-clock-rates = <340000000>, <340000000>;
			resets = <&cru SRST_A_VDPP>, <&cru SRST_H_VDPP>, <&cru SRST_CORE_VDPP>;
			reset-names = "axi", "ahb", "core";
			iommus = <&iep_mmu>;
			power-domains = <&power RK3528_PD_VO>;
			status = "okay";
		};

		iep_mmu: iommu@ff860800 {
			compatible = "rockchip,rk3568-iommu";
			reg = <0x0 0xff860800 0x0 0x100>;
			interrupts = <GIC_SPI 106 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru ACLK_VDPP>, <&cru HCLK_VDPP>;
			clock-names = "aclk", "iface";
			#iommu-cells = <0>;
			power-domains = <&power RK3528_PD_VO>;
			status = "okay";
		};

		vdpp: vdpp@ff861000 {
			compatible = "rockchip,rk3528-vdpp";
			reg = <0x0 0xff861000 0x0 0x100>, <0x0 0xff862000 0x0 0x900>;
			reg-names = "vdpp", "zme";
			interrupts = <GIC_SPI 106 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru ACLK_VDPP>, <&cru HCLK_VDPP>, <&cru CLK_CORE_VDPP>;
			clock-names = "aclk", "hclk", "sclk";
			assigned-clocks = <&cru ACLK_VDPP>, <&cru CLK_CORE_VDPP>;
			assigned-clock-rates = <340000000>, <340000000>;
			resets = <&cru SRST_A_VDPP>, <&cru SRST_H_VDPP>, <&cru SRST_CORE_VDPP>;
			reset-names = "axi", "ahb", "core";
			iommus = <&iep_mmu>;
			power-domains = <&power RK3528_PD_VO>;
			status = "okay";
		};

		jpegd: video-codec@ff870000 {
			compatible = "rockchip,rk3588-jpegd";
			reg = <0x0 0xff870000 0x0 0x400>;
			interrupts = <GIC_SPI 107 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru ACLK_JPEG_DECODER>, <&cru HCLK_JPEG_DECODER>;
			clock-names = "axi", "ahb";
			assigned-clocks = <&cru ACLK_JPEG_DECODER>;
			assigned-clock-rates = <340000000>;
			iommus = <&jpegd_mmu>;
			power-domains = <&power RK3528_PD_VPU>;
			resets = <&cru SRST_A_JPEG_DECODER>, <&cru SRST_H_JPEG_DECODER>;
			reset-names = "axi", "ahb";
			status = "okay";
		};

		jpegd_mmu: iommu@ff870480 {
			compatible = "rockchip,rk3568-iommu";
			reg = <0x0 0xff870480 0x0 0x40>;
			interrupts = <GIC_SPI 108 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru ACLK_JPEG_DECODER>, <&cru HCLK_JPEG_DECODER>;
			clock-names = "aclk", "iface";
			#iommu-cells = <0>;
			power-domains = <&power RK3528_PD_VPU>;
			status = "okay";
		};

		/* VDPU2, as on RK3568: MPEG-2, VP8 and H.264 behind the decoder at +0x400. */
		vpu: video-codec@ff7c0000 {
			compatible = "rockchip,rk3528-vpu", "rockchip,rk3568-vpu";
			reg = <0x0 0xff7c0000 0x0 0x800>;
			interrupts = <GIC_SPI 98 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "vdpu";
			clocks = <&cru ACLK_VPU>, <&cru HCLK_VPU>;
			clock-names = "aclk", "hclk";
			iommus = <&vdpu_mmu>;
			power-domains = <&power RK3528_PD_VPU>;
			status = "okay";
		};

		vdpu_mmu: iommu@ff7c0800 {
			compatible = "rockchip,rk3568-iommu";
			reg = <0x0 0xff7c0800 0x0 0x40>;
			interrupts = <GIC_SPI 99 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru ACLK_VPU>, <&cru HCLK_VPU>;
			clock-names = "aclk", "iface";
			#iommu-cells = <0>;
			power-domains = <&power RK3528_PD_VPU>;
			status = "okay";
		};

		/*
		 * The vendor DTB uses the BSP-only "rockchip,iommu-v2"; mainline reaches
		 * the same v2 ops through "rockchip,rk3568-iommu".
		 */
		vdec_mmu: iommu@ff740800 {
			compatible = "rockchip,rk3568-iommu";
			reg = <0x0 0xff740800 0x0 0x40>,
			      <0x0 0xff740900 0x0 0x40>;
			interrupts = <GIC_SPI 95 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru ACLK_RKVDEC>, <&cru HCLK_RKVDEC>;
			clock-names = "aclk", "iface";
			#iommu-cells = <0>;
			rockchip,disable-mmu-reset;
			status = "okay";
		};

		/*
		 * No power-domains on purpose.  rk3528.dtsi leaves
		 * power-domain@RK3528_PD_RKVDEC disabled, so referencing it makes both
		 * devices fail with deferred probe timeouts.  The vendor DTB does not
		 * use a power domain here either: the RK3528 vdec domain is defined with
		 * a zero power mask, i.e. bus idle handshake only, permanently powered.
		 */
		vdec: video-codec@ff740000 {
			compatible = "rockchip,rk3528-vdec";
			reg = <0x0 0xff740000 0x0 0x100>,
			      <0x0 0xff740100 0x0 0x400>;
			reg-names = "link", "function";
			interrupts = <GIC_SPI 94 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru ACLK_RKVDEC>, <&cru HCLK_RKVDEC>,
			 <&cru CLK_HEVC_CA_RKVDEC>;
			clock-names = "axi", "ahb", "hevc_cabac";
			assigned-clocks = <&cru ACLK_RKVDEC>, <&cru CLK_HEVC_CA_RKVDEC>;
			assigned-clock-rates = <340000000>, <600000000>;
			iommus = <&vdec_mmu>;
			sram = <&vdec_sram>;
			status = "okay";
		};

		vop_mmu: iommu@ff847e00 {
			compatible = "rockchip,rk3568-iommu";
			reg = <0x0 0xff847e00 0x0 0x100>;
			interrupts = <GIC_SPI 109 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru ACLK_VOP>, <&cru HCLK_VOP>;
			clock-names = "aclk", "iface";
			#iommu-cells = <0>;
			rockchip,disable-device-link-resume;
			power-domains = <&power RK3528_PD_VO>;
			status = "okay";
		};

		tve: tve@ff880000 {
			compatible = "rockchip,rk3528-tve";
			reg = <0x0 0xff880000 0x0 0x4000>, <0x0 0xffde0000 0x0 0x300>;
			interrupts = <GIC_SPI 112 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru HCLK_CVBS>, <&cru PCLK_VCDCPHY>, <&cru DCLK_CVBS>,
			 <&cru DCLK_4X_CVBS>;
			clock-names = "hclk", "pclk_vdac", "dclk", "dclk_4x";
			nvmem-cells = <&vdac_out_current>, <&test_version>;
			nvmem-cell-names = "out-current", "version";
			power-domains = <&power RK3528_PD_VO>;
			rockchip,grf = <&vo_grf>;
			status = "okay";

			port {
				tve_in_vp1: endpoint {
					remote-endpoint = <&vp1_out_tve>;
				};
			};
		};

		rkvenc: video-codec@ff780000 {
			compatible = "rockchip,rk3528-rkvenc";
			reg = <0x0 0xff780000 0x0 0x6000>;
			interrupts = <GIC_SPI 97 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru ACLK_RKVENC>, <&cru HCLK_RKVENC>,
			 <&cru CLK_CORE_RKVENC>;
			clock-names = "axi", "ahb", "core";
			assigned-clocks = <&cru ACLK_RKVENC_ROOT>, <&cru CLK_CORE_RKVENC>;
			assigned-clock-rates = <300000000>, <300000000>;
			resets = <&cru SRST_A_RKVENC>, <&cru SRST_H_RKVENC>,
			 <&cru SRST_CORE_RKVENC>;
			reset-names = "axi", "ahb", "core";
			iommus = <&rkvenc_mmu>;
			power-domains = <&power RK3528_PD_RKVENC>;
			status = "okay";
		};

		rkvenc_mmu: iommu@ff78f000 {
			compatible = "rockchip,rk3568-iommu";
			reg = <0x0 0xff78f000 0x0 0x40>;
			interrupts = <GIC_SPI 96 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&cru ACLK_RKVENC>, <&cru HCLK_RKVENC>;
			clock-names = "aclk", "iface";
			#iommu-cells = <0>;
			power-domains = <&power RK3528_PD_RKVENC>;
			status = "okay";
		};

		sram: sram@fe480000 {
			compatible = "mmio-sram";
			reg = <0x0 0xfe480000 0x0 0xc000>;
			ranges = <0x0 0x0 0xfe480000 0xc000>;
			#address-cells = <1>;
			#size-cells = <1>;

			vdec_sram: rkvdec-sram@0 {
				reg = <0x0 0xc000>;
				pool;
			};
		};

		gic: interrupt-controller@fed01000 {
			compatible = "arm,gic-400";
			reg = <0x0 0xfed01000 0 0x1000>,
			      <0x0 0xfed02000 0 0x2000>,
			      <0x0 0xfed04000 0 0x2000>,
			      <0x0 0xfed06000 0 0x2000>;
			interrupts = <GIC_PPI 9 (GIC_CPU_MASK_SIMPLE(4) |
						 IRQ_TYPE_LEVEL_LOW)>;
			interrupt-controller;
			#address-cells = <0>;
			#interrupt-cells = <3>;
		};

		usb_host0_ehci: usb@ff100000 {
			compatible = "generic-ehci";
			reg = <0x0 0xff100000 0x0 0x40000>;
			clocks = <&cru HCLK_USBHOST>, <&cru HCLK_USBHOST_ARB>,
				 <&usb2phy>;
			interrupts = <GIC_SPI 143 IRQ_TYPE_LEVEL_HIGH>;
			phys = <&usb2phy_host>;
			phy-names = "usb";
			power-domains = <&power RK3528_PD_VO>;
			status = "okay";
		};

		usb_host0_ohci: usb@ff140000 {
			compatible = "generic-ohci";
			reg = <0x0 0xff140000 0x0 0x40000>;
			clocks = <&cru HCLK_USBHOST>, <&cru HCLK_USBHOST_ARB>,
				 <&usb2phy>;
			interrupts = <GIC_SPI 144 IRQ_TYPE_LEVEL_HIGH>;
			phys = <&usb2phy_host>;
			phy-names = "usb";
			power-domains = <&power RK3528_PD_VO>;
			status = "okay";
		};

		qos_crypto_a: qos@ff200000 {
			compatible = "rockchip,rk3528-qos", "syscon";
			reg = <0x0 0xff200000 0x0 0x20>;
		};

		qos_crypto_p: qos@ff200080 {
			compatible = "rockchip,rk3528-qos", "syscon";
			reg = <0x0 0xff200080 0x0 0x20>;
		};

		qos_dcf: qos@ff200100 {
			compatible = "rockchip,rk3528-qos", "syscon";
			reg = <0x0 0xff200100 0x0 0x20>;
