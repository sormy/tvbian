			arm_pins: arm-pins {
				rockchip,pins = <4 RK_PC4 3 &pcfg_pull_none>;
			};
		};

		clk {
			clkm0_32k_out: clkm0-32k-out {
				rockchip,pins = <3 RK_PC3 3 &pcfg_pull_none>;
			};

			clkm1_32k_out: clkm1-32k-out {
				rockchip,pins = <1 RK_PC3 1 &pcfg_pull_none>;
			};
		};

		emmc {
			emmc_rstnout: emmc-rstnout {
				rockchip,pins = <1 RK_PD6 1 &pcfg_pull_none>;
			};

			emmc_bus8: emmc-bus8 {
				rockchip,pins = <1 RK_PC4 1 &pcfg_pull_up_drv_level_2>,
				                <1 RK_PC5 1 &pcfg_pull_up_drv_level_2>,
				                <1 RK_PC6 1 &pcfg_pull_up_drv_level_2>,
				                <1 RK_PC7 1 &pcfg_pull_up_drv_level_2>,
				                <1 RK_PD0 1 &pcfg_pull_up_drv_level_2>,
				                <1 RK_PD1 1 &pcfg_pull_up_drv_level_2>,
				                <1 RK_PD2 1 &pcfg_pull_up_drv_level_2>,
				                <1 RK_PD3 1 &pcfg_pull_up_drv_level_2>;
			};

			emmc_clk: emmc-clk {
				rockchip,pins = <1 RK_PD5 1 &pcfg_pull_up_drv_level_2>;
			};

			emmc_cmd: emmc-cmd {
				rockchip,pins = <1 RK_PD4 1 &pcfg_pull_up_drv_level_2>;
			};

