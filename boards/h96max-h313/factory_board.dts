			nand0_p2 = <0x55aaaa55>;
			nand0_p3 = <0x55aaaa55>;
			chip_code = "sun50iw9";
			status = "disabled";
			linux,phandle = <0x16e>;
			phandle = <0x16e>;
			nand0_support_2ch = <0x00>;
			pinctrl-0 = <&nand0_pins_a>, <&nand0_pins_b>;
		};

		ts0: ts0@05060000 {
			compatible = "allwinner,sun50i-tsc";
			device_type = "ts0";
			reg = <0x00 0x5060000 0x00 0x1000>;
			interrupts = <GIC_SPI 17 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&clk_pll_periph0>, <&clk_ts>;
			clock-frequency = <120000000>;
			pinctrl-names = "ts0-default", "ts0-sleep";
			pinctrl-0 = <&ts0_pins_a>;
			pinctrl-1 = <&ts0_pins_b>;
			ts0config = <1>;
			status = "okay";
			linux,phandle = <0x16f>;
			phandle = <0x16f>;
		};

		ths: thermal_sensor {
			compatible = "arm,sun50iw9p1";
			reg = <0x00 0x5070400 0x00 0x400>;
			clocks = <&clk_ths>;
			clock-names = "bus";
			nvmem-cells = <&ths_calib>;
			nvmem-cell-names = "calibration";
			nvmem-names = "sid";
			nvmem = <&sunxi_sid>;
			#thermal-sensor-cells = <1>;
			linux,phandle = <0xc6>;
			phandle = <0xc6>;
		};

		thermal-zones {

			cpu_thermal_zone {
				polling-delay-passive = <500>;
				polling-delay = <1000>;
				thermal-sensors = <&ths 2>;
				sustainable-power = <1000>;
				k_po = <20>;
				k_pu = <40>;
				k_i = <0>;

				cpu_trips: trips {
					linux,phandle = <0x170>;
					phandle = <0x170>;

					cpu_threshold: trip-point@0 {
						temperature = <60000>;
						type = "passive";
						hysteresis = <0>;
						linux,phandle = <0x171>;
						phandle = <0x171>;
					};

					cpu_target: trip-point@1 {
						temperature = <70000>;
						type = "passive";
						hysteresis = <0>;
						linux,phandle = <0xc7>;
						phandle = <0xc7>;
					};

					cpu_crit: cpu_crit@0 {
						temperature = <115000>;
						type = "critical";
						hysteresis = <0>;
						linux,phandle = <0x172>;
						phandle = <0x172>;
					};
				};

				cooling-maps {

					map0 {
						trip = <&cpu_target>;
						cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
						contribution = <1024>;
					};

					map1 {
						trip = <&cpu_target>;
						cooling-device = <&gpu THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
						contribution = <1024>;
					};
				};
			};

			gpu_thermal_zone {
				polling-delay-passive = <500>;
				polling-delay = <1000>;
				thermal-sensors = <&ths 0>;
				sustainable-power = <1100>;
			};

			ve_thermal_zone {
				polling-delay-passive = <0>;
				polling-delay = <0>;
				thermal-sensors = <&ths 1>;
			};

			ddr_thermal_zone {
				polling-delay-passive = <0>;
				polling-delay = <0>;
				thermal-sensors = <&ths 3>;
			};
		};

		gpadc: gpadc {
			compatible = "allwinner,sunxi-gpadc";
			reg = <0x00 0x5070000 0x00 0x400>;
