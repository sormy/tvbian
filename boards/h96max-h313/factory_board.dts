	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	n_brom {
		compatible = "allwinner,n-brom";
		reg = <0x00 0x00 0x00 0xa000>;
	};

	s_brom {
		compatible = "allwinner,s-brom";
		reg = <0x00 0x00 0x00 0x10000>;
	};

	sram_ctrl {
		device_type = "sram_ctrl";
		compatible = "allwinner,sram_ctrl";
		reg = <0x00 0x3000000 0x00 0x100>;
	};

	sram_a1 {
		compatible = "allwinner,sram_a1";
		reg = <0x00 0x20000 0x00 0x8000>;
	};

	sram_a2 {
		compatible = "allwinner,sram_a2";
		reg = <0x00 0x100000 0x00 0x14000>;
	};

	prcm {
		compatible = "allwinner,prcm";
		reg = <0x00 0x1f01400 0x00 0x400>;
	};

	s_cpuscfg {
		compatible = "allwinner,s_cpuscfg";
		reg = <0x00 0x1f01c00 0x00 0x400>;
	};

	ion {
		compatible = "allwinner,sunxi-ion";

		heap_sys_user@0 {
			compatible = "allwinner,sys_user";
			heap-name = "sys_user";
			heap-id = <0>;
			heap-base = <0x00>;
			heap-size = <0>;
			heap-type = "ion_system";
		};

		heap_cma@0 {
			compatible = "allwinner,cma";
			heap-name = "cma";
			heap-id = <4>;
			heap-base = <0x00>;
			heap-size = <0>;
			heap-type = "ion_cma";
		};

		heap_secure@0 {
			compatible = "allwinner,secure";
			heap-name = "secure";
			heap-id = <6>;
			heap-base = <0x00>;
			heap-size = <0>;
			heap-type = "ion_secure";
		};
	};

	dram: dram {
		compatible = "allwinner,dram";
		clocks = <&clk_pll_ddr0>;
		clock-names = "pll_ddr";
		dram_clk = <600>;
		dram_type = <3>;
		dram_zq = <0x3f3fdd>;
		dram_odt_en = <1>;
		dram_para1 = <0x30fb>;
		dram_para2 = <0x00>;
		dram_mr0 = <0x840>;
		dram_mr1 = <0x04>;
		dram_mr2 = <0x08>;
		dram_mr3 = <0x00>;
		dram_tpr0 = <0xc0001002>;
		dram_tpr1 = <0x00>;
		dram_tpr2 = <0x100>;
		dram_tpr3 = <0x00>;
		dram_tpr4 = <0x00>;
		dram_tpr5 = <0x00>;
		dram_tpr6 = <0x33808080>;
		dram_tpr7 = <0x00>;
		dram_tpr8 = <0x00>;
		dram_tpr9 = <0x00>;
		dram_tpr10 = <0x2f1107>;
		dram_tpr11 = <0xddddcccc>;
		dram_tpr12 = <0xeddc7665>;
		dram_tpr13 = <0x40>;
		linux,phandle = <0x17d>;
		phandle = <0x17d>;
		device_type = "dram";
		dram_dx_odt = <0x3030303>;
		dram_dx_dri = <0xe0e0e0e>;
		dram_ca_dri = <0x1f12>;
		dram_mr4 = <0x00>;
		dram_mr5 = <0x00>;
		dram_mr6 = <0x00>;
		dram_mr11 = <0x00>;
		dram_mr12 = <0x00>;
		dram_mr13 = <0x00>;
		dram_mr14 = <0x00>;
		dram_mr16 = <0x00>;
		dram_mr17 = <0x00>;
		dram_mr22 = <0x00>;
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0x00 0x40000000 0x00 0x20000000>;
	};

	gic: interrupt-controller@03020000 {
		compatible = "arm,cortex-a15-gic", "arm,cortex-a9-gic";
		#interrupt-cells = <3>;
		#address-cells = <0>;
		device_type = "gic";
		interrupt-controller;
		reg = <0x00 0x3021000 0x00 0x1000 0x00 0x3022000 0x00 0x2000 0x00 0x3024000 0x00 0x2000 0x00 0x3026000 0x00 0x2000>;
		interrupts = <GIC_PPI 9 (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_HIGH)>;
		interrupt-parent = <&gic>;
		linux,phandle = <0x85>;
		phandle = <0x85>;
	};

	wakeupgen: interrupt-controller@0 {
		compatible = "allwinner,sunxi-wakeupgen";
		interrupt-controller;
		#interrupt-cells = <3>;
		interrupt-parent = <&gic>;
		linux,phandle = <0x01>;
		phandle = <0x01>;
	};

	nmi_intc: intc-nmi@07010320 {
		compatible = "allwinner,sun8i-nmi";
		interrupt-parent = <&gic>;
		#interrupt-cells = <2>;
		#address-cells = <0>;
		interrupt-controller;
		reg = <0x00 0x7010320 0x00 0x0c>;
		pad-control-v1 = <0x7000208>;
		interrupts = <GIC_SPI 103 IRQ_TYPE_LEVEL_HIGH>;
		linux,phandle = <0x17e>;
		phandle = <0x17e>;
	};

	sid: sunxi-sid@03006000 {
		compatible = "allwinner,sunxi-sid";
		device_type = "sid";
		reg = <0x00 0x3006000 0x00 0x1000>;
		linux,phandle = <0x17f>;
		phandle = <0x17f>;
	};

	sunxi_sid: sunxi-sid-ng@03006000 {
		compatible = "allwinner,sun50iw9p1-sid";
		reg = <0x00 0x3006000 0x00 0x1000>;
		#address-cells = <1>;
		#size-cells = <1>;
		linux,phandle = <0xc5>;
		phandle = <0xc5>;

		speedbin_efuse: speed@00 {
			reg = <0x00 0x02>;
			linux,phandle = <0xd9>;
			phandle = <0xd9>;
		};

		ths_calib: calib@14 {
			reg = <0x14 0x08>;
			linux,phandle = <0xc4>;
			phandle = <0xc4>;
		};
	};

	chipid: sunxi-chipid@03006200 {
		compatible = "allwinner,sunxi-chipid";
		device_type = "chipid";
		reg = <0x00 0x3006200 0x00 0x200>;
		linux,phandle = <0x180>;
		phandle = <0x180>;
	};

	timer_arch {
		compatible = "arm,armv8-timer";
		interrupts = <GIC_PPI 13 (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_LOW)>,
		             <GIC_PPI 14 (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_LOW)>,
		             <GIC_PPI 11 (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_LOW)>,
		             <GIC_PPI 10 (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_LOW)>;
		clock-frequency = <24000000>;
		interrupt-parent = <&gic>;
		arm,no-tick-in-suspend;
	};

	pmu {
		compatible = "arm,armv8-pmuv3";
		interrupts = <GIC_SPI 140 IRQ_TYPE_LEVEL_HIGH>,
		             <GIC_SPI 141 IRQ_TYPE_LEVEL_HIGH>,
		             <GIC_SPI 142 IRQ_TYPE_LEVEL_HIGH>,
		             <GIC_SPI 143 IRQ_TYPE_LEVEL_HIGH>;
	};

	dramfreq {
		compatible = "allwinner,sunxi-dramfreq";
		reg = <0x00 0x4002000 0x00 0x1000 0x00 0x4003000 0x00 0x3000 0x00 0x3001000 0x00 0x1000>;
		interrupts = <GIC_SPI 33 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&clk_pll_ddr0>;
		status = "okay";
	};

	uboot: uboot {
		linux,phandle = <0x181>;
		phandle = <0x181>;
	};

	mmu_aw: iommu@030f0000 {
		compatible = "allwinner,sunxi-iommu";
		reg = <0x00 0x30f0000 0x00 0x1000>;
		interrupts = <GIC_SPI 61 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "iommu-irq";
		clocks = <&clk_iommu>;
		clock-names = "iommu";
		#iommu-cells = <2>;
		status = "okay";
		linux,phandle = <0x28>;
		phandle = <0x28>;
	};

	gpu: gpu@0x01800000 {
		device_type = "gpu";
		compatible = "arm,mali-midgard";
		reg = <0x00 0x1800000 0x00 0x10000>;
		interrupts = <GIC_SPI 95 IRQ_TYPE_LEVEL_HIGH>,
		             <GIC_SPI 96 IRQ_TYPE_LEVEL_HIGH>,
		             <GIC_SPI 97 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "JOB", "MMU", "GPU";
		clocks = <&clk_pll_gpu>, <&clk_gpu0>, <&clk_gpu1>;
		clock-names = "clk_parent", "clk_mali", "clk_bak";
		#cooling-cells = <2>;
		gpu_idle = <1>;
		dvfs_status = <0>;
		operating-points = <600000 950000 576000 950000 540000 950000 504000 950000>;
		linux,phandle = <0xc9>;
		phandle = <0xc9>;

		ipa_dvfs: ipa_dvfs {
			compatible = "arm,mali-simple-power-model";
			static-coefficient = <17000>;
			dynamic-coefficient = <750>;
			ts = <254682 9576 4294967192 4>;
			thermal-zone = "gpu_thermal_zone";
			ss-coefficient = <36>;
			ff-coefficient = <291>;
			linux,phandle = <0x182>;
			phandle = <0x182>;
		};
	};

	box_start_os0 {
		compatible = "allwinner,box_start_os";
		start_type = <1>;
		irkey_used = <0>;
		pmukey_used = <0>;
		pmukey_num = <0>;
		led_power = <0>;
		led_state = <0>;
		pinctrl-0 = <&standby_blue>;
		pinctrl-1 = <&standby_red>;
		pinctrl-2 = <&standby_bt>;
	};
};
