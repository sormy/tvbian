--- factory_board_translated.dts
+++ board.dts
@@ -18,8 +18,10 @@
 	interrupt-parent = <&gic>;
 	#address-cells = <2>;
 	#size-cells = <2>;
-	compatible = "amlogic,s905x", "amlogic,meson-gxl";
-	model = "Amlogic";
+	/* board first; the GXLX family last, which mainline's drivers match */
+	compatible = "h96max-m20,gxlx2-tvbox", "amlogic,p291", "amlogic,s905l", "amlogic,meson-gxlx";
+	/* the factory's model is only "Amlogic" */
+	model = "H96 Max M20 (905_DG_ZX01_V01)";
 
 	cpus {
 		#address-cells = <0x2>;
@@ -658,7 +660,8 @@
 				compatible = "amlogic,meson-gx-ir", "amlogic,meson-gxbb-ir";
 				reg = <0x0 0x00580 0x0 0x40>;
 				interrupts = <GIC_SPI 196 IRQ_TYPE_EDGE_RISING>;
-				status = "okay";
+				/* NOT FITTED: no IR receiver (dtb.md) */
+				status = "disabled";
 				pinctrl-names = "default";
 				pinctrl-0 = <&remote_pins>;
 			};
@@ -686,6 +689,8 @@
 				clocks = <&clkc CLKID_FCLK_DIV4>;
 				clock-names = "ref";
 				mdio-parent-bus = <&mdio0>;
+				/* NOT FITTED: the Ethernet PHY's MDIO, with no Ethernet */
+				status = "disabled";
 
 				external_mdio: mdio@0 {
 					reg = <0x0>;
@@ -1521,6 +1526,14 @@
 						bias-disable;
 					};
 				};
+
+				/* the DDC pins as GPIOs, for i2c-hdmi-ddc; U-Boot leaves them on hdmi_i2c */
+				hdmitx_ddc_gpio: hdmitx-ddc-pins {
+					mux {
+						groups = "GPIOH_1", "GPIOH_2";
+						function = "gpio_periphs";
+					};
+				};
 			};
 		};
 
@@ -1764,8 +1777,9 @@
 				vmmc-supply = <&vcc_3v3>;
 				vqmmc-supply = <&vcc_3v3>;
 				max-frequency = <50000000>;
+				/* no cap-sdio-irq, which the factory's caps ask for: with it the MT7668's events arrive
+				   late or not at all; ksdioirqd's polling associates in 3 s (dtb.md) */
 				keep-power-in-suspend;
-				cap-sdio-irq;
 			};
 
 			usb2_phy0: phy@78000 {
@@ -1851,7 +1865,9 @@
 			sound-name-prefix = "HDMITX";
 			status = "okay";
 			pinctrl-names = "default";
-			pinctrl-0 = <&hdmitx_hpd>, <&hdmitx_ddc>;
+			/* hot-plug only: the DDC pins are i2c-hdmi-ddc's */
+			pinctrl-0 = <&hdmitx_hpd>;
+			ddc-i2c-bus = <&hdmi_ddc>;
 
 			/* VPU VENC Input */
 			hdmi_tx_venc_port: port@0 {
@@ -1903,7 +1919,8 @@
 			clock-names = "stmmaceth", "clkin0", "clkin1", "timing-adjustment";
 			phy-mode = "rmii";
 			phy-handle = <&internal_phy>;
-			status = "okay";
+			/* NOT FITTED: a stick, no Ethernet jack */
+			status = "disabled";
 
 			mdio0: mdio {
 				#address-cells = <1>;
@@ -1922,7 +1939,9 @@
 			clocks = <&clkc CLKID_USB>, <&clkc CLKID_USB1_DDR_BRIDGE>;
 			clock-names = "usb_ctrl", "ddr";
 			resets = <&reset RESET_USB_OTG>;
-			dr_mode = "otg";
+			/* port 0 is the USB-C, OTG by the factory's dwc2 node; Android runs it as host, a gadget
+			   appearing only in U-Boot's burning window (worklog.md), which drives the port itself */
+			dr_mode = "host";
 			phys = <&usb2_phy0>, <&usb2_phy1>;
 			phy-names = "usb2-phy0", "usb2-phy1";
 
@@ -1967,8 +1986,10 @@
 		serial4 = &uart_AO_B;
 	};
 
+	/* 2 GiB, where stock's linux,usable-memory ends; U-Boot writes what it finds at boot */
 	memory@0 {
 		device_type = "memory";
+		reg = <0x0 0x0 0x0 0x80000000>;
 	};
 
 	reserved-memory {
@@ -2021,16 +2042,20 @@
 		compatible = "gpio-leds";
 		status = "okay";
 
-		led-red {
-			label = "sys_red";
-			gpios = <&gpio GPIODV_24 GPIO_ACTIVE_HIGH>;
-			default-state = "off";
+		/* the board's one LED, blue: the factory's sys_red, which its disabled sysled node
+		   drives active low; power is the name the shared LED hooks drive */
+		led-power {
+			label = "power";
+			gpios = <&gpio GPIODV_24 GPIO_ACTIVE_LOW>;
+			default-state = "on";
 		};
 
 		led-green {
 			label = "sys_green";
 			gpios = <&gpio GPIOZ_14 GPIO_ACTIVE_HIGH>;
 			default-state = "on";
+			/* NOT FITTED: the board's LED has two pins, one colour */
+			status = "disabled";
 		};
 	};
 
@@ -2082,7 +2107,8 @@
 				};
 
 				cpu_critical: cpu-critical {
-					temperature = <260000>;
+					/* mainline's: the factory's 260 C is past any temperature the SoC reaches alive */
+					temperature = <110000>;
 					hysteresis = <1000>;
 					type = "critical";
 				};
@@ -2118,6 +2144,8 @@
 		#address-cells = <2>;
 		#size-cells = <2>;
 		ranges;
+		/* earlycon, in BOARD_CMDLINE, takes its console from here */
+		stdout-path = "serial0:115200n8";
 
 		simplefb_cvbs: framebuffer-cvbs {
 			compatible = "amlogic,simple-framebuffer",
@@ -2233,7 +2261,8 @@
 	/* HDMI audio: the AIU's I2S into the HDMI transmitter, inside the SoC */
 	hdmi_sound: sound {
 		compatible = "amlogic,gx-sound-card";
-		model = "GXLX2-HDMI";
+		/* the ALSA id the board's hdmi-audio files key on */
+		model = "H96-MAX-M20";
 		clocks = <&clkc CLKID_MPLL0>,
 			 <&clkc CLKID_MPLL1>,
 			 <&clkc CLKID_MPLL2>;
@@ -2271,7 +2300,9 @@
 
 	wifi_pwrseq: sdio-pwrseq {
 		compatible = "mmc-pwrseq-simple";
-		reset-gpios = <&gpio GPIOX_6 GPIO_ACTIVE_LOW>;
+		/* the combo chip's Bluetooth enable too, the factory's bt-dev gpio_en: both halves
+		   power up together, before the SDIO bus probes */
+		reset-gpios = <&gpio GPIOX_6 GPIO_ACTIVE_LOW>, <&gpio GPIOX_17 GPIO_ACTIVE_LOW>;
 		pinctrl-names = "default";
 		pinctrl-0 = <&wifi_32k_pins>;
 		clocks = <&wifi32k>;
@@ -2303,4 +2334,15 @@
 			};
 		};
 	};
+
+	/* the HDMI DDC lines as a full I2C bus: dw-hdmi's own master reads the EDID but
+	   refuses DDC/CI */
+	hdmi_ddc: i2c-ddc {
+		compatible = "i2c-gpio";
+		sda-gpios = <&gpio GPIOH_1 GPIO_OPEN_DRAIN>;
+		scl-gpios = <&gpio GPIOH_2 GPIO_OPEN_DRAIN>;
+		i2c-gpio,delay-us = <5>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&hdmitx_ddc_gpio>;
+	};
 };
