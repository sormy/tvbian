			usb_regulator_io = "nocare";
			status = "okay";
			phandle = <0xc6>;
		};

		ehci3: ehci3-controller@5311000 {
			compatible = "allwinner,sunxi-ehci3";
			reg = <0x00 0x5311000 0x00 0xfff 0x00 0x00 0x00 0x100 0x00 0x5100000 0x00 0x1000>;
			interrupts = <GIC_SPI 32 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_BUS_EHCI3>, <&ccu CLK_USB_PHY3>;
			clock-names = "bus_hci", "phy";
			resets = <&ccu RST_BUS_EHCI3>, <&ccu RST_USB_PHY3>;
			reset-names = "hci", "phy";
			hci_ctrl_no = <3>;
			drvvbus-supply = <&usb0_drvvbus>;
			status = "okay";
			phandle = <0xc7>;
		};

		ohci3: ohci3-controller@5311400 {
			compatible = "allwinner,sunxi-ohci3";
			reg = <0x00 0x5311400 0x00 0xfff 0x00 0x00 0x00 0x100 0x00 0x5100000 0x00 0x1000>;
			interrupts = <GIC_SPI 33 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_BUS_OHCI3>, <&ccu CLK_USB_OHCI3>, <&ccu CLK_USB_PHY3>;
			clock-names = "bus_hci", "ohci", "phy";
			resets = <&ccu RST_BUS_OHCI3>, <&ccu RST_USB_PHY3>;
			reset-names = "hci", "phy";
			hci_ctrl_no = <3>;
			drvvbus-supply = <&usb0_drvvbus>;
			status = "okay";
			phandle = <0xc8>;
		};

		hdmi: hdmi@6000000 {
			compatible = "allwinner,sunxi-hdmi";
			reg = <0x00 0x6000000 0x00 0x100000>;
			interrupts = <GIC_SPI 63 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_BUS_HDMI>,
			         <&ccu CLK_HDMI>,
			         <&ccu CLK_HDMI_SLOW>,
			         <&ccu CLK_HDMI_CEC>,
			         <&ccu CLK_BUS_HDMI_HDCP>,
			         <&ccu CLK_HDMI_HDCP>,
			         <&ccu CLK_TCON_TV0>;
			clock-names = "clk_bus_hdmi", "clk_hdmi", "clk_ddc", "clk_cec", "clk_bus_hdcp", "clk_hdcp", "clk_tcon_tv";
			resets = <&ccu RST_BUS_HDMI_SUB>,
			         <&ccu RST_BUS_HDMI_MAIN>,
			         <&ccu RST_BUS_HDMI_HDCP>;
			reset-names = "rst_bus_sub", "rst_bus_main", "rst_bus_hdcp";
			assigned-clocks = <&ccu CLK_HDMI>, <&ccu CLK_HDMI_HDCP>;
			assigned-clock-parents = <&ccu CLK_PLL_VIDEO2>, <&ccu CLK_PLL_PERIPH1>;
			assigned-clock-rates = <0>, <0>;
			status = "okay";
			hdmi_used = <1>;
			aldo1-supply = <&reg_aldo1>;
			dcdc1-supply = <&reg_dcdc1>;
			hdmi_power_cnt = <2>;
			hdmi_power0 = "aldo1";
			hdmi_power1 = "dcdc1";
			hdmi_hdcp_enable = <1>;
			hdmi_hdcp22_enable = <1>;
			hdmi_cts_compatibility = <0>;
			hdmi_cec_support = <1>;
			hdmi_cec_super_standby = <0>;
			ddc_en_io_ctrl = <0>;
			power_io_ctrl = <0x00>;
			phandle = <0xc9>;
		};

		nmi_intc: interrupt-controller@7010320 {
			compatible = "allwinner,sun8i-nmi";
			interrupt-controller;
			#interrupt-cells = <2>;
			reg = <0x00 0x7010320 0x00 0x0c>;
			interrupts = <GIC_SPI 103 IRQ_TYPE_LEVEL_HIGH>;
			pad-control-v1 = <0x7000208>;
			phandle = <0xca>;
		};

		s_cir0: s_cir@7040000 {
			compatible = "allwinner,s_cir";
			reg = <0x00 0x7040000 0x00 0x400>;
			interrupts = <GIC_SPI 106 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&r_ccu CLK_R_APB1_BUS_IR>, <&dcxo24M>, <&r_ccu CLK_R_APB1_IR>;
			clock-names = "bus", "pclk", "mclk";
			resets = <&r_ccu RST_R_APB1_BUS_IR>;
			status = "okay";
			s_cir0_used = <1>;
			pinctrl-names = "default", "sleep";
			pinctrl-0 = <&s_cir0_pins_a>;
			pinctrl-1 = <&s_cir0_pins_b>;
			ir_power_key_code0 = <64>;
			ir_addr_code0 = <0xfe01>;
			ir_power_key_code1 = <26>;
			ir_addr_code1 = <0xfb04>;
			ir_power_key_code2 = <242>;
			ir_addr_code2 = <0x2992>;
			ir_power_key_code3 = <87>;
			ir_addr_code3 = <0x9f00>;
			ir_power_key_code4 = <220>;
			ir_addr_code4 = <0x4cb3>;
			ir_power_key_code5 = <24>;
			ir_addr_code5 = <0xff00>;
			ir_power_key_code6 = <220>;
			ir_addr_code6 = <0xdd22>;
			ir_power_key_code7 = <13>;
			ir_addr_code7 = <0xbc00>;
			ir_power_key_code8 = <77>;
			ir_addr_code8 = <0x4040>;
			wakeup-source;
			phandle = <0xcb>;
		};

		rfkill: rfkill {
			compatible = "allwinner,sunxi-rfkill";
			status = "okay";
			chip_en;
			power_en;
			pinctrl-0 = <&clk_losc_pins_a>;
			pinctrl-names = "default";
			phandle = <0xcc>;

			wlan: wlan {
				compatible = "allwinner,sunxi-wlan";
				clocks = <&rtc_ccu CLK_OSC32K_OUT>;
				clock-names = "osc32k-out";
				wlan_busnum = <1>;
				wlan_power;
				wlan_regon = <&pio 6 18 GPIO_ACTIVE_HIGH>;
				wlan_hostwake = <&pio 6 15 GPIO_ACTIVE_HIGH>;
				wakeup-source;
				phandle = <0xcd>;
			};

			bt: bt {
				compatible = "allwinner,sunxi-bt";
				clocks = <&rtc_ccu CLK_OSC32K_OUT>;
				clock-names = "osc32k-out";
				bt_power;
				bt_rst_n = <&pio 6 19 GPIO_ACTIVE_LOW>;
				phandle = <0xce>;
			};
		};

		addr_mgt: addr_mgt {
			compatible = "allwinner,sunxi-addr_mgt";
			status = "okay";
			type_addr_wifi = <0>;
			type_addr_bt = <0>;
			type_addr_eth = <0>;
			phandle = <0xcf>;
		};

		btlpm: btlpm {
			compatible = "allwinner,sunxi-btlpm";
			status = "okay";
			uart_index = <1>;
			bt_wake = <&pio 6 17 GPIO_ACTIVE_HIGH>;
			bt_hostwake = <&pio 6 16 GPIO_ACTIVE_LOW>;
			wakeup-source;
			phandle = <0xd0>;
		};

		card0_boot_para@2 {
			reg = <0x00 0x02 0x00 0x00>;
			device_type = "card0_boot_para";
			card_ctrl = <0>;
			card_high_speed = <1>;
			card_line = <4>;
			pinctrl-0 = <&sdc0_pins_a>;
		};

		card2_boot_para@3 {
			reg = <0x00 0x03 0x00 0x00>;
			device_type = "card2_boot_para";
			card_ctrl = <2>;
			card_high_speed = <1>;
			card_line = <8>;
			pinctrl-0 = <&sdc2_pins_a>, <&sdc2_pins_c>;
			sdc_ex_dly_used = <2>;
			sdc_io_1v8 = <1>;
			sdc_type = "tm4";
		};

		clk_pll_video2: pll_video2 {
			#clock-cells = <0>;
			compatible = "allwinner,pll-clock";
			lock-mode = "new";
			assigned-clocks = <&clk_pll_video2>;
			clock-output-names = "pll_video2";
			phandle = <0x64>;
		};

		clk_pll_de: pll_de {
			#clock-cells = <0>;
			compatible = "allwinner,pll-clock";
			assigned-clocks = <&clk_pll_de>;
			assigned-clock-rates = <696000000>;
			lock-mode = "new";
			clock-output-names = "pll_de";
			phandle = <0x65>;
		};

		clk_de: de {
			#clock-cells = <0>;
			compatible = "allwinner,periph-clock";
			assigned-clock-parents = <&clk_pll_de>;
			assigned-clock-rates = <696000000>;
			assigned-clocks = <&clk_de>;
			clock-output-names = "de";
			phandle = <0x66>;
		};

		clk_display_top: display_top {
			#clock-cells = <0>;
			compatible = "allwinner,periph-clock";
			clock-output-names = "display_top";
			phandle = <0x6e>;
		};

		clk_tcon_lcd: tcon_lcd {
			#clock-cells = <0>;
			compatible = "allwinner,periph-clock";
			clock-output-names = "tcon_lcd";
			phandle = <0x6f>;
		};

		clk_tcon_lcd1: tcon_lcd1 {
			#clock-cells = <0>;
			compatible = "allwinner,periph-clock";
			clock-output-names = "tcon_lcd1";
			phandle = <0x70>;
		};

		clk_tcon_tv: tcon_tv {
			#clock-cells = <0>;
			compatible = "allwinner,periph-clock";
			assigned-clock-parents = <&clk_pll_video2>;
			assigned-clocks = <&clk_tcon_tv>;
			clock-output-names = "tcon_tv";
			phandle = <0x67>;
		};

		clk_tcon_tv1: tcon_tv1 {
			#clock-cells = <0>;
			compatible = "allwinner,periph-clock";
			clock-output-names = "tcon_tv1";
			phandle = <0x71>;
		};

		clk_lvds: lvds {
			#clock-cells = <0>;
			compatible = "allwinner,periph-clock";
			clock-output-names = "lvds";
			assigned-clocks = <&clk_lvds>;
			phandle = <0x68>;
		};

		clk_hdmi: hdmi {
			#clock-cells = <0>;
			compatible = "allwinner,periph-clock";
			assigned-clock-parents = <&clk_pll_video2>;
			assigned-clocks = <&clk_hdmi>;
			clock-output-names = "hdmi";
			phandle = <0x69>;
		};

		clk_hdmi_slow: hdmi_slow {
			#clock-cells = <0>;
			compatible = "allwinner,periph-clock";
			assigned-clocks = <&clk_hdmi_slow>;
			clock-output-names = "hdmi_slow";
			phandle = <0x6a>;
		};

		clk_hdmi_cec: hdmi_cec {
			#clock-cells = <0>;
			compatible = "allwinner,periph-clock";
			assigned-clocks = <&clk_hdmi_cec>;
			clock-output-names = "hdmi_cec";
			phandle = <0x6b>;
		};

		clk_hdmi_hdcp: hdmi_hdcp {
			#clock-cells = <0>;
			compatible = "allwinner,periph-clock";
			assigned-clock-parents = <&clk_pll_periph1>;
			assigned-clocks = <&clk_hdmi_hdcp>;
			clock-output-names = "hdmi_hdcp";
			phandle = <0x6d>;
		};

		clk_pll_periph1: pll_periph1 {
			#clock-cells = <0>;
			compatible = "allwinner,pll-clock";
			assigned-clocks = <&clk_pll_periph1>;
			assigned-clock-rates = <600000000>;
			lock-mode = "new";
			clock-output-names = "pll_periph1";
			phandle = <0x6c>;
		};

		auto_print@54321 {
			reg = <0x00 0x54321 0x00 0x00>;
			device_type = "auto_print";
			status = "disabled";
		};

		aw_vfd: aw_vfd {
			compatible = "amediatech,yxt_vfd";
			vfd_data_gpio = <&pio 2 2 GPIO_ACTIVE_HIGH>;
			vfd_clock_gpio = <&pio 2 7 GPIO_ACTIVE_HIGH>;
			vfd_stb_gpio = <&pio 2 12 GPIO_ACTIVE_HIGH>;
			status = "okay";
			phandle = <0xd1>;
		};
	};

	uboot_disp: uboot_disp@1000000 {
		compatible = "allwinner,sunxi-disp";
		reg = <0x00 0x1000000 0x00 0x1400000 0x00 0x6510000 0x00 0x200 0x00 0x6511000 0x00 0x1000 0x00 0x6512000 0x00 0x1000 0x00 0x6515000 0x00 0x1000 0x00 0x6516000 0x00 0x1000>;
		interrupts = <GIC_SPI 88 IRQ_TYPE_LEVEL_HIGH>,
		             <GIC_SPI 64 IRQ_TYPE_LEVEL_HIGH>,
		             <GIC_SPI 65 IRQ_TYPE_LEVEL_HIGH>,
		             <GIC_SPI 66 IRQ_TYPE_LEVEL_HIGH>,
		             <GIC_SPI 67 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&clk_de>,
		         <&clk_display_top>,
		         <&clk_tcon_lcd>,
		         <&clk_tcon_lcd1>,
		         <&clk_tcon_tv>,
		         <&clk_tcon_tv1>,
		         <&clk_lvds>;
		boot_disp = <0>;
		fb_base = <0>;
		phandle = <0xd2>;
	};

	uboot_hdmi: uboot_hdmi@6000000 {
		compatible = "allwinner,sunxi-hdmi";
		reg = <0x00 0x6000000 0x00 0x100000>;
		interrupts = <GIC_SPI 63 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&clk_hdmi>, <&clk_hdmi_slow>, <&clk_hdmi_hdcp>, <&clk_hdmi_cec>;
		phandle = <0xd3>;
	};

	thermal-zones {

		cpu_thermal_zone {
			polling-delay-passive = <500>;
			polling-delay = <1000>;
			thermal-sensors = <&ths 2>;
			sustainable-power = <927>;

			cpu_trips: trips {
				phandle = <0xd4>;

				cpu_threshold: trip-point@0 {
					temperature = <70000>;
					type = "passive";
					hysteresis = <0>;
					phandle = <0xd5>;
				};

				cpu_target: trip-point@1 {
					temperature = <90000>;
					type = "passive";
					hysteresis = <0>;
					phandle = <0x73>;
				};

				cpu_crit: cpu_crit@0 {
					temperature = <115000>;
					type = "critical";
					hysteresis = <0>;
					phandle = <0xd6>;
				};
			};

			cooling-maps {

				map0 {
					trip = <&cpu_target>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
					contribution = <1024>;
				};

				map1 {
					trip = <&cpu_target>;
					cooling-device = <&gpu THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
					contribution = <1024>;
				};
			};
		};

		ddr_thermal_zone {
			polling-delay-passive = <0>;
			polling-delay = <0>;
			thermal-sensors = <&ths 3>;
		};

		gpu_thermal_zone {
			polling-delay-passive = <500>;
			polling-delay = <1000>;
			thermal-sensors = <&ths 0>;
			sustainable-power = <1100>;
		};

		ve_thermal_zone {
			polling-delay-passive = <0>;
			polling-delay = <0>;
			thermal-sensors = <&ths 1>;
		};
	};

	usb0_drvvbus: usb0-drvvvbus {
		compatible = "regulator-fixed";
		regulator-name = "usb0-drvvbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-enable-ramp-delay = <1000>;
		gpio = <&pio 7 8 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		phandle = <0x5f>;
	};

	box_start_os0 {
		compatible = "allwinner,box_start_os";
		start_type = <1>;
		irkey_used = <0>;
		pmukey_used = <0>;
		pmukey_num = <0>;
		led_power = <0>;
		led_state = <0>;
		pinctrl-0 = <&standby_blue>;
		pinctrl-1 = <&standby_red>;
	};
};
