			i_cpu_efuse: i-cpu@28 {
				reg = <0x28 0x02>;
				phandle = <0x85>;
			};

			secure_status {
				reg = <0x00 0x00>;
				offset = <0xa0>;
				size = <0x04>;
			};

			chipid {
				reg = <0x00 0x00>;
				offset = <0x200>;
				size = <0x10>;
			};

			rotpk {
				reg = <0x00 0x00>;
				offset = <0x270>;
				size = <0x20>;
			};
		};

