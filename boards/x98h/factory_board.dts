/dts-v1/;

/* dt-bindings from orangepi-xunlong/linux-orangepi orange-pi-5.4-sun50iw9 (3a4a29414d558664847202f4d8919b8ab8bcf4a8), include/ */
#include <dt-bindings/clock/sun50iw9-ccu.h>
#include <dt-bindings/clock/sun50iw9-r-ccu.h>
#include <dt-bindings/clock/sun50iw9-ccu-rtc.h>
#include <dt-bindings/reset/sun50iw9-ccu.h>
#include <dt-bindings/reset/sun50iw9-r-ccu.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/input/linux-event-codes.h>
#include <dt-bindings/thermal/thermal.h>

/ {
	interrupt-parent = <&wakeupgen>;
	#address-cells = <2>;
	#size-cells = <2>;
	model = "sun50iw9";
	compatible = "allwinner,h616", "arm,sun50iw9p1";

	aliases {
		serial0 = &uart0;
		serial1 = &uart1;
		serial2 = &uart2;
		serial3 = &uart3;
		serial4 = &uart4;
		serial5 = &uart5;
		pwm = &pwm;
		pwm0 = &pwm0;
		pwm1 = &pwm1;
		pwm2 = &pwm2;
		pwm3 = &pwm3;
		pwm4 = &pwm4;
		pwm5 = &pwm5;
		ir0 = &s_cir0;
		mmc0 = &sdc0;
		mmc2 = &sdc2;
		tv0 = &tv0;
		gmac0 = &gmac0;
		gmac1 = &gmac1;
		ac200 = &ac200;
		nand0 = &nand0;
		ve0 = &ve;
		ve1 = &ve1;
		disp = &uboot_disp;
		lcd0 = &lcd0;
		pmu0 = &pmu0;
		standby_param = &standby_param;
		hdmi = &uboot_hdmi;
		spi0 = &spi0;
		spi1 = &spi1;
		twi0 = &twi0;
		twi1 = &twi1;
		twi2 = &twi2;
		twi3 = &twi3;
		twi4 = &twi4;
		twi5 = &twi5;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		bl31 {
			reg = <0x00 0x48000000 0x00 0x1000000>;
		};
	};

	firmware {

		android {
			compatible = "android,firmware";
			boot_devices = "soc@3000000/4020000.sdmmc,soc@3000000/4022000.sdmmc,soc@3000000";

			vbmeta {
				compatible = "android,vbmeta";
				parts = "vbmeta,vbmeta_system,vbmeta_vendor,boot";
			};
		};

		optee {
			compatible = "linaro,optee-tz";
			method = "smc";
		};
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu0: cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x00>;
			enable-method = "psci";
			clocks = <&ccu CLK_CPUX>;
			operating-points-v2 = <&cpu_opp_table>;
			cpu-idle-states = <&CPU_SLEEP>;
			dynamic-power-coefficient = <202>;
			#cooling-cells = <2>;
			cpu-supply = <&reg_dcdc2>;
			phandle = <0x74>;
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x01>;
			enable-method = "psci";
			clocks = <&ccu CLK_CPUX>;
			operating-points-v2 = <&cpu_opp_table>;
			cpu-idle-states = <&CPU_SLEEP>;
			dynamic-power-coefficient = <202>;
			#cooling-cells = <2>;
		};

		cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x02>;
			enable-method = "psci";
			clocks = <&ccu CLK_CPUX>;
			operating-points-v2 = <&cpu_opp_table>;
			cpu-idle-states = <&CPU_SLEEP>;
			dynamic-power-coefficient = <202>;
			#cooling-cells = <2>;
		};

		cpu@3 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x03>;
			enable-method = "psci";
			clocks = <&ccu CLK_CPUX>;
			operating-points-v2 = <&cpu_opp_table>;
			cpu-idle-states = <&CPU_SLEEP>;
			dynamic-power-coefficient = <202>;
			#cooling-cells = <2>;
		};

		idle-states {
			entry-method = "psci";

			CPU_SLEEP: cpu-sleep {
				compatible = "arm,idle-state";
				local-timer-stop;
				arm,psci-suspend-param = <0x10000>;
				entry-latency-us = <46>;
				exit-latency-us = <59>;
				min-residency-us = <3570>;
				phandle = <0x04>;
			};
		};
	};

	cpu_opp_table: cpu-opp-table {
		compatible = "allwinner,sun50i-operating-points";
		nvmem-cells = <&speedbin_efuse>;
		nvmem-cell-names = "speed";
		opp-shared;
		phandle = <0x03>;

		opp@480000000 {
			opp-hz = /bits/ 64 <480000000>;
			opp-microvolt-a0 = <900000>;
			opp-microvolt-a1 = <900000>;
			opp-microvolt-a2 = <900000>;
			opp-microvolt-a3 = <900000>;
			opp-microvolt-a4 = <900000>;
			opp-microvolt-a5 = <900000>;
			opp-microvolt-a6 = <900000>;
			clock-latency-ns = <244144>;
			opp-supported-hw = <0x7f>;
		};

		opp@600000000 {
			opp-hz = /bits/ 64 <600000000>;
			opp-microvolt-a1 = <900000>;
			opp-microvolt-a4 = <900000>;
			opp-microvolt-a6 = <900000>;
			clock-latency-ns = <244144>;
			opp-supported-hw = <0x52>;
		};

		opp@720000000 {
			opp-hz = /bits/ 64 <720000000>;
			opp-microvolt-a0 = <900000>;
			opp-microvolt-a2 = <900000>;
			opp-microvolt-a3 = <900000>;
			opp-microvolt-a5 = <950000>;
			clock-latency-ns = <244144>;
			opp-supported-hw = <0x2d>;
		};

		opp@792000000 {
			opp-hz = /bits/ 64 <792000000>;
			opp-microvolt-a1 = <900000>;
			opp-microvolt-a4 = <940000>;
			opp-microvolt-a6 = <940000>;
			clock-latency-ns = <244144>;
			opp-supported-hw = <0x52>;
		};

		opp@936000000 {
			opp-hz = /bits/ 64 <936000000>;
			opp-microvolt-a2 = <900000>;
			opp-microvolt-a3 = <900000>;
			opp-microvolt-a5 = <950000>;
			clock-latency-ns = <244144>;
			opp-supported-hw = <0x2c>;
		};

		opp@1008000000 {
			opp-hz = /bits/ 64 <1008000000>;
			opp-microvolt-a1 = <940000>;
			opp-microvolt-a2 = <950000>;
			opp-microvolt-a3 = <950000>;
			opp-microvolt-a4 = <1020000>;
			opp-microvolt-a5 = <1000000>;
			opp-microvolt-a6 = <1020000>;
			clock-latency-ns = <244144>;
			opp-supported-hw = <0x7e>;
		};

		opp@1032000000 {
			opp-hz = /bits/ 64 <1032000000>;
			opp-microvolt-a0 = <900000>;
			clock-latency-ns = <244144>;
			opp-supported-hw = <0x01>;
		};

		opp@1104000000 {
			opp-hz = /bits/ 64 <1104000000>;
			opp-microvolt-a0 = <950000>;
			opp-microvolt-a2 = <1000000>;
			opp-microvolt-a3 = <1000000>;
			opp-microvolt-a5 = <1050000>;
			clock-latency-ns = <244144>;
			opp-supported-hw = <0x2d>;
		};

		opp@1200000000 {
			opp-hz = /bits/ 64 <1200000000>;
			opp-microvolt-a0 = <1000000>;
			opp-microvolt-a1 = <1020000>;
			opp-microvolt-a2 = <1050000>;
			opp-microvolt-a3 = <1050000>;
			opp-microvolt-a4 = <1100000>;
			opp-microvolt-a5 = <1100000>;
			opp-microvolt-a6 = <1100000>;
			clock-latency-ns = <244144>;
			opp-supported-hw = <0x7f>;
		};

		opp@1296000000 {
			opp-hz = /bits/ 64 <1296000000>;
			opp-microvolt-a0 = <1050000>;
			clock-latency-ns = <244144>;
			opp-supported-hw = <0x01>;
		};

		opp@1320000000 {
			opp-hz = /bits/ 64 <1320000000>;
			opp-microvolt-a2 = <1100000>;
			opp-microvolt-a3 = <1100000>;
			opp-microvolt-a5 = <1150000>;
			clock-latency-ns = <244144>;
			opp-supported-hw = <0x2c>;
		};

		opp@1344000000 {
			opp-hz = /bits/ 64 <1344000000>;
			opp-microvolt-a4 = <1120000>;
			opp-microvolt-a6 = <1120000>;
			clock-latency-ns = <244144>;
			opp-supported-hw = <0x50>;
		};

		opp@1416000000 {
			opp-hz = /bits/ 64 <1416000000>;
			opp-microvolt-a0 = <1100000>;
			opp-microvolt-a2 = <1150000>;
			opp-microvolt-a3 = <1160000>;
			clock-latency-ns = <244144>;
			opp-supported-hw = <0x0d>;
		};

		opp@1512000000 {
			opp-hz = /bits/ 64 <1512000000>;
			opp-microvolt-a0 = <1150000>;
			opp-microvolt-a1 = <1100000>;
			opp-microvolt-a3 = <1100000>;
			clock-latency-ns = <244144>;
			opp-supported-hw = <0x0b>;
		};
	};

	dump_reg: dump-reg@20000 {
		compatible = "allwinner,sunxi-dump-reg";
		reg = <0x00 0x20000 0x00 0x04>;
		phandle = <0x78>;
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	iosc: internal-osc-clk {
		#clock-cells = <0>;
		compatible = "fixed-clock";
		clock-frequency = <16000000>;
		clock-accuracy = <0x11e1a300>;
		clock-output-names = "iosc";
		phandle = <0x0c>;
	};

	dcxo24M: dcxo24M-clk {
		#clock-cells = <0>;
		compatible = "fixed-clock";
		clock-frequency = <24000000>;
		clock-output-names = "dcxo24M";
		phandle = <0x0a>;
	};

	osc32k: osc32k-clk {
		#clock-cells = <0>;
		compatible = "fixed-clock";
		clock-frequency = <32768>;
		clock-output-names = "osc32k";
		phandle = <0x0b>;
	};

	gic: interrupt-controller@3021000 {
		compatible = "arm,cortex-a15-gic", "arm,cortex-a9-gic";
		#interrupt-cells = <3>;
		#address-cells = <0>;
		interrupt-controller;
		reg = <0x00 0x3021000 0x00 0x1000 0x00 0x3022000 0x00 0x2000 0x00 0x3024000 0x00 0x2000 0x00 0x3026000 0x00 0x2000>;
		interrupts = <GIC_PPI 9 (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_HIGH)>;
		interrupt-parent = <&gic>;
		phandle = <0x07>;
	};

	wakeupgen: interrupt-controller@0 {
		compatible = "allwinner,sunxi-wakeupgen";
		interrupt-controller;
		#interrupt-cells = <3>;
		interrupt-parent = <&gic>;
		phandle = <0x01>;
	};

	timer_arch {
		compatible = "arm,armv8-timer";
		interrupts = <GIC_PPI 13 (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_LOW)>,
		             <GIC_PPI 14 (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_LOW)>,
		             <GIC_PPI 11 (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_LOW)>,
		             <GIC_PPI 10 (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_LOW)>;
		clock-frequency = <24000000>;
		interrupt-parent = <&gic>;
		arm,no-tick-in-suspend;
	};

	reg_pio1_8: pio-18 {
		compatible = "regulator-fixed";
		regulator-name = "pio-18";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		phandle = <0x17>;
	};

	reg_pio3_3: pio-33 {
		compatible = "regulator-fixed";
		regulator-name = "pio-33";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		phandle = <0x18>;
	};

	dram: dram {
		phandle = <0x79>;
	};

	soc: soc@3000000 {
		compatible = "simple-bus";
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		phandle = <0x7a>;

		disp: disp@1000000 {
			compatible = "allwinner,sunxi-disp";
			reg = <0x00 0x1000000 0x00 0x1400000 0x00 0x6510000 0x00 0x200 0x00 0x6511000 0x00 0x1000 0x00 0x6512000 0x00 0x1000 0x00 0x6515000 0x00 0x1000 0x00 0x6516000 0x00 0x1000>;
			interrupts = <GIC_SPI 88 IRQ_TYPE_LEVEL_HIGH>,
			             <GIC_SPI 64 IRQ_TYPE_LEVEL_HIGH>,
			             <GIC_SPI 65 IRQ_TYPE_LEVEL_HIGH>,
			             <GIC_SPI 66 IRQ_TYPE_LEVEL_HIGH>,
			             <GIC_SPI 67 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_DE>,
			         <&ccu CLK_DE>,
			         <&ccu CLK_BUS_DE>,
			         <&ccu CLK_BUS_DE>,
			         <&ccu CLK_TCON_LCD0>,
			         <&ccu CLK_TCON_LCD1>,
			         <&ccu CLK_TCON_TV0>,
			         <&ccu CLK_TCON_TV1>,
			         <&ccu CLK_BUS_TCON_LCD0>,
			         <&ccu CLK_BUS_TCON_LCD1>,
			         <&ccu CLK_BUS_TCON_TV0>,
			         <&ccu CLK_BUS_TCON_TV1>,
			         <&ccu CLK_BUS_DISPLAY_IF_TOP>,
			         <&ccu CLK_BUS_DISPLAY_IF_TOP>,
			         <&ccu CLK_BUS_DISPLAY_IF_TOP>,
			         <&ccu CLK_BUS_DISPLAY_IF_TOP>;
			clock-names = "clk_de0", "clk_de1", "clk_bus_de0", "clk_bus_de1", "clk_tcon0", "clk_tcon1", "clk_tcon2", "clk_tcon3", "clk_bus_tcon0", "clk_bus_tcon1", "clk_bus_tcon2", "clk_bus_tcon3", "clk_bus_dpss_top0", "clk_bus_dpss_top1", "clk_bus_dpss_top2", "clk_bus_dpss_top3";
			resets = <&ccu RST_BUS_DE>,
			         <&ccu RST_BUS_DE>,
			         <&ccu RST_BUS_TCON_LCD0>,
			         <&ccu RST_BUS_TCON_LCD1>,
			         <&ccu RST_BUS_TCON_TV0>,
			         <&ccu RST_BUS_TCON_TV1>,
			         <&ccu RST_BUS_LVDS>,
			         <&ccu RST_BUS_LVDS>,
			         <&ccu RST_BUS_DISPLAY_IF_TOP>,
			         <&ccu RST_BUS_DISPLAY_IF_TOP>,
			         <&ccu RST_BUS_DISPLAY_IF_TOP>,
			         <&ccu RST_BUS_DISPLAY_IF_TOP>;
			reset-names = "rst_bus_de0", "rst_bus_de1", "rst_bus_tcon0", "rst_bus_tcon1", "rst_bus_tcon2", "rst_bus_tcon3", "rst_bus_lvds0", "rst_bus_lvds1", "rst_bus_dpss_top0", "rst_bus_dpss_top1", "rst_bus_dpss_top2", "rst_bus_dpss_top3";
			assigned-clocks = <&ccu CLK_TCON_TV0>;
			assigned-clock-parents = <&ccu CLK_PLL_VIDEO2>;
			assigned-clock-rates = <0>;
			iommus = <&mmu_aw 0 0>;
			boot_disp = <0>;
			fb_base = <0>;
			disp_init_enable = <1>;
			disp_mode = <0>;
			screen0_output_type = <3>;
			screen0_output_mode = <10>;
			screen0_output_format = <0>;
			screen0_output_bits = <0>;
			screen0_output_eotf = <4>;
			screen0_output_cs = <257>;
			screen0_output_dvi_hdmi = <2>;
			screen0_output_range = <2>;
			screen0_output_scan = <0>;
			screen0_output_aspect_ratio = <8>;
			screen1_output_type = <2>;
			screen1_output_mode = <11>;
			screen1_output_format = <1>;
			screen1_output_bits = <0>;
			screen1_output_eotf = <4>;
			screen1_output_cs = <260>;
			screen1_output_dvi_hdmi = <0>;
			screen1_output_range = <2>;
			screen1_output_scan = <0>;
			screen1_output_aspect_ratio = <8>;
			dev0_output_type = <4>;
			dev0_output_mode = <10>;
			dev0_screen_id = <0>;
			dev0_do_hpd = <1>;
			dev1_output_type = <2>;
			dev1_output_mode = <11>;
			dev1_screen_id = <1>;
			dev1_do_hpd = <1>;
			dev2_output_type = <0>;
			def_output_dev = <0>;
			hdmi_mode_check = <1>;
			fb0_format = <0>;
			fb0_width = <1280>;
			fb0_height = <720>;
			fb1_format = <0>;
			fb1_width = <0>;
			fb1_height = <0>;
			chn_cfg_mode = <1>;
			disp_para_zone = <1>;
			phandle = <0x7b>;
		};

		ve: ve@1c0e000 {
			compatible = "allwinner,sunxi-cedar-ve";
			reg = <0x00 0x1c0e000 0x00 0x1000 0x00 0x3000000 0x00 0x10 0x00 0x3001000 0x00 0x1000>;
			interrupts = <GIC_SPI 93 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_BUS_VE>, <&ccu CLK_VE>, <&ccu CLK_MBUS_VE>;
			clock-names = "bus_ve", "ve", "mbus_ve";
			resets = <&ccu RST_BUS_VE>;
			iommus = <&mmu_aw 3 1>;
			phandle = <0x7c>;
		};

		ve1: ve1@1c0e000 {
			compatible = "allwinner,sunxi-cedar-ve";
			iommus = <&mmu_aw 2 1>;
			phandle = <0x7d>;
		};

		g2d: g2d@1480000 {
			compatible = "allwinner,sunxi-g2d";
			reg = <0x00 0x1480000 0x00 0x3ffff>;
			interrupts = <GIC_SPI 90 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_BUS_G2D>, <&ccu CLK_G2D>, <&ccu CLK_MBUS_G2D>;
			clock-names = "bus", "g2d", "mbus_g2d";
			resets = <&ccu RST_BUS_G2D>;
			iommus = <&mmu_aw 6 1>;
			phandle = <0x7e>;
		};

		di: deinterlace@1420000 {
			#address-cells = <1>;
			#size-cells = <0>;
			compatible = "allwinner,sunxi-deinterlace";
			reg = <0x00 0x1420000 0x00 0x40000>;
			interrupts = <GIC_SPI 89 IRQ_TYPE_LEVEL_HIGH>;
			iommus = <&mmu_aw 1 1>;
			status = "okay";
			clocks = <&ccu CLK_DI>, <&ccu CLK_BUS_DI>, <&ccu CLK_PLL_PERIPH0_2X>;
			clock-names = "clk_di", "clk_bus_di", "pll_periph";
			resets = <&ccu RST_BUS_DI>;
			reset-names = "rst_bus_di";
			assigned-clocks = <&ccu CLK_DI>;
			assigned-clock-parents = <&ccu CLK_PLL_PERIPH0_2X>;
			assigned-clock-rates = <300000000>;
			phandle = <0x7f>;
		};

		gpu: gpu@1800000 {
			device_type = "gpu";
			compatible = "arm,mali-midgard";
			reg = <0x00 0x1800000 0x00 0x10000>;
			interrupts = <GIC_SPI 95 IRQ_TYPE_LEVEL_HIGH>,
			             <GIC_SPI 96 IRQ_TYPE_LEVEL_HIGH>,
			             <GIC_SPI 97 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "JOB", "MMU", "GPU";
			clocks = <&ccu CLK_PLL_GPU>,
			         <&ccu CLK_GPU0>,
			         <&ccu CLK_GPU1>,
			         <&ccu CLK_BUS_GPU>;
			clock-names = "clk_parent", "clk_mali", "clk_bak", "clk_bus";
			resets = <&ccu RST_BUS_GPU>;
			#cooling-cells = <2>;
			gpu_idle = <1>;
			dvfs_status = <1>;
			operating-points = <600000 950000 576000 950000 540000 950000 504000 950000 456000 950000 420000 950000 384000 950000 360000 950000 336000 950000 306000 950000>;
			phandle = <0x75>;

			ipa_dvfs: ipa_dvfs {
				compatible = "arm,mali-simple-power-model";
				static-coefficient = <17000>;
				dynamic-coefficient = <750>;
				ts = <254682 9576 4294967192 4>;
				thermal-zone = "gpu_thermal_zone";
				ss-coefficient = <36>;
				ff-coefficient = <291>;
				phandle = <0x80>;
			};
		};

		lcd0: lcd0@1c0c000 {
			compatible = "allwinner,sunxi-lcd0";
			reg = <0x00 0x1c0c000 0x00 0x00>;
			pinctrl-names = "active", "sleep";
			lcd_used = <0>;
			lcd_driver_name = "default_lcd";
			lcd_backlight = <50>;
			lcd_if = <0>;
			lcd_x = <1280>;
			lcd_y = <720>;
			lcd_width = <150>;
			lcd_height = <94>;
			lcd_dclk_freq = <70>;
			lcd_pwm_used = <0>;
			lcd_pwm_ch = <0>;
			lcd_pwm_freq = <50000>;
			lcd_pwm_pol = <0>;
			lcd_pwm_max_limit = <255>;
			lcd_hbp = <20>;
			lcd_ht = <1418>;
			lcd_hspw = <10>;
			lcd_vbp = <10>;
			lcd_vt = <814>;
			lcd_vspw = <5>;
			lcd_lvds_if = <0>;
			lcd_lvds_colordepth = <0>;
			lcd_lvds_mode = <0>;
			lcd_frm = <0>;
			lcd_hv_clk_phase = <0>;
			lcd_hv_sync_polarity = <0>;
			lcd_gamma_en = <0>;
			lcd_bright_curve_en = <0>;
			lcd_cmap_en = <0>;
			deu_mode = <0>;
			lcdgamma4iep = <22>;
			smart_color = <90>;
			lcd_pin_power = "bldo1";
			lcd_power = "dc1sw";
			phandle = <0x81>;
		};

		tv0: tv0@6520000 {
			compatible = "allwinner,sunxi-tv";
			reg = <0x00 0x6520000 0x00 0x100 0x00 0x6524000 0x00 0x3fc>;
			clocks = <&ccu CLK_BUS_TVE_TOP>, <&ccu CLK_TVE>, <&ccu CLK_BUS_TVE>;
			clock-names = "clk_bus_tve_top", "clk_tve", "clk_bus_tve";
			resets = <&ccu RST_BUS_TVE_TOP>, <&ccu RST_BUS_TVE>;
			reset-names = "rst_bus_tve_top", "rst_bus_tve";
			assigned-clocks = <&ccu CLK_TVE>;
			assigned-clock-parents = <&ccu CLK_PLL_VIDEO1>;
			nvmem-cells = <&tvout>;
			nvmem-cell-names = "tvout";
			device_type = "tv0";
			pinctrl-names = "active", "sleep";
			status = "okay";
			interface = <1>;
			dac_type0 = <0>;
			dac_src0 = <0>;
			phandle = <0x82>;
		};

		ccu: ccu@3001000 {
			compatible = "allwinner,sun50iw9-ccu";
