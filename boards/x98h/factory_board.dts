				pins = "PA6", "PA7", "PA8", "PA9";
				function = "i2s0";
				drive-strength = <20>;
				bias-disable;
				phandle = <0x8b>;
			};

			ahub_daudio0_pins_b: ahub_daudio0_sleep@0 {
				pins = "PA6", "PA7", "PA8", "PA9";
				function = "gpio_in";
				drive-strength = <20>;
				bias-disable;
				phandle = <0x8c>;
			};

			ahub_daudio2_pins_a: ahub_daudio2@0 {
				pins = "PG11", "PG12";
				function = "i2s2";
				drive-strength = <20>;
				bias-disable;
				phandle = <0x4c>;
			};

			ahub_daudio2_pins_b: ahub_daudio2@1 {
				pins = "PG13";
				function = "i2s2_dout0";
				drive-strength = <20>;
				bias-disable;
				phandle = <0x4d>;
			};

			ahub_daudio2_pins_c: ahub_daudio2@2 {
				pins = "PG14";
				function = "i2s2_din0";
				drive-strength = <20>;
				bias-disable;
				phandle = <0x4e>;
			};

			ahub_daudio2_pins_d: ahub_daudio2_sleep@0 {
				pins = "PG11", "PG12", "PG13", "PG14";
				function = "gpio_in";
				drive-strength = <20>;
				bias-disable;
				phandle = <0x4f>;
			};

			ahub_daudio3_pins_a: ahub_daudio3@0 {
				pins = "PH5", "PH6", "PH7";
				function = "i2s3";
				drive-strength = <20>;
				bias-disable;
				phandle = <0x8d>;
			};

			ahub_daudio3_pins_b: ahub_daudio3@1 {
				pins = "PH8";
				function = "i2s3_dout0";
				drive-strength = <20>;
				bias-disable;
				phandle = <0x8e>;
			};

			ahub_daudio3_pins_c: ahub_daudio3@2 {
				pins = "PH9";
				function = "i2s3_din0";
				drive-strength = <20>;
				bias-disable;
				phandle = <0x8f>;
			};

			ahub_daudio3_pins_d: ahub_daudio3_sleep@0 {
				pins = "PH5", "PH6", "PH7", "PH8", "PH9";
				function = "gpio_in";
				drive-strength = <20>;
				bias-disable;
				phandle = <0x90>;
			};

			standby_red: standby@0 {
				allwinner,pins = "PH6";
				allwinner,function = "gpio_out";
				allwinner,muxsel = <1>;
				allwinner,data = <1>;
				allwinner,drive = <0>;
				allwinner,pull = <0>;
				phandle = <0x77>;
			};

			standby_blue: standby@1 {
				allwinner,pins = "PH7";
				allwinner,function = "gpio_out";
				allwinner,muxsel = <1>;
				allwinner,data = <0>;
				allwinner,drive = <2>;
				allwinner,pull = <2>;
				phandle = <0x76>;
			};

			standby_bt: standby@2 {
				allwinner,pins = "PG16";
				allwinner,function = "gpio_in";
				allwinner,muxsel = <0>;
				allwinner,data = <0>;
				allwinner,drive = <0>;
				allwinner,pull = <0>;
				phandle = <0x91>;
			};

			clk_losc_pins_a: losc_out@0 {
				allwinner,pins = "PG10";
				allwinner,function = "x32kfout";
				allwinner,muxsel = <3>;
				allwinner,drive = <2>;
				allwinner,pull = <1>;
				phandle = <0x63>;
			};
		};

		r_pio: pinctrl@7022000 {
			compatible = "allwinner,sun50iw9-r-pinctrl";
			reg = <0x00 0x7022000 0x00 0x400>;
			clocks = <&r_ccu CLK_R_APB1>, <&dcxo24M>, <&osc32k>;
			clock-names = "apb", "hosc", "losc";
			gpio-controller;
			#gpio-cells = <3>;
			phandle = <0x92>;

			s_twi0_pins_a: s_twi0@0 {
				pins = "PL0", "PL1";
				function = "s_twi0";
				drive-strength = <20>;
				bias-pull-up;
				phandle = <0x40>;
			};

			s_twi0_pins_b: s_twi0@1 {
				pins = "PL0", "PL1";
				function = "gpio_in";
				phandle = <0x41>;
			};
		};

		mmu_aw: iommu@30f0000 {
