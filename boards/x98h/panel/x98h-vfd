#!/usr/bin/env python3
"""x98h-vfd - put text on the X98H front panel.

Normally this is a thin client for the vfdd daemon (which shows the clock when
idle, so your message temporarily takes over and then yields back). If the
daemon isn't running it drives the pins directly.

    x98h-vfd "HELLO"                  show 4 chars for a moment
    x98h-vfd --scroll "ALL SYSTEMS GO" --loops 2
    x98h-vfd --scroll "1234567890" --duration 30s
    x98h-vfd --hold "CHECK SD"       stay until: x98h-vfd --release
    x98h-vfd --status / --release / --off

Durations accept s, m, h (e.g. 45s, 10m, 1h30m). Text length is unlimited;
long text scrolls.

7-segment letters: X/K/M/W render as H, Z/S as 2, G as 6, N as n, V as U.
"""

import argparse
import json
import os
import re
import socket
import sys
sys.path.insert(0, "/usr/lib/tvb")
import time

SOCK = "/run/x98h-vfd.sock"


def parse_duration(s):
    if s is None:
        return None
    s = str(s).strip()
    if re.fullmatch(r"\d+(\.\d+)?", s):
        return float(s)
    total = 0.0
    for num, unit in re.findall(r"(\d+(?:\.\d+)?)\s*([hms]?)", s):
        if not num:
            continue
        v = float(num)
        total += v * {"h": 3600, "m": 60, "s": 1, "": 1}[unit]
    return total or None


def send(req, timeout=2.0):
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(timeout)
    try:
        s.connect(SOCK)
        s.sendall((json.dumps(req) + "\n").encode())
        data = s.recv(4096).decode().strip()
    except (FileNotFoundError, ConnectionRefusedError):
        return None
    finally:
        s.close()
    try:
        return json.loads(data)
    except ValueError:
        return {"ok": False, "error": data}


def direct(args):
    """Fallback: drive the panel ourselves when vfdd is not running."""
    from x98h_vfd import Vfd, open_lines, render
    with open_lines() as req:
        v = Vfd(req)
        if args.off:
            v.off()
            return True
        text = args.text or args.scroll or ""
        icons = list(args.icon)
        if ":" in text and "colon" not in icons:
            icons.append("colon")
        text = text.replace(":", "")
        if args.scroll:
            framed = "    " + text + "    "
            loops = args.loops or 1
            for _ in range(loops):
                for i in range(len(framed) - 3):
                    v.commit(render(framed[i:i + 4]), args.bright, icons)
                    time.sleep(args.delay)
            return True
        v.commit(render(text[:4]), args.bright, icons)
        return True


def main():
    ap = argparse.ArgumentParser(description="put text on the X98H front display")
    ap.add_argument("text", nargs="?", help="text to show (4 chars, or scrolls if --scroll)")
    ap.add_argument("--scroll", metavar="TEXT", help="scroll this text")
    ap.add_argument("--delay", type=float, default=0.35, help="scroll step seconds")
    ap.add_argument("--loops", type=int, default=0, help="scroll repetitions (0 = once)")
    ap.add_argument("--duration", help="yield the display after this (e.g. 30s, 10m, 1h)")
    ap.add_argument("--hold", action="store_true",
                    help="keep it on screen until --release or a higher priority message")
    ap.add_argument("--priority", type=int, default=10)
    ap.add_argument("--bright", type=int, default=7, choices=range(8))
    ap.add_argument("--icon", action="append", default=[], help="usb|card|colon|hd|cvbs")
    ap.add_argument("--reverse", action="store_true")
    ap.add_argument("--status", action="store_true")
    ap.add_argument("--release", action="store_true")
    ap.add_argument("--off", action="store_true")
    ap.add_argument("--direct", action="store_true", help="bypass the daemon")
    ap.add_argument("--test", action="store_true", help="count 0..9 (direct)")
    args = ap.parse_args()

    if args.status:
        r = send({"op": "status"})
        print(json.dumps(r) if r else "vfdd not running")
        return 0
    if args.release:
        r = send({"op": "release"})
        print(json.dumps(r) if r else "vfdd not running")
        return 0

    if args.direct or args.test:
        return 0 if direct(args) else 1

    text = args.text or args.scroll or ""
    if not text and not args.off:
        ap.print_help()
        return 1

    req = {
        "op": "show",
        "text": text,
        "scroll": bool(args.scroll),
        "delay": args.delay,
        "loops": args.loops,
        "duration": parse_duration(args.duration),
        "hold": args.hold,
        "priority": args.priority,
        "bright": args.bright,
        "icons": list(args.icon),
    }
    if ":" in text and "colon" not in req["icons"]:
        req["icons"].append("colon")
        req["text"] = text.replace(":", "")

    # sensible defaults: a plain message shows briefly; scroll does one pass
    if not req["hold"]:
        if req["duration"] is None and not req["loops"]:
            if req["scroll"]:
                req["loops"] = 1
            else:
                req["duration"] = 5.0

    r = send(req)
    if r is None:
        print("vfdd not running - driving the panel directly")
        return 0 if direct(args) else 1
    if not r.get("ok"):
        print("rejected:", r.get("error"))
        return 2
    print("queued")
    return 0


if __name__ == "__main__":
    sys.exit(main())
