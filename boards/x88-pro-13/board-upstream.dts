	ir_key13 {
		rockchip,usercode = <0x4040>;
		rockchip,key_table = <0xe5 KEY_HOME>, <0xbd KEY_BACK>, <0xba KEY_MENU>,
		                     <0xf2 KEY_REPLY>, <0xf4 KEY_UP>, <0xf1 KEY_DOWN>,
		                     <0xef KEY_LEFT>, <0xee KEY_RIGHT>,
		                     <0xe3 KEY_VOLUMEDOWN>, <0xea KEY_VOLUMEUP>,
