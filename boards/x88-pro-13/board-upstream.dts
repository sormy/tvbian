&reboot_mode {
	mode-bootloader = <0x5242c301>;
	mode-charge = <0x5242c30b>;
	mode-fastboot = <0x5242c309>;
	mode-loader = <0x5242c301>;
	mode-normal = <0x5242c300>;
	mode-recovery = <0x5242c303>;
	mode-ums = <0x5242c30c>;
	mode-panic = <0x5242c307>;
	mode-watchdog = <0x5242c308>;
};

&rkvtunnel {
	status = "disabled";
};

&rmii0_phy {
	/delete-property/ pinctrl-names;
	/delete-property/ pinctrl-0;
	/delete-property/ rockchip,thermal-zone;
};

&rockchip_suspend {
	rockchip,sleep-mode-config = <RKPM_SLP_ARMPD>;
	rockchip,wakeup-config = <(RKPM_CPU0_WKUP_EN | RKPM_GPIO_WKUP_EN)>;
	rockchip,pwm-regulator-config = <RKPM_PWM1_M0_REGULATOR_EN>;
};

&route_hdmi {
	logo,mode = "fullscreen";
	charge_logo,mode = "fullscreen";
};

&sai1 {
	status = "disabled";
};

&sai3 {
	/delete-property/ assigned-clocks;
	/delete-property/ assigned-clock-rates;
	/delete-property/ rockchip,always-on;
};

&sdhci {
	/delete-property/ no-sd;
	/delete-property/ no-sdio;
	/delete-property/ mmc-hs400-1_8v;
	/delete-property/ mmc-hs400-enhanced-strobe;
	max-frequency = <150000000>;
	supports-emmc;
	cap-mmc-highspeed;
	mmc-hs200-1_8v;
	fixed-emmc-driver-type = <0x04>;
};

&sdio0 {
	max-frequency = <150000000>;
};

&sdio_pwrseq {
	/delete-property/ post-power-on-delay-ms;
	/delete-property/ reset-gpios;
	status = "okay";
};

&sfc {
	status = "disabled";
};

&tve {
	rockchip,tve-upsample = <0x02>;
};

&u2phy_otg {
	/delete-property/ vbus-supply;
	phy-supply = <&vcc5v0_host>;
};

&usbdrd_dwc3 {
	snps,xhci-trb-ent-quirk;
};

&vcc5v0_host {
	gpio = <&gpio4 RK_PB4 GPIO_ACTIVE_HIGH>;
};

&vcc5v0_host_en {
	rockchip,pins = <4 RK_PB4 RK_FUNC_GPIO &pcfg_pull_none>;
};

&vcc5v0_otg {
	status = "disabled";
};

&vcc_sd {
	regulator-boot-on;
};

&vdd_gpu {
	status = "disabled";
};

&vdd_logic {
	regulator-min-microvolt = <703000>;
};

&vop {
	esmart_lb_mode = [03];
};

&wdt {
	/* Let the watchdog recover a hung kernel. */
	status = "okay";
};

&wireless_bluetooth {
	/delete-property/ bt_port;
	/delete-property/ BT,wake_gpio;
};

&wireless_wlan {
	wifi_chip_type = [00];
	WIFI,reset_gpio = <&gpio1 RK_PA6 GPIO_ACTIVE_HIGH>;
};
