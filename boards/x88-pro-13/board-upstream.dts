/dts-v1/;

/*
 * Written by tools/dtcx/upstream.py from board.dts: a view, not edited.
 * Over rockchip-linux/kernel at 77168c8d5ab8.
 */

#include "rk3528-evb1-ddr4-v10.dts"
#include <dt-bindings/clock/rk3528-cru.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pinctrl/rockchip.h>
#include <dt-bindings/input/linux-event-codes.h>
#include <dt-bindings/suspend/rockchip-rk3528.h>

/ {
	compatible = "rockchip,rk3528-hugsun-x88pro-ddr4-v10", "rockchip,rk3528";
	model = "X88 Pro 13";

	vdd_fixed: vdd-fixed {
		compatible = "regulator-fixed";
		regulator-name = "vdd_fixed";
		regulator-min-microvolt = <900000>;
		regulator-max-microvolt = <900000>;
		regulator-always-on;
		regulator-boot-on;
		vin-supply = <&vcc5v0_sys>;
	};

	seekwcn_boot: seekwcn_boot {
		compatible = "seekwave,sv6160";
		dma_type = <0x01>;
		status = "okay";
	};

	skykirin_led {
		compatible = "skykirin-ht1628";
		spi_cs = <&gpio4 RK_PA5 GPIO_ACTIVE_HIGH>;
		spi_clk = <&gpio4 RK_PA4 GPIO_ACTIVE_HIGH>;
		spi_data = <&gpio4 RK_PA6 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};

	leds: gpio-leds {
		compatible = "gpio-leds";

		ir {
			gpios = <&gpio4 RK_PB7 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "none";
			default-state = "off";
		};

		pwr-green {
			gpios = <&gpio4 RK_PC1 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "none";
			default-state = "off";
			retain-state-suspended;
			retain-state-shutdown;
		};
	};

	sky_storage: sky-storage {
		compatible = "rockchip,hgs_vendor_storage";
		status = "okay";
	};
};

&cpu0_opp_table {
	/delete-property/ rockchip,temp-hysteresis;
	/delete-property/ rockchip,low-temp;
	/delete-property/ rockchip,low-temp-min-volt;
	rockchip,pvtm-voltage-sel = <0 1320 0>, <1321 1350 1>, <1351 1375 2>, <1376 1405 3>,
	                            <1406 1435 4>, <1436 1470 5>, <1471 1505 6>,
	                            <1506 1540 7>, <1541 1575 8>, <1576 1610 9>,
	                            <1611 1640 10>, <1641 9999 11>;
};

&dmc {
	status = "disabled";
};

&dmc_opp_table {
	rockchip,leakage-voltage-sel = <1 10 0>, <11 14 1>, <15 22 2>, <23 28 3>,
	                               <29 254 4>;
	/delete-node/ opp-324000000;
	/delete-node/ opp-666000000;
};

&gmac1 {
	status = "disabled";
};

&gpu {
	/* Lima names the GPU interrupts and clocks by function. */
	interrupt-names = "gp", "gpmmu", "pp", "pp0", "ppmmu0", "pp1", "ppmmu1";
	clocks = <&cru ACLK_GPU_MALI>, <&scmi_clk SCMI_CLK_GPU>;
	clock-names = "bus", "core";
	mali-supply = <&vdd_fixed>;
};

&gpu_bus {
	status = "disabled";
};

&gpu_bus_opp_table {
	rockchip,leakage-voltage-sel = <1 22 0>, <23 254 1>;
};

&gpu_opp_table {
	/delete-property/ rockchip,temp-hysteresis;
	/delete-property/ rockchip,low-temp;
	/delete-property/ rockchip,low-temp-min-volt;
	rockchip,pvtm-voltage-sel = <0 750 0>, <751 770 1>, <771 790 2>, <791 810 3>,
	                            <811 830 4>, <831 850 5>, <851 870 6>, <871 890 7>,
	                            <891 9999 8>;
};

&gpu_power_model {
	ls = <0xffffc2d6 0x1071a 0x00>;
	ts = <0x302a42 0x1d55a 0xfffff636 0x27>;
};

&hdmi {
	/delete-property/ rockchip,cts-manual;
};

&i2c1 {
	i2c-scl-rising-time-ns = <100>;
	i2c-scl-falling-time-ns = <30>;
	status = "okay";

	hym8563: hym8563@51 {
		compatible = "haoyu,hym8563";
		reg = <0x51>;
		pinctrl-names = "default";
		pinctrl-0 = <&rtc_irq>;
		irq_gpio = <&gpio4 RK_PB2 2>;
		status = "okay";
	};
};

&i2c6 {
	status = "disabled";
};

&mpp_srv {
	/delete-property/ rockchip,iommu-shared-mask;
};

&pinctrl {
	/delete-node/ sdio-pwrseq;

	wireless-wlan {
		wifi_enable_h: wifi-enable-h {
			rockchip,pins = <1 RK_PA6 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	hym8563-irq {
		rtc_irq: rtc-irq {
			rockchip,pins = <4 RK_PB2 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};

&pwm0 {
	status = "disabled";
};

&pwm1 {
	/delete-property/ interrupts;
};

&pwm2 {
	/delete-property/ interrupts;
};

&pwm3 {
	/delete-node/ ir_key1;
	/delete-node/ ir_key2;
	/delete-node/ ir_key3;
	/delete-node/ ir_key7;
	/delete-node/ ir_key8;
	/delete-node/ ir_key9;

	ir_key4 {
		rockchip,usercode = <0xf709>;
		rockchip,key_table = <0xf5 KEY_POWER>, <0xdd KEY_MICMUTE>, <0xff KEY_UP>,
