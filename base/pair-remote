#!/bin/sh
# Pairs a Bluetooth remote: the user puts it in pairing mode, this finds the first device offering
# the HID service, pairs, trusts and connects it. Exits 0 once its keys arrive as an input device.
set -u
LIMIT_S=120
SCAN_S=60
HID=00001812-0000-1000-8000-00805f9b34fb

work=$(mktemp -d)
trap 'kill "$ctl" 2>/dev/null; rm -rf "$work"' EXIT
mkfifo "$work/in"
timeout "$LIMIT_S" bluetoothctl <"$work/in" >"$work/log" 2>&1 &
ctl=$!
exec 3>"$work/in"
say() { echo "$1" >&3; }
info() { bluetoothctl info "$1" 2>/dev/null; }
# bluetoothctl's last complaint, without its colour codes and prompts
last_error() {
  sed 's/\x1b\[[0-9;]*m//g; s/^.*\] *//; s/^\[[A-Za-z ]*\]> *//' "$work/log" |
    grep -iE "error|fail|not available|timeout|canceled" | tail -1
}

echo "Hold the remote's Left and Right keys until its light blinks, then let go."
echo "Searching for a remote in pairing mode, up to ${SCAN_S} s..."
say "agent NoInputNoOutput"
say "default-agent"
say "pairable on"
say "scan on"

remote=
end=$(($(date +%s) + SCAN_S))
while [ -z "$remote" ] && [ "$(date +%s)" -lt "$end" ]; do
  sleep 2
  for mac in $(bluetoothctl devices | awk '{print $2}'); do
    # advertising now, in this scan: an idle remote bonded here shows no RSSI and is left alone
    details=$(info "$mac")
    echo "$details" | grep -q "RSSI:" || continue
    echo "$details" | grep -q "Connected: yes" && continue
    echo "$details" | grep -q "$HID" && remote=$mac && break
  done
done
[ -n "$remote" ] || { say "scan off"; echo "No remote in pairing mode found."; exit 1; }
echo "Found $(info "$remote" | sed -n 's/^\tName: //p') ($remote)."

# a re-pair starts from no bond at all: the remote has wiped its keys, so the box drops its own,
# then finds the remote afresh; the scan runs on through the pairing, which needs it
if info "$remote" | grep -q "Paired: yes"; then
  echo "It was paired here before: forgetting the old pairing."
  # the session pairs only a device it lists: wait until it finds the remote again after the remove
  seen=$(wc -l <"$work/log")
  say "remove $remote"
  end=$(($(date +%s) + 15))
  until tail -n +"$seen" "$work/log" | grep -q "NEW.*Device $remote" || [ "$(date +%s)" -ge "$end" ]; do
    sleep 1
  done
fi
echo "Pairing..."
say "pair $remote"
end=$(($(date +%s) + 30))
until info "$remote" | grep -q "Bonded: yes"; do
  grep -q "Failed to pair" "$work/log" || [ "$(date +%s)" -ge "$end" ] || { sleep 1; continue; }
  say "quit"
  echo "Pairing failed: $(last_error)"
  exit 1
done
say "scan off"
echo "Paired. Connecting..."
say "trust $remote"
say "connect $remote"
# the input device appears once the remote itself reconnects, which it does on a key press
echo "Press any key on the remote."
end=$(($(date +%s) + 30))
while [ "$(date +%s)" -lt "$end" ]; do
  # its input devices carry its address
  if grep -qix "$remote" /sys/class/input/input*/uniq 2>/dev/null; then
    say "quit"
    echo "Done: the remote is connected and its keys work."
    exit 0
  fi
  sleep 1
done
say "quit"
echo "Paired, but no key arrived: press a key on the remote to connect it."
exit 1
