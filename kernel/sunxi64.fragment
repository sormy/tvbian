CONFIG_LOCALVERSION="-tvb-sunxi64"
# CONFIG_LOCALVERSION_AUTO is not set
# no DWARF and so no BTF: a debug-info tree outgrows a CI runner's disk
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_DWARF5 is not set
# CONFIG_DEBUG_INFO_BTF is not set
# the H616 HDMI pipeline: mixer, TCON TOP, DesignWare HDMI and its CEC
CONFIG_DRM_SUN8I_MIXER=y
CONFIG_DRM_SUN8I_TCON_TOP=y
CONFIG_DRM_SUN8I_DW_HDMI=y
CONFIG_DRM_DW_HDMI_CEC=y
# the H616's analog codec: the AV jack's line out
CONFIG_SND_SUN4I_CODEC=y
# the H616's DI300 deinterlacer
CONFIG_VIDEO_SUN50I_DI300=y
# a module, so it probes once the rootfs holds the keymap module its tree names
CONFIG_IR_SUNXI=m
# built in, its TRNG seeds the entropy pool during probe; systemd-random-seed waited 1.5 s for it
CONFIG_CRYPTO_DEV_SUN8I_CE=y
# a hung task logs; the watchdog, not a panic nothing reboots from, ends a real hang
# CONFIG_BOOTPARAM_HUNG_TASK_PANIC is not set
# the console font fbcon prefers on a TV, as meson64's: 8x16 at 1080p is 240 columns
CONFIG_FONTS=y
CONFIG_FONT_8x8=y
CONFIG_FONT_8x16=y
CONFIG_FONT_TER16x32=y
# every family: a panic reboots, and leaves its log in pstore
CONFIG_PSTORE_RAM=y
CONFIG_PANIC_TIMEOUT=10
# every family: a kernel that preempts anywhere, at a tick 50 and 60 Hz frames both divide; the UI and
# audio threads wait on no kernel loop
CONFIG_PREEMPT=y
CONFIG_HZ_300=y
# every family: a CPU stuck without timer interrupts, or one that never yields, panics into that
# reboot; the watchdog only proves PID 1 runs, on another CPU
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=y
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_HARDLOCKUP_PANIC=y
# the RCU stall warning, at mainline's 21 s, resets the soft-lockup clock: a stuck CPU panicked past
# 45 s, or not at all. 60, as Rockchip's kernel has
CONFIG_RCU_CPU_STALL_TIMEOUT=60
# kexec: a one-shot test boot over the network, as meson64
CONFIG_KEXEC=y
# every family: no boot logo, as rk35xx and meson64
# CONFIG_LOGO is not set
# every family: file names on FAT, NTFS and exFAT disks in UTF-8
CONFIG_NLS_DEFAULT="utf8"
# what rk35xx and meson64 both give every box, and Armbian's defconfig leaves out or turns off
CONFIG_PRINTK_TIME=y
CONFIG_DYNAMIC_DEBUG=y
CONFIG_NETCONSOLE=m
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_STRICT_DEVMEM=y
CONFIG_COMPAT=y
CONFIG_COMPAT_32BIT_TIME=y
CONFIG_KUSER_HELPERS=y
CONFIG_ARMV8_DEPRECATED=y
CONFIG_SWP_EMULATION=y
CONFIG_CP15_BARRIER_EMULATION=y
CONFIG_SETEND_EMULATION=y
CONFIG_ARM64_ERRATUM_845719=y
CONFIG_PSI=y
CONFIG_SCHED_AUTOGROUP=y
CONFIG_CHECKPOINT_RESTORE=y
CONFIG_HUGETLBFS=y
CONFIG_CGROUP_HUGETLB=y
CONFIG_ZSWAP_COMPRESSOR_DEFAULT_ZSTD=y
CONFIG_WQ_POWER_EFFICIENT_DEFAULT=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
# CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER is not set
CONFIG_NTFS3_FS_POSIX_ACL=y
CONFIG_NTFS3_LZX_XPRESS=y
CONFIG_NLS_ASCII=y
CONFIG_HFS_FS=m
CONFIG_HFSPLUS_FS=m
CONFIG_XFS_QUOTA=y
CONFIG_SQUASHFS_4K_DEVBLK_SIZE=y
CONFIG_DM_VERITY=m
CONFIG_DM_MIRROR=m
CONFIG_DM_CACHE=m
CONFIG_DM_ZERO=m
CONFIG_MQ_IOSCHED_KYBER=y
CONFIG_BLK_DEV_RAM=m
CONFIG_MTD_SPI_NAND=m
CONFIG_MMC_BLOCK_MINORS=32
CONFIG_HID_BATTERY_STRENGTH=y
CONFIG_HID_SONY=m
CONFIG_HID_NINTENDO=m
CONFIG_HID_STEAM=m
CONFIG_HID_WIIMOTE=m
CONFIG_HID_MICROSOFT=m
CONFIG_HID_APPLE=m
CONFIG_HID_MULTITOUCH=m
CONFIG_HID_MAGICMOUSE=m
CONFIG_HID_KENSINGTON=m
CONFIG_HID_SAITEK=m
CONFIG_HID_STEELSERIES=m
CONFIG_HID_ROCCAT=m
CONFIG_TCP_CONG_BBR=m
CONFIG_IFB=m
CONFIG_NET_SCH_PIE=m
CONFIG_TAP=m
CONFIG_MACVTAP=m
CONFIG_NET_VRF=m
CONFIG_NET_TEAM=m
CONFIG_MPTCP=y
CONFIG_NF_CONNTRACK_PROCFS=y
CONFIG_NETFILTER_XTABLES_COMPAT=y
CONFIG_MEDIA_DIGITAL_TV_SUPPORT=y
CONFIG_MEDIA_ANALOG_TV_SUPPORT=y
CONFIG_MEDIA_RADIO_SUPPORT=y
CONFIG_MEDIA_SDR_SUPPORT=y
CONFIG_DVB_NET=y
CONFIG_DVB_DYNAMIC_MINORS=y
CONFIG_DVB_USB_V2=m
CONFIG_DVB_USB_RTL28XXU=m
CONFIG_DVB_USB_AF9035=m
CONFIG_DVB_USB_DVBSKY=m
CONFIG_VIDEO_EM28XX_DVB=m
CONFIG_SMS_USB_DRV=m
CONFIG_SND_ALOOP=m
CONFIG_SND_SEQUENCER=m
CONFIG_SND_SEQ_DUMMY=m
CONFIG_SND_DYNAMIC_MINORS=y
CONFIG_LEDS_TRIGGER_DISK=y
CONFIG_LEDS_TRIGGER_TRANSIENT=m
CONFIG_LEDS_CLASS_MULTICOLOR=m
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_RTC_INTF_PROC=y
CONFIG_EEPROM_AT24=m
CONFIG_MODULE_FORCE_UNLOAD=y
# Debian's wireless-regdb is signed by Debian's key: trusted beside the kernel's, or cfg80211
# rejects it and every country stays 00
CONFIG_CFG80211_CERTIFICATION_ONUS=y
CONFIG_CFG80211_EXTRA_REGDB_KEYDIR="/repo/kernel/regdb-certs"
# the H616 audio hub and its HDMI audio
CONFIG_SND_SUN50I_H616_AHUB=y
CONFIG_DRM_DW_HDMI_I2S_AUDIO=y
CONFIG_SND_SOC_SUNXI_HDMI=y
# the H616 EPHY, clocked from PWM5: built in, as the EMAC's reset needs its clock
CONFIG_PWM_SUN20I=y
CONFIG_XPOWERS_ACX00_PHY=y
# the bring-up's lockup checks load it; nothing else does
CONFIG_TEST_LOCKUP=m
