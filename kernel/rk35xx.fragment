CONFIG_LOCALVERSION="-tvb-rk35xx"
# CONFIG_LOCALVERSION_AUTO is not set
# no DWARF and so no BTF: a debug-info tree outgrows a CI runner's disk
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_DWARF5 is not set
# CONFIG_DEBUG_INFO_BTF is not set
# warnings stay warnings: vendor code, in-tree and built against it, is not warning-clean
# CONFIG_WERROR is not set
# no TV box has a touchscreen, and this one is broken at the pin: it still calls set_fs()
# CONFIG_TOUCHSCREEN_FTS is not set
# the vendor's phone sensor stack: nothing a TV box carries, and its ak8975 clashes with IIO's
# CONFIG_SENSOR_DEVICE is not set
# the console font fbcon prefers on a TV, as meson64's: 8x16 at 1080p is 240 columns
CONFIG_FONTS=y
CONFIG_FONT_8x8=y
CONFIG_FONT_8x16=y
CONFIG_FONT_TER16x32=y
# every family: a panic reboots, and leaves its log in pstore
CONFIG_PSTORE_RAM=y
CONFIG_PANIC_TIMEOUT=10
# every family: a kernel that preempts anywhere, at a tick 50 and 60 Hz frames both divide; the UI and
# audio threads wait on no kernel loop
CONFIG_PREEMPT=y
CONFIG_HZ_300=y
# real-time priority for a process in any cgroup, as an audio server under systemd needs; Android's
# group budget refuses it
# CONFIG_RT_GROUP_SCHED is not set
# every family: a CPU stuck without timer interrupts, or one that never yields, panics into that
# reboot; the watchdog only proves PID 1 runs, on another CPU
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=y
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_HARDLOCKUP_PANIC=y
# every family: file names on FAT, NTFS and exFAT disks in UTF-8
CONFIG_NLS_DEFAULT="utf8"
# Debian's wireless-regdb is signed by Debian's key: trusted beside the kernel's, or cfg80211
# rejects it and every country stays 00
CONFIG_CFG80211_CERTIFICATION_ONUS=y
CONFIG_CFG80211_EXTRA_REGDB_KEYDIR="/repo/kernel/regdb-certs"
# the AV jack's composite output, the R69's and the 3518's; a tree without the jack disables its TVE
CONFIG_ROCKCHIP_DRM_TVE=y
