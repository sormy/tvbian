CONFIG_LOCALVERSION="-tvb-rk35xx-next2"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_DWARF5 is not set
# CONFIG_DEBUG_INFO_BTF is not set
CONFIG_PREEMPT=y
CONFIG_HZ_300=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PANIC_TIMEOUT=10
CONFIG_AUTOFS_FS=y
CONFIG_EXT4_FS=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_DWMAC_ROCKCHIP=y
CONFIG_ROCKCHIP_PHY=y
CONFIG_ROCKCHIP_THERMAL=y
# the vendor's thermal zones: switch-on at threshold, held at target, sustainable-power
CONFIG_THERMAL_DEFAULT_GOV_POWER_ALLOCATOR=y
# devfreq's fixed-rate governors, for a test that pins the GPU or DDR
CONFIG_DEVFREQ_GOV_PERFORMANCE=y
CONFIG_DEVFREQ_GOV_POWERSAVE=y
CONFIG_DEVFREQ_GOV_USERSPACE=y
CONFIG_ARM_RK3528_DMC_DEVFREQ=m
CONFIG_ARM_ROCKCHIP_CPUFREQ_PVTM=y
CONFIG_DRM_ROCKCHIP=m
CONFIG_ROCKCHIP_VOP2=y
CONFIG_ROCKCHIP_DW_HDMI=y
CONFIG_PHY_ROCKCHIP_INNO_HDMI=m
CONFIG_DRM_LIMA=m
CONFIG_VIDEO_ROCKCHIP_VDEC=m
CONFIG_VIDEO_ROCKCHIP_JPEGD=m
CONFIG_VIDEO_ROCKCHIP_RKVENC=m
CONFIG_ROCKCHIP_TVE=y
CONFIG_SRAM=y
CONFIG_SND_SOC_SPDIF=m
CONFIG_DRM_DW_HDMI_I2S_AUDIO=m
CONFIG_LIRC=y
CONFIG_IR_NEC_DECODER=m
CONFIG_HW_RANDOM_ROCKCHIP=m
CONFIG_SND_SOC_RK3528=m
CONFIG_REGULATOR_PWM=y
CONFIG_REGULATOR_GPIO=y
CONFIG_RFKILL=y
CONFIG_CFG80211=y
CONFIG_CFG80211_CERTIFICATION_ONUS=y
CONFIG_CFG80211_EXTRA_REGDB_KEYDIR="/repo/kernel/regdb-certs"
CONFIG_EXPERT=y
# EXPERT defaults namespaces off; sandboxes, containers and systemd's isolation need them
CONFIG_NAMESPACES=y

CONFIG_FONTS=y
CONFIG_FONT_TER16x32=y
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=1
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_HARDLOCKUP_PANIC=y
CONFIG_TEST_LOCKUP=m
CONFIG_ZRAM=m
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_DYNAMIC_DEBUG=y
# each CMA pool's use, which the suite's cma.peak.mib samples
CONFIG_CMA_DEBUGFS=y
# the last functions each CPU ran, kept in pstore across a reset: a hard lockup leaves no other trace
CONFIG_PSTORE_FTRACE=y
# key presses from userspace, which the suites' input checks make
CONFIG_INPUT_UINPUT=m

# The SDIO power sequences reset their radios through GPIOs, the path every radio runs on
# CONFIG_RESET_GPIO is not set
# the IEP2 deinterlacer, a V4L2 mem2mem device
CONFIG_VIDEO_ROCKCHIP_IEP2=m
# the VDPP scaler, a V4L2 mem2mem device sharing the IEP2's engine
CONFIG_VIDEO_ROCKCHIP_VDPP=m
# the dma-buf heaps, built in: no device loads them, and a client allocates its own buffers there
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_DMABUF_HEAPS_CMA=y
