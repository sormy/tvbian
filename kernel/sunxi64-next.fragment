# 6.19 made the hung-task panic a count: 0 keeps it off
CONFIG_BOOTPARAM_HUNG_TASK_PANIC=0
# 7.2 brings the old NTFS driver back under NTFS_FS, which named NTFS3 before
# CONFIG_NTFS_FS is not set
CONFIG_NTFS3_FS=m
# LibreELEC's AC200 core and PHY both build as ac200.ko: the core built in
CONFIG_MFD_AC200=y
