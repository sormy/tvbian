# Wayland, and video through the VA driver: Chromium opens VA-API on a non-PCI GPU only on the
# node it is named, which tvb-va-driver links as /dev/dri/va
export CHROMIUM_FLAGS="$CHROMIUM_FLAGS --ozone-platform=wayland --hardware-video-device-path=/dev/dri/va --enable-features=VaapiVideoDecoder,VaapiIgnoreDriverChecks,VaapiVideoDecodeLinuxGL,AcceleratedVideoDecodeLinuxGL"
