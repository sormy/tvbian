// the dock: launchers, then the open windows
{
  "layer": "top",
  "position": "bottom",
  "height": 56,
  "margin-bottom": 6,
  "exclusive": false,
  "name": "dock",
  "modules-center": ["image#terminal", "image#files", "image#browser", "wlr/taskbar"],
  "image#terminal": {
    "path": "/usr/share/icons/WhiteSur/apps/scalable/utilities-terminal.svg",
    "size": 40,
    "on-click": "foot"
  },
  "image#files": {
    "path": "/usr/share/icons/WhiteSur/apps/scalable/system-file-manager.svg",
    "size": 40,
    "on-click": "pcmanfm"
  },
  "image#browser": {
    "path": "/usr/share/icons/WhiteSur/apps/scalable/web-browser.svg",
    "size": 40,
    "on-click": "falkon"
  },
  "wlr/taskbar": { "format": "{icon}", "icon-size": 40, "on-click": "activate" }
}
