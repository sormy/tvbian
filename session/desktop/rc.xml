<?xml version="1.0"?>
<labwc_config>
  <core>
    <gap>4</gap>
    <!-- wlroots 0.18 frees a lazily started Xwayland's socket sources it still polls: an HDMI replug crashes labwc -->
    <xwaylandPersistence>yes</xwaylandPersistence>
  </core>
  <theme>
    <name>TVBian</name>
    <titlebar>
      <layout>close,iconify,max:</layout>
    </titlebar>
    <cornerRadius>8</cornerRadius>
    <font place="">
      <name>Inter</name>
      <size>10</size>
    </font>
  </theme>
  <keyboard>
    <default />
    <keybind key="W-Return">
      <action name="Execute" command="foot" />
    </keybind>
    <keybind key="W-space">
      <action name="Execute" command="fuzzel" />
    </keybind>
    <keybind key="W-l">
      <action name="Execute" command="swaylock -f -c 202020" />
    </keybind>
    <keybind key="Print">
      <action name="Execute" command="sh -c 'grim ~/screenshot-$(date +%F-%H%M%S).png'" />
    </keybind>
    <keybind key="S-Print">
      <action name="Execute" command="sh -c 'grim -g &quot;$(slurp)&quot; ~/screenshot-$(date +%F-%H%M%S).png'" />
    </keybind>
  </keyboard>
  <mouse>
    <default />
  </mouse>
</labwc_config>
